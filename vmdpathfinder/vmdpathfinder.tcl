proc ::VMDPathFinder::show_about_dialog {{tab guide}} {
    # `tab` is which notebook page to land on: "guide" (Help menu) or "cite"
    # (the main window's "How to cite" button). An already-open window is
    # switched to the requested page instead of being left where it was.
    variable w
    variable version
    variable plugin_author

    # Pathed under $w (not root ".") so it closes automatically when the main
    # window does - see show_import_dialog's identical fix.
    set d $w.about
    if {$tab ni {guide cite}} { set tab guide }
    if {[winfo exists $d]} {
        catch {$d.nb select $d.nb.$tab}
        wm deiconify $d; raise $d; return
    }
    toplevel $d
    wm withdraw $d
    wm title $d "VMDPathFinder Help"
    wm minsize $d 600 560

    ttk::notebook $d.nb
    set g [_about_make_tab $d.nb guide]
    $d.nb add $d.nb.guide -text "Guide"
    set c [_about_make_tab $d.nb cite]
    $d.nb add $d.nb.cite  -text "Citations"
    pack $d.nb -expand 1 -fill both -padx 8 -pady {8 4}

    _about_fill_guide     $g $version
    _about_fill_citations $c $version $plugin_author
    $g configure -state disabled
    $c configure -state disabled

    button $d.ok -text "Dismiss" -command [list destroy $d]
    pack $d.ok -pady {4 10}
    catch {$d.nb select $d.nb.$tab}
    _center_toplevel $d 660 640
}

# ------------------------------------------------------------------------------
# Core helpers
# ------------------------------------------------------------------------------

proc ::VMDPathFinder::_stop_background_work {} {
    # Signal every loop to stop and cancel the self-rescheduling timers. Widgets
    # are NOT touched: this also runs from Tk shutdown, when they are going away
    # anyway. Safe to call more than once.
    variable state
    variable playing
    set _t0 [clock milliseconds]
    catch {set state(abort_requested) 1}
    catch {set playing 0}
    set _ncancel 0
    foreach _av {display_apply_after prebuild_after material_after prewarm_after play_watchdog_after} {
        variable $_av
        if {[info exists $_av] && [set $_av] ne ""} {
            catch {after cancel [set $_av]}
            set $_av ""
            incr _ncancel
        }
    }
    # The vmd_frame trace fires on every frame change INCLUDING the ones VMD
    # makes while tearing a molecule down, and frame_changed is not a cheap
    # handler. Nothing else removes it on the quit path.
    catch {remove_frame_trace}
    # The helper processes too, or VMD waits on them: the mesher/classifier
    # server and the persistent per-frame workers both outlive a plain quit.
    catch {_csg_server_close}
    catch {_pw_shutdown}
    # Where a slow quit went.
    set _el [expr {[clock milliseconds] - $_t0}]
    if {$_el > 200} {
        catch {vmdcon -info "VMDPathFinder: shutdown teardown $_el ms ($_ncancel timer(s), [llength [after info]] after(s) left)"}
    }
}

proc ::VMDPathFinder::_withdraw_child_dialogs {} {
    # Withdraw every toplevel the plugin owns, main window excluded. Called on
    # close so no settings/gear panel is left floating over VMD with nothing
    # behind it. Tooltips are destroyed instead: they are transient
    # `$widget.__vmdpathfinder_tip` windows with no state worth keeping, and one left
    # mapped is a black box stuck on screen.
    variable w
    if {![_have_tk] || ![winfo exists $w]} { return }
    foreach t [winfo children $w] {
        if {[winfo class $t] ne "Toplevel"} { continue }
        catch {wm withdraw $t}
    }
    # Tooltips hang off the widget they annotate, anywhere in the tree.
    _destroy_tooltips $w
}

proc ::VMDPathFinder::_on_main_unmapped {} {
    # VMD's Extensions menu withdraws the main window ITSELF, without going
    # through close_gui - so every gear, settings and results window the plugin
    # had open stayed on screen with nothing behind them. Only "withdrawn"
    # counts: minimising gives "iconic", and a minimised window is coming back.
    variable w
    if {![_have_tk] || ![winfo exists $w]} { return }
    if {[catch {wm state $w} _st] || $_st ne "withdrawn"} { return }
    _withdraw_child_dialogs
}

proc ::VMDPathFinder::_destroy_tooltips {root} {
    # Depth-first: a tooltip is named __vmdpathfinder_tip and parented to its own
    # widget, so it can be arbitrarily deep rather than a direct child of $w.
    foreach c [winfo children $root] {
        if {[string match "*.__vmdpathfinder_tip" $c]} {
            catch {destroy $c}
            continue
        }
        _destroy_tooltips $c
    }
}

proc ::VMDPathFinder::close_gui {} {
    variable w
    variable state
    variable current_surface_mol
    variable results
    _csg_server_close
    catch {_pw_shutdown}
    catch {_watermelon_restore_vmd_colors}
    # Cancel any pending GUI-apply idle callbacks so a deferred handler can't fire
    # against the just-destroyed window (display/material re-apply, surface prebuild,
    # prewarm). The per-frame settle/scrub afters ARE torn down by remove_frame_trace
    # below when the visualization is dropped, and deliberately KEPT when
    # keep_visualization lets the user go on scrubbing.
    # play_watchdog_after is NOT one of those: it is a self-rescheduling loop
    # (start_play_watchdog -> play_watchdog -> reschedules itself every 400 ms
    # while `playing`), independent of the vmd_frame trace, so closing mid-
    # playback left it polling forever against a destroyed window - harmless
    # per firing (its own widget touches are guarded/caught) but never actually
    # stops, which is exactly the leak this function exists to prevent.
    # Anything still computing must be told to stop, or the shell pool keeps
    # pumping against a destroyed window and VMD will not exit - reported as
    # "the vmdpathfinder closed but I had to close the vmd terminal".
    catch {set state(abort_requested) 1}
    catch {_drop_owned_reps}
    variable playing
    set playing 0
    foreach _av {display_apply_after prebuild_after material_after prewarm_after play_watchdog_after} {
        variable $_av
        if {[info exists $_av] && [set $_av] ne ""} {
            catch {after cancel [set $_av]}
            set $_av ""
        }
    }
    # UI traces are deliberately NOT removed here - none of them. All are
    # registered by _trace_once inside the GUI BUILD code, and show_gui's
    # reopen path returns at `winfo exists $w` before any of that runs (VMD's
    # Extensions re-map bypasses show_gui entirely), so a trace removed on
    # close is gone for the rest of the session. Four of them (display_mode,
    # hydro_scheme, show_hydro_scalebar, scalebar_font_color) were stripped
    # here, and their controls - the only ones that apply immediately with no
    # Redraw button - went dead after one close/reopen. The window is
    # withdrawn, never destroyed, so their handlers' widget writes stay valid.
    variable tunnel_result_frames
    set have_vis [expr {($current_surface_mol >= 0 && \
        ![catch {molinfo $current_surface_mol get name}]) || [dict size $results] > 0 \
        || [llength $tunnel_result_frames] > 0}]
    if {[string is true -strict $state(keep_visualization)] && $have_vis} {
        # Leave the surface molecule, the frame-sync trace, and the cached
        # results in place so the user can keep scrubbing/playing the trajectory
        # and watch the HOLE surface follow the frames after the panel closes.
        # Temp outputs are kept too, since per-frame surface files are re-read on
        # each redraw; reopen the plugin and use Cleanup Temp to remove them.
        set state(status) "Visualization kept - scrub or play frames to animate the pore."
    } else {
        remove_frame_trace
        # A settle timer armed by the last scrub outlives the trace removal
        # and would re-run the profile/surface pipeline against the torn-down
        # session 150 ms after the window disappears. Kept, deliberately,
        # in the keep_visualization branch above.
        variable frame_changed_after
        if {[info exists frame_changed_after] && $frame_changed_after ne ""} {
            catch {after cancel $frame_changed_after}
            set frame_changed_after ""
        }
        catch {_smooth_watch_stop}
        catch {remove_ellipse_surface}
        clear_surface
        # Remove every other molecule's surface track too (clear_surface only
        # deletes the active one).
        variable surface_mols
        foreach k [array names surface_mols] {
            if {![catch {molinfo $surface_mols($k) get name}]} {
                catch {mol delete $surface_mols($k)}
            }
            unset surface_mols($k)
        }
        # Memory tracks live in their own array (a memory's surface is not the
        # molecule's), so this loop would otherwise leave every memory's pore
        # floating in the viewer after the window closed.
        variable mem_surface_mols
        foreach k [array names mem_surface_mols] {
            if {![catch {molinfo $mem_surface_mols($k) get name}]} {
                catch {mol delete $mem_surface_mols($k)}
            }
            unset mem_surface_mols($k)
        }
        # Marker spheres (CPOINT / tunnel start) live in their own mols and
        # were the one visual left floating in the viewer after every
        # surface, centerline and scale bar was cleaned up.
        variable point_marker_mols
        if {[info exists point_marker_mols]} {
            dict for {_mk _mm} $point_marker_mols {
                if {$_mm ne "" && ![catch {molinfo $_mm get name}]} { catch {mol delete $_mm} }
            }
            set point_marker_mols [dict create]
        }
        cleanup_temporary_outputs
    }
    # Deliberately does NOT call save_config here, so closing the window never
    # bakes in whatever the current live settings happen to be, including
    # one-off experiments never meant to become the new default. Preferences
    # persist only via the explicit "Save Settings" buttons - see save_config.
    # WITHDRAW, never destroy. vmd_install_extension remembers the toplevel
    # this extension returned the first time it was opened and simply maps that
    # path afterwards, so destroying it left the Extensions entry pointing at a
    # window that no longer exists - the plugin could not be reopened at all
    # for the rest of the session. show_gui deiconifies an existing window.
    # Every dialog goes with it. They are all CHILDREN of $w but each is its own
    # toplevel, and withdrawing a parent does not withdraw a child toplevel - so
    # closing the plugin left them all on screen, orphaned: measured 17 of 18
    # still mapped (settings, the HOLE/scale/mean/profile/overtime/histogram
    # panels, align, vector, ion flow, hydration, trends, about, import, the two
    # tunnel gears, and the Connolly per-row/global region gear). Only the
    # Message Log closed itself.
    #
    # Enumerated, not a hard-coded list: a dialog added later is covered without
    # anyone remembering to add it here. WITHDRAW rather than destroy, for the
    # same reason $w itself is withdrawn - several of these are rebuilt-on-open
    # (the region gear destroys and recreates itself) but others just deiconify
    # what already exists, and destroying those strands the state they hold.
    # A modal confirm may be mid-tkwait (Run's overwrite prompt holds a grab
    # and an unanswered ::VMDPathFinder::_overwrite_ans). Withdrawing it without
    # answering leaves the tkwait pending and the application grab pointing at
    # an unmapped window: every Tk surface VMD owns goes mouse-dead and busy
    # stays 1. Closing the window IS the answer - Cancel - and setting it lets
    # tkwait return, the dialog release its own grab, and the caller unwind.
    catch {set ::VMDPathFinder::_overwrite_ans 0}
    _withdraw_child_dialogs
    if {[_have_tk] && [winfo exists $w]} { catch {wm withdraw $w} }
    # And the entry is a toggle, so VMD also has to be told it is off, or its
    # own state says "on" with nothing on screen and the next click is a no-op.
    catch {menu vmdpathfinder off}
    # LOWER THE ABORT AGAIN. It was raised at the top of this proc to stop
    # in-flight work; leaving it raised poisons everything computed after the
    # next open, because VMD re-maps the remembered toplevel WITHOUT calling
    # show_gui, so nothing else ever clears it. Every long loop polls it, so
    # _conn_site_table returned "stopped before finishing" and the openings
    # list came up empty having computed nothing - reliably, from the first
    # close onward, which is what "sometimes it works" was.
    variable _calc_depth
    variable busy
    if {(![info exists busy] || !$busy) && $_calc_depth <= 0} {
        set _calc_depth 0
        catch {set state(abort_requested) 0}
    } else {
        # Work is in flight: leave the abort RAISED, or the pool suspended
        # inside this very call's [update] resumes, never sees it, and runs
        # every remaining frame against a closed window - the reported
        # wont-exit defect quoted at the top of this proc. The aborted
        # run unwinds through _end_calc, whose depth<=0 arm lowers the flag,
        # and _begin_calc clears it on the next 0->1 transition - so the
        # reopen-poison this synchronous lower was written for stays fixed
        # for the idle-close case above, the only case it ever applied to.
    }
}

proc ::VMDPathFinder::_axg_unit {v} {
    lassign $v x y z; set n [expr {sqrt($x*$x+$y*$y+$z*$z)}]
    if {$n < 1e-12} { return [list 0.0 0.0 1.0] }
    return [list [expr {$x/$n}] [expr {$y/$n}] [expr {$z/$n}]]
}
proc ::VMDPathFinder::_axg_meanvar {coords axis} {
    # mean + variance of the projection of coords onto unit `axis`
    lassign $axis ux uy uz; set n 0; set s 0.0; set s2 0.0
    foreach c $coords { lassign $c x y z; set p [expr {$x*$ux+$y*$uy+$z*$uz}]
        set s [expr {$s+$p}]; set s2 [expr {$s2+$p*$p}]; incr n }
    if {$n < 2} { return [list 0.0 0.0] }
    set m [expr {$s/double($n)}]
    return [list $m [expr {$s2/double($n) - $m*$m}]]
}
proc ::VMDPathFinder::_detect_pore_axis {molid seltext} {
    # Memoised. The work below is a whole-system atomselect over the lipid
    # phosphates, a `measure inertia`, and four Tcl passes over every one of
    # their coordinates - seconds on a bilayer. It is the same answer for the
    # same structure and selection, and it is asked for again every time a
    # memory slot is created, which is what made adding one feel slow.
    variable _pore_axis_memo
    if {![info exists _pore_axis_memo]} { set _pore_axis_memo [dict create] }
    set _key "$molid|$seltext"
    catch {append _key "|[molinfo $molid get numatoms]|[molinfo $molid get numframes]"}
    # A cheap coordinate fingerprint, not just molid/numatoms/numframes - the
    # same idea run_signature already uses for the same reason. Without it,
    # aligning the trajectory (the panel's own "Align traj" button, which
    # MODIFIES coordinates in place - molid, atom count and frame count all
    # stay the same) left this returning the PRE-alignment axis forever.
    #
    # Centroid alone would miss a ROTATION-dominant alignment (an RMSD fit can
    # leave the centroid nearly where it was while turning the structure,
    # which is exactly the case this axis guess needs to notice) - so the
    # first atom's own absolute position is included too, cheap to read and
    # sensitive to rotation the centroid is blind to.
    catch {
        set _fcs [atomselect $molid "all" frame 0]
        set _fcc [measure center $_fcs]
        $_fcs delete
        set _fa0 {0.0 0.0 0.0}
        catch {
            set _a0 [atomselect $molid "index 0" frame 0]
            set _fa0 [lindex [$_a0 get {x y z}] 0]
            $_a0 delete
        }
        append _key [format "|%.2f,%.2f,%.2f|%.2f,%.2f,%.2f" \
            [lindex $_fcc 0] [lindex $_fcc 1] [lindex $_fcc 2] \
            [lindex $_fa0 0] [lindex $_fa0 1] [lindex $_fa0 2]]
    }
    if {[dict exists $_pore_axis_memo $_key]} { return [dict get $_pore_axis_memo $_key] }
    set _res [_detect_pore_axis_uncached $molid $seltext]
    dict set _pore_axis_memo $_key $_res
    return $_res
}

proc ::VMDPathFinder::_detect_pore_axis_uncached {molid seltext} {
    # Tiered pore-axis guess. Returns {axis method} (axis a unit 3-vector) or {{} {}}.
    # measure inertia is used ONLY for the three principal DIRECTIONS (its eigenvectors are
    # reliable); each is then ranked by a variance WE compute, since measure inertia's
    # eigenVALUES come back unsorted and occasionally negative.
    # (1) MEMBRANE NORMAL - the bilayer's thin direction (smallest variance of the lipid
    #     phosphates), signed by leaflet order. This is what PPM computes to orient a protein.
    if {![catch {atomselect $molid "name P and not protein"} psel]} {
        set nP 0; catch {set nP [$psel num]}
        if {$nP >= 40} {
            set pc [$psel get {x y z}]
            if {![catch {measure inertia $psel} mi]} {
                catch {$psel delete}
                lassign $mi _pe pevecs
                set best {}; set bv 1e30
                foreach e $pevecs { set u [_axg_unit $e]; lassign [_axg_meanvar $pc $u] _m v
                    if {$v < $bv} { set bv $v; set best $u } }
                if {$best ne {}} {
                    lassign [_axg_meanvar $pc $best] pm _
                    lassign $best bx by bz
                    set su 0.0; set nu 0; set sl 0.0; set nl 0
                    foreach c $pc { lassign $c x y z; set p [expr {$x*$bx+$y*$by+$z*$bz}]
                        if {$p > $pm} { set su [expr {$su+$p}]; incr nu } else { set sl [expr {$sl+$p}]; incr nl } }
                    if {$nu > 0 && $nl > 0 && [expr {$su/$nu - $sl/$nl}] < 0} {
                        set best [list [expr {-$bx}] [expr {-$by}] [expr {-$bz}]] }
                    return [list $best "membrane normal ($nP lipid P)"]
                }
            } else { catch {$psel delete} }
        } else { catch {$psel delete} }
    }
    # (2) SYMMETRY AXIS - a rotationally-symmetric (Cn) channel's pore axis is the one
    #     principal direction whose spread differs from the other two (which are ~equal by
    #     symmetry). The in-plane degeneracy of the other two is the confidence.
    set ssel ""
    if {[catch {atomselect $molid "($seltext) and name CA" frame 0} ssel] || [$ssel num] < 10} {
        catch {$ssel delete}
        if {[catch {atomselect $molid "$seltext" frame 0} ssel]} { return [list {} {}] }
    }
    if {$ssel eq "" || [$ssel num] < 4} { catch {$ssel delete}; return [list {} {}] }
    set cc [$ssel get {x y z}]
    if {[catch {measure inertia $ssel} mi2]} { catch {$ssel delete}; return [list {} {}] }
    catch {$ssel delete}
    lassign $mi2 _e2 evecs
    set us {}; set vs {}
    foreach e $evecs { set u [_axg_unit $e]; lappend us $u; lassign [_axg_meanvar $cc $u] _m v; lappend vs $v }
    lassign $vs v0 v1 v2
    set d0 [expr {abs($v0-($v1+$v2)/2.0)}]; set d1 [expr {abs($v1-($v0+$v2)/2.0)}]; set d2 [expr {abs($v2-($v0+$v1)/2.0)}]
    set k 0; if {$d1 > $d0 && $d1 >= $d2} { set k 1 } elseif {$d2 > $d0 && $d2 > $d1} { set k 2 }
    set oth {}; foreach i {0 1 2} { if {$i != $k} { lappend oth [lindex $vs $i] } }
    lassign $oth oa ob; set mxo [expr {max($oa,$ob)}]
    set degen [expr {$mxo > 0 ? abs($oa-$ob)/$mxo : 1.0}]
    if {$degen < 0.5} { return [list [lindex $us $k] [format "symmetry axis (conf %.2f)" $degen]] }
    # (3) INERTIA LONG AXIS (last resort) - the largest-variance principal direction, i.e.
    #     the long axis of an elongated protein.
    set kk 0; set mxv [lindex $vs 0]
    foreach i {1 2} { if {[lindex $vs $i] > $mxv} { set mxv [lindex $vs $i]; set kk $i } }
    return [list [lindex $us $kk] "inertia long axis"]
}

proc ::VMDPathFinder::suggest_cvect {{force 0} {warn_var {}}} {
    # Auto-detect pore axis from the molecule chosen in the plugin UI.
    # Tries the Orient package first; falls back to the smallest principal
    # moment of inertia (= long axis of a cylindrical protein) using frame 0.
    # Works for both single structures and trajectories.
    # Uses state(molid) and state(selection) - same subset as HOLE analysis.
    # Returns a human-readable note string describing what was done.
    # NOTE: no `return` inside catch - Tcl raises TCL_RETURN (code 2) which
    # catch intercepts, preventing the proc from actually returning.
    variable state
    if {!$force && [string trim $state(cvect)] ne ""} { return "already set" }
    if {[catch {set molid [resolve_molid]}]} { return "no molecule" }
    set molname [get_molecule_basename $molid]
    # Use the plugin's atom selection (same subset that HOLE will analyse).
    set seltext [string trim $state(selection)]
    if {$seltext eq "" || $seltext eq "all"} { set seltext "protein" }

    # Tiered pore-axis detection: membrane normal (lipid bilayer) -> symmetry axis (Cn
    # channel) -> inertia long axis. See _detect_pore_axis.
    set _res {}
    catch {set _res [_detect_pore_axis $molid $seltext]}
    lassign $_res _ax _method
    if {$_ax ne {}} {
        lassign [_axg_unit $_ax] _x _y _z
        # Sign convention: make the dominant component positive (HOLE traces either way).
        if {abs($_x) >= abs($_y) && abs($_x) >= abs($_z)} { set _d $_x } \
        elseif {abs($_y) >= abs($_z)} { set _d $_y } else { set _d $_z }
        if {$_d < 0} { set _x [expr {-$_x}]; set _y [expr {-$_y}]; set _z [expr {-$_z}] }
        set state(cvect) [format "%.4f %.4f %.4f" $_x $_y $_z]
        # The method only. The molecule, the selection and the vector itself are
        # all on screen already; repeating them made the readout unreadable.
        return $_method
    }
    set state(cvect) "0 0 1"
    return "no pore axis found, using Z"
}

# -- CVECT vector helper -------------------------------------------------------

proc ::VMDPathFinder::vector_point_from_sel {molid frame seltext} {
    # Coordinate to use for one end of the channel vector: the geometric centre
    # of an atom selection (so single atoms or small groups both work).
    set seltext [string trim $seltext]
    if {$seltext eq ""} { error "Empty atom selection." }
    set sel [atomselect $molid $seltext frame $frame]
    if {[$sel num] == 0} { $sel delete; error "Selection '$seltext' matched 0 atoms." }
    set c [measure center $sel]
    $sel delete
    return $c
}

proc ::VMDPathFinder::vector_from_points {p1 p2} {
    # Normalised direction pointing from p1 to p2, each {x y z}.
    lassign $p1 x1 y1 z1
    lassign $p2 x2 y2 z2
    set dx [expr {$x2 - $x1}]
    set dy [expr {$y2 - $y1}]
    set dz [expr {$z2 - $z1}]
    set len [expr {sqrt($dx*$dx + $dy*$dy + $dz*$dz)}]
    if {$len < 1e-9} { error "The two endpoints coincide; cannot form a direction." }
    return [list [expr {$dx/$len}] [expr {$dy/$len}] [expr {$dz/$len}]]
}

proc ::VMDPathFinder::compute_vector {d} {
    # Compute CVECT from the two-point form (Point 1 → Point 2) and show it in the
    # dialog WITHOUT closing, so the user can review before "Apply". Each entry accepts
    # x,y,z coordinates or a VMD atomselect string, evaluated at the CURRENT frame.
    variable state
    variable vec_p1
    variable vec_p2
    if {[catch {
        if {[string trim $vec_p1] eq "" || [string trim $vec_p2] eq ""} {
            error "Fill in both Point 1 and Point 2.\n(Use x,y,z - e.g. 1,0,0 - or a VMD selection - e.g. protein and resid 50 and name CA)"
        }
        set molid [resolve_molid]
        set frame [molinfo $molid get frame]
        set a [_resolve_point_input $vec_p1 $molid $frame]
        set b [_resolve_point_input $vec_p2 $molid $frame]
        set v [vector_from_points $a $b]
        set state(cvect) [format "%.4f %.4f %.4f" {*}$v]
        # Remember the two-point DEFINITION so "Recompute per frame" can re-evaluate
        # the axis at each frame (set AFTER state(cvect) so the clearing trace, which
        # fires on the line above, does not wipe it). Selection/label inputs track the
        # structure; literal x,y,z inputs stay fixed.
        set state(cvect_def_p1) $vec_p1
        set state(cvect_def_p2) $vec_p2
        set state(status) "CVECT set to $state(cvect)."
        if {[winfo exists $d.result]} { $d.result configure -text "CVECT = $state(cvect)" }
        catch {_sync_cvect_handles}
        _cvect_sync_stab_controls $d
    } msg]} {
        tk_messageBox -icon error -type ok -title "CVECT" -message $msg -parent $d
    } else {
        # A dialog of its own is dismissed on success; inside the stick dialog
        # the page stays, showing the result.
        if {[winfo toplevel $d] eq $d} { catch {destroy $d} }
    }
}

proc ::VMDPathFinder::_resolve_point_input {val molid frame} {
    # Try to parse as x,y,z first; fall back to treating as a VMD atom selection.
    set norm [normalize_triplet_value $val]
    if {$norm ne {}} { return $norm }
    return [vector_point_from_sel $molid $frame $val]
}

proc ::VMDPathFinder::_point_now {val molid frame} {
    # A point field ("x y z" OR an atom selection) as three numbers at THIS
    # frame, or {} if it is neither. A selection of several atoms gives its
    # centre of geometry, recomputed for the frame asked for, so a point tied
    # to residues follows the structure.
    if {[string trim $val] eq ""} { return {} }
    set n [normalize_triplet_value $val]
    if {$n ne {}} { return $n }
    if {[catch {vector_point_from_sel $molid $frame $val} c]} { return {} }
    if {[llength $c] != 3} { return {} }
    return $c
}

proc ::VMDPathFinder::_clear_cvect_def {args} {
    # Drop the stored two-point CVECT definition whenever CVECT is set by any other
    # means (manual edit, Z-axis, guess). compute_vector re-sets it right after
    # for the two-point method, so only definition-less axes are left static.
    variable state
    set state(cvect_def_p1) {}
    set state(cvect_def_p2) {}
    # Redraw: the state is what Guess/Use Z invalidate, but the point 1 / point 2
    # spheres and the axis are drawn geometry and stayed on screen showing a
    # definition that no longer exists.
    catch {_sync_cvect_handles}
    variable w
    if {[_have_tk] && [winfo exists $w.axisstick]} {
        catch {_cvect_sync_stab_controls $w.axisstick}
    }
}

proc ::VMDPathFinder::_on_track_cpoint_toggled {} {
    # Track and Stabilize are mutually exclusive: if Track turns on, clear Stabilize.
    variable state
    if {[info exists state(track_cpoint)] && $state(track_cpoint) && \
            [info exists state(stabilize_cpoint)] && $state(stabilize_cpoint)} {
        set state(stabilize_cpoint) 0
    }
    _update_cpoint_scope_row
}

proc ::VMDPathFinder::_on_stabilize_toggled {which} {
    # CPOINT Stabilize ↔ Track are mutually exclusive; refresh the contextual scope row.
    variable state
    if {$which eq "cpoint" && [info exists state(stabilize_cpoint)] && $state(stabilize_cpoint)} {
        if {[info exists state(track_cpoint)]} { set state(track_cpoint) 0 }
    }
    _update_cpoint_scope_row
}

proc ::VMDPathFinder::_update_cpoint_scope_row {{parent ""}} {
    # Show the scope fields that match the checked per-frame mode:
    #   Stabilize → inner/outer/RMSD-warn   |   Track → centroid radius   |   neither → empty
    variable state
    variable _runpanel
    variable w
    if {$parent eq ""} {
        # The panel row is gone; the stick dialog owns these now. Fall back to it
        # so the checkbox handlers, which pass no parent, still drive the row.
        foreach _cand [list [expr {[info exists _runpanel] ? $_runpanel : ""}] "$w.axisstick.pf"] {
            if {$_cand ne "" && [winfo exists $_cand.scope_box]} { set parent $_cand; break }
        }
    }
    if {$parent eq "" || ![winfo exists $parent.scope_box]} { return }
    # Inside the stick dialog these fields are CPOINT's; on any other page they
    # stay hidden whatever the checkboxes say.
    if {[string match "*.axisstick.pf" $parent] && [info exists state(axis_stick_mode)] \
            && $state(axis_stick_mode) ne "cpoint"} {
        catch {grid remove $parent.scope_box}
        return
    }
    set sb $parent.scope_box
    foreach c [winfo children $sb] { catch {pack forget $c} }
    if {[info exists state(stabilize_cpoint)] && $state(stabilize_cpoint)} {
        pack $sb.sl $sb.ri $sb.ri_l $sb.ro $sb.ro_l $sb.rw -side left -padx 3
        grid $sb
    } elseif {[info exists state(track_cpoint)] && $state(track_cpoint)} {
        pack $sb.tl $sb.tr $sb.tr_l -side left -padx 3
        grid $sb
    } else {
        # Nothing to show: fully remove the row so it leaves no gap behind.
        grid remove $sb
    }
}

proc ::VMDPathFinder::_set_point_to_selection_center {key label} {
    # Set state($key) to the geometric centre of a selection at the current
    # frame. Shared by HOLE's CPOINT "COM" button and Tunnel mode's start-point
    # "COM" button - same computation, different target key. Centers whatever
    # is CURRENTLY typed in state($key) itself when that's a usable selection
    # (a prior "COM scope" side field asked the user to duplicate the same
    # text there instead, which nobody could see the point of - removed).
    # Blank, or text that fails to resolve (including an already-numeric
    # x,y,z from an earlier COM click), falls back to the main Selection.
    variable state
    if {[catch {
        set molid [resolve_molid]
        set frame [molinfo $molid get frame]
        if {![string is integer -strict $frame] || $frame < 0} { set frame 0 }
        set seltext [string trim $state($key)]
        if {[catch {set c [vector_point_from_sel $molid $frame $seltext]}]} {
            set seltext [string trim $state(selection)]
            if {$seltext eq "" || $seltext eq "all"} { set seltext "protein" }
            set c [vector_point_from_sel $molid $frame $seltext]
        }
        set state($key) [format_triplet $c]
        set state(status) "$label set to center of selection \"$seltext\"."
    } msg]} {
        set state(status) $msg
        tk_messageBox -icon error -type ok -title "HOLE" -message $msg
    }
}
proc ::VMDPathFinder::use_selection_center {} { _set_point_to_selection_center cpoint CPOINT }
proc ::VMDPathFinder::tunnel_use_selection_center {} { _set_point_to_selection_center tunnel_start "Tunnel start point" }

proc ::VMDPathFinder::_ensure_axis_refs {molid} {
    # Track/Stabilize CPOINT and Stabilize-CVECT derive their per-frame
    # point/direction from refs _stab_init captures once, so the cue is only
    # live if those refs both exist and still match CPOINT, CVECT-def-p1/p2
    # and the molecule - all four are independently editable. Initialised
    # here on demand (run_analysis is the only other caller, at run start).
    #
    # Debounced: reached from a per-keystroke write trace on state(cpoint)
    # (_sync_point_marker); _stab_init's atomselect + measure-center calls
    # are too costly to repeat per character. run_analysis's own call to
    # _stab_init (line ~35649) is separate and stays synchronous.
    variable state
    variable _track_offset
    variable _stab_cp_ref_xyz
    variable _stab_p1_ref_xyz
    variable _stab_p2_ref_xyz
    variable _axis_refs_cp; variable _axis_refs_molid
    variable _axis_refs_p1; variable _axis_refs_p2
    set do_cv [expr {$state(stabilize_cvect) \
        && !([info exists state(cvect_exact)] && $state(cvect_exact))}]
    set need 0
    if {$state(track_cpoint) && (![info exists _track_offset] || $_track_offset eq {})} {
        set need 1
    }
    if {$state(stabilize_cpoint) && (![info exists _stab_cp_ref_xyz] || $_stab_cp_ref_xyz eq {})} {
        set need 1
    }
    if {$do_cv && (![info exists _stab_p1_ref_xyz] || $_stab_p1_ref_xyz eq {} \
            || ![info exists _stab_p2_ref_xyz] || $_stab_p2_ref_xyz eq {})} {
        set need 1
    }
    if {!$need && ($state(track_cpoint) || $state(stabilize_cpoint) || $do_cv)} {
        set _cp_now [string trim $state(cpoint)]
        set _p1_now [string trim $state(cvect_def_p1)]
        set _p2_now [string trim $state(cvect_def_p2)]
        if {![info exists _axis_refs_cp]    || $_axis_refs_cp ne $_cp_now}    { set need 1 }
        if {![info exists _axis_refs_p1]    || $_axis_refs_p1 ne $_p1_now}    { set need 1 }
        if {![info exists _axis_refs_p2]    || $_axis_refs_p2 ne $_p2_now}    { set need 1 }
        if {![info exists _axis_refs_molid] || $_axis_refs_molid ne $molid}   { set need 1 }
    }
    if {!$need} { return }
    variable _axis_refs_after
    if {[info exists _axis_refs_after] && $_axis_refs_after ne ""} {
        after cancel $_axis_refs_after
    }
    set _axis_refs_after [after 150 [list ::VMDPathFinder::_axis_refs_settle $molid]]
}

proc ::VMDPathFinder::_axis_refs_settle {molid} {
    # Debounced tail of _ensure_axis_refs: run the real (expensive) re-init,
    # then redraw the cue with the fresh refs - it drew immediately on the
    # triggering keystroke using whatever refs it had, so it needs a second
    # nudge once the settled ones are ready.
    variable _axis_refs_after
    set _axis_refs_after ""
    catch {_stab_init $molid}
    catch {_sync_point_marker cpoint show_cpoint_marker}
}

proc ::VMDPathFinder::_sync_point_marker {key show_key args} {
    # Draws (or removes) a single sphere at state($key) - a visual cue for where
    # CPOINT/the tunnel start point actually is, since a wrong point is a common
    # reason a search finds nothing and the number alone doesn't show WHERE it
    # landed. Toggled per mode under that mode's own gear settings. Shares one
    # small dedicated mol per key (created on demand, deleted when hidden), kept
    # in sync via a write trace on both state($key) and state($show_key) - args
    # swallows the (name1 name2 op) Tcl appends when called as a trace command.
    variable state
    variable point_marker_mols
    if {![info exists point_marker_mols]} { set point_marker_mols [dict create] }
    if {![_have_tk]} { return }
    set molid [expr {[dict exists $point_marker_mols $key] ? [dict get $point_marker_mols $key] : ""}]
    set want [expr {[info exists state($show_key)] && $state($show_key)}]
    set pt ""
    if {$want && [info exists state($key)] && [string trim $state($key)] ne ""} {
        # Resolve the SAME way CPOINT/the tunnel start point are resolved for a
        # real run: literal "x y z" first, then a VMD atom selection. Without
        # the selection fallback the marker only ever drew for the narrower
        # already-numeric case - CPOINT left as a selection (its other, equally
        # normal form; the field is a plain text entry, not numbers-only) always
        # looked "not wired up" even with the checkbox on, since there was never
        # anything for the old numeric-only parse to match. catch: a selection
        # mid-typed by the user (fires on every keystroke, via the write trace)
        # is often momentarily invalid - that just means "nothing to show yet",
        # not an error.
        set _pm_ref ""
        set _pm_at 0
        set _pm_cv ""
        catch {
            set _pm_molid [resolve_molid]
            set _pm_frame [molinfo $_pm_molid get frame]
            # CPOINT: ask frame_axis for the point the RUN would actually use at
            # this frame, not the static field. Track/Stabilize move CPOINT per
            # frame, and resolving state(cpoint) directly ignored both - so the
            # cue sat still while the search was using a point that had moved,
            # i.e. the cue was showing something the run does not use. frame_axis
            # is that same per-frame resolver (Track > Stabilize > Static), and
            # it returns the matching CVECT in the same call, so the arrow picks
            # up Exact/Stabilize for free instead of duplicating the logic.
            if {$key eq "cpoint"} {
                _ensure_axis_refs $_pm_molid
                lassign [frame_axis $_pm_molid $_pm_frame] _fa_cp _fa_cv
                set _pm_cv $_fa_cv
                set _pm_src $_fa_cp
            } else {
                set _pm_src $state($key)
            }
            set _pm_pt [_resolve_point_input $_pm_src $_pm_molid $_pm_frame]
            if {[llength $_pm_pt] == 3} {
                set pt $_pm_pt; set _pm_ref $_pm_molid; set _pm_at $_pm_frame
            }
        }
    }
    if {$pt eq ""} {
        if {$molid ne "" && ![catch {molinfo $molid get name}]} { catch {mol delete $molid} }
        dict unset point_marker_mols $key
        return
    }
    if {$molid eq "" || [catch {molinfo $molid get name}]} {
        # mol new silently makes the new (empty) molecule VMD's top molecule.
        # state(molid) defaults to "top", so resolve_molid - including THIS
        # proc's own next call, on the next keystroke while typing a CPOINT
        # selection - would start resolving against the marker instead of the
        # real structure, fail to find the selection in an atom-less molecule,
        # and delete the marker it just drew. Restore top immediately so the
        # marker never hijacks which molecule the rest of the plugin sees.
        set _pm_prev_top [molinfo top]
        # EVERY molecule carries its own view matrices, and a fresh `mol new`
        # gets the IDENTITY ones - so a marker drawn into it is rendered in a
        # different coordinate frame than the structure. Measured on 1GRM: the
        # structure sits at scale 0.0586 with a z offset, the marker at scale
        # 1.0 with none, i.e. the sphere drawn ~17x oversized and off-centre,
        # far outside the visible volume. That is why "Show CPOINT as a sphere"
        # created a molecule with real graphics primitives in it, reported
        # displayed=1, and STILL showed nothing on screen - the object existed,
        # it just was not where the camera was looking. ensure_surface_mol has
        # always done this for the HOLE surface (which is why THAT lines up);
        # the marker simply never did.
        set _pm_pv {}
        if {$_pm_ref ne ""} {
            catch {set _pm_pv [molinfo $_pm_ref get \
                {center_matrix rotate_matrix scale_matrix global_matrix}]}
        }
        set molid [mol new]
        catch {mol rename $molid "VMDPathFinder: $key marker"}
        if {$_pm_pv ne ""} {
            catch {molinfo $molid set \
                {center_matrix rotate_matrix scale_matrix global_matrix} $_pm_pv}
            # Restore the structure's own view too: creating an empty molecule
            # can disturb the camera (same reason ensure_surface_mol does it).
            catch {molinfo $_pm_ref set \
                {center_matrix rotate_matrix scale_matrix global_matrix} $_pm_pv}
        }
        catch {mol top $_pm_prev_top}
        dict set point_marker_mols $key $molid
    } elseif {$_pm_ref ne ""} {
        # Existing marker: re-align in case the two drifted apart (a molecule
        # loaded/deleted since, or the structure re-centred).
        catch {sync_surface_view $molid $_pm_ref}
    }
    catch {graphics $molid delete all}
    # A glossy material rather than the flat-shaded default: every property/
    # radius color scheme this plugin uses is some rainbow or diverging
    # red-white-blue ramp, so a flat marker can read as "part of the surface"
    # at a glance. Glossy gives it the rounded-highlight look of a real VDW
    # atom, distinct on shading alone even where color overlap is possible.
    #
    # One color per mode, because both cues can be on screen at once and
    # "which mode is this point for?" is the whole question they answer.
    # Tunnel mode must ALSO avoid _tunnel_color's route palette
    # ({1 0 4 7 3 9 11 23 27 30}), which already contains magenta (27) - so the
    # start point takes lime, which is not in it.
    set _pm_col [expr {$key eq "tunnel_start" ? "lime" : "magenta"}]
    catch {graphics $molid materials on}
    catch {graphics $molid material Glossy}
    catch {graphics $molid color $_pm_col}
    catch {graphics $molid sphere $pt radius 1.1 resolution 20}
    # CVECT arrow, HOLE mode only (a branching MOLE tunnel has no single axis).
    # Drawn into the SAME marker mol so one checkbox governs both cues and both
    # inherit the view matrices aligned above.
    # The axis, drawn ONCE and here: white shaft, length taken from CVECT's two
    # points when they are set (a length the user chose, whose ends are the
    # points Stabilize/Exact carry) and from the selection's span otherwise.
    # The stick adds grab handles at these same ends while its CVECT page is
    # open; it never draws a second axis of its own.
    if {$key eq "cpoint" && $_pm_ref ne ""} {
        catch { _draw_cvect_axis $molid [_cvect_axis_ends] }
    }
}

proc ::VMDPathFinder::_cvect_page_open {} {
    # Is the stick showing its CVECT page right now? Both the handles and
    # _sync_point_marker's axis arrow ask, so the two cannot disagree about
    # which one is drawing the axis.
    variable w
    variable state
    if {![_have_tk]} { return 0 }
    set d $w.axisstick
    if {![winfo exists $d] || [catch {wm state $d} _st] || $_st ne "normal"} { return 0 }
    return [expr {[info exists state(axis_stick_mode)] && $state(axis_stick_mode) eq "cvect"}]
}

proc ::VMDPathFinder::_cvect_axis_ends {} {
    # THE axis, as its two end points. One definition, used by the cue and by
    # the stick's handles, so there is exactly one axis on screen and the
    # handles always sit on it.
    #
    # Position and direction come from frame_axis - the same per-frame resolver
    # the run uses (CPOINT: Track > Stabilize > Static; CVECT: Exact >
    # Stabilize > Static) - so the drawing follows the axis the search will
    # actually use at this frame rather than the static fields.
    #
    # LENGTH comes from the two points when they are set: that is a length the
    # user chose, and its ends are the points Stabilize/Exact carry. Without a
    # pair there is no chosen length, so it falls back to spanning the analysis
    # selection, which is what makes it read as "the axis the search runs
    # along" instead of an arbitrary stick.
    variable state
    variable vec_p1
    variable vec_p2
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return {} }
    set frame 0; catch {set frame [molinfo $molid get frame]}
    set c {}; set u {}
    catch {
        lassign [frame_axis $molid $frame] _fa_cp _fa_cv
        set c [_resolve_point_input $_fa_cp $molid $frame]
        set u [_normalize_dir $_fa_cv]
    }
    if {[llength $c] != 3} { catch {set c [_resolve_point_input $state(cpoint) $molid $frame]} }
    if {[llength $u] != 3} { catch {set u [_normalize_dir $state(cvect)]} }
    if {[llength $c] != 3 || [llength $u] != 3} { return {} }
    lassign $c cx cy cz
    lassign $u ux uy uz
    set a {}; set b {}
    catch {set a [_resolve_point_input $vec_p1 $molid $frame]}
    catch {set b [_resolve_point_input $vec_p2 $molid $frame]}
    if {[llength $a] == 3 && [llength $b] == 3} {
        lassign $a ax ay az
        lassign $b bx by bz
        set len [expr {sqrt(($bx-$ax)*($bx-$ax)+($by-$ay)*($by-$ay)+($bz-$az)*($bz-$az))}]
        if {$len > 1e-9} {
            set h [expr {$len/2.0}]
            return [list [list [expr {$cx-$h*$ux}] [expr {$cy-$h*$uy}] [expr {$cz-$h*$uz}]] \
                         [list [expr {$cx+$h*$ux}] [expr {$cy+$h*$uy}] [expr {$cz+$h*$uz}]]]
        }
    }
    lassign [_axis_bbox_span $molid $frame $c $u] tmin tmax
    return [list [list [expr {$cx+$ux*$tmin}] [expr {$cy+$uy*$tmin}] [expr {$cz+$uz*$tmin}]] \
                 [list [expr {$cx+$ux*$tmax}] [expr {$cy+$uy*$tmax}] [expr {$cz+$uz*$tmax}]]]
}

proc ::VMDPathFinder::_draw_cvect_axis {molid ends} {
    # The axis itself: a white shaft with a head at end 2. Drawn once, by
    # whichever cue is up - never by two drawers at the same time.
    if {[llength $ends] != 2} { return }
    lassign $ends p1 p2
    lassign $p1 x1 y1 z1
    lassign $p2 x2 y2 z2
    set dx [expr {$x2-$x1}]; set dy [expr {$y2-$y1}]; set dz [expr {$z2-$z1}]
    set len [expr {sqrt($dx*$dx+$dy*$dy+$dz*$dz)}]
    if {$len < 1e-6} { return }
    set cone [expr {$len*0.18 < 3.0 ? $len*0.18 : 3.0}]
    if {$cone < 1.0} { set cone 1.0 }
    set f [expr {($len-$cone)/$len}]
    set base [list [expr {$x1+$dx*$f}] [expr {$y1+$dy*$f}] [expr {$z1+$dz*$f}]]
    # Yellow, not white: white disappears against a pale cartoon or surface, and
    # every other pore-mode cue is taken - CPOINT magenta, point 1 cyan, point 2
    # orange, tunnel start lime.
    catch {graphics $molid color yellow}
    catch {graphics $molid cylinder $p1 $base radius 0.15 resolution 12 filled yes}
    catch {graphics $molid cone $base $p2 radius 0.4 resolution 12}
}

proc ::VMDPathFinder::_sync_cvect_handles {args} {
    # Grab handles for CVECT's two points, drawn while the stick's CVECT page
    # is open. The AXIS itself is not drawn here - the cue draws it, once,
    # from the same _cvect_axis_ends - so the two can never disagree or put a
    # second arrow on screen. These are just the ends made grabbable, and the
    # labels saying which end is which.
    variable w
    variable state
    variable vec_p1
    variable vec_p2
    variable point_marker_mols
    if {![_have_tk]} { return }
    if {![info exists point_marker_mols]} { set point_marker_mols [dict create] }
    set key cvect_pts
    set molid [expr {[dict exists $point_marker_mols $key] ? [dict get $point_marker_mols $key] : ""}]
    # The handles are the two POINTS, at their own positions - independent of
    # each other and of the axis. The axis is a separate object: the line
    # through CPOINT along their direction (see _cvect_axis_ends). Making the
    # handles the axis's ends is what forced them to move together.
    set ends {}
    if {[_cvect_page_open]} {
        set _m ""; catch {set _m [resolve_molid]}
        if {$_m ne ""} {
            set _f 0; catch {set _f [molinfo $_m get frame]}
            set _a {}; set _b {}
            catch {set _a [_resolve_point_input $vec_p1 $_m $_f]}
            catch {set _b [_resolve_point_input $vec_p2 $_m $_f]}
            if {[llength $_a] == 3 && [llength $_b] == 3} { set ends [list $_a $_b] }
        }
    }
    if {[llength $ends] != 2} {
        if {$molid ne "" && ![catch {molinfo $molid get name}]} { catch {mol delete $molid} }
        catch {dict unset point_marker_mols $key}
        return
    }
    lassign $ends p1 p2
    set ref ""; catch {set ref [resolve_molid]}
    if {$molid eq "" || [catch {molinfo $molid get name}]} {
        # Same two hazards _sync_point_marker documents: `mol new` steals top
        # (and state(molid) defaults to "top"), and a fresh molecule carries
        # IDENTITY view matrices, so anything drawn into it renders in another
        # coordinate frame and lands off-screen.
        set _prev_top [molinfo top]
        set _pv {}
        if {$ref ne ""} {
            catch {set _pv [molinfo $ref get \
                {center_matrix rotate_matrix scale_matrix global_matrix}]}
        }
        set molid [mol new]
        catch {mol rename $molid "VMDPathFinder: CVECT points"}
        if {$_pv ne ""} {
            catch {molinfo $molid set {center_matrix rotate_matrix scale_matrix global_matrix} $_pv}
            catch {molinfo $ref   set {center_matrix rotate_matrix scale_matrix global_matrix} $_pv}
        }
        catch {mol top $_prev_top}
        dict set point_marker_mols $key $molid
    } elseif {$ref ne ""} {
        catch {sync_surface_view $molid $ref}
    }
    catch {graphics $molid delete all}
    catch {graphics $molid materials on}
    catch {graphics $molid material Glossy}
    # Point 2 is the end the vector points AT, so it takes the warmer colour.
    catch {graphics $molid color cyan}
    catch {graphics $molid sphere $p1 radius 0.7 resolution 18}
    catch {graphics $molid text $p1 " 1" size 0.8 thickness 2}
    catch {graphics $molid color orange}
    catch {graphics $molid sphere $p2 radius 0.7 resolution 18}
    catch {graphics $molid text $p2 " 2" size 0.8 thickness 2}
}
proc ::VMDPathFinder::_normalize_dir {v} {
    # "x y z" -> unit direction, or {} if it is not three real numbers.
    set p [normalize_triplet_value $v]
    if {$p eq {}} { return {} }
    foreach c $p { if {![string is double -strict $c]} { return {} } }
    lassign $p vx vy vz
    set len [expr {sqrt($vx*$vx + $vy*$vy + $vz*$vz)}]
    if {$len < 1e-9} { return {} }
    return [list [expr {$vx/$len}] [expr {$vy/$len}] [expr {$vz/$len}]]
}

proc ::VMDPathFinder::_resolve_cvect_now {molid frame} {
    # The CVECT direction as it applies AT THIS FRAME, normalised, or {}.
    #
    # Prefers the two-point definition over the stored literal: when CVECT was
    # defined from two selections, those selections move with the trajectory,
    # so re-resolving them here is what makes the drawn arrow follow the
    # structure instead of freezing at whatever direction frame 0 had. This is
    # the same precedence run_analysis' own per-frame axis path uses (Exact >
    # Stabilize > Static), just without the fitting - the cue shows the axis,
    # it does not define it.
    variable state
    if {[info exists state(cvect_def_p1)] && [info exists state(cvect_def_p2)] && \
            [string trim $state(cvect_def_p1)] ne "" && \
            [string trim $state(cvect_def_p2)] ne ""} {
        if {![catch {
            set a [_resolve_point_input $state(cvect_def_p1) $molid $frame]
            set b [_resolve_point_input $state(cvect_def_p2) $molid $frame]
            set v [vector_from_points $a $b]
        }]} { return $v }
    }
    if {![info exists state(cvect)]} { return {} }
    set lit [normalize_triplet_value $state(cvect)]
    if {$lit eq {}} { return {} }
    foreach c $lit { if {![string is double -strict $c]} { return {} } }
    lassign $lit vx vy vz
    set len [expr {sqrt($vx*$vx + $vy*$vy + $vz*$vz)}]
    if {$len < 1e-9} { return {} }
    return [list [expr {$vx/$len}] [expr {$vy/$len}] [expr {$vz/$len}]]
}

proc ::VMDPathFinder::_axis_bbox_span {refmol frame origin u} {
    # {tmin tmax}: how far the analysis selection reaches along u either side of
    # origin, from the eight corners of one `measure minmax` rather than a
    # per-atom scan - this redraws on every keystroke while CPOINT is typed.
    # Falls back to a symmetric default when the span is degenerate (origin
    # outside the box, or a one-atom selection).
    variable state
    lassign $u ux uy uz
    lassign $origin ox oy oz
    set tmin -10.0; set tmax 10.0
    catch {
        set _seltext [string trim $state(selection)]
        if {$_seltext eq "" || $_seltext eq "all"} { set _seltext "protein" }
        set _s [atomselect $refmol $_seltext frame $frame]
        set _mm [measure minmax $_s]
        $_s delete
        lassign [lindex $_mm 0] x0 y0 z0
        lassign [lindex $_mm 1] x1 y1 z1
        set first 1
        foreach cx [list $x0 $x1] {
            foreach cy [list $y0 $y1] {
                foreach cz [list $z0 $z1] {
                    set t [expr {($cx-$ox)*$ux + ($cy-$oy)*$uy + ($cz-$oz)*$uz}]
                    if {$first} { set tmin $t; set tmax $t; set first 0 } \
                    elseif {$t < $tmin} { set tmin $t } elseif {$t > $tmax} { set tmax $t }
                }
            }
        }
    }
    if {$tmax - $tmin < 2.0} { set tmin -10.0; set tmax 10.0 }
    return [list $tmin $tmax]
}

proc ::VMDPathFinder::_within_dist_sel {hsel cx cy cz r} {
    # Build a VMD atom-selection distance predicate that works across all VMD versions.
    # "within X of {cx cy cz}" is NOT supported by all VMD builds; the math form is.
    set r2 [expr {double($r) * double($r)}]
    return "($hsel) and (x-$cx)*(x-$cx)+(y-$cy)*(y-$cy)+(z-$cz)*(z-$cz) <= $r2"
}

proc ::VMDPathFinder::_scoped_ca_indices {molid frame hsel cx cy cz ri ro} {
    # Return indices of Cα atoms in hsel within ri Å of (cx,cy,cz) at $frame.
    # Expands to ro Å with a warning when fewer than 3 found at ri.
    # Returns "" when still fewer than 3 (scoped fit disabled for this point).
    set idx ""
    catch {
        set si [atomselect $molid "[_within_dist_sel $hsel $cx $cy $cz $ri] and name CA" frame $frame]
        set ni [$si num]; catch {$si delete}
        if {$ni >= 3} {
            set si [atomselect $molid "[_within_dist_sel $hsel $cx $cy $cz $ri] and name CA" frame $frame]
            set idx [$si get index]; catch {$si delete}
        } else {
            set so [atomselect $molid "[_within_dist_sel $hsel $cx $cy $cz $ro] and name CA" frame $frame]
            set no [$so num]
            if {$no >= 3} {
                vmdcon -warn "VMDPathFinder: scoped fit expanded to $ro Å ($ni Cα at $ri Å, $no at $ro Å)"
                set idx [$so get index]
            } else {
                vmdcon -warn "VMDPathFinder: scoped fit: only $no Cα within $ro Å - stabilization disabled for this point"
            }
            catch {$so delete}
        }
    }
    return $idx
}

proc ::VMDPathFinder::_stab_fit_rmsd {ref_sel cur_sel M {refxyz ""} {scratch ""}} {
    # Residual RMSD of the scoped rigid-body fit: how far the CURRENT positions
    # of the local Cα group are from where the best-fit matrix M predicts they
    # should be (M applied to their REFERENCE positions). A small residual means
    # that local patch really did move as one rigid unit between frames (the
    # assumption Stabilize depends on); a large one means it deformed/dispersed,
    # so the fitted point is no longer a trustworthy stand-in.
    # The REFERENCE coordinates are pinned to ref_frame and cannot change
    # across the run, but were re-marshalled from VMD every frame. The caller
    # passes the cached list; "" keeps this proc usable standalone.
    if {$refxyz eq ""} { set refxyz [$ref_sel get {x y z}] }
    # FAST PATH, and the exact same quantity: put the pristine reference
    # coordinates into a scratch selection, apply M to it, and let VMD's own
    # `measure rmsd` do the per-atom work in C. MEASURED 465 -> 52 ms per 1000
    # frames on a 293-atom scope (8.9x), agreeing with the Tcl loop to 2.2e-7 A
    # - the same single-precision floor `coordtrans` already sits on, and 7
    # orders of magnitude below the 3.0 A threshold this feeds.
    #
    # Coordinates are RESET from $refxyz every frame rather than undone with an
    # inverse transform: the inverse-move variant was both slower (81 ms) and
    # accumulated drift to 3.8e-5 A over 1000 frames, since each round trip
    # leaves float error behind.
    if {$scratch ne ""} {
        set _r ""
        if {![catch {
            $scratch set {x y z} $refxyz
            $scratch move $M
            set _r [measure rmsd $scratch $cur_sel]
        }]} { return $_r }
        # Fall through to the Tcl loop if anything about the scratch went bad.
    }
    set curxyz [$cur_sel get {x y z}]
    set n [llength $refxyz]
    if {$n == 0 || $n != [llength $curxyz]} { return 0.0 }
    # M unpacked ONCE and applied with plain expr, instead of a `coordtrans`
    # command per atom. NOT bit-identical: measured against a per-atom loop over
    # 1000 frames the residual differs by up to 2.8e-7 Å, because coordtrans
    # does not carry full double precision internally. That is 8 orders of
    # magnitude below the 3.0 Å threshold this feeds, so no warning can flip -
    # but it is a real difference, not an exact rewrite.
    lassign [lindex $M 0] a11 a12 a13 a14
    lassign [lindex $M 1] a21 a22 a23 a24
    lassign [lindex $M 2] a31 a32 a33 a34
    set sumsq 0.0
    foreach rc $refxyz cc $curxyz {
        lassign $rc rx ry rz
        lassign $cc cx cy cz
        set dx [expr {$a11*$rx + $a12*$ry + $a13*$rz + $a14 - $cx}]
        set dy [expr {$a21*$rx + $a22*$ry + $a23*$rz + $a24 - $cy}]
        set dz [expr {$a31*$rx + $a32*$ry + $a33*$rz + $a34 - $cz}]
        set sumsq [expr {$sumsq + $dx*$dx + $dy*$dy + $dz*$dz}]
    }
    return [expr {sqrt($sumsq/$n)}]
}

proc ::VMDPathFinder::_stab_check_rmsd {label ref_sel cur_sel M frame {refxyz ""} {scratch ""}} {
    # Compares the scoped fit's residual (_stab_fit_rmsd) against the
    # stab_rmsd_warn threshold and warns if the fit has degraded too far.
    variable state
    set thresh [expr {[string is double -strict $state(stab_rmsd_warn)] ? $state(stab_rmsd_warn) : 3.0}]
    set r [_stab_fit_rmsd $ref_sel $cur_sel $M $refxyz $scratch]
    if {$r > $thresh} {
        vmdcon -warn "VMDPathFinder: $label Stabilize fit residual ${r} Å exceeds ${thresh} Å at frame $frame - the local scaffold may no longer be moving rigidly; the fitted point may be unreliable here."
    }
}

proc ::VMDPathFinder::_stab_cleanup {} {
    # Forget the scoped selections captured by a previous _stab_init call. These are
    # plain selection STRINGS, not atomselect handles (see the variable block for
    # why), so there is nothing to `delete` for those.
    foreach v {::VMDPathFinder::_stab_txt_cp ::VMDPathFinder::_stab_txt_p1 ::VMDPathFinder::_stab_txt_p2} {
        set $v ""
    }
    # The per-point fit selections ARE real handles now (_stab_sel_pair keeps
    # them alive across frames via `uplevel #0`), so they have to be released
    # here - this proc already runs on every run exit path, including the
    # error/abort ones.
    variable _stab_selcache
    if {[info exists _stab_selcache]} {
        dict for {_k _p} $_stab_selcache {
            catch {[lindex $_p 0] delete}
            catch {[lindex $_p 1] delete}
            # The scratch selection AND the molecule behind it - leaking the
            # latter would leave a stray entry in VMD's molecule list.
            if {[lindex $_p 3] ne ""} { catch {[lindex $_p 3] delete} }
            if {[lindex $_p 4] ne ""} { catch {mol delete [lindex $_p 4]} }
        }
    }
    set _stab_selcache [dict create]
    set ::VMDPathFinder::_stab_cp_ref_xyz {}
    set ::VMDPathFinder::_stab_p1_ref_xyz {}
    set ::VMDPathFinder::_stab_p2_ref_xyz {}
    set ::VMDPathFinder::_stab_ref_e1 {}
    set ::VMDPathFinder::_track_txt ""
    set ::VMDPathFinder::_track_offset {}
    set ::VMDPathFinder::_track_cp_xyz {}
}

proc ::VMDPathFinder::_stab_init {molid} {
    # One-time setup before the per-frame HOLE loop. Captures the "now" frame as the
    # reference, finds Cα atoms in a scope radius around each axis point, and stores
    # that atom set as SELECTION TEXT ("index i j k ...") for frame_axis to rebuild
    # from on each frame. It deliberately does NOT cache atomselect handles - VMD
    # destroys those when this proc returns, which silently disabled all three
    # per-frame axis modes (see the _stab_txt_* variable block for the full note).
    variable state
    variable _stab_ref_frame
    variable _stab_txt_cp; variable _stab_txt_p1; variable _stab_txt_p2
    variable _stab_cp_ref_xyz; variable _stab_p1_ref_xyz; variable _stab_p2_ref_xyz
    _stab_cleanup
    # What CPOINT/CVECT-def/molecule these refs are captured for - see
    # _ensure_axis_refs, which re-inits when any of the four drift.
    variable _axis_refs_cp; variable _axis_refs_molid
    variable _axis_refs_p1; variable _axis_refs_p2
    set _axis_refs_cp [expr {[info exists state(cpoint)] ? [string trim $state(cpoint)] : ""}]
    set _axis_refs_molid $molid
    set _axis_refs_p1 [string trim $state(cvect_def_p1)]
    set _axis_refs_p2 [string trim $state(cvect_def_p2)]
    set now [molinfo $molid get frame]
    set _stab_ref_frame $now
    set hsel [string trim $state(selection)]
    if {$hsel eq "" || $hsel eq "all"} { set hsel "protein" }
    set ri [expr {[string is double -strict $state(stab_radius_inner)] ? $state(stab_radius_inner) : 10.0}]
    set ro [expr {[string is double -strict $state(stab_radius_outer)] ? $state(stab_radius_outer) : 15.0}]
    # CPOINT scoped selection (when explicit Stabilize is on)
    if {$state(stabilize_cpoint) && [string trim $state(cpoint)] ne ""} {
        if {![catch {_resolve_point_input $state(cpoint) $molid $now} _cp]} {
            set _stab_cp_ref_xyz $_cp
            lassign $_cp cpx cpy cpz
            set idx [_scoped_ca_indices $molid $now $hsel $cpx $cpy $cpz $ri $ro]
            if {$idx ne ""} { set _stab_txt_cp "index [join $idx { }]" }
        }
    }
    # Track: follow a FIXED patch of nearby atoms by its centroid DISPLACEMENT, not by
    # re-selecting atoms near the running estimate each frame - the re-select approach
    # drifted ~8 Å off the pore within 10-20 frames (verified): re-searching from an
    # already-shifted estimate compounds the wall-density bias into a runaway walk. Here
    # the atom SET is frozen at the reference frame; only its displacement is applied:
    #   cp(f) = cp0 + (centroid(f) - centroid0)
    # which cancels the wall-bias in centroid0, so the tracked point starts exactly at
    # the user's CPOINT and stays drift-free. Translation-only cousin of Stabilize
    # (which also fits rotation) - Track ignores local rotation.
    variable _track_cp_xyz
    variable _track_txt
    variable _track_offset
    if {[info exists state(track_cpoint)] && $state(track_cpoint) && \
            [string trim $state(cpoint)] ne ""} {
        if {![catch {_resolve_point_input $state(cpoint) $molid $now} _cp0]} {
            set _track_cp_xyz $_cp0
            lassign $_cp0 _c0x _c0y _c0z
            set _trk [expr {[string is double -strict $state(track_radius)] ? $state(track_radius) : 8.0}]
            # Freeze the patch once. Expand the radius if fewer than 3 atoms are
            # caught (same escalation idea as _scoped_ca_indices) so a sparse start
            # still yields a stable patch to follow.
            foreach _rad [list $_trk [expr {$_trk*1.5}] [expr {$_trk*2.5}]] {
                set _si ""
                if {[catch {
                    set _si [atomselect $molid [_within_dist_sel $hsel $_c0x $_c0y $_c0z $_rad] frame $now]
                    set _n [$_si num]
                }]} { catch {$_si delete}; continue }
                if {$_n >= 3} {
                    set _idxq "index [$_si get index]"
                    lassign [measure center $_si] _e0x _e0y _e0z
                    catch {$_si delete}
                    set _track_txt $_idxq
                    set _track_offset [list [expr {$_c0x-$_e0x}] \
                                            [expr {$_c0y-$_e0y}] [expr {$_c0z-$_e0z}]]
                    break
                }
                catch {$_si delete}
            }
        }
    }
    # CVECT p1 and p2: independent scoped handles (when explicit Stabilize is on).
    # Skip when the user supplied an EXACT vector - there is nothing to re-fit then.
    # ⚠️ Parenthesisation is load-bearing: must be
    #     !([info exists state(cvect_exact)] && $state(cvect_exact))
    if {$state(stabilize_cvect) && \
            !([info exists state(cvect_exact)] && $state(cvect_exact))} {
        if {[string trim $state(cvect_def_p1)] ne ""} {
            if {![catch {_resolve_point_input $state(cvect_def_p1) $molid $now} _p1]} {
                set _stab_p1_ref_xyz $_p1
                lassign $_p1 p1x p1y p1z
                set idx1 [_scoped_ca_indices $molid $now $hsel $p1x $p1y $p1z $ri $ro]
                if {$idx1 ne ""} { set _stab_txt_p1 "index [join $idx1 { }]" }
            }
        }
        if {[string trim $state(cvect_def_p2)] ne ""} {
            if {![catch {_resolve_point_input $state(cvect_def_p2) $molid $now} _p2]} {
                set _stab_p2_ref_xyz $_p2
                lassign $_p2 p2x p2y p2z
                set idx2 [_scoped_ca_indices $molid $now $hsel $p2x $p2y $p2z $ri $ro]
                if {$idx2 ne ""} { set _stab_txt_p2 "index [join $idx2 { }]" }
            }
        }
        # Reference azimuth zero-point for the roll-checked co-rotating basis
        # (see _stab_roll_checked_e1): only meaningful once BOTH scoped fits
        # are live, since either one alone cannot check the other's roll.
        variable _stab_ref_e1
        set _stab_ref_e1 {}
        if {$_stab_txt_p1 ne "" && $_stab_txt_p2 ne ""} {
            if {![catch {lassign [split $state(cvect)] _rvx _rvy _rvz}]} {
                set _rlen [expr {sqrt($_rvx*$_rvx + $_rvy*$_rvy + $_rvz*$_rvz)}]
                if {$_rlen > 1e-9} {
                    set _stab_ref_e1 [lrange [_conn_axis_basis \
                        [expr {$_rvx/$_rlen}] [expr {$_rvy/$_rlen}] [expr {$_rvz/$_rlen}]] 0 2]
                }
            }
        }
    }
}

proc ::VMDPathFinder::_stab_gap_report {} {
    # Which per-frame axis modes were REQUESTED but could not be set up?
    #
    # _stab_init establishes a scoped selection per mode; if it cannot (the
    # defining point is blank, or resolves to a selection matching no atoms) the
    # mode silently falls back to the static axis. The checkbox stays ticked, the
    # axis never moves, and the user is given no reason to suspect the feature did
    # nothing - which is indistinguishable from it being broken. Returns a
    # human-readable list of gaps, or "" when everything requested is live.
    variable state
    variable _stab_txt_cp; variable _stab_txt_p1; variable _stab_txt_p2
    variable _track_txt
    set gaps {}
    if {[info exists state(track_cpoint)] && $state(track_cpoint) && \
            (![info exists _track_txt] || $_track_txt eq "")} {
        lappend gaps "CPOINT Track: no atoms within the track radius of CPOINT"
    }
    if {$state(stabilize_cpoint) && (![info exists _stab_txt_cp] || $_stab_txt_cp eq "")} {
        lappend gaps "CPOINT Stabilize: no Cα atoms in the scope radius around CPOINT"
    }
    # CVECT Exact deliberately disables the p1/p2 re-fit - a literal vector has
    # nothing to fit - so that combination is not a gap.
    if {$state(stabilize_cvect) && \
            !([info exists state(cvect_exact)] && $state(cvect_exact))} {
        foreach {v lbl def} [list _stab_txt_p1 p1 cvect_def_p1 _stab_txt_p2 p2 cvect_def_p2] {
            if {![info exists $v] || [set $v] eq ""} {
                set d ""
                catch {set d [string trim $state($def)]}
                if {$d eq ""} {
                    lappend gaps "CVECT Stabilize: $lbl has no defining point set"
                } else {
                    lappend gaps "CVECT Stabilize: $lbl selection '$d' matched no atoms"
                }
            }
        }
    }
    return $gaps
}

proc ::VMDPathFinder::_stab_sel_pair {molid seltext ref_frame} {
    # The {ref cur} atomselect pair for one scoped point, created ONCE and
    # reused across frames. Returns {} if the pair cannot be made.
    #
    # `uplevel #0`: VMD destroys an atomselect when the proc that created it
    # returns, which is why this used to be rebuilt per frame (see the
    # _stab_txt_* variable block). Creating it in the GLOBAL frame instead
    # makes the handle outlive this call, so it can be cached - verified
    # directly, including reuse from a different proc on a later frame.
    variable _stab_selcache
    if {![info exists _stab_selcache]} { set _stab_selcache [dict create] }
    set key "$molid|$ref_frame|$seltext"
    if {[dict exists $_stab_selcache $key]} {
        set p [dict get $_stab_selcache $key]
        # Still alive? A closed molecule or an outside `delete` invalidates the
        # handle, and a dead one must not be handed out.
        if {![catch {[lindex $p 0] num}] && ![catch {[lindex $p 1] num}]} { return $p }
        dict unset _stab_selcache $key
    }
    set ref ""; set cur ""
    if {[catch {
        set ref [uplevel #0 [list atomselect $molid $seltext frame $ref_frame]]
        set cur [uplevel #0 [list atomselect $molid $seltext]]
    }]} {
        catch {$ref delete}; catch {$cur delete}
        return {}
    }
    # Cache the REFERENCE coordinates with the handles: they are pinned to
    # ref_frame, so re-fetching them per frame was pure marshalling.
    set refxyz [$ref get {x y z}]
    # A selection matching NOTHING must not become a fit: `measure fit` on two
    # empty selections returns a matrix without erroring, so the caller would
    # have carried the axis point through a meaningless transform instead of
    # falling back to the static value.
    if {[llength $refxyz] == 0} {
        catch {$ref delete}; catch {$cur delete}
        return {}
    }
    # A scratch molecule holding a MUTABLE copy of those reference atoms, so
    # the residual check can run entirely in C (see _stab_fit_rmsd). Optional:
    # if this VMD cannot make one, the pure-Tcl path still runs.
    set scratch ""; set smol ""
    if {[catch {
        # `mol new` steals "top", which
        # any [molinfo top] elsewhere would then read as this scratch. Put it
        # back, and keep the molecule hidden and named so it is recognisable
        # if it ever outlives a run.
        set _savedtop ""
        catch {set _savedtop [molinfo top]}
        # `animate dup` RESETS THE CAMERA: it re-fits the view to the molecule
        # set, rescaling every molecule. Measured on 1BL8 - the structure goes
        # from scale 0.02413 to 0.50000, a 20.7x zoom, and neither `mol off`
        # nor restoring `top` undoes it, nor does deleting the scratch. With
        # Stabilize on this runs per frame, which is the "after the run it
        # zooms inside the channel" report. Save every viewpoint and put it
        # back, the same way ensure_surface_mol does around its own `mol new`.
        set _vps [dict create]
        foreach _m [molinfo list] {
            catch {dict set _vps $_m [molinfo $_m get \
                {center_matrix rotate_matrix scale_matrix global_matrix}]}
        }
        set smol [mol new atoms [llength $refxyz]]
        animate dup $smol
        catch {mol rename $smol "vmdpathfinder_stab_scratch"}
        catch {mol off $smol}
        if {$_savedtop ne ""} { catch {mol top $_savedtop} }
        dict for {_m _v} $_vps {
            if {[catch {molinfo $_m get name}]} continue
            catch {molinfo $_m set \
                {center_matrix rotate_matrix scale_matrix global_matrix} $_v}
        }
        set scratch [uplevel #0 [list atomselect $smol all]]
        $scratch set {x y z} $refxyz
    }]} {
        catch {$scratch delete}
        catch {mol delete $smol}
        set scratch ""; set smol ""
    }
    set p [list $ref $cur $refxyz $scratch $smol]
    dict set _stab_selcache $key $p
    return $p
}

proc ::VMDPathFinder::_stab_fit_point {molid seltext ref_frame frame ref_xyz label {mvar ""}} {
    # Rigid-body-fit the scoped atom set from its reference frame onto $frame, and
    # carry $ref_xyz through that transform. Returns the moved point, or {} on any
    # failure (caller then keeps the static value). When $mvar is given, the fit
    # matrix itself is also stashed there (upvar) - CVECT Stabilize's roll check
    # needs the ROTATION, not just where it sends one point; this avoids a
    # second `measure fit` call to get it.
    #
    # MEASURED breakdown per frame (293-atom scope, 1000 frames):
    #   frame retarget + measure fit + coordtrans   14 ms   <- the actual work
    #   _stab_check_rmsd                           491 ms   <- 97 % of the cost
    # The warning check dominates entirely, because it marshals every scoped
    # atom into a Tcl list and loops over it. Caching the selection pair and
    # the reference coordinates took the whole proc 0.587 -> 0.489 ms/frame
    # (17 %); the remaining cost is that per-atom Tcl loop, and removing it
    # means changing what the check measures, which is a behaviour decision.
    # _stab_cleanup releases the handles on every run exit path.
    if {$mvar ne ""} { upvar 1 $mvar _outM; set _outM "" }
    if {$seltext eq "" || $ref_xyz eq {}} { return {} }
    set p [_stab_sel_pair $molid $seltext $ref_frame]
    if {$p eq {}} { return {} }
    lassign $p ref cur refxyz scratch
    set out {}
    if {[catch {
        $cur frame $frame
        set M [measure fit $ref $cur]
        if {$mvar ne ""} { set _outM $M }
        set out [coordtrans $M $ref_xyz]
        _stab_check_rmsd $label $ref $cur $M $frame $refxyz $scratch
    } _err]} { set out {} }
    return $out
}

proc ::VMDPathFinder::_run_axis_manifest {which} {
    # The value a reader of this run should treat as its axis: the user's own
    # field when set, otherwise whatever _run_axis_init pinned for the run.
    variable state
    variable _run_axis_cp; variable _run_axis_cv
    set lit [string trim $state($which)]
    if {[normalize_triplet_value $lit] ne {}} { return $lit }
    # A SELECTION (e.g. "resid 45 and name CA"), not a literal triplet.
    # normalize_triplet_value rightly refuses it - it is not three numbers -
    # but that meant this proc treated a selection-form CPOINT as blank and
    # fell through to the AUTO-GUESSED value, so a run's manifest and
    # parameter file recorded no trace of the selection actually used, only
    # for a CPOINT typed as x y z. Resolve it to its centre of geometry
    # instead, and keep the selection text so the run can be repeated.
    if {$lit ne "" && $which eq "cpoint"} {
        set _molid ""; catch {set _molid [resolve_molid_or -1]}
        set _frame 0
        catch {
            variable result_frames
            if {[llength $result_frames]} { set _frame [lindex $result_frames 0] }
        }
        if {$_molid ne "" && $_molid >= 0} {
            set _pt [_point_now $lit $_molid $_frame]
            if {[llength $_pt] == 3} {
                return "$lit = [format_triplet $_pt]"
            }
        }
        return $lit
    }
    set g [expr {$which eq "cpoint" \
        ? [expr {[info exists _run_axis_cp] ? $_run_axis_cp : ""}] \
        : [expr {[info exists _run_axis_cv] ? $_run_axis_cv : ""}]}]
    if {$g eq ""} { return "" }
    return "$g (guessed)"
}

proc ::VMDPathFinder::_run_axis_reset {} {
    variable _run_axis_cp; variable _run_axis_cv
    set _run_axis_cp {}; set _run_axis_cv {}
}

proc ::VMDPathFinder::_run_axis_init {molid frame seltext} {
    # HOLE guesses a blank CPOINT/CVECT ONCE PER RUN (hole.f:623 -> cguess.f).
    # Letting each frame guess for itself is NOT equivalent: the CVECT half of
    # CGUESS picks the best of the three CARDINAL axes by summed pore radius, and
    # that argmax changes between frames. Measured on the Nav trajectory with a
    # fixed CPOINT, 10 frames sampled across 100: Z Y Y Y Y X X Y Y Y, with the
    # winner beating the runner-up by as little as 1.7%. Profiles taken along
    # different axes are not comparable, so every Trends / Mean Profile /
    # Over Time series built from such a run mixes two or three channels.
    #
    # Resolved here on the FIRST analysed frame and pinned for the whole run, so
    # a blank-axis run behaves like one where the user typed the same values.
    # Also gives the 3D features and the manifest a real axis to register
    # against - with a blank CVECT they had none at all.
    variable state
    variable _run_axis_cp; variable _run_axis_cv
    _run_axis_reset
    # A CPOINT given as an atom selection is SET, not blank - resolve it here
    # rather than letting CGUESS overwrite it.
    set _need_cp [expr {[_point_now $state(cpoint) $molid $frame] eq {}}]
    set _need_cv [expr {[normalize_triplet_value $state(cvect)]  eq {}}]
    if {!$_need_cp && !$_need_cv} { return }
    set _tmp [file join [get_temp_base] "vmdpathfinder_cguess_[pid].pdb"]
    if {[catch {
        set _s [atomselect $molid $seltext frame $frame]
        $_s writepdb $_tmp
        $_s delete
        lassign [hole::read_pdb $_tmp $state(radius_file)] _n _xs _ys _zs _rs _ans
        if {$_n == 0} { error "no atoms" }
        set _cp [_point_now $state(cpoint) $molid $frame]
        if {$_need_cp} { set _cp [hole::cguess_cpoint $_n $_xs $_ys $_zs $_rs $_ans] }
        if {$_need_cv} {
            set _cv [hole::cguess_cvect [lindex $_cp 0] [lindex $_cp 1] [lindex $_cp 2] \
                        $_n $_xs $_ys $_zs $_rs]
        } else {
            set _cv [normalize_triplet_value $state(cvect)]
        }
        if {$_need_cp} { set _run_axis_cp [format "%.4f %.4f %.4f" {*}$_cp] }
        if {$_need_cv} { set _run_axis_cv [format "%.4f %.4f %.4f" {*}$_cv] }
    } _e]} {
        catch {file delete -force $_tmp}
        # Not fatal: leaving these blank restores the previous behaviour, where
        # HOLE guesses per frame. Say so rather than failing the run.
        vmdcon -warn "VMDPathFinder: could not pre-resolve the blank channel axis ($_e).\
            HOLE will guess it per frame, which can profile different frames along\
            different axes."
        return
    }
    catch {file delete -force $_tmp}
    set _what {}
    if {$_need_cp} { lappend _what "CPOINT $_run_axis_cp" }
    if {$_need_cv} { lappend _what "CVECT $_run_axis_cv" }
    vmdcon -info "VMDPathFinder: channel axis was blank - guessed once from frame $frame\
        ([join $_what {, }]) and pinned for every frame of this run.\
        HOLE's own guess only ever returns an x, y or z axis; set CPOINT/CVECT\
        yourself if that is not your channel."
}

proc ::VMDPathFinder::frame_axis {molid frame} {
    # Per-frame {cpoint cvect M1 M2} - cpoint/cvect as "x y z" strings, M1/M2 the
    # p1/p2 fit matrices from a live CVECT Stabilize (else ""). Per-component,
    # mutually exclusive:
    #   CPOINT: Track (local centroid) > Stabilize (scoped rigid-body) > Static
    #   CVECT:  Exact (literal per-frame eval) > Stabilize (independent p1+p2 fits) > Static
    # When nothing is selected the point is static (a literal x,y,z, or frozen at setup).
    # M1/M2 exist ONLY for the Stabilize-CVECT branch - Exact has no rigid-body fit to
    # give one, so its direction can drift with nothing this proc's caller can use to
    # roll-check a co-rotating azimuth basis from (see _stab_roll_checked_e1).
    variable state
    variable _stab_ref_frame
    variable _stab_txt_cp; variable _stab_cp_ref_xyz
    variable _stab_txt_p1; variable _stab_p1_ref_xyz
    variable _stab_txt_p2; variable _stab_p2_ref_xyz
    variable _track_cp_xyz
    variable _track_txt
    variable _track_offset
    set cp $state(cpoint)
    set cv $state(cvect)
    # A blank field falls back to the axis resolved ONCE for this run by
    # _run_axis_init, so every frame is profiled along the SAME axis and the
    # value reaches write_control_file, the manifest and _frame_axis_persisted.
    variable _run_axis_cp; variable _run_axis_cv
    if {[normalize_triplet_value $cp] eq {} && [info exists _run_axis_cp] && $_run_axis_cp ne {}} {
        set cp $_run_axis_cp
    }
    if {[normalize_triplet_value $cv] eq {} && [info exists _run_axis_cv] && $_run_axis_cv ne {}} {
        set cv $_run_axis_cv
    }

    # ---- CPOINT ----  Track > Stabilize > Static (mutually exclusive in the UI)
    set do_track_cp [expr {[info exists state(track_cpoint)] && $state(track_cpoint)}]
    set do_stab_cp  [expr {[info exists state(stabilize_cpoint)] && $state(stabilize_cpoint)}]

    if {$do_track_cp && $_track_txt ne "" && $_track_offset ne {}} {
        # Track (drift-free): follow the FIXED patch of atoms captured at init by its
        # centroid DISPLACEMENT, not by re-selecting atoms near the running estimate.
        #   cp(f) = offset + centroid(f),   offset = cp0 - centroid0   (from _stab_init)
        # Applying the displacement cancels the wall-bias in centroid0, so cp starts
        # exactly at the user's CPOINT and stays on the pore instead of walking into
        # the wall (re-selecting atoms near the running estimate each frame instead
        # drifts ~8 Å within 10-20 frames).
        set _tsel ""
        if {![catch {
            set _tsel [atomselect $molid $_track_txt frame $frame]
            lassign [measure center $_tsel] _mx _my _mz
            lassign $_track_offset _ox _oy _oz
            set _track_cp_xyz [list [expr {$_ox+$_mx}] [expr {$_oy+$_my}] [expr {$_oz+$_mz}]]
            set cp [format "%.4f %.4f %.4f" {*}$_track_cp_xyz]
        }]} {}
        catch {$_tsel delete}
    } elseif {$do_stab_cp && $_stab_txt_cp ne "" && $_stab_cp_ref_xyz ne {}} {
        # Stabilize: scoped rigid-body fit of nearby Cα carries CPOINT across frames.
        set _cpn [_stab_fit_point $molid $_stab_txt_cp $_stab_ref_frame $frame \
                                  $_stab_cp_ref_xyz "CPOINT"]
        if {$_cpn ne {}} { set cp [format "%.4f %.4f %.4f" {*}$_cpn] }
    }

    # ---- CVECT ----  Exact > Stabilize > Static (set in the Vector… dialog)
    set do_exact_cv [expr {[info exists state(cvect_exact)] && $state(cvect_exact)}]
    set do_stab_cv  [expr {!$do_exact_cv && \
                            [info exists state(stabilize_cvect)] && $state(stabilize_cvect)}]

    if {$do_exact_cv && [string trim $state(cvect_def_p1)] ne "" && \
                          [string trim $state(cvect_def_p2)] ne ""} {
        # Exact: re-evaluate p1/p2 selections literally at this frame - no fitting.
        if {![catch {
            set a [_resolve_point_input $state(cvect_def_p1) $molid $frame]
            set b [_resolve_point_input $state(cvect_def_p2) $molid $frame]
            set v [vector_from_points $a $b]
        }]} { set cv [format "%.4f %.4f %.4f" {*}$v] }
    } elseif {$do_stab_cv} {
        # Independent scoped fit per point: p1 and p2 each get their own local context.
        # CVECT can span both sides of the channel - piggybacking CPOINT's matrix is wrong.
        set p1_new $_stab_p1_ref_xyz
        set p2_new $_stab_p2_ref_xyz
        set _f1 [_stab_fit_point $molid $_stab_txt_p1 $_stab_ref_frame $frame \
                                 $_stab_p1_ref_xyz "CVECT p1" _M1]
        if {$_f1 ne {}} { set p1_new $_f1 }
        set _f2 [_stab_fit_point $molid $_stab_txt_p2 $_stab_ref_frame $frame \
                                 $_stab_p2_ref_xyz "CVECT p2" _M2]
        if {$_f2 ne {}} { set p2_new $_f2 }
        if {$p1_new ne {} && $p2_new ne {}} {
            if {![catch {set v [vector_from_points $p1_new $p2_new]}]} {
                set cv [format "%.4f %.4f %.4f" {*}$v]
            }
        }
    }
    if {![info exists _M1]} { set _M1 "" }
    if {![info exists _M2]} { set _M2 "" }
    # CPOINT may be an atom selection rather than three numbers. Resolve it to
    # its centre of geometry AT THIS FRAME, so it follows the structure. Without
    # this the selection reached write_control_file unresolved, the cpoint card
    # was dropped, and HOLE guessed the point instead - silently.
    if {[normalize_triplet_value $cp] eq {}} {
        set _cpsel [_point_now $cp $molid $frame]
        if {$_cpsel ne {}} { set cp [format "%.4f %.4f %.4f" {*}$_cpsel] }
    }
    return [list $cp $cv $_M1 $_M2]
}

proc ::VMDPathFinder::_stab_rotate_dir {M v} {
    # The pure-rotation effect of homogeneous transform M on direction v:
    # transform (origin+v) and origin separately and subtract, which cancels
    # M's translation and leaves only what the rotation did to the direction.
    lassign $v vx vy vz
    lassign [coordtrans $M [list $vx $vy $vz]] x1 y1 z1
    lassign [coordtrans $M {0.0 0.0 0.0}] x0 y0 z0
    return [list [expr {$x1-$x0}] [expr {$y1-$y0}] [expr {$z1-$z0}]]
}

proc ::VMDPathFinder::_stab_project_perp_unit {v axis} {
    # v with its component along unit `axis` removed, renormalized to a unit
    # vector. axis must already be unit length.
    lassign $axis ax ay az
    lassign $v vx vy vz
    set d [expr {$vx*$ax + $vy*$ay + $vz*$az}]
    set px [expr {$vx - $d*$ax}]; set py [expr {$vy - $d*$ay}]; set pz [expr {$vz - $d*$az}]
    set n [expr {sqrt($px*$px + $py*$py + $pz*$pz)}]
    if {$n < 1e-9} { return {} }
    return [list [expr {$px/$n}] [expr {$py/$n}] [expr {$pz/$n}]]
}

proc ::VMDPathFinder::_stab_angle_deg {a b} {
    lassign $a ax ay az; lassign $b bx by bz
    set d [expr {$ax*$bx + $ay*$by + $az*$bz}]
    if {$d > 1.0} { set d 1.0 }; if {$d < -1.0} { set d -1.0 }
    return [expr {acos($d) * 180.0 / 3.14159265358979323846}]
}

proc ::VMDPathFinder::_stab_roll_checked_e1 {M1 M2 ref_e1 axis_unit} {
    # A co-rotating azimuth zero-point for ONE frame of a genuine Stabilize-CVECT
    # run: the reference frame's e1 (_stab_ref_e1), carried to this frame by the
    # SAME rigid-body rotation that moved p1's and p2's scoped Cα groups (M1/M2 -
    # already computed by frame_axis's CVECT-stabilize branch, reused here rather
    # than re-fit). p1 and p2 are independent local patches; if the pore genuinely
    # twists between them, their two candidate e1's disagree - that disagreement
    # (roll) is what a single global azimuth basis would silently paper over, so
    # it is checked here and the frame refused (not degraded) when it is large.
    #
    # Threshold: half of _conn_lobe_tol's azimuth bucket width (tola, default 35
    # deg -> 17.5 deg here). Measured on a real 100-frame trajectory with a
    # well-conditioned scope (~40-100 atoms/end): 9.55 deg worst case, 3.1 deg
    # median - comfortably inside. The SAME measurement with the default 10/15 A
    # scope radius (6-8 atoms/end) gave a 93 deg median, i.e. noise, not signal -
    # this gate is what keeps that case from ever reaching a lobe.
    #
    # Returns {ex ey ez} (unit, already reprojected perpendicular to axis_unit)
    # or "" - refused, caller must exclude this frame from lobe classification
    # rather than fall back to a basis that does not track the real rotation.
    if {$M1 eq "" || $M2 eq "" || $ref_e1 eq ""} { return "" }
    set e1a [_stab_project_perp_unit [_stab_rotate_dir $M1 $ref_e1] $axis_unit]
    set e1b [_stab_project_perp_unit [_stab_rotate_dir $M2 $ref_e1] $axis_unit]
    if {$e1a eq "" || $e1b eq ""} { return "" }
    set roll [_stab_angle_deg $e1a $e1b]
    lassign [_conn_lobe_tol] _tolz _tola
    if {$roll > $_tola * 0.5} { return "" }
    lassign $e1a ax ay az; lassign $e1b bx by bz
    return [_stab_project_perp_unit \
        [list [expr {$ax+$bx}] [expr {$ay+$by}] [expr {$az+$bz}]] $axis_unit]
}

proc ::VMDPathFinder::align_trajectory {{molid ""}} {
    # Permanently superpose every frame of $molid onto a reference frame by
    # RMSD-fitting an atom selection, then moving ALL atoms by that transform - the
    # standard VMD measure-fit/move alignment used by the RMSD Trajectory Tool
    # (L. Gracia, Weinstein Lab) and vmd_rmsdttnc (T. Giorgino). MODIFIES the loaded
    # trajectory coordinates. Returns the number of frames aligned.
    variable state
    if {$molid eq ""} { set molid [resolve_molid] }
    set seltext [string trim $state(align_sel)]
    if {$seltext eq ""} { error "Alignment selection is empty." }
    set nf [molinfo $molid get numframes]
    set rf $state(align_ref_frame)
    if {![string is integer -strict $rf] || $rf < 0 || $rf >= $nf} {
        error "Reference frame '$rf' is out of range (0..[expr {$nf - 1}])."
    }
    set ref [atomselect $molid $seltext frame $rf]
    if {[$ref num] == 0} { $ref delete; error "Alignment selection '$seltext' matched 0 atoms." }
    set sel [atomselect $molid $seltext]
    set all [atomselect $molid all]
    vmdcon -info "VMDPathFinder: aligning trajectory - $nf frame(s) onto ref $rf  sel=\"$seltext\""
    # Progress + abort. The per-frame cost is small (measured 0.05 ms/frame on a
    # 4.6k-atom system), but `$all move` rewrites EVERY atom of every frame, so
    # on a big solvated system x 10k frames it is minutes of frozen UI with no
    # feedback and no way out - which is what "the alignment took too long"
    # actually is. Throttled to ~10 Hz so the update itself is not the cost.
    set _last_ui [clock milliseconds]
    set _aborted 0
    for {set f 0} {$f < $nf} {incr f} {
        set _now [clock milliseconds]
        if {$_now - $_last_ui >= 100} {
            set state(status) "Aligning trajectory: $f / $nf frame(s)…"
            update
            set _last_ui $_now
            if {[_abort_requested]} { set _aborted 1; break }
        }
        $sel frame $f
        $all frame $f
        # measure fit can fail (degenerate/mismatched selection, deleted molecule
        # mid-loop). Swallowing it with an empty catch left SOME frames moved and
        # others not, then reported "complete" - a silently inconsistent coordinate
        # set. Abort with the failing frame instead; clean up the selections first.
        if {[catch {set _M [measure fit $sel $ref]} _err]} {
            $ref delete; $sel delete; $all delete
            error "Alignment failed at frame $f: $_err"
        }
        $all move $_M
    }
    $ref delete; $sel delete; $all delete
    if {$_aborted} {
        # Say so plainly: the frames BEFORE the break are moved and the rest are
        # not, so the trajectory is now half-aligned. Silently reporting "$nf
        # frames" would hide a genuinely inconsistent coordinate set.
        vmdcon -warn "VMDPathFinder: alignment ABORTED at frame $f of $nf - frames 0..[expr {$f-1}] are\
            superposed and the rest are NOT. Re-run Align to finish, or reload the trajectory."
        error "Alignment aborted at frame $f of $nf; the trajectory is now partly aligned."
    }
    vmdcon -info "VMDPathFinder: alignment complete - $nf frame(s) superposed."
    _align_mark_done $molid $seltext $rf $nf
    return $nf
}

proc ::VMDPathFinder::_align_signature {molid seltext ref_frame nframes} {
    # What an alignment is a function of. Atom COUNT is in it because a
    # reloaded/replaced molecule can reuse a molid.
    set na "?"
    catch {set na [molinfo $molid get numatoms]}
    return "$molid|$seltext|$ref_frame|$nframes|$na"
}

proc ::VMDPathFinder::_align_mark_done {molid seltext ref_frame nframes} {
    variable _align_done
    if {![info exists _align_done]} { set _align_done [dict create] }
    dict set _align_done [_align_signature $molid $seltext $ref_frame $nframes] 1
}

proc ::VMDPathFinder::_align_already_done {molid seltext ref_frame nframes} {
    # Superposition is IDEMPOTENT, so re-running it is not wrong - just wasted.
    # The tunnel run aligns automatically on EVERY run, so a second search over
    # the same trajectory paid the whole cost again for no change. Only counts
    # alignments THIS session did: coordinates loaded from disk are unknown to
    # us, and `Align traj` clears nothing, so a user forcing a re-align by hand
    # still gets one.
    variable _align_done
    if {![info exists _align_done]} { return 0 }
    return [dict exists $_align_done [_align_signature $molid $seltext $ref_frame $nframes]]
}

proc ::VMDPathFinder::do_align_trajectory {} {
    # In-place superposition of the trajectory - the standard, expected behaviour of
    # VMD's RMSD Trajectory Tool, so no confirmation prompt (only errors are shown).
    variable state
    variable busy
    # Minutes of coordinate rewriting that pumps the full event loop: without
    # the guard and the busy/_begin_calc bracket, Run passed its own guard
    # mid-align and analysed a half-aligned trajectory, and align's abort
    # poll was unreachable because no Abort button was ever shown. The
    # bracket is held HERE, not in align_trajectory, which run_tunnel_analysis
    # calls while already holding busy itself.
    if {[_op_in_progress]} {
        set state(status) "Another operation is already in progress."
        return
    }
    set busy 1
    _begin_calc
    set _rc [catch {align_trajectory} res]
    set busy 0
    _end_calc
    if {$_rc} {
        tk_messageBox -icon error -type ok -title "Align trajectory" -message $res
        return
    }
    set state(status) "Aligned $res frame(s) onto reference frame $state(align_ref_frame) using '$state(align_sel)'."
}

proc ::VMDPathFinder::show_align_dialog {} {
    # Clean dialog: just the inputs. What it does (RMSD measure-fit/move superposition
    # onto a reference frame, the same as VMD's RMSD Trajectory Tool / vmd_rmsdttnc)
    # is documented in Help and the README, and implemented in align_trajectory.
    variable w
    set d "$w.aligndlg"
    if {[winfo exists $d]} { wm deiconify $d; raise $d; return }
    toplevel $d
    wm withdraw $d
    wm title $d "Align trajectory"
    wm resizable $d 0 0
    label $d.rf_l -text "Reference frame"
    entry $d.rf_e -textvariable ::VMDPathFinder::state(align_ref_frame) -width 8
    grid $d.rf_l -row 0 -column 0 -sticky w  -padx 10 -pady {12 4}
    grid $d.rf_e -row 0 -column 1 -sticky w  -padx 10 -pady {12 4}
    label $d.as_l -text "Alignment selection"
    entry $d.as_e -textvariable ::VMDPathFinder::state(align_sel) -width 34
    grid $d.as_l -row 1 -column 0 -sticky w  -padx 10 -pady 4
    grid $d.as_e -row 1 -column 1 -sticky ew -padx 10 -pady 4
    button $d.go -text "Align" -command ::VMDPathFinder::do_align_trajectory
    button $d.close -text "Close" -command [list destroy $d]
    grid $d.go    -row 2 -column 0 -sticky w -padx 10 -pady {8 12}
    grid $d.close -row 2 -column 1 -sticky e -padx 10 -pady {8 12}
    grid columnconfigure $d 1 -weight 1
    _center_toplevel $d
}

proc ::VMDPathFinder::vector_labeled_atoms {} {
    # Atoms the user has labeled in VMD (Mouse > Label > Atoms). Returns a list
    # of {display_text molid atomid}. 'label list Atoms' yields one {molid
    # atomid} pair per atom label.
    set out {}
    if {[catch {label list Atoms} labels]} { return {} }
    foreach lab $labels {
        # An Atoms label is a {molid atomid} pair, but VMD versions differ on
        # brace nesting ({0 5} vs {{0 5}}); flatten braces and take the first
        # two integers.
        set flat [string map {\{ { } \} { }} $lab]
        if {[llength $flat] < 2} { continue }
        set molid  [lindex $flat 0]
        set atomid [lindex $flat 1]
        if {![string is integer -strict $molid] || ![string is integer -strict $atomid]} { continue }
        set text "mol $molid  index $atomid"
        if {![catch {atomselect $molid "index $atomid"} sel]} {
            if {[$sel num] == 1} {
                lassign [lindex [$sel get {resname resid name}] 0] rn ri nm
                set text "mol $molid  $rn$ri:$nm  (index $atomid)"
            }
            catch {$sel delete}
        }
        lappend out [list $text $molid $atomid]
    }
    return $out
}

proc ::VMDPathFinder::_build_vector_controls {d} {
    # CVECT from two points (coordinates, VMD selections or labelled atoms),
    # with Guess, Use Z and the per-frame endpoint modes, built into frame $d.
    label $d.orl -text "Or from two points" -foreground gray40
    grid $d.orl -row 0 -column 0 -columnspan 4 -sticky w -padx 6 -pady {6 2}
    # Two ways to fill a point without typing: "Pick" arms one click in the VMD
    # window (the next atom clicked lands here - no labelling step), "Label"
    # lists atoms already labelled with VMD's own '1' key. Pick is what people
    # reach for; Label stays for a point chosen earlier.
    label $d.l1 -text "Point 1"
    entry $d.e1 -textvariable ::VMDPathFinder::vec_p1 -width 16
    button $d.p1 -text "Pick" \
        -command [list ::VMDPathFinder::_cvect_pick_3d ::VMDPathFinder::vec_p1 1 $d]
    button $d.b1 -text "Label \u25be" \
        -command [list ::VMDPathFinder::_cvect_pick_label $d.e1 ::VMDPathFinder::vec_p1 $d]
    label $d.l2 -text "Point 2"
    entry $d.e2 -textvariable ::VMDPathFinder::vec_p2 -width 16
    button $d.p2 -text "Pick" \
        -command [list ::VMDPathFinder::_cvect_pick_3d ::VMDPathFinder::vec_p2 2 $d]
    button $d.b2 -text "Label \u25be" \
        -command [list ::VMDPathFinder::_cvect_pick_label $d.e2 ::VMDPathFinder::vec_p2 $d]
    grid $d.l1 -row 1 -column 0 -sticky e  -padx {6 4} -pady 2
    grid $d.e1 -row 1 -column 1 -sticky ew -padx 2     -pady 2
    grid $d.p1 -row 1 -column 2 -sticky w  -padx {4 0} -pady 2
    grid $d.b1 -row 1 -column 3 -sticky w  -padx {2 6} -pady 2
    grid $d.l2 -row 2 -column 0 -sticky e  -padx {6 4} -pady 2
    grid $d.e2 -row 2 -column 1 -sticky ew -padx 2     -pady 2
    grid $d.p2 -row 2 -column 2 -sticky w  -padx {4 0} -pady 2
    grid $d.b2 -row 2 -column 3 -sticky w  -padx {2 6} -pady 2
    grid columnconfigure $d 1 -weight 0
    grid columnconfigure $d 4 -weight 1
    add_tooltip $d.p1 "Click an atom in the VMD window; it becomes Point 1. When both points are set the vector is computed at once."
    add_tooltip $d.p2 "Click an atom in the VMD window; it becomes Point 2. When both points are set the vector is computed at once."
    add_tooltip $d.b1 "Choose an atom you already labelled in VMD (press '1' and click atoms)."
    add_tooltip $d.b2 "Choose an atom you already labelled in VMD (press '1' and click atoms)."
    label $d.hint -text "The vector points from Point 1 to Point 2." \
        -foreground gray -wraplength 340 -justify left
    grid $d.hint -row 3 -column 0 -columnspan 4 -sticky w -padx 6 -pady {0 4}
    add_tooltip $d.hint "Each point takes x y z, a VMD selection, or an atom picked in the 3D view.\
        A selection of several atoms uses its centre of geometry."
    frame $d.sb
    label       $d.sb.l   -text "Per-frame:"
    checkbutton $d.sb.cv  -text "Stabilize endpoints" \
        -variable ::VMDPathFinder::state(stabilize_cvect) \
        -command [list ::VMDPathFinder::_cvect_stab_excl $d stab]
    checkbutton $d.sb.ex  -text "Exact selection" \
        -variable ::VMDPathFinder::state(cvect_exact) \
        -command [list ::VMDPathFinder::_cvect_stab_excl $d exact]
    # Dynamic only: empty unless Exact is on with a non-protein endpoint. The
    # STATIC "why is this greyed" text lives in the checkboxes' own tooltips
    # (_cvect_sync_stab_controls) - this is not that; removing it silently
    # dropped the warning _cvect_stab_excl sets, which fires only sometimes.
    label $d.sb.note -text "" -foreground gray40 -font {Helvetica 8}
    pack $d.sb.l $d.sb.cv $d.sb.ex $d.sb.note -side left -padx {0 6}
    grid $d.sb -row 4 -column 0 -columnspan 4 -sticky w -padx 6 -pady {0 4}
    label $d.result -text "" -anchor w -foreground blue -wraplength 340 -justify left
    grid $d.result -row 5 -column 0 -columnspan 4 -sticky ew -padx 6
    # One row: the three actions on the left, Close on the right. They were two
    # rows, which put Close on a line of its own and stretched the dialog.
    frame $d.btns
    button $d.btns.guess -text "Guess"   -width 8 -command [list ::VMDPathFinder::_cvect_guess $d]
    button $d.btns.z     -text "Use Z"   -width 8 -command [list ::VMDPathFinder::_cvect_set_z $d]
    button $d.btns.calc  -text "Compute" -width 8 -command [list ::VMDPathFinder::compute_vector $d]
    button $d.btns.close -text "Close"   -width 8 \
        -command [list ::VMDPathFinder::_axis_stick_close [winfo toplevel $d]]
    pack $d.btns.guess $d.btns.z $d.btns.calc -side left -padx {0 4}
    pack $d.btns.close -side right
    grid $d.btns -row 6 -column 0 -columnspan 4 -sticky ew -padx 6 -pady {4 6}
    add_tooltip $d.sb.cv ""
    add_tooltip $d.sb.ex ""
    _cvect_sync_stab_controls $d
}

proc ::VMDPathFinder::_cvect_sync_stab_controls {d} {
    # Enable the per-frame Stabilize/Exact controls only when CVECT has a TWO-POINT
    # definition (cvect_def_p1/p2 both set). A literal direction (Guess / Use Z /
    # manual x,y,z) clears that definition, so stabilization is meaningless there.
    variable state
    # Headless guard - see _have_tk.
    if {![_have_tk]} { return }
    if {![winfo exists $d.sb]} { return }
    set has_def [expr {[string trim $state(cvect_def_p1)] ne "" && \
                       [string trim $state(cvect_def_p2)] ne ""}]
    # EXACT needs a SELECTION endpoint. It re-resolves the two definitions
    # literally at each frame (frame_axis' own Exact branch), so with two
    # x,y,z constants it re-derives the identical vector every frame - a live
    # control that provably cannot do anything. Stabilize is different: it fits
    # a local atom context around each endpoint, which is meaningful for a
    # literal point too, so it stays enabled on the two-point definition alone.
    set has_sel [expr {$has_def && \
        ([normalize_triplet_value $state(cvect_def_p1)] eq {} || \
         [normalize_triplet_value $state(cvect_def_p2)] eq {})}]
    catch {$d.sb.cv configure -state [expr {$has_def ? "normal" : "disabled"}]}
    catch {$d.sb.ex configure -state [expr {$has_sel ? "normal" : "disabled"}]}
    # Why a control is greyed goes in its tooltip, not in a label on the row -
    # the label was as wide as the rest of the dialog put together.
    set _why_stab "Re-fits each endpoint's local context per frame, then recomputes the direction."
    set _why_exact "Re-evaluates the two endpoint selections literally each frame, with no fit."
    if {!$has_def} {
        set state(stabilize_cvect) 0
        set state(cvect_exact) 0
        append _why_stab "\nNeeds CVECT defined from two points."
        append _why_exact "\nNeeds CVECT defined from two points."
    } elseif {!$has_sel} {
        set state(cvect_exact) 0
        append _why_exact "\nNeeds at least one endpoint given as a selection, not as x y z."
    }
    catch {set_tooltip $d.sb.cv $_why_stab}
    catch {set_tooltip $d.sb.ex $_why_exact}
}

proc ::VMDPathFinder::_cvect_stab_excl {d which} {
    # Stabilize and Exact are mutually exclusive (Exact = literal, no fit;
    # Stabilize = fit). Turning one on turns the other off.
    variable state
    if {$which eq "stab" && $state(stabilize_cvect)} { set state(cvect_exact) 0 }
    if {$which eq "exact" && $state(cvect_exact)}     { set state(stabilize_cvect) 0 }
    # Say it at the moment the choice is made, not only at run time.
    if {[_have_tk] && [winfo exists $d.sb.note]} {
        set _nw [_cvect_exact_nonprotein]
        if {[llength $_nw]} {
            $d.sb.note configure -text "⚠ non-protein endpoint - see the run warnings"                 -foreground "#b00000"
            set state(status) [lindex $_nw 0]
        } else {
            $d.sb.note configure -text "" -foreground gray40
        }
    }
}

proc ::VMDPathFinder::_cvect_guess {d} {
    variable state
    set note [suggest_cvect 1]
    set state(status) "CVECT $state(cvect) from $note."
    if {[winfo exists $d.result]} {
        $d.result configure -text "CVECT $state(cvect) - from $note"
    }
    _cvect_sync_stab_controls $d
}

proc ::VMDPathFinder::_cvect_set_z {d} {
    variable state
    set state(cvect) "0 0 1"
    set state(status) "CVECT 0 0 1, the Z axis."
    if {[winfo exists $d.result]} {
        $d.result configure -text "CVECT 0 0 1 - the Z axis"
    }
    _cvect_sync_stab_controls $d
}

proc ::VMDPathFinder::_cvect_pick_label {entry_widget var_name parent} {
    # Show a popup menu of VMD-labeled atoms; selecting one fills the entry
    # with "index <atomid>" (a valid VMD atomselect expression).
    set atoms [vector_labeled_atoms]
    if {[llength $atoms] == 0} {
        tk_messageBox -icon info -type ok -parent $parent \
            -title "VMD Labels" \
            -message "No atoms are labeled in VMD.\n\nIn VMD, press '1' (or Mouse > Label > Atoms) and click atoms to label them."
        return
    }
    set m ".vmdpathfinder_labelpick_m"
    catch {destroy $m}
    menu $m -tearoff 0
    foreach entry $atoms {
        lassign $entry text molid atomid
        $m add command -label $text \
            -command [list ::VMDPathFinder::_cvect_fill_entry $var_name $atomid]
    }
    tk_popup $m \
        [winfo rootx $entry_widget] \
        [expr {[winfo rooty $entry_widget] + [winfo height $entry_widget]}]
}

proc ::VMDPathFinder::_cvect_fill_entry {var_name atomid} {
    set $var_name "index $atomid"
    catch {destroy .vmdpathfinder_labelpick_m}
}

proc ::VMDPathFinder::_cvect_pick_3d {var_name which parent} {
    # Arm ONE click in the VMD window for Point $which: the next atom picked
    # fills the entry, then the mouse goes back to rotate. The vmd_pick_event
    # trace is the idiom VMD's own plugins (paratool, contactmap) use; it is
    # removed on the first pick so a stray click later never rewrites the
    # point, and re-arming replaces any pick still pending.
    variable state
    variable _cvect_pick_trace
    _cvect_pick_disarm
    if {[catch {mouse mode pick; mouse callback on} _err]} {
        set state(status) "Could not enter VMD's pick mode: $_err"
        return
    }
    set _cvect_pick_trace [list ::VMDPathFinder::_cvect_picked $var_name $which $parent]
    trace add variable ::vmd_pick_event write $_cvect_pick_trace
    set state(status) "Click an atom in the VMD window for Point $which."
}

proc ::VMDPathFinder::_cvect_pick_disarm {} {
    variable _cvect_pick_trace
    if {[info exists _cvect_pick_trace] && $_cvect_pick_trace ne ""} {
        catch {trace remove variable ::vmd_pick_event write $_cvect_pick_trace}
    }
    set _cvect_pick_trace ""
}

proc ::VMDPathFinder::_cvect_picked {var_name which parent args} {
    variable state
    variable vec_p1
    variable vec_p2
    _cvect_pick_disarm
    catch {mouse mode rotate}
    if {![info exists ::vmd_pick_atom] || ![string is integer -strict $::vmd_pick_atom]} { return }
    set $var_name "index $::vmd_pick_atom"
    set _pm [expr {[info exists ::vmd_pick_mol] ? $::vmd_pick_mol : ""}]
    set _note ""
    if {$_pm ne "" && [string trim $state(molid)] ne "" && $_pm != [string trim $state(molid)]} {
        # The selection is evaluated on the analysis molecule, so an atom index
        # from another molecule would silently mean a different atom.
        set _note " - NOTE: picked in mol $_pm, but the analysis molecule is $state(molid)"
    }
    set state(status) "Point $which = atom index $::vmd_pick_atom$_note"
    # Both ends set: compute straight away, so pick-pick needs no third click.
    if {[string trim $vec_p1] ne "" && [string trim $vec_p2] ne "" \
            && [winfo exists $parent] && [winfo exists $parent.result]} {
        catch {compute_vector $parent}
    }
}

proc ::VMDPathFinder::_autofill_start_points {topmol {allow_view_fallback 1}} {
    # Fill CPOINT / the tunnel start point, but ONLY when blank - never clobber
    # a value the user typed.
    #
    # Default CPOINT = geometric centre of the ANALYSIS SELECTION (the pore-
    # defining region), not the VMD view centre - the view centre drifts as the
    # user rotates/zooms and is unrelated to the channel. Falls back to the view
    # centre if the selection can't be evaluated.
    #
    # Split out of sync_top_defaults so _on_molecule_loaded can reuse exactly
    # this and nothing else: sync_top_defaults also re-points state(molid) and
    # rewrites the status line, which is right for the "Use Top" BUTTON but
    # wrong to do behind the user's back every time any molecule is loaded.
    variable state
    if {[string trim $state(cpoint)] eq ""} {
        set _cpset 0
        catch {
            set _seltext [string trim $state(selection)]
            if {$_seltext eq "" || $_seltext eq "all"} { set _seltext "protein" }
            set _cf [molinfo $topmol get frame]
            if {![string is integer -strict $_cf] || $_cf < 0} { set _cf 0 }
            set _c [vector_point_from_sel $topmol $_cf $_seltext]
            set state(cpoint) [format_triplet $_c]
            set _cpset 1
        }
        # allow_view_fallback 0 (the automatic molecule-load path): leave it
        # BLANK rather than dropping in the view centre. A molecule that is not
        # ready yet gives the origin, and an explicit wrong cpoint is worse than
        # none - blank makes HOLE guess the point itself, which is at least
        # informed by the structure. The "Use Top" button still passes 1: there
        # the user clicked, so the molecule is definitely loaded.
        if {!$_cpset && $allow_view_fallback} { catch {use_view_center} }
    }
    # Same default for Tunnel mode's start point, which had no auto-fill at all
    # before this - it stayed blank until the user set it by hand.
    if {[string trim $state(tunnel_start)] eq ""} {
        set _spset 0
        catch {
            set _seltext [string trim $state(selection)]
            if {$_seltext eq "" || $_seltext eq "all"} { set _seltext "protein" }
            set _cf [molinfo $topmol get frame]
            if {![string is integer -strict $_cf] || $_cf < 0} { set _cf 0 }
            set _c [vector_point_from_sel $topmol $_cf $_seltext]
            set state(tunnel_start) [format_triplet $_c]
            set _spset 1
        }
        if {!$_spset && $allow_view_fallback} { catch {tunnel_use_view_center} }
    }
}

proc ::VMDPathFinder::_on_molecule_loaded {args} {
    # VMD's own ::vmd_molecule array fires on every molecule create/delete.
    #
    # sync_top_defaults fills CPOINT only at show_gui time, so opening the
    # plugin BEFORE loading a structure - a completely normal order, and the
    # one a user who keeps the panel open hits every time - left CPOINT blank
    # forever. Blank is not cosmetic: write_control_file omits the cpoint card
    # entirely when it is empty, so HOLE falls back to guessing the point
    # itself ("WARNING have not found a CPOINT record - will try to guess"),
    # and "Show CPOINT as a sphere" had nothing to draw, which is what the
    # checkbox doing nothing actually was.
    #
    # RE-ENTRANCY GUARD: _sync_point_marker creates the marker with `mol new`,
    # which is itself a molecule event that would otherwise fire this again -
    # unguarded, this recurses into a storm of marker molecules. The flag is
    # dropped by the deferred body below, not here, because that body is what
    # does the creating.
    variable _in_molecule_load
    if {[info exists _in_molecule_load] && $_in_molecule_load} { return }
    set _in_molecule_load 1
    # Deferred: this fires at molecule CREATION, before coordinates are
    # necessarily readable, and an atomselect there returns the origin rather
    # than the real centroid - which is how the first version of this filled
    # CPOINT with 0,0,0. `after idle` lets the load finish first.
    after idle ::VMDPathFinder::_autofill_after_load
}

proc ::VMDPathFinder::_autofill_after_load {} {
    variable _in_molecule_load
    catch {
        if {![catch {molinfo top} topmol] && $topmol >= 0} {
            # allow_view_fallback 0: leave blank rather than guess the origin.
            _autofill_start_points $topmol 0
            _sync_point_marker cpoint show_cpoint_marker
            _sync_point_marker tunnel_start show_tunnel_start_marker
        }
    }
    set _in_molecule_load 0
}

proc ::VMDPathFinder::sync_top_defaults {} {
    variable state
    if {[catch {molinfo top} topmol] || $topmol < 0} {
        set state(status) "No molecule loaded in VMD."
        return
    }
    set state(molid) $topmol
    # Do NOT reset frame_spec here: clicking "Use Top" must not silently wipe a
    # frame range the user typed (the state default is already "now").
    _autofill_start_points $topmol
    set nf [molinfo $topmol get numframes]
    set _gnote [suggest_cvect]
    set state(status) "Mol $topmol, $nf frame(s). CVECT $state(cvect) from $_gnote."
    activate_molecule $topmol
}

proc ::VMDPathFinder::_set_point_to_view_center {key label} {
    # Shared by HOLE's CPOINT "COR" button and Tunnel mode's start-point "COR"
    # button - same computation, different target key.
    variable state
    if {[catch {
        set molid [resolve_molid]
        set center [get_view_center $molid]
    } message]} {
        set state(status) $message
        tk_messageBox -icon error -type ok -title "HOLE" -message $message
        return
    }
    set state($key) [format_triplet $center]
    set state(status) "$label updated from VMD view center."
}
proc ::VMDPathFinder::use_view_center {} { _set_point_to_view_center cpoint CPOINT }
proc ::VMDPathFinder::tunnel_use_view_center {} { _set_point_to_view_center tunnel_start "Tunnel start point" }

proc ::VMDPathFinder::_axis_stick_center {which} {
    # COG / COR for the point the stick is moving.
    variable state
    set key [_axis_stick_key $state(axis_stick_mode)]
    set lbl [expr {$key eq "tunnel_start" ? "Tunnel start point" : "CPOINT"}]
    if {$which eq "sel"} { _set_point_to_selection_center $key $lbl } else { _set_point_to_view_center $key $lbl }
    catch {_sync_point_marker $key [_axis_stick_cue_key $state(axis_stick_mode)]}
}

proc ::VMDPathFinder::_view_right_up {molid} {
    set right {1.0 0.0 0.0}; set up {0.0 1.0 0.0}
    catch {
        set rm [lindex [molinfo $molid get rotate_matrix] 0]
        set r0 [lindex $rm 0]; set r1 [lindex $rm 1]
        set right [lrange $r0 0 2]; set up [lrange $r1 0 2]
    }
    set right [_normalize_dir $right]; if {$right eq {}} { set right {1.0 0.0 0.0} }
    set up    [_normalize_dir $up];    if {$up    eq {}} { set up    {0.0 1.0 0.0} }
    return [concat $right $up]
}

# The three things the stick can move, and the cue that belongs to each.
proc ::VMDPathFinder::_axis_stick_key {mode} {
    # Which literal point the stick currently moves. CVECT has no single
    # point of its own - it moves whichever of the two-point definition's
    # ends is selected (state(axis_stick_vec_pt): p1 or p2), and CVECT is
    # then recomputed from the pair, exactly as typing over the two fields
    # and pressing Compute would do.
    variable state
    if {$mode eq "tunnel_start"} { return "tunnel_start" }
    if {$mode eq "cvect"} {
        return [expr {[info exists state(axis_stick_vec_pt)] && $state(axis_stick_vec_pt) eq "p2" \
            ? "vec_p2" : "vec_p1"}]
    }
    return "cpoint"
}
proc ::VMDPathFinder::_axis_stick_cue_key {mode} {
    return [expr {$mode eq "tunnel_start" ? "show_tunnel_start_marker" : "show_cpoint_marker"}]
}

proc ::VMDPathFinder::_axis_stick_getvar {key} {
    # vec_p1/vec_p2 are plain namespace variables, not state array entries -
    # this and _axis_stick_setvar are the one place that difference is hidden.
    variable state
    variable vec_p1
    variable vec_p2
    switch -- $key {
        vec_p1 { return $vec_p1 }
        vec_p2 { return $vec_p2 }
        default { return [expr {[info exists state($key)] ? $state($key) : ""}] }
    }
}
proc ::VMDPathFinder::_axis_stick_setvar {key val} {
    variable state
    variable vec_p1
    variable vec_p2
    switch -- $key {
        vec_p1 { set vec_p1 $val }
        vec_p2 { set vec_p2 $val }
        default { set state($key) $val }
    }
}

proc ::VMDPathFinder::_axis_stick_current {mode} {
    # The target point as three literal numbers, resolving its other normal
    # form (a VMD atom selection) once, since the stick moves it by
    # arithmetic from here on - exactly what typing over it by hand would do.
    set key [_axis_stick_key $mode]
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return {} }
    set frame 0; catch {set frame [molinfo $molid get frame]}
    set pt {}
    if {[catch {set pt [_resolve_point_input [_axis_stick_getvar $key] $molid $frame]}] || [llength $pt] != 3} {
        return {}
    }
    return $pt
}

proc ::VMDPathFinder::_cvect_ensure_two_point {} {
    # Give CVECT's stick something to move. The stick moves one END of the
    # two-point definition, but a CVECT typed as a literal vector (or guessed,
    # or Use Z) has no points at all - both entries blank - and the stick then
    # did nothing, silently. Seed the pair from what IS known: Point 1 = CPOINT
    # (or the selection's centre when CPOINT is blank), Point 2 = Point 1 +
    # 10 A along the current CVECT. That reproduces the current vector exactly,
    # so nothing changes until the user actually moves an end. A blank single
    # end is rebuilt from the other one the same way. Returns 1 when both
    # points are usable afterwards.
    variable state
    variable vec_p1
    variable vec_p2
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return 0 }
    set frame 0; catch {set frame [molinfo $molid get frame]}
    set p1 {}; set p2 {}
    catch {set p1 [_resolve_point_input $vec_p1 $molid $frame]}
    catch {set p2 [_resolve_point_input $vec_p2 $molid $frame]}
    if {[llength $p1] == 3 && [llength $p2] == 3} { return 1 }
    set dir {}
    set _cv [regexp -all -inline -- {[-+]?[0-9]*\.?[0-9]+(?:[eE][-+]?[0-9]+)?} $state(cvect)]
    if {[llength $_cv] == 3} { catch {set dir [_normalize_dir $_cv]} }
    if {[llength $dir] != 3} { set dir {0.0 0.0 1.0} }
    set L 10.0
    if {[llength $p1] != 3 && [llength $p2] != 3} {
        catch {set p1 [_resolve_point_input $state(cpoint) $molid $frame]}
        if {[llength $p1] != 3} {
            set _sel [string trim $state(selection)]
            if {$_sel eq "" || $_sel eq "all"} { set _sel "protein" }
            catch {set p1 [vector_point_from_sel $molid $frame $_sel]}
        }
        if {[llength $p1] != 3} { return 0 }
    }
    if {[llength $p1] == 3 && [llength $p2] != 3} {
        # Symmetric about the seed point, matching how the axis is drawn
        # (CPOINT-centred): P1 half a length back, P2 half a length on.
        set _h [expr {$L/2.0}]
        set p2 [list [expr {[lindex $p1 0]+$_h*[lindex $dir 0]}] \
                     [expr {[lindex $p1 1]+$_h*[lindex $dir 1]}] \
                     [expr {[lindex $p1 2]+$_h*[lindex $dir 2]}]]
        set p1 [list [expr {[lindex $p1 0]-$_h*[lindex $dir 0]}] \
                     [expr {[lindex $p1 1]-$_h*[lindex $dir 1]}] \
                     [expr {[lindex $p1 2]-$_h*[lindex $dir 2]}]]
    } elseif {[llength $p2] == 3 && [llength $p1] != 3} {
        set p1 [list [expr {[lindex $p2 0]-$L*[lindex $dir 0]}] \
                     [expr {[lindex $p2 1]-$L*[lindex $dir 1]}] \
                     [expr {[lindex $p2 2]-$L*[lindex $dir 2]}]]
    }
    set vec_p1 [format_triplet $p1]
    set vec_p2 [format_triplet $p2]
    return 1
}

proc ::VMDPathFinder::_axis_stick_apply {mode dx dy dz} {
    # Add a screen-relative displacement (dx dy dz, in world units) to the
    # target point. For CVECT's endpoints this moves one END OF THE DRAWN AXIS
    # and recomputes CVECT from the pair, live, the same as pressing Compute.
    variable state
    variable vec_p1
    variable vec_p2
    if {$mode eq "cvect" && ![_cvect_ensure_two_point]} {
        set state(status) "CVECT stick: set CPOINT (or a selection) first - there is no point to move yet."
        return
    }
    set key [_axis_stick_key $mode]
    set cur [_axis_stick_current $mode]
    if {$cur eq {}} {
        set state(status) "Stick: the [_axis_stick_key $mode] entry is not a point (x y z or a VMD selection)."
        return
    }
    lassign $cur cx cy cz
    _axis_stick_setvar $key [format_triplet [list [expr {$cx+$dx}] [expr {$cy+$dy}] [expr {$cz+$dz}]]]
    if {$key in {vec_p1 vec_p2}} {
        variable w
        catch {compute_vector $w.axisstick.vec}
        catch {_sync_point_marker cpoint show_cpoint_marker}
        catch {_sync_cvect_handles}
    } else {
        catch {_sync_point_marker $key [_axis_stick_cue_key $mode]}
    }
}

proc ::VMDPathFinder::_axis_stick_nudge {mode dir} {
    # dir: right left up down. One step in the CURRENT screen orientation.
    variable state
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return }
    lassign [_view_right_up $molid] rx ry rz ux uy uz
    set step $state(axis_stick_step_cpoint)
    if {![string is double -strict $step]} { set step 1.0 }
    switch -- $dir {
        right { _axis_stick_apply $mode [expr {$rx*$step}] [expr {$ry*$step}] [expr {$rz*$step}] }
        left  { _axis_stick_apply $mode [expr {-$rx*$step}] [expr {-$ry*$step}] [expr {-$rz*$step}] }
        up    { _axis_stick_apply $mode [expr {$ux*$step}] [expr {$uy*$step}] [expr {$uz*$step}] }
        down  { _axis_stick_apply $mode [expr {-$ux*$step}] [expr {-$uy*$step}] [expr {-$uz*$step}] }
    }
}

proc ::VMDPathFinder::_axis_stick_drag_start {d x y} {
    variable _axis_stick_last
    set _axis_stick_last [list $x $y]
}

proc ::VMDPathFinder::_axis_stick_drag_motion {d x y} {
    # Incremental screen delta since the LAST motion event (not from the pad's
    # centre) - a trackpad, not a rate joystick: drag far in one gesture and
    # the point keeps moving with the finger, no separate hold-to-repeat timer
    # needed. The knob itself is drawn clamped to the pad's radius, for the
    # "stick" look; only the raw delta drives the actual displacement.
    variable state
    variable _axis_stick_last
    if {![info exists _axis_stick_last]} { set _axis_stick_last [list $x $y] }
    lassign $_axis_stick_last lx ly
    set dxpix [expr {$x-$lx}]; set dypix [expr {$y-$ly}]
    set _axis_stick_last [list $x $y]
    set cx 70; set cy 70; set r 52
    set kx [expr {$x-$cx}]; set ky [expr {$y-$cy}]
    set kd [expr {sqrt($kx*$kx+$ky*$ky)}]
    if {$kd > $r} { set kx [expr {$kx*$r/$kd}]; set ky [expr {$ky*$r/$kd}] }
    catch {$d.pad.canv coords knob [expr {$cx+$kx-8}] [expr {$cy+$ky-8}] [expr {$cx+$kx+8}] [expr {$cy+$ky+8}]}
    if {$dxpix == 0 && $dypix == 0} { return }
    set mode $state(axis_stick_mode)
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return }
    lassign [_view_right_up $molid] rx ry rz ux uy uz
    set step $state(axis_stick_step_cpoint)
    if {![string is double -strict $step]} { set step 1.0 }
    set sens [expr {$step/30.0}]
    # Canvas y grows downward, so screen "up" is a NEGATIVE canvas dy.
    set wx [expr {$dxpix*$sens*$rx - $dypix*$sens*$ux}]
    set wy [expr {$dxpix*$sens*$ry - $dypix*$sens*$uy}]
    set wz [expr {$dxpix*$sens*$rz - $dypix*$sens*$uz}]
    _axis_stick_apply $mode $wx $wy $wz
}

proc ::VMDPathFinder::_axis_stick_drag_end {d} {
    variable _axis_stick_last
    catch {unset _axis_stick_last}
    catch {$d.pad.canv coords knob 62 62 78 78}
}

proc ::VMDPathFinder::_axis_stick_sync_mode {d} {
    variable state
    set m $state(axis_stick_mode)
    set lbl [dict get {cpoint "CPOINT (start point)" cvect "CVECT: place its two points" tunnel_start "Tunnel start point"} $m]
    catch {$d.hdr configure -text "Moving: $lbl"}
    catch {
        # only this mode's targets: a pore run has no tunnel start, a tunnel run no CPOINT/CVECT
        if {[analysis_mode] eq "tunnel"} { grid remove $d.m_cp $d.m_cv; grid $d.m_ts } \
        else { grid $d.m_cp $d.m_cv; grid remove $d.m_ts }
    }
    # Per-frame handling belongs to the thing being moved: CPOINT carries
    # Track/Stabilize, CVECT its own Stabilize/Exact pair, the tunnel start
    # point neither - so the choice sits with the point it governs.
    catch {
        if {$m eq "cpoint"} {
            grid $d.pf.cp
            _update_cpoint_scope_row $d.pf
        } else {
            # The fit/patch fields belong to CPOINT's Track/Stabilize only.
            grid remove $d.pf.cp
            grid remove $d.pf.scope_box
        }
        if {$m eq "cvect"}  {
            grid $d.vec; grid $d.pt2; _cvect_sync_stab_controls $d.vec; grid remove $d.pc
            # Fill the two points in the moment the page opens, so the entries
            # show the ends the stick is about to move (and the stick works on
            # a CVECT that was typed/guessed rather than built from points).
            if {[_cvect_ensure_two_point]} {
                # The two points ARE the definition, so bring CVECT in line with
                # them as the page opens - the same thing Compute does, and what
                # every later move does. Without it a pair typed into the entries
                # left the drawn axis pointing along a stale CVECT until the user
                # happened to nudge something.
                catch {compute_vector $d.vec}
                catch {_sync_point_marker cpoint show_cpoint_marker}
            }
        } else { grid remove $d.vec; grid remove $d.pt2; grid $d.pc }
    }
    # Draws the two handles on the CVECT page, clears them on any other - so
    # leaving the page takes them off screen without a separate teardown.
    catch {_sync_cvect_handles}
    catch {
        if {$m eq "tunnel_start"} { grid $d.pf.none } else { grid remove $d.pf.none }
    }
    _axis_stick_sync_val_label $d
}

proc ::VMDPathFinder::show_axis_stick_dialog {{mode ""}} {
    # One control for both fields: a mode switch (Point/Vector) plus a
    # draggable pad and four step buttons that always move the point/direction
    # in the CURRENT screen's up/down/left/right, whatever the model's own
    # rotation is - see _view_right_up. Reopening while already open just
    # re-targets it, so the CPOINT and CVECT buttons can share one dialog.
    variable w
    variable state
    if {$mode ne ""} { set state(axis_stick_mode) $mode }
    set d "$w.axisstick"
    # The cue is shown while the stick is open and put back the way it was
    # when the stick closes - see _axis_stick_cue_on, which records the
    # previous value of EVERY cue it turns on.
    if {[winfo exists $d]} {
        _axis_stick_cue_on $state(axis_stick_mode)
        _axis_stick_sync_mode $d
        wm deiconify $d; raise $d
        catch {_sync_cvect_handles}
        return
    }
    toplevel $d
    wm withdraw $d
    wm title $d "CPOINT / CVECT"
    wm resizable $d 0 0
    label $d.hdr -font {Helvetica 9 bold}
    grid $d.hdr -row 0 -column 0 -columnspan 3 -sticky w -padx 10 -pady {10 4}
    radiobutton $d.m_cp -text "CPOINT" -variable ::VMDPathFinder::state(axis_stick_mode) -value cpoint -command [list ::VMDPathFinder::_axis_stick_sync_mode $d]
    radiobutton $d.m_cv -text "CVECT" -variable ::VMDPathFinder::state(axis_stick_mode) -value cvect -command [list ::VMDPathFinder::_axis_stick_sync_mode $d]
    radiobutton $d.m_ts -text "Tunnel start" -variable ::VMDPathFinder::state(axis_stick_mode) -value tunnel_start -command [list ::VMDPathFinder::_axis_stick_sync_mode $d]
    grid $d.m_cp -row 1 -column 0 -sticky w -padx 10
    grid $d.m_cv -row 1 -column 1 -sticky w -padx 10
    grid $d.m_ts -row 1 -column 2 -sticky w -padx 10
    # Per-frame handling for whatever is being moved - the same variables and
    # handlers the panel rows use, so the two stay in step either way.
    frame $d.pf
    grid $d.pf -row 3 -column 0 -columnspan 3 -sticky w -padx 10
    frame $d.pf.cp
    label       $d.pf.cp.l  -text "Per-frame:"
    checkbutton $d.pf.cp.st -text "Stabilize" -variable ::VMDPathFinder::state(stabilize_cpoint) -command [list ::VMDPathFinder::_on_stabilize_toggled cpoint]
    checkbutton $d.pf.cp.tk -text "Track" -variable ::VMDPathFinder::state(track_cpoint) -command ::VMDPathFinder::_on_track_cpoint_toggled
    pack $d.pf.cp.l $d.pf.cp.st $d.pf.cp.tk -side left -padx {0 6}
    grid $d.pf.cp -row 0 -column 0 -sticky w
    # The scope fields for whichever of the two is checked. They used to sit in
    # the left panel; they follow the checkboxes here, or they would be
    # unreachable. Same widget names, so _update_cpoint_scope_row drives this
    # one unchanged - it takes the PARENT of scope_box.
    frame $d.pf.scope_box
    label $d.pf.scope_box.sl   -text "fit"
    entry $d.pf.scope_box.ri   -textvariable ::VMDPathFinder::state(stab_radius_inner) -width 4
    label $d.pf.scope_box.ri_l -text "auto expand to"
    entry $d.pf.scope_box.ro   -textvariable ::VMDPathFinder::state(stab_radius_outer) -width 4
    label $d.pf.scope_box.ro_l -text "warn at"
    entry $d.pf.scope_box.rw   -textvariable ::VMDPathFinder::state(stab_rmsd_warn) -width 4
    label $d.pf.scope_box.tl   -text "patch radius"
    entry $d.pf.scope_box.tr   -textvariable ::VMDPathFinder::state(track_radius) -width 4
    label $d.pf.scope_box.tr_l -text "A, at start"
    grid $d.pf.scope_box -row 1 -column 0 -sticky w -pady {2 0}
    add_tooltip $d.pf.scope_box.ri "CA atoms within this radius of CPOINT, at the reference frame, set the local motion the axis follows."
    add_tooltip $d.pf.scope_box.ro "If fewer than 3 Ca atoms are found within the fit radius, search out to here instead."
    add_tooltip $d.pf.scope_box.rw "Warn in the console if the fit's residual error exceeds this many A."
    add_tooltip $d.pf.scope_box.tr "Radius around CPOINT, at the reference frame, that picks the patch of atoms Track follows."
    _update_cpoint_scope_row $d.pf
    frame $d.vec -relief groove -borderwidth 1
    _build_vector_controls $d.vec
    grid $d.vec -row 7 -column 0 -columnspan 3 -sticky ew -padx 10 -pady {0 6}
    frame $d.pc
    button $d.pc.cog -text "COG" -command [list ::VMDPathFinder::_axis_stick_center sel]
    button $d.pc.cor -text "COR" -command [list ::VMDPathFinder::_axis_stick_center view]
    button $d.pc.close -text "Close" -command [list ::VMDPathFinder::_axis_stick_close $d]
    pack $d.pc.cog $d.pc.cor -side left -padx {0 6}
    pack $d.pc.close -side right
    grid $d.pc -row 8 -column 0 -columnspan 3 -sticky ew -padx 10 -pady {0 6}
    add_tooltip $d.pc.cog "The centre of geometry of the atom selection."
    add_tooltip $d.pc.cor "VMD's current centre of rotation."
    label $d.pf.none -text "Per-frame: the tunnel search re-runs from this point each frame." -foreground gray40 -font {Helvetica 8}
    grid $d.pf.none -row 0 -column 0 -sticky w
    add_tooltip $d.pf.cp.st "Keeps CPOINT fixed relative to the local structure as it moves or rotates."
    add_tooltip $d.pf.cp.tk "Moves CPOINT by the translation of a frozen patch of atoms - drift-free, rotation-blind."

    # The stick moves ONE of the two endpoints CVECT is computed from - which
    # one is this selector, not a mode of its own; switching it only changes
    # what the next click or drag targets, exactly like choosing CPOINT vs
    # the tunnel start point does at the row above.
    frame $d.pt2
    label       $d.pt2.l  -text "Move:"
    radiobutton $d.pt2.p1 -text "Point 1" -variable ::VMDPathFinder::state(axis_stick_vec_pt) -value p1 \
        -command [list ::VMDPathFinder::_axis_stick_sync_mode $d]
    radiobutton $d.pt2.p2 -text "Point 2" -variable ::VMDPathFinder::state(axis_stick_vec_pt) -value p2 \
        -command [list ::VMDPathFinder::_axis_stick_sync_mode $d]
    pack $d.pt2.l $d.pt2.p1 $d.pt2.p2 -side left -padx {0 6}
    grid $d.pt2 -row 2 -column 0 -columnspan 3 -sticky w -padx 10 -pady {2 0}

    frame $d.pad
    grid $d.pad -row 4 -column 0 -columnspan 3 -pady {6 4}
    button $d.pad.up    -text "↑" -width 3 -command [list ::VMDPathFinder::_axis_stick_nudge_cur $d up]
    button $d.pad.down  -text "↓" -width 3 -command [list ::VMDPathFinder::_axis_stick_nudge_cur $d down]
    button $d.pad.left  -text "←" -width 3 -command [list ::VMDPathFinder::_axis_stick_nudge_cur $d left]
    button $d.pad.right -text "→" -width 3 -command [list ::VMDPathFinder::_axis_stick_nudge_cur $d right]
    canvas $d.pad.canv -width 140 -height 140 -highlightthickness 0 -bg white
    $d.pad.canv create oval 8 8 132 132 -outline gray60 -width 2
    $d.pad.canv create line 70 8 70 132 -fill gray85
    $d.pad.canv create line 8 70 132 70 -fill gray85
    $d.pad.canv create oval 62 62 78 78 -fill #4a90d9 -outline "" -tags knob
    grid $d.pad.up    -row 0 -column 1
    grid $d.pad.left  -row 1 -column 0
    grid $d.pad.canv  -row 1 -column 1
    grid $d.pad.right -row 1 -column 2
    grid $d.pad.down  -row 2 -column 1
    add_tooltip $d.pad.canv "Drag moves the point the way you drag, relative to the view: up, down, left and right always match the screen. For CVECT, pick Point 1 or Point 2 first."
    bind $d.pad.canv <ButtonPress-1> [list ::VMDPathFinder::_axis_stick_drag_start $d %x %y]
    bind $d.pad.canv <B1-Motion>     [list ::VMDPathFinder::_axis_stick_drag_motion $d %x %y]
    bind $d.pad.canv <ButtonRelease-1> [list ::VMDPathFinder::_axis_stick_drag_end $d]

    frame $d.sv
    label   $d.sv.step_l -text "Step"
    spinbox $d.sv.step_e -width 5 -from 0.05 -to 180 -increment 0.5 -justify right \
        -textvariable ::VMDPathFinder::state(axis_stick_step_cpoint)
    label   $d.sv.val_l -text "Value"
    label   $d.sv.val_v -width 30 -anchor w -relief sunken
    pack $d.sv.step_l $d.sv.step_e -side left -padx {0 4}
    pack $d.sv.val_l -side left -padx {10 4}
    pack $d.sv.val_v -side left
    grid $d.sv -row 5 -column 0 -columnspan 3 -sticky w -padx 10 -pady {4 8}
    add_tooltip $d.sv.step_e "Distance moved per arrow click, in \u00c5. Also the drag sensitivity."

    wm protocol $d WM_DELETE_WINDOW [list ::VMDPathFinder::_axis_stick_close $d]
    grid columnconfigure $d 2 -weight 1
    _axis_stick_sync_val_label $d
    trace add variable ::VMDPathFinder::state(axis_stick_mode) write [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]
    trace add variable ::VMDPathFinder::state(cpoint) write [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]
    trace add variable ::VMDPathFinder::state(tunnel_start) write [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]
    trace add variable ::VMDPathFinder::vec_p1 write [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]
    trace add variable ::VMDPathFinder::vec_p2 write [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]
    bind $d <Destroy> [list ::VMDPathFinder::_axis_stick_dialog_closed $d]
    _axis_stick_cue_on $state(axis_stick_mode)
    _axis_stick_sync_mode $d
    _center_toplevel $d
    # After the window is actually mapped: _sync_cvect_handles draws only for a
    # dialog in state "normal", and everything above runs while it is still
    # withdrawn.
    catch {_sync_cvect_handles}
}

proc ::VMDPathFinder::_axis_stick_cue_on {mode} {
    # Show the cue for what the stick is about to move, remembering what that
    # checkbox was set to first so Close can put it back.
    #
    # EVERY cue the stick turns on is remembered, not just the one it opened
    # with: the dialog is shared and re-targeted in place (the CPOINT, CVECT
    # and tunnel-start buttons all call show_axis_stick_dialog on the same
    # toplevel), so a single remembered variable restored only whichever
    # target came first and left the other cue - and its marker molecule -
    # in the scene after Close.
    variable state
    variable _axis_stick_prev_cue
    if {![info exists _axis_stick_prev_cue]} { set _axis_stick_prev_cue [dict create] }
    set key [_axis_stick_cue_key $mode]
    if {![dict exists $_axis_stick_prev_cue $key]} {
        dict set _axis_stick_prev_cue $key \
            [expr {[info exists state($key)] ? $state($key) : 0}]
    }
    set state($key) 1
}

proc ::VMDPathFinder::_axis_stick_close {d} {
    variable state
    variable _axis_stick_prev_cue
    catch {wm withdraw $d}
    if {![info exists _axis_stick_prev_cue]} { return }
    dict for {key prev} $_axis_stick_prev_cue {
        set state($key) $prev
        # Explicitly, not only through the write trace: the trace for a given
        # cue is installed by the panel/gear that owns that checkbox, and the
        # stick can turn a cue on before its owner has ever been built.
        # _sync_point_marker is idempotent and removes the marker mol itself.
        catch {_sync_point_marker [expr {$key eq "show_tunnel_start_marker" \
            ? "tunnel_start" : "cpoint"}] $key}
    }
    set _axis_stick_prev_cue [dict create]
    catch {_sync_cvect_handles}
}

proc ::VMDPathFinder::_axis_stick_nudge_cur {d dir} {
    variable state
    _axis_stick_nudge $state(axis_stick_mode) $dir
}

proc ::VMDPathFinder::_axis_stick_sync_val_label {d} {
    # A plain -text, not -textvariable: the target for CVECT is vec_p1 or
    # vec_p2, plain namespace variables rather than a state array entry, so
    # what the label shows has to be re-read on every change instead of
    # bound once.
    variable state
    if {![winfo exists $d.sv.val_v]} { return }
    # On the CVECT page the raw target text is already in the Point 1/Point 2
    # entry right above, so echoing it says nothing. Report instead what the
    # entries cannot: how long the vector between the two points is, and the
    # unit direction that length is discarded in favour of.
    if {[info exists state(axis_stick_mode)] && $state(axis_stick_mode) eq "cvect"} {
        set _txt [_axis_stick_getvar [_axis_stick_key $state(axis_stick_mode)]]
        catch {
            variable vec_p1
            variable vec_p2
            set _m [resolve_molid]
            set _f [molinfo $_m get frame]
            set _a [_resolve_point_input $vec_p1 $_m $_f]
            set _b [_resolve_point_input $vec_p2 $_m $_f]
            if {[llength $_a] == 3 && [llength $_b] == 3} {
                lassign $_a _ax _ay _az
                lassign $_b _bx _by _bz
                set _l [expr {sqrt(($_bx-$_ax)*($_bx-$_ax) + ($_by-$_ay)*($_by-$_ay)
                                   + ($_bz-$_az)*($_bz-$_az))}]
                set _u [expr {$_l > 1e-9 ? [format "%.3f %.3f %.3f" \
                    [expr {($_bx-$_ax)/$_l}] [expr {($_by-$_ay)/$_l}] [expr {($_bz-$_az)/$_l}]] : "-"}]
                set _txt [format "len %.2f Å   dir %s" $_l $_u]
            }
        }
        catch {$d.sv.val_v configure -text $_txt}
    } else {
        catch {$d.sv.val_v configure -text [_axis_stick_getvar [_axis_stick_key $state(axis_stick_mode)]]}
    }
    # vec_p1/vec_p2 are traced onto this proc already, so typing an endpoint
    # moves its handle live without a second set of traces to install and tear
    # down.
    catch {_sync_cvect_handles}
}
proc ::VMDPathFinder::_axis_stick_sync_val_label_trace {d args} { _axis_stick_sync_val_label $d }

proc ::VMDPathFinder::_axis_stick_dialog_closed {d args} {
    catch {trace remove variable ::VMDPathFinder::state(axis_stick_mode) write         [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]}
    catch {trace remove variable ::VMDPathFinder::state(cpoint) write         [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]}
    catch {trace remove variable ::VMDPathFinder::state(tunnel_start) write         [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]}
    catch {trace remove variable ::VMDPathFinder::vec_p1 write         [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]}
    catch {trace remove variable ::VMDPathFinder::vec_p2 write         [list ::VMDPathFinder::_axis_stick_sync_val_label_trace $d]}
}

proc ::VMDPathFinder::resolve_molid {} {
    variable state
    set id $state(molid)
    if {$id eq "top" || $id eq ""} { set id [molinfo top] }
    if {[catch {molinfo $id get name}]} { error "Molecule '$id' is not available." }
    return $id
}

proc ::VMDPathFinder::resolve_molid_or {fallback} {
    # resolve_molid THROWS when state(molid) names a deleted molecule, and
    # when nothing is loaded at all (molinfo top returns -1, which then fails
    # the name lookup). Redraw, readout and button entry points want "no
    # molecule" as a VALUE they can branch on - several of them tested `< 0`
    # against a helper that never returns it, leaving their own friendly
    # error branches unreachable and a raw background error in their place.
    if {[catch {resolve_molid} id]} { return $fallback }
    return $id
}

# ---------------------------------------------------------------------------
# Memory slots: several spherical analyses held, and drawn, at the same time.
# ---------------------------------------------------------------------------

proc ::VMDPathFinder::_mem_run_keys {} {
    # What a memory's run was computed with. Restored with the memory; a new
    # memory starts from the defaults except the four method settings, which
    # carry over.
    return {pore_method search_engine conn_engine sample
            selection cpoint cvect endrad ignore shorto extra_cards
            random_seed mcstep mcdisp mckt cvect_def_p1 cvect_def_p2
            stabilize_cpoint track_cpoint stabilize_cvect cvect_exact
            stab_radius_inner stab_radius_outer stab_rmsd_warn track_radius
            dynamic_axis frame_spec}
}

proc ::VMDPathFinder::_mem_display_keys {} {
    # How a memory is DRAWN, where memories are ALLOWED to differ - five pores
    # in five colours is the point of the feature. "Sync presentation" copies
    # the active memory's set to every other one when the user wants them to
    # read as one picture instead of five unrelated ones.
    return {surface_color surface_color_disp surface_material dot_density
            hydro_scheme hydro_scheme_disp
            mean_surface_color mean_surface_color_disp mean_surface_material}
}

proc ::VMDPathFinder::_mem_enabled {} {
    # SPHERICAL PORE ONLY. Tunnel keeps its own result store and surface track,
    # and Connolly/Capsule produce a different kind of surface; mixing them into
    # one slot list would be indistinguishable downstream, which is the defect
    # the tunnel_results comment already warns about.
    variable state
    # analysis_mode returns "hole"/"tunnel" - the left-panel tab, not the pore
    # method. Both gates are needed: the Tunnel tab, and Connolly/Capsule.
    if {[analysis_mode] ne "hole"} { return 0 }
    return [expr {[info exists state(pore_method)] && $state(pore_method) eq "circular"}]
}

proc ::VMDPathFinder::_mem_capture {} {
    # The live analysis, as a memory record: its settings, its results and the
    # run folder they live in.
    variable state
    variable results
    variable result_frames
    variable run_root
    set p [dict create]
    foreach k [concat [_mem_run_keys] [_mem_display_keys]] {
        if {[info exists state($k)]} { dict set p $k $state($k) }
    }
    return [dict create params $p results $results frames $result_frames run_root $run_root]
}

proc ::VMDPathFinder::_mem_apply {rec} {
    # Restore a memory into the live slots. Parameters AND results, so the panel
    # shows the numbers that produced what is on screen.
    variable state
    variable results
    variable result_frames
    variable plot_data_version
    variable run_root
    if {![dict size $rec]} { return }
    dict for {k v} [dict get $rec params] { set state($k) $v }
    _mem_sync_shared_labels
    set results [dict get $rec results]
    set result_frames [dict get $rec frames]
    set run_root [expr {[dict exists $rec run_root] ? [dict get $rec run_root] : ""}]
    # last_geom_key is a single global "what is currently drawn" stamp. Another
    # memory's results are different geometry under a key that may compare
    # equal, so without this the switch leaves the previous memory's surface on
    # screen next to the new memory's numbers.
    variable last_geom_key
    set last_geom_key "mem-switch"
    incr plot_data_version
}

proc ::VMDPathFinder::_mem_stash_active {} {
    # Write the live analysis back into whichever memory is current.
    variable pore_memories
    variable pore_memory_active
    if {$pore_memory_active eq ""} { return }
    dict set pore_memories $pore_memory_active [_mem_capture]
}

proc ::VMDPathFinder::_mem_ensure_first {} {
    # The live analysis becomes memory 1 the first time the feature is touched,
    # so an existing run is never left outside the list.
    variable pore_memories
    variable pore_memory_active
    variable pore_memory_next
    if {$pore_memory_active ne ""} { return }
    variable results
    set id 1
    set pore_memory_active $id
    if {$pore_memory_next <= $id} { set pore_memory_next [expr {$id+1}] }
    # adopt any surface already drawn for this molecule as memory 1's track,
    # so the pore on screen when the feature is first touched keeps its graphics
    # MOVE, not copy. Leaving the entry in surface_mols leaves the same mol id
    # reachable from ensure_surface_mol's non-memory branch, so a Connolly or
    # Capsule surface would render straight into memory 1's track and slot 1
    # would then show spherical numbers over Connolly graphics. It would also
    # leave surface_mols dangling at a deleted mol after _mem_forget_tracks.
    variable surface_mols
    variable mem_surface_mols
    foreach mk [array names surface_mols] {
        set key "$mk|$id"
        if {![info exists mem_surface_mols($key)]} {
            set mem_surface_mols($key) $surface_mols($mk)
        }
        unset surface_mols($mk)
    }
    dict set pore_memories $id [_mem_capture]
}

proc ::VMDPathFinder::_mem_new {} {
    # A new memory, from DEFAULTS. The previous one keeps its results, its
    # surface and its numbers.
    variable state
    variable results
    variable result_frames
    variable pore_memories
    variable pore_memory_active
    variable pore_memory_next
    variable default_state
    variable run_root
    _mem_ensure_first
    _mem_stash_active
    set id $pore_memory_next
    incr pore_memory_next
    # The frame range and the method settings describe the trajectory and how
    # it is analysed, so they carry over; the pore's own settings start from
    # the defaults.
    foreach k [_mem_run_keys] {
        if {$k in {frame_spec pore_method search_engine conn_engine sample}} continue
        if {[info exists default_state($k)]} { set state($k) $default_state($k) }
    }
    set results [dict create]
    set result_frames {}
    set run_root ""
    set pore_memory_active $id
    _mem_drop_mean_surface
    _mem_seed_axis
    _mem_point_surface_mol
    dict set pore_memories $id [_mem_capture]
    _mem_sync_cues
    return $id
}

proc ::VMDPathFinder::_mem_drop_mean_surface {} {
    # The Mean Profile tube is built from ONE analysis's frames, so it stops
    # describing anything the moment another memory becomes the active one.
    # Left standing it also came back on its own: a later surface redraw
    # re-solos the mean whenever show_mean_surface is still set.
    variable mean_surface_mol
    variable state
    if {$mean_surface_mol < 0 || [catch {molinfo $mean_surface_mol get name}]} { return }
    catch {remove_mean_surface}
    catch {_update_surface_vis_buttons}
}

proc ::VMDPathFinder::_mem_activate {id} {
    # Switch to a memory: its numbers come back into the panel and its results
    # become the live ones. Every memory's surface stays drawn either way.
    variable pore_memories
    variable pore_memory_active
    if {![dict exists $pore_memories $id]} { return 0 }
    if {$pore_memory_active eq $id} { return 1 }
    _mem_stash_active
    set pore_memory_active $id
    _mem_drop_mean_surface
    _mem_apply [dict get $pore_memories $id]
    _mem_keep_frame
    _mem_point_surface_mol
    _mem_sync_cues
    return 1
}

proc ::VMDPathFinder::_mem_blank_track {frame} {
    # Clear ONE memory's surface track for a frame its run does not cover.
    # blank_surface_for_frame's per-memory twin, minus the scalebar, which is
    # shared. current_surface_mol must already point at that memory's track.
    variable current_surface_mol
    if {$current_surface_mol < 0 || [catch {molinfo $current_surface_mol get name}]} { return }
    catch {graphics $current_surface_mol delete all}
    catch {dict unset ::VMDPathFinder::_drawn_key $current_surface_mol}
    catch {mol rename $current_surface_mol "HOLE surface (frame $frame: no data)"}
}

proc ::VMDPathFinder::_mem_forget_assets {} {
    # A geometry change (mesher, display mode, smoothing) invalidates every
    # memory's surface, not only the active one's.
    variable pore_memories
    dict for {id rec} $pore_memories {
        set r [dict get $rec results]
        foreach f [dict keys $r] { dict set r $f asset {} }
        dict set pore_memories $id [dict replace $rec results $r]
    }
}

proc ::VMDPathFinder::_mem_render_other_memories {frame draft} {
    # Draw the frame for every memory OTHER than the active one. Playback and
    # scrubbing render the live `results` only, so with five pores held, four of
    # them froze at whatever frame was on screen when the slot was left - "with
    # play it only plays one memory".
    #
    # Each memory is swapped in just far enough to render: its results, its
    # display settings and its own track. Deliberately NOT _mem_activate, which
    # also restores run parameters, redraws the cues and bumps
    # plot_data_version - all wrong to do per frame, and visible as flicker in
    # the panel. The active memory is left to the ordinary path so the common
    # single-memory case runs exactly as it always has.
    variable pore_memories
    variable pore_memory_active
    variable results
    variable result_frames
    variable current_surface_mol
    variable state
    if {![_mem_enabled] || [dict size $pore_memories] < 2} { return }
    variable _mem_render_busy
    variable _mem_swapping
    set _mem_render_busy 1
    # Swapping another memory's display keys into state() fires the same
    # traces a user edit does; those re-arm apply_display_change and
    # apply_material_now, which render the other memories again - an idle
    # two-memory session redrew forever. The handlers return while this is up.
    set _mem_swapping 1
    set save_results $results
    set save_frames  $result_frames
    set save_mol     $current_surface_mol
    set save_active  $pore_memory_active
    # Drawn with its own display settings AND its own method settings, so a
    # Connolly memory next to a spherical one is built the way it was run.
    set _swap [concat [_mem_display_keys] {pore_method search_engine conn_engine sample endrad}]
    set save_disp [dict create]
    foreach k $_swap {
        if {[info exists state($k)]} { dict set save_disp $k $state($k) }
    }
    foreach id [lsort -integer [dict keys $pore_memories]] {
        # Stop means stop. This is the one hot per-frame loop with no abort
        # check, so pressing Stop during a multi-memory redraw kept cycling
        # through the remaining memories, each one rewriting the status bar.
        if {[_abort_requested]} { break }
        if {$id eq $save_active} { continue }
        set rec [dict get $pore_memories $id]
        set pore_memory_active $id
        # A memory whose run does not cover this frame is BLANKED, not left as
        # it was. Two runs over different frame ranges kept the shorter one's
        # last surface on screen for every frame past its end - one memory
        # stuck on a stale frame while the trajectory played on. The active
        # memory has always blanked here (blank_surface_for_frame); this is the
        # same answer for the others.
        if {![dict exists [dict get $rec results] $frame]} {
            _mem_point_surface_mol
            _mem_blank_track $frame
            continue
        }
        set results       [dict get $rec results]
        set result_frames [dict get $rec frames]
        dict for {k v} [dict get $rec params] {
            if {[lsearch -exact $_swap $k] >= 0} { set state($k) $v }
        }
        _mem_point_surface_mol
        catch {load_surface_for_frame $frame $draft}
        # write back, since rendering caches the built asset into results
        dict set rec results $results
        dict set pore_memories $id $rec
    }
    set results        $save_results
    set result_frames  $save_frames
    set pore_memory_active $save_active
    set current_surface_mol $save_mol
    dict for {k v} $save_disp { set state($k) $v }
    set _mem_swapping 0
    set _mem_render_busy 0
    catch {_update_surface_vis_buttons}
    # The flag this loop raised is the one it consumes. Leaving it up would
    # abort the next real calculation before it started.
    if {[_abort_requested] && ![_op_in_progress]} {
        set state(abort_requested) 0
        set state(status) "Stopped."
    }
}

proc ::VMDPathFinder::_mem_keep_frame {} {
    # Keep the frame the user is on across a memory switch. The frame belongs to
    # the trajectory, not to a memory, but the new memory may hold no result for
    # it - falling back to that memory's FIRST frame made the Over Time indicator
    # jump and the 3-D surface snap. Nearest available is the smallest move that
    # still shows something.
    variable state
    variable result_frames
    if {![llength $result_frames]} { set state(selected_result_frame) {}; return }
    set want $state(selected_result_frame)
    if {$want ne "" && [lsearch -exact $result_frames $want] >= 0} { return }
    if {$want eq "" || ![string is integer -strict $want]} {
        set state(selected_result_frame) [lindex $result_frames 0]
        return
    }
    set best [lindex $result_frames 0]
    set bestd [expr {abs($best - $want)}]
    foreach f $result_frames {
        set d [expr {abs($f - $want)}]
        if {$d < $bestd} { set bestd $d; set best $f }
    }
    set state(selected_result_frame) $best
}

proc ::VMDPathFinder::_mem_seed_axis {} {
    # A new memory's blank CPOINT/CVECT draws no cue, so there is nothing to
    # grab. Seed it with exactly what the panel's own Guess button would give:
    # the selection's centre of geometry, and _detect_pore_axis's axis.
    #
    # NOT HOLE's CGUESS, which was used here first. CGUESS only ever returns an
    # x, y or z axis, chosen by summed pore radius, so on a membrane channel it
    # regularly seeded "1 0 0" - a handle pointing across the pore instead of
    # along it. Silent on failure: blank stays valid.
    variable state
    if {[catch {resolve_molid} molid] || $molid < 0} { return }
    set seltext [string trim $state(selection)]
    if {$seltext eq "" || $seltext eq "all"} { set seltext "protein" }
    set frame 0
    catch {set frame [molinfo $molid get frame]}
    catch {set state(cpoint) [format_triplet [vector_point_from_sel $molid $frame $seltext]]}
    catch {suggest_cvect 1}
}

proc ::VMDPathFinder::_mem_point_surface_mol {} {
    # Re-point current_surface_mol at the ACTIVE memory's track. Without this a
    # new memory inherited the previous one's track pointer, and the first
    # clear_surface of its run deleted the previous memory's surface - the
    # "creating a new memory hides the first one" report.
    variable current_surface_mol
    variable mem_surface_mols
    variable pore_memory_active
    set current_surface_mol -1
    if {$pore_memory_active eq ""} { return }
    foreach k [array names mem_surface_mols "*|$pore_memory_active"] {
        if {![catch {molinfo $mem_surface_mols($k) get name}]} {
            set current_surface_mol $mem_surface_mols($k)
            return
        }
        unset mem_surface_mols($k)
    }
}

proc ::VMDPathFinder::_mem_sync_cues {} {
    # Redraw the CPOINT sphere, the CVECT handles and the axis stick for the
    # memory now active. Restoring the parameters is not enough on its own: the
    # write trace on state(cvect) CLEARS the cue by design (a cvect typed by
    # hand invalidates a two-point definition), so a switch left the previous
    # memory's cue on screen or no cue at all. The cue shows the axis, it does
    # not define it, so redrawing it here changes nothing about the run.
    # Not _axis_stick_cue_on: that belongs to the stick dialog, which saves the
    # checkbox states it overrode so Close can put them back. Calling it from
    # outside the dialog would corrupt that saved set.
    catch {_sync_point_marker cpoint show_cpoint_marker}
    catch {_sync_cvect_handles}
    # Stabilize/Track are restored as values; the fields they govern are shown
    # or hidden by this call. Without it a memory with Stabilize off still
    # displayed the previous memory's fit radii, reading as "on".
    catch {_update_cpoint_scope_row}
}

proc ::VMDPathFinder::_mem_delete {id} {
    variable pore_memories
    variable pore_memory_active
    variable mem_surface_mols
    if {![dict exists $pore_memories $id]} { return 0 }
    if {[dict size $pore_memories] < 2} { return 0 }
    dict unset pore_memories $id
    _mem_forget_tracks $id
    _mem_drop_mean_surface
    if {$pore_memory_active eq $id} {
        set pore_memory_active [lindex [lsort -integer [dict keys $pore_memories]] 0]
        _mem_apply [dict get $pore_memories $pore_memory_active]
        # The same tail _mem_activate runs. Without it current_surface_mol still
        # pointed at the DELETED memory's track.
        _mem_keep_frame
        _mem_point_surface_mol
        _mem_sync_cues
    }
    return 1
}

proc ::VMDPathFinder::_mem_track_ids {id} {
    # Every surface track belonging to this memory. Keyed "<molid>|<memory>",
    # so one memory can have a track per analysed molecule.
    variable mem_surface_mols
    set out {}
    foreach k [array names mem_surface_mols "*|$id"] { lappend out $mem_surface_mols($k) }
    return $out
}

proc ::VMDPathFinder::_mem_forget_tracks {id} {
    variable mem_surface_mols
    variable _drawn_key
    foreach k [array names mem_surface_mols "*|$id"] {
        # Check the mol still exists before deleting it: `mol delete` on an id
        # VMD has already dropped is the crash this file guards against
        # everywhere else it deletes a track.
        if {![catch {molinfo $mem_surface_mols($k) get name}]} {
            catch {mol delete $mem_surface_mols($k)}
        }
        # VMD REUSES freed molecule ids, so the draw cache must forget this one
        # or the next track handed that id is told it is already drawn and never
        # renders - the deleted memory's frame lingers and playback jumps at it.
        catch {dict unset _drawn_key $mem_surface_mols($k)}
        unset mem_surface_mols($k)
    }
}

proc ::VMDPathFinder::_mem_show_tracks {on} {
    # Leaving spherical hides the extra memories' surfaces rather than deleting
    # them: Connolly and Tunnel draw a different kind of surface into their own
    # track, and leaving five spherical pores on screen underneath would read as
    # part of their result. Coming back shows them again - nothing is lost.
    # Only tracks this proc hid come back: one the user hid with P, or in
    # VMD Main, stays hidden across a memory switch.
    variable pore_memories
    variable pore_memory_active
    variable _mem_tracks_autohidden
    if {![info exists _mem_tracks_autohidden]} { set _mem_tracks_autohidden {} }
    if {$on} {
        foreach m $_mem_tracks_autohidden { catch {mol on $m} }
        set _mem_tracks_autohidden {}
        return
    }
    foreach id [dict keys $pore_memories] {
        if {$id eq $pore_memory_active} { continue }
        foreach m [_mem_track_ids $id] {
            if {[catch {molinfo $m get displayed} d] || !$d} continue
            catch {mol off $m}
            lappend _mem_tracks_autohidden $m
        }
    }
}

proc ::VMDPathFinder::_mem_refresh_row {} {
    # Rebuild the slot buttons: one numbered square per memory plus the "+" that
    # starts a new one. Cheap - a handful of buttons - so it just rebuilds
    # rather than tracking which slot changed.
    variable _mem_row
    variable pore_memories
    variable pore_memory_active
    variable state
    if {![_have_tk] || ![info exists _mem_row] || ![winfo exists $_mem_row]} { return }
    # Outside spherical the row has nothing it can hold. Hiding it (rather than
    # greying it) also stops the other memories' surfaces being left on screen
    # under a Connolly or Tunnel result.
    if {![_mem_enabled]} {
        catch {grid remove $_mem_row}
        _mem_show_tracks 0
        return
    }
    catch {grid $_mem_row}
    _mem_show_tracks 1
    _mem_ensure_first
    set f $_mem_row.slots
    foreach c [winfo children $f] { destroy $c }
    foreach id [lsort -integer [dict keys $pore_memories]] {
        set b $f.m$id
        set rec [dict get $pore_memories $id]
        set has [dict size [dict get $rec results]]
        button $b -text $id -width 2 -padx 1 -pady 0 \
            -command [list ::VMDPathFinder::_mem_slot_clicked $id]
        if {$id eq $pore_memory_active} {
            $b configure -relief sunken -font {Helvetica 9 bold}
        } else {
            $b configure -relief raised
        }
        # A slot the user can see is empty, or holding results that no longer
        # match the live settings, must LOOK that way - the whole point of the
        # row is telling five analyses apart at a glance.
        if {!$has} {
            catch {$b configure -fg gray45}
            add_tooltip $b "Memory $id - no analysis yet. Set the parameters and press Run."
        } else {
            set p [dict get $rec params]
            set cp [expr {[dict exists $p cpoint] && [dict get $p cpoint] ne "" ? [dict get $p cpoint] : "auto"}]
            set pm [expr {[dict exists $p pore_method] ? [dict get $p pore_method] : ""}]
            set rr [expr {[dict exists $rec run_root] ? [file tail [dict get $rec run_root]] : ""}]
            add_tooltip $b "Memory $id - $pm, [dict size [dict get $rec results]] frame(s), CPOINT $cp. Folder: $rr"
        }
        pack $b -side left -padx 1
    }
    # The "+" square: groove relief is Tk 8.5's nearest thing to the dashed
    # outline, and reads as "empty slot" next to the raised numbered ones.
    button $f.add -text "+" -width 2 -padx 1 -pady 0 -relief groove \
        -command ::VMDPathFinder::_mem_add_clicked
    pack $f.add -side left -padx {3 0}
    add_tooltip $f.add "Start another analysis of this structure, from the default parameters.\
        The analyses already held keep their results and stay on screen."
    set n [dict size $pore_memories]
    catch {$_mem_row.sync configure -state [expr {$n > 1 ? "normal" : "disabled"}]}
    catch {$_mem_row.del  configure -state [expr {$n > 1 ? "normal" : "disabled"}]}
}

proc ::VMDPathFinder::_mem_guard_busy {what} {
    # Switching or adding a slot mid-run would stash half a run's results and
    # redirect the rest of it into a different folder.
    variable state
    if {![_op_in_progress]} { return 0 }
    set state(status) "Cannot $what while an analysis is running."
    return 1
}

proc ::VMDPathFinder::_mem_slot_clicked {id} {
    variable state
    if {[_mem_guard_busy "switch memory"]} { return }
    if {![_mem_activate $id]} { return }
    _mem_refresh_row
    catch {refresh_results_list}
    catch {apply_display_change}
    # The lining belongs to the analysis, so it follows the switch.
    catch {update_pore_lining_rep}
    catch {update_pore_facing_rep}
    # P reads the track of the memory now active.
    catch {_update_surface_vis_buttons}
    set state(status) "Memory $id."
}

proc ::VMDPathFinder::_mem_max {} { return 10 }

proc ::VMDPathFinder::_mem_add_clicked {} {
    variable state
    variable pore_memories
    if {[_mem_guard_busy "add a memory"]} { return }
    if {[dict size $pore_memories] >= [_mem_max]} {
        set state(status) "At most [_mem_max] memories. Delete one to add another."
        return
    }
    set id [_mem_new]
    _mem_refresh_row
    catch {refresh_results_list}
    catch {update_pore_lining_rep}
    catch {update_pore_facing_rep}
    set state(status) "Memory $id - set the parameters and press Run. The other analyses stay on screen."
}

proc ::VMDPathFinder::_mem_delete_clicked {} {
    variable state
    variable pore_memory_active
    if {[_mem_guard_busy "delete a memory"]} { return }
    set id $pore_memory_active
    if {![_mem_delete $id]} {
        set state(status) "The last memory cannot be deleted."
        return
    }
    _mem_refresh_row
    catch {refresh_results_list}
    catch {apply_display_change}
    set state(status) "Memory $id deleted."
}

proc ::VMDPathFinder::_mem_sync_clicked {} {
    variable state
    if {[_mem_guard_busy "sync"]} { return }
    set n [_mem_sync_presentation]
    _mem_refresh_row
    set state(status) "Presentation synced to $n other [expr {$n == 1 ? {memory} : {memories}}]."
}

proc ::VMDPathFinder::_mem_sig_field {sig key} {
    # One field out of the pipe-joined run_signature string.
    set parts [split $sig "|"]
    set n [llength $parts]
    for {set i 0} {$i < $n - 1} {incr i 2} {
        if {[lindex $parts $i] eq $key} { return [lindex $parts [expr {$i+1}]] }
    }
    return ""
}

proc ::VMDPathFinder::_run_structure_mismatch {dir molid} {
    # "" when the saved run's structure matches this molecule (atom count and
    # radius of gyration of frame 0), else one sentence saying how they differ.
    set sig [_mem_run_dir_signature $dir]
    set c [_mem_sig_field $sig coords]
    if {$c eq "" || ![regexp {^(\d+):\d+:[^:]*:([0-9.]+)$} $c -> na rg]} { return "" }
    set src [_mem_sig_field $sig source]
    set nb ""; set rb ""
    catch {
        set nb [molinfo $molid get numatoms]
        set fs [atomselect $molid all frame 0]
        set rb [measure rgyr $fs]
        $fs delete
    }
    if {$nb eq "" || $rb eq ""} { return "" }
    if {$nb == $na && abs($rb - $rg) < 0.05} { return "" }
    set name ""; catch {set name [molinfo $molid get name]}
    return [format "This analysis was made on %s (%d atoms, radius of gyration %.1f A); the loaded molecule %s has %d atoms, %.1f A." \
        [expr {$src ne "" ? $src : "another structure"}] $na $rg $name $nb $rb]
}

proc ::VMDPathFinder::_mem_run_dir_signature {dir} {
    # The signature a saved run recorded for itself. Read from the first frame
    # that has one, since run_analysis stamps the same string into every frame.
    foreach fd [lsort [glob -nocomplain -directory $dir -type d "frame_*"]] {
        set sf [file join $fd vmdpathfinder_signature.dat]
        if {![file exists $sf]} { continue }
        if {[catch {open $sf r} fh]} { continue }
        set sig [string trim [read $fh]]
        close $fh
        if {$sig ne ""} { return $sig }
    }
    return ""
}

proc ::VMDPathFinder::_mem_discover_roots {root} {
    # The runs under a folder, as {id dir} pairs numbered in name order: the
    # folder itself when it holds frame_* directly, then every subfolder that
    # does (each run has its own, named structure_date-time_hash).
    set out {}
    set id 0
    if {[llength [glob -nocomplain -directory $root -type d "frame_*"]] > 0} {
        lappend out [list [incr id] $root]
    }
    foreach d [lsort [glob -nocomplain -directory $root -type d *]] {
        if {[llength [glob -nocomplain -directory $d -type d "frame_*"]] == 0} { continue }
        lappend out [list [incr id] $d]
    }
    return $out
}

proc ::VMDPathFinder::_mem_sync_shared_labels {} {
    # The *_disp fields the option menus show. Set alongside their values, or a
    # loaded run silently displays the previous run's method in the panel.
    # Set directly rather than through _set_pore_method / _set_search_engine:
    # those call clear_results_for_new_settings, which would wipe the results
    # the load just brought in.
    variable state
    array set lbl {
        pore_method   {circular Spherical connolly Connolly capsule Capsule}
        search_engine {mc {Monte Carlo} nm {Nelder-Mead}}
        conn_engine   {hole {HOLE conn} fast {Fast port}}
    }
    foreach k [array names lbl] {
        if {![info exists state($k)]} { continue }
        array set m $lbl($k)
        if {[info exists m($state($k))]} { set state(${k}_disp) $m($state($k)) }
        array unset m
    }
}

proc ::VMDPathFinder::_mem_sync_presentation {{redraw 1}} {
    # Copy the ACTIVE memory's display settings to every other memory, then
    # REDRAW them: rewriting the stored dict alone leaves every other memory on
    # screen in its old colour, and a sync that changes nothing is not a sync.
    # Run geometry is never copied - that is what makes each memory its own pore.
    variable state
    variable pore_memories
    variable pore_memory_active
    if {$pore_memory_active eq ""} { return 0 }
    _mem_stash_active
    set home $pore_memory_active
    set src [dict get [dict get $pore_memories $home] params]
    set n 0
    set touched {}
    dict for {id rec} $pore_memories {
        if {$id eq $home} { continue }
        set p [dict get $rec params]
        foreach k [_mem_display_keys] {
            if {[dict exists $src $k]} { dict set p $k [dict get $src $k] }
        }
        dict set rec params $p
        dict set pore_memories $id $rec
        lappend touched $id
        incr n
    }
    if {$redraw} {
        # Redraw each memory's CURRENT frame with the new display settings,
        # through the same lightweight swap playback uses.
        #
        # NOT _mem_activate + apply_display_change, which is what this did
        # first: _mem_apply resets last_geom_key, so apply_display_change treated
        # every switch as a geometry change and rebuilt EVERY frame's mesh for
        # EVERY memory - sph_process and sos_triangle per frame. On a real
        # trajectory that never finished, which is the "sync goes into a loop
        # and stays there" report. Sync changes colour, material and dot
        # density; only dot density is geometry, and only the shown frame needs
        # it now - the rest rebuild lazily when they are shown.
        # load_surface_for_frame pumps the event loop between render chunks, so
        # bracket the loop or a slot click lands mid-sync and the remaining
        # redraws go to the wrong memory.
        _begin_calc
        # load_surface_for_frame runs a full `update`. While this loop has
        # ANOTHER memory swapped in, a queued display apply or frame event
        # would render into that memory with the live settings and then start
        # the same loop again - the "sync keeps loading surfaces" report. The
        # same two flags the playback path honours close both doors.
        variable _frame_render_busy
        variable _display_applying
        set _lock_prev [list [expr {[info exists _frame_render_busy] ? $_frame_render_busy : 0}] \
                             [expr {[info exists _display_applying] ? $_display_applying : 0}]]
        variable _mem_swapping
        set _frame_render_busy 1
        set _display_applying 1
        set _mem_swapping 1
        set _syncerr [catch {
            variable results
            variable result_frames
            variable current_surface_mol
            set save_results $results
            set save_frames  $result_frames
            set save_mol     $current_surface_mol
            set frame $state(selected_result_frame)
            foreach id $touched {
                set rec [dict get $pore_memories $id]
                if {$frame eq "" || ![dict exists [dict get $rec results] $frame]} { continue }
                set results       [dict get $rec results]
                set result_frames [dict get $rec frames]
                set pore_memory_active $id
                dict for {k v} [dict get $rec params] {
                    if {[lsearch -exact [_mem_display_keys] $k] >= 0} { set state($k) $v }
                }
                _mem_point_surface_mol
                catch {load_surface_for_frame $frame 0}
                dict set rec results $results
                dict set pore_memories $id $rec
            }
            set results        $save_results
            set result_frames  $save_frames
            set pore_memory_active $home
            set current_surface_mol $save_mol
            foreach k [_mem_display_keys] {
                if {[dict exists $src $k]} { set state($k) [dict get $src $k] }
            }
        } _serr _sopts]
        set _mem_swapping 0
        lassign $_lock_prev _frame_render_busy _display_applying
        _end_calc
        if {$_syncerr == 1} { return -options $_sopts $_serr }
    }
    return $n
}

proc ::VMDPathFinder::activate_molecule {molid} {
    # Make `molid` the live molecule: stash the outgoing molecule's results,
    # restore this one's cached set (empty if never analyzed), re-point the
    # surface track and frame-sync, and refresh the panels. This is what lets
    # the user flip between molecules without re-importing or overwriting.
    variable active_molid
    variable results
    variable result_frames
    variable mol_results
    variable mol_result_frames
    variable current_surface_mol
    variable surface_mols
    variable state

    if {$molid eq "" || ![string is integer -strict $molid]} { return }
    if {$active_molid eq $molid} { return }

    # Memories belong to the MOLECULE, exactly as results do. Without this the
    # slot list would follow the user to a different structure and offer five
    # pores of the previous one, whose CPOINTs mean nothing here.
    variable pore_memories
    variable pore_memory_active
    variable pore_memory_next
    variable mol_memories
    if {$active_molid ne ""} {
        set mol_results($active_molid) $results
        set mol_result_frames($active_molid) $result_frames
        _mem_stash_active
        set mol_memories($active_molid) [list $pore_memories $pore_memory_active $pore_memory_next]
    }
    if {[info exists mol_results($molid)]} {
        set results $mol_results($molid)
        set result_frames $mol_result_frames($molid)
    } else {
        set results [dict create]
        set result_frames {}
    }
    if {[info exists mol_memories($molid)]} {
        lassign $mol_memories($molid) pore_memories pore_memory_active pore_memory_next
    } else {
        set pore_memories [dict create]
        set pore_memory_active ""
        set pore_memory_next 1
    }
    variable run_root
    set run_root ""
    if {$pore_memory_active ne "" && [dict exists $pore_memories $pore_memory_active run_root]} {
        set run_root [dict get $pore_memories $pore_memory_active run_root]
    }
    set active_molid $molid

    # Same resolution order as ensure_surface_mol: under spherical the track
    # belongs to the active memory, and surface_mols no longer holds it.
    variable mem_surface_mols
    set _sm ""
    set _mk "$molid|$pore_memory_active"
    if {[_mem_enabled] && $pore_memory_active ne "" && [info exists mem_surface_mols($_mk)]} {
        set _sm $mem_surface_mols($_mk)
    } elseif {[info exists surface_mols($molid)]} {
        set _sm $surface_mols($molid)
    }
    if {$_sm ne "" && ![catch {molinfo $_sm get name}]} {
        set current_surface_mol $_sm
    } else {
        set current_surface_mol -1
    }

    update_frame_trace
    refresh_results_list
    catch {_mem_refresh_row}
    if {[llength $result_frames] > 0} {
        select_result [lindex $result_frames 0]
    } else {
        set state(selected_result_frame) {}
        set state(min_radius) {}
        set state(min_coord) {}
        set state(profile_points) 0
        set state(status) "Molecule $molid has no HOLE results yet - the slider still animates the trajectory."
        catch {draw_profile_plot -1}
    }
    # Sync the transport to this molecule's trajectory so the slider/play work
    # even when the molecule has no HOLE results yet.
    update_frame_slider
}

proc ::VMDPathFinder::on_molid_changed {args} {
    # Commit handler for the Molecule field (Return / focus-out): switch the
    # live view to the chosen molecule. Bound on commit, not per keystroke.
    variable busy
    # Don't swap the live result set out from under an in-progress run or
    # bracketed read pass.
    if {[_op_in_progress]} { return }
    if {[catch {resolve_molid} molid]} { return }
    activate_molecule $molid
}

proc ::VMDPathFinder::get_view_center {molid} {
    if {![catch {molinfo $molid get center} center]} {
        set parsed [normalize_triplet_value $center]
        if {$parsed ne {}} { return $parsed }
    }
    set frame [molinfo $molid get frame]
    set sel [atomselect $molid all frame $frame]
    set center [measure center $sel weight mass]
    $sel delete
    return $center
}

proc ::VMDPathFinder::_triplet_tokens {value} {
    # Three words, split on whitespace or commas. Says nothing about whether
    # they are numbers.
    set parsed [string trim $value]
    if {$parsed eq ""} { return {} }
    # Accept comma-separated input (e.g. "1,0,0" or "1, 0, 0")
    set parsed [string map {"," " "} $parsed]
    set parsed [regsub -all {[{}]} $parsed ""]
    if {[llength $parsed] != 3} { return {} }
    return $parsed
}

proc ::VMDPathFinder::normalize_triplet_value {value} {
    # "x y z" as three real numbers, or {} for anything else - which callers
    # then treat as an atom selection.
    #
    # The numeric check is not optional. Without it a three-word selection such
    # as "name CA CB" parsed as a coordinate, and the arithmetic downstream
    # threw "syntax error in expression" - once per keystroke while the field
    # was being typed.
    set parsed [_triplet_tokens $value]
    if {$parsed eq {}} { return {} }
    foreach part $parsed {
        if {![string is double -strict $part]} { return {} }
    }
    return $parsed
}

proc ::VMDPathFinder::format_triplet {value} {
    return [format "%.4f %.4f %.4f" [lindex $value 0] [lindex $value 1] [lindex $value 2]]
}

proc ::VMDPathFinder::validate_triplet {label value} {
    # {} means "not a coordinate", and the caller resolves it as a selection.
    # Three words that are nearly numbers ("1 0 z") are a typo, not a selection,
    # so they still get the clear message here rather than an atomselect error
    # much later.
    set parts [_triplet_tokens $value]
    if {$parts eq {}} { return {} }
    foreach part $parts {
        if {![string is double -strict $part]} {
            error "$label must contain only numeric values (X Y Z)."
        }
    }
    return $parts
}

proc ::VMDPathFinder::ensure_path {label path} {
    set trimmed [string trim $path]
    if {$trimmed eq ""} {
        error "$label is not set. Open File > Settings to configure the path."
    }
    if {![file exists $trimmed]} { error "$label not found: $trimmed" }
    return [file normalize $trimmed]
}

proc ::VMDPathFinder::_is_finite {v} {
    # Tcl's [string is double -strict] accepts "NaN" and "Inf" - both are valid
    # doubles to the parser and both are meaningless as HOLE inputs. Since every
    # validated number here is written verbatim into the HOLE control file, a
    # non-finite value is not caught until HOLE produces an empty or garbage profile,
    # far from the setting that caused it. This is the finiteness test the numeric
    # checks below actually need.
    if {![string is double -strict $v]} { return 0 }
    return [expr {$v == $v && $v < Inf && $v > -Inf}]
}

proc ::VMDPathFinder::validate_inputs {} {
    variable state
    # Every numeric check is finite-AND-in-range: a bare [string is double
    # -strict] test alone would let NaN, Inf, SAMPLE<=0, dot density 0 or an
    # out-of-range SHORTO through into the control file.
    if {![_is_finite $state(sample)]}  { error "SAMPLE must be a finite number." }
    if {$state(sample) <= 0}           { error "SAMPLE must be greater than 0 (it is the step between sampled planes, in Angstroms)." }
    if {![_is_finite $state(endrad)]}  { error "ENDRAD must be a finite number." }
    if {$state(endrad) <= 0}           { error "ENDRAD must be greater than 0 (it is the radius at which HOLE decides the channel has ended)." }
    if {![string is integer -strict $state(shorto)]}      { error "SHORTO must be an integer." }
    foreach {_k _lbl} {mcstep MCSTEP mcdisp MCDISP mckt MCKT} {
        if {![info exists state($_k)]} continue
        set _v [string trim $state($_k)]
        if {$_v eq ""} continue
        if {![string is double -strict $_v] || $_v <= 0} {
            error "$_lbl must be a positive number, or blank for HOLE's default."
        }
    }
    if {$state(shorto) < 0 || $state(shorto) > 2}         { error "SHORTO must be 0, 1 or 2 (HOLE's output-verbosity levels)." }
    if {![string is integer -strict $state(dot_density)]} { error "Dot density must be an integer." }
    if {$state(dot_density) < 1 || $state(dot_density) > 100} { error "Dot density must be between 1 and 100 (sph_process's own accepted range)." }
    set _cp [validate_triplet CPOINT $state(cpoint)]
    set _cv [validate_triplet CVECT  $state(cvect)]
    foreach _c $_cp { if {![_is_finite $_c]} { error "CPOINT components must be finite numbers." } }
    foreach _c $_cv { if {![_is_finite $_c]} { error "CVECT components must be finite numbers." } }
    if {[llength $_cv] == 3} {
        lassign $_cv _vx _vy _vz
        if {abs($_vx) + abs($_vy) + abs($_vz) < 1e-12} {
            error "CVECT must not be the zero vector - it is the direction HOLE searches along."
        }
    }
    # No HOLE binary is not automatically fatal: the inlined pure-Tcl engine can
    # run the search instead. Only route there when it is actually usable, so a
    # genuinely missing install still gets ensure_path's own message.
    set state(hole_tcl_fallback) 0
    if {[string trim $state(hole_exec)] ne "" && [file exists $state(hole_exec)]} {
        set state(hole_exec) [ensure_path "HOLE executable" $state(hole_exec)]
    } elseif {[_hole_tcl_load] && [_hole_tcl_script] ne ""} {
        set state(hole_tcl_fallback) 1
    } else {
        set state(hole_exec) [ensure_path "HOLE executable" $state(hole_exec)]
    }
    set state(radius_file) [ensure_path "Radius file"     $state(radius_file)]
    # Same rule as hole_exec: a missing surface binary routes to the inlined
    # engine when it is usable, and only errors when it is not. Blanked rather
    # than left at a bad path, because every call site tests for "" to choose.
    set _fb [expr {[_hole_tcl_load] && [_hole_tcl_script] ne ""}]
    if {$state(display_mode) ne "none"} {
        if {!$_fb || [string trim $state(sph_process_exec)] ne ""} {
            set state(sph_process_exec) [ensure_path "sph_process" $state(sph_process_exec)]
        } else {
            set state(sph_process_exec) ""
        }
    }
    if {$state(display_mode) in {triangulated wireframe dots}} {
        if {!$_fb || [string trim $state(sos_triangle_exec)] ne ""} {
            set state(sos_triangle_exec) [ensure_path "sos_triangle" $state(sos_triangle_exec)]
        } else {
            set state(sos_triangle_exec) ""
        }
    }
    if {$_fb && [_surface_tcl_fallback]} { _surface_tcl_warn_once }
    # backward compat: treat legacy "dotted" as "centerline", "mesh" as "dots", "color"/"radial" as "triangulated"
    if {$state(display_mode) eq "dotted"} { set state(display_mode) centerline }
    if {$state(display_mode) eq "mesh"}   { set state(display_mode) dots }
    if {$state(display_mode) in {color radial}}  { set state(display_mode) triangulated }
    migrate_hydrophobic_mode
}

proc ::VMDPathFinder::migrate_hydrophobic_mode {} {
    # Hydrophobicity is a Color, not a Display mode. Migrate legacy
    # state/config so an old "hydrophobic" display mode becomes a triangulated
    # surface colored by hydrophobicity.
    variable state
    if {$state(display_mode) eq "hydrophobic"} {
        set state(display_mode) triangulated
        set state(surface_color) property
    }
}

proc ::VMDPathFinder::_cvect_exact_nonprotein {} {
    # Under EXACT, and only under Exact, the two endpoint selections are
    # re-resolved literally at every frame - so whatever they match is what the
    # axis follows. A non-protein pick moves with its own dynamics: measured
    # over 20 frames, a protein residue's centre moves 0.63 A per frame, a water
    # shell 1.84, and one fixed water molecule 83 A (it diffuses and wraps at
    # the periodic boundary).
    #
    # Static and Stabilize are NOT checked: a static selection is resolved once
    # into a coordinate and never re-read, so what it matched cannot drift.
    # A literal x,y,z is skipped too - under Exact it re-derives the same vector
    # every frame and is inert.
    variable state
    set out {}
    if {![info exists state(cvect_exact)] || !$state(cvect_exact)} { return {} }
    set molid ""
    if {[catch {resolve_molid} molid] || $molid eq "" || $molid < 0} { return {} }
    foreach {key label} [list cvect_def_p1 "CVECT point 1" cvect_def_p2 "CVECT point 2"] {
        if {![info exists state($key)]} { continue }
        set v [string trim $state($key)]
        if {$v eq "" || [normalize_triplet_value $v] ne {}} { continue }
        set n 0; set nnp 0; set nw 0
        if {[catch {
            set _s [atomselect $molid $v];                  set n   [$_s num]; $_s delete
            set _n [atomselect $molid "($v) and not protein"]; set nnp [$_n num]; $_n delete
            set _w [atomselect $molid "($v) and water"];    set nw  [$_w num]; $_w delete
        }]} { continue }
        if {$n == 0 || $nnp == 0} { continue }
        set what [expr {$nw == $nnp ? "water" : "not protein"}]
        lappend out [format "%s is set to Exact on a selection that is %s (%d of %d atoms%s). Exact re-resolves it every frame, so the axis follows those atoms: a protein residue's centre moves ~0.6 A per frame, a water shell ~1.8, a single water ~83 A once it diffuses and wraps. Use a protein selection, or switch this endpoint off Exact - Static resolves the selection once and cannot drift." \
            $label $what $nnp $n [expr {$nw && $nw != $nnp ? ", $nw of them water" : ""}]]
    }
    return $out
}

proc ::VMDPathFinder::collect_input_warnings {} {
    # Soft, non-blocking warnings for settings that are valid but commonly
    # produce confusing results. Returned as a list of human-readable strings.
    variable state
    set warns {}
    if {[string is double -strict $state(sample)] && $state(sample) < 0.05} {
        lappend warns "SAMPLE = $state(sample) is very small. With a sub-0.05 step HOLE's probe tends to wander into side crevices instead of tracking the pore center, giving a wonky path. A value of 0.1-0.5 A is typical."
    }
    if {[string is integer -strict $state(shorto)] && $state(shorto) >= 2} {
        lappend warns "SHORTO = $state(shorto) makes HOLE omit the radius table that the pore-profile plot is built from, so the plot will be empty. Use SHORTO 0 or 1 to keep the in-GUI plot."
    }
    # The 30,000-polygon ceiling is the STOCK sos_triangle's; the accelerated
    # build allows 200,000, so warn only when the feature probe finds a stock binary.
    if {[string is integer -strict $state(dot_density)] && $state(dot_density) > 20 &&
        $state(display_mode) in {dots triangulated wireframe} &&
        [llength [sos_triangle_features]] == 0} {
        lappend warns "Dot density = $state(dot_density) can exceed the stock sos_triangle's polygon limit, which makes the surface fail to render (the funnel disappears). Use 10-20, or point Settings at the accelerated sos_triangle, whose limit is far higher."
    }
    foreach w [_ion_fallback_ambiguity_warnings] { lappend warns $w }
    foreach w [_cvect_exact_nonprotein] { lappend warns $w }
    return $warns
}

proc ::VMDPathFinder::parse_frame_spec {molid spec} {
    set spec [string trim $spec]
    if {$spec eq "" || $spec eq "now" || $spec eq "current"} {
        return [list [molinfo $molid get frame]]
    }
    set nframes [molinfo $molid get numframes]
    if {$spec eq "all"} {
        set frames {}
        for {set f 0} {$f < $nframes} {incr f} { lappend frames $f }
        return $frames
    }
    set frames {}
    foreach token [split [string map {" " ""} $spec] ","] {
        if {$token eq ""} { continue }
        if {$token eq "now" || $token eq "current"} {
            lappend frames [molinfo $molid get frame]; continue
        }
        if {[string is integer -strict $token]} { lappend frames $token; continue }
        set pieces [split $token ":"]
        if {[llength $pieces] == 2} {
            lassign $pieces start stop
            set step [expr {$start <= $stop ? 1 : -1}]
        } elseif {[llength $pieces] == 3} {
            lassign $pieces start step stop
        } else {
            error "Unsupported frame token '$token'. Use now, all, N, N:M, or N:S:M."
        }
        foreach v [list $start $step $stop] {
            if {![string is integer -strict $v]} { error "Non-integer in token '$token'." }
        }
        if {$step == 0} { error "Zero step in '$token'." }
        if {$step > 0} {
            for {set f $start} {$f <= $stop} {incr f $step} { lappend frames $f }
        } else {
            for {set f $start} {$f >= $stop} {incr f $step} { lappend frames $f }
        }
    }
    if {[llength $frames] == 0} { error "No frames selected by '$spec'." }
    set unique {}
    foreach f $frames {
        if {$f < 0 || $f >= $nframes} { error "Frame $f out of range 0-[expr {$nframes-1}]." }
        if {[lsearch -exact $unique $f] < 0} { lappend unique $f }
    }
    return $unique
}

proc ::VMDPathFinder::get_molecule_source_dir {molid} {
    if {[catch {molinfo $molid get filename} fnames]} { return {} }
    if {[llength $fnames] == 0} { return {} }
    # VMD may return a nested list for PSF+DCD: {{/path/file.psf} {/path/file.dcd}}
    # Flatten one level and check each candidate
    foreach outer $fnames {
        foreach f $outer {
            set f [string trim $f]
            if {$f ne "" && [file exists $f]} {
                return [file dirname [file normalize $f]]
            }
        }
    }
    return {}
}

proc ::VMDPathFinder::export_initial_dir {} {
    # resolve_molid THROWS on a stale/closed molecule (by design - see its own
    # comment), which this proc's own fallback logic clearly intends to survive
    # (falls back to [pwd] when there's no usable molid) but never actually
    # caught - so any export button raised an uncaught Tcl error the moment
    # state(molid) outlived the molecule it named, instead of the graceful
    # fallback already written one line below.
    variable state
    set molid ""
    catch {set molid [resolve_molid]}
    if {$molid ne ""} {
        set d [get_molecule_source_dir $molid]
        if {$d ne "" && [file isdirectory $d]} { return $d }
    }
    return [pwd]
}

proc ::VMDPathFinder::get_temp_base {} {
    if {[info exists ::env(TMPDIR)] && $::env(TMPDIR) ne ""} {
        return [file normalize $::env(TMPDIR)]
    }
    return /tmp
}

proc ::VMDPathFinder::_scratch_base {} {
    # Base dir for the plugin's TRANSIENT scratch (ellipse-batch, AMISE workers, figure
    # export, clip, hydro3d-props, heatmap). Prefer a hidden ".vmdpathfinder_scratch" subdir UNDER
    # the results directory the user ASSIGNED (work_dir) - or the current results root - so a
    # run's files stay contained in that folder, not scattered in /tmp (user: "all files
    # generated during my runs should be in the directory I assigned, not temp"). Falls back to
    # get_temp_base only when no writable results dir is known yet. NOTE: NOT used for the HOLE
    # run's own multi-GB PDB/text scratch, which stays on /dev/shm (RAM) for speed and never
    # touches disk - moving that to a real folder would write GBs to the user's directory.
    variable state
    set root ""
    if {[info exists state(work_dir)] && [string trim $state(work_dir)] ni {"" auto}} {
        set root [file normalize [string trim $state(work_dir)]]
    } elseif {[info exists state(last_root_dir)] && $state(last_root_dir) ne ""} {
        set root $state(last_root_dir)
    }
    if {$root ne "" && [file isdirectory $root] && [file writable $root]} {
        set sd [file join $root ".vmdpathfinder_scratch"]
        if {![catch {file mkdir $sd}] && [file writable $sd]} { return $sd }
    }
    return [get_temp_base]
}

proc ::VMDPathFinder::get_molecule_basename {molid} {
    # Return a filesystem-safe short name for the loaded molecule, used to
    # suffix the output directory so different structures don't clobber each other.
    if {[catch {molinfo $molid get filename} fnames]} { return "mol$molid" }
    foreach outer $fnames {
        foreach f $outer {
            set f [string trim $f]
            if {$f ne ""} {
                set base [file rootname [file tail $f]]
                # Strip characters that cause trouble in directory names
                regsub -all {[^A-Za-z0-9_.\-]} $base "_" base
                if {$base ne ""} { return $base }
            }
        }
    }
    return "mol$molid"
}

proc ::VMDPathFinder::_output_base {molid kind} {
    # Where a run's folder goes, as {dir is_temporary}: the chosen work dir, else
    # hole_output_<structure> / tunnel_output_<structure> beside the structure
    # when results are saved, else the same under the temp dir.
    variable state
    variable temporary_roots
    set leaf [expr {$kind eq "tunnel" ? "tunnel_output" : "hole_output"}]
    set requested [string trim $state(work_dir)]
    if {$requested ne "" && $requested ne "auto"} {
        set root [file normalize $requested]
        if {$kind eq "tunnel"} { set root [file join $root "tunnels"] }
        file mkdir $root
        return [list $root 0]
    }
    set molname [get_molecule_basename $molid]
    if {$state(save_results)} {
        set src [get_molecule_source_dir $molid]
        if {$src ne "" && [file writable $src]} {
            set root [file join $src "${leaf}_${molname}"]
            file mkdir $root
            return [list [file normalize $root] 0]
        }
    }
    set root [file join [get_temp_base] "vmdpathfinder_[pid]" "${leaf}_${molname}"]
    file mkdir $root
    if {[lsearch -exact $temporary_roots $root] < 0} { lappend temporary_roots $root }
    return [list [file normalize $root] 1]
}

proc ::VMDPathFinder::_run_root_new {molid} {
    # A fresh folder for one pore run, structure_date-time_hash under the
    # output base, remembered as the active memory's run_root. Sets
    # state(run_id) to the same stamp.
    variable state
    variable run_root
    variable run_root_temp
    lassign [_output_base $molid hole] base is_temp
    set state(run_id) [_run_id $molid $state(selection)]
    set root [file join $base "[get_molecule_basename $molid]_$state(run_id)"]
    file mkdir $root
    set run_root [file normalize $root]
    set run_root_temp $is_temp
    return [list $run_root $is_temp]
}

proc ::VMDPathFinder::resolve_output_root {molid {kind hole}} {
    # The folder the current results live in, as {dir is_temporary}. Tunnel
    # output never shares a folder with the pore's. A pore run's folder is
    # made by _run_root_new when the run starts; before any run, or after a
    # load, it is the loaded folder.
    variable run_root
    variable run_root_temp
    if {$kind eq "tunnel"} { return [_output_base $molid tunnel] }
    if {$run_root ne "" && [file isdirectory $run_root]} {
        return [list $run_root [expr {[info exists run_root_temp] ? $run_root_temp : 0}]]
    }
    return [_run_root_new $molid]
}

proc ::VMDPathFinder::choose_import_dir {} {
    variable state
    set init $state(import_dir)
    if {$init eq "" || ![file exists $init]} { set init [pwd] }
    # -mustexist 1: without it, some native directory pickers return whatever folder
    # was last BROWSED INTO (to see its own contents) rather than the one actually
    # selected/confirmed - a real reported case of ending up with the PARENT of the
    # intended hole_output_* folder. Forcing -mustexist tightens that selection
    # semantics; import_results_from_folder also now falls back one level if this
    # still picks a folder with no direct frame_* children (see collect_frame_dirs).
    set chosen [tk_chooseDirectory -initialdir $init -title "Choose Results Folder" -mustexist 1]
    if {$chosen ne ""} { set state(import_dir) $chosen }
}

proc ::VMDPathFinder::collect_frame_dirs {path} {
    # Intentionally NON-RECURSIVE: only DIRECT frame_* children of the chosen folder. Recursing
    # would silently merge frame_* dirs from several hole_output_* dirs under a browsed parent,
    # loading the wrong run's data. Valid import targets:
    #   hole_output_molname/    → direct frame_* children → use them
    #   frame_00000/            → this IS a frame_* dir → return it
    #   (parent of hole_output) → no direct frame_* → empty → caller reports error
    set norm [file normalize $path]
    if {![file isdirectory $norm]} { return {} }
    if {[string match "frame_*" [file tail $norm]]} { return [list $norm] }
    return [lsort [glob -nocomplain -directory $norm -type d "frame_*"]]
}

proc ::VMDPathFinder::frame_from_dir {frame_dir fallback} {
    if {[regexp {frame_0*([0-9]+)$} [file tail $frame_dir] -> f]} { return $f }
    return $fallback
}

proc ::VMDPathFinder::_surface_offmol {sph_file molid frame} {
    # A HOLE surface is baked in the ABSOLUTE coordinates the molecule had when HOLE
    # ran. Returns 1 if the sph centerline centroid lies OUTSIDE the loaded molecule's
    # bounding box (so the surface won't overlay it - the molecule was moved/re-centered
    # since, or a different molecule is loaded), 0 if it overlays, "" if undeterminable.
    variable state
    if {![file exists $sph_file]} { return "" }
    set centers [parse_sph_centerline $sph_file]
    if {[llength $centers] < 1} { return "" }
    set sx 0.0; set sy 0.0; set sz 0.0; set n 0
    foreach c $centers { lassign $c cx cy cz
        set sx [expr {$sx+$cx}]; set sy [expr {$sy+$cy}]; set sz [expr {$sz+$cz}]; incr n }
    set sx [expr {$sx/$n}]; set sy [expr {$sy/$n}]; set sz [expr {$sz/$n}]
    set seltext [string trim $state(selection)]
    if {$seltext eq "" || $seltext eq "all"} { set seltext "protein" }
    if {[catch {
        set _s [atomselect $molid $seltext frame $frame]
        if {[$_s num] == 0} { catch {$_s delete}; error empty }
        lassign [measure minmax $_s] _mn _mx
        catch {$_s delete}
    }]} { return "" }
    lassign $_mn x0 y0 z0; lassign $_mx x1 y1 z1
    set m 5.0
    return [expr {($sx < $x0-$m || $sx > $x1+$m || $sy < $y0-$m || $sy > $y1+$m \
                || $sz < $z0-$m || $sz > $z1+$m) ? 1 : 0}]
}

proc ::VMDPathFinder::_surface_fresh {plot_path sph_file} {
    # A cached .vmd_plot surface is valid only if it is at least as new as the .sph it
    # was built from; an older one is stale (sph re-run since) and must be rebuilt.
    if {![file exists $plot_path]} { return 0 }
    if {$sph_file eq "" || ![file exists $sph_file]} { return 1 }
    return [expr {[file mtime $plot_path] >= [file mtime $sph_file]}]
}

proc ::VMDPathFinder::find_existing_asset {run_dir sph_file {molid -1} {frame 0}} {
    # Return the COLOR-INDEPENDENT base geometry for the current display mode
    # (coloring is applied at render time, so no color-specific file is needed).
    # Accepts the legacy "_hdef" filenames too, since that radius-colored mesh is
    # an identical base, so re-importing older results does not re-triangulate.
    #
    # FRESHNESS: a .vmd_plot surface is built FROM the .sph, so a valid one is newer
    # than its sph. If the sph was later overwritten (a re-run), an older surface is
    # STALE - ignore it (return empty → rebuilt from the current sph) so it never draws
    # a surface that doesn't match the current sph/profile. _surface_fresh checks this.
    variable state
    switch -- $state(display_mode) {
        centerline {
            if {[file exists $sph_file]} { return [dict create kind sph path $sph_file] }
        }
        dots {
            foreach p [list [file join $run_dir hole_dots.vmd_plot] \
                            [file join $run_dir hole_dots_hdef.vmd_plot]] {
                if {[_surface_fresh $p $sph_file]} { return [dict create kind vmd_plot path $p] }
            }
        }
        triangulated - wireframe {
            # Suffixed names only when the sideways gate is on, so a fresh ungated
            # mesh from a previous toggle can never stand in for the gated one.
            set _cs [_conn_surface_suffix]
            foreach p [list [file join $run_dir "hole_triangulated${_cs}.vmd_plot"] \
                            [file join $run_dir "hole_triangulated${_cs}_hdef.vmd_plot"]] {
                if {[_surface_fresh $p $sph_file]} { return [dict create kind vmd_plot path $p] }
            }
        }
    }
    set _cs [_conn_surface_suffix]
    foreach candidate [list \
        [file join $run_dir "hole_triangulated${_cs}.vmd_plot"] \
        [file join $run_dir "hole_triangulated${_cs}_hdef.vmd_plot"] \
        [file join $run_dir hole_dots.vmd_plot] \
        [file join $run_dir hole_dots_hdef.vmd_plot] \
        [file join $run_dir hole_color.vmd_plot]] {
        if {[_surface_fresh $candidate $sph_file]} { return [dict create kind vmd_plot path $candidate] }
    }
    # No pre-built surface file exists on disk for this display mode. Do NOT build
    # it here: return empty so the surface is created lazily - and then cached -
    # only when the frame is actually shown (load_surface_for_frame builds on
    # demand). Building eagerly for every frame is what made "load computed data"
    # run sph_process + sos_triangle on every frame, i.e. feel like a full HOLE
    # recompute. The first shown frame still builds once; the rest stay deferred.
    return {}
}

proc ::VMDPathFinder::import_memories_from_folder {{root ""}} {
    # Load EVERY memory saved under one run root in a single action, each into
    # its own slot, and refuse the load outright when they were not computed the
    # same way. Delegates each folder to the ordinary single-folder import, so
    # there is one loader and no second code path to drift.
    #
    # The coherence check runs BEFORE anything is loaded. A partial load would
    # leave the panel holding some memories from this root and some from
    # whatever was there before, which is worse than not loading at all.
    variable state
    variable pore_memories
    variable pore_memory_active
    variable pore_memory_next
    variable run_root
    if {$root eq ""} { set root [string trim $state(import_dir)] }
    if {$root eq "" || ![file isdirectory $root]} {
        set state(status) "Load: folder not found."
        return 0
    }
    set pairs [_mem_discover_roots $root]
    if {[llength $pairs] == 0} {
        set state(status) "Load: no results found under $root."
        return 0
    }
    # Start from an empty slot list: these memories replace whatever was held,
    # rather than being appended to an unrelated set.
    foreach id [dict keys $pore_memories] { _mem_forget_tracks $id }
    set pore_memories [dict create]
    set pore_memory_active ""
    set pore_memory_next 1
    set loaded 0
    foreach pr $pairs {
        lassign $pr id dir
        if {$id > [_mem_max]} {
            set state(status) "Load: at most [_mem_max] memories; the rest of $root was not loaded."
            break
        }
        set pore_memory_active $id
        if {$pore_memory_next <= $id} { set pore_memory_next [expr {$id+1}] }
        set state(import_dir) $dir
        set run_root $dir
        if {[catch {import_results_from_folder} err]} {
            set state(status) "Load: memory $id failed: $err"
            continue
        }
        _mem_sync_shared_labels
        dict set pore_memories $id [_mem_capture]
        incr loaded
    }
    set state(import_dir) $root
    if {$loaded == 0} {
        set state(status) "Load: nothing could be loaded from $root."
        return 0
    }
    set pore_memory_active [lindex [lsort -integer [dict keys $pore_memories]] 0]
    _mem_apply [dict get $pore_memories $pore_memory_active]
    _mem_refresh_row
    set state(status) "Loaded $loaded [expr {$loaded == 1 ? {memory} : {memories}}] from $root."
    return $loaded
}

proc ::VMDPathFinder::import_results_from_folder {{dialog {}}} {
    variable state
    if {[_op_in_progress]} {
        set state(status) "Another operation is already in progress."
        return
    }
    variable results
    variable result_frames

    set import_dir [string trim $state(import_dir)]
    # Headless policy, matching run_analysis's validate_inputs branch: a batch caller
    # gets a catchable Tcl error rather than tk_messageBox, which does not exist under
    # `vmd -dispdev text` and would itself raise "invalid command name".
    if {$import_dir eq ""} {
        if {![_have_tk]} { error "VMDPathFinder import: no folder set (state(import_dir) is empty)." }
        tk_messageBox -icon error -type ok -title "HOLE" -message "Choose a folder first."
        return
    }
    if {![file isdirectory $import_dir]} {
        if {![_have_tk]} { error "VMDPathFinder import: folder not found: $import_dir" }
        tk_messageBox -icon error -type ok -title "HOLE" -message "Folder not found: $import_dir"
        return
    }

    if {[catch {
        set frame_dirs [collect_frame_dirs $import_dir]
        if {[llength $frame_dirs] == 0} {
            # Fallback: some native directory pickers return the PARENT of the folder
            # the user actually browsed into (a real reported case) - if exactly ONE
            # immediate subdirectory of what was chosen has its own frame_* children,
            # use that instead of failing outright. Still deliberately non-recursive
            # beyond this one extra level, and still refuses if it's ambiguous (0 or
            # 2+ candidates), so this can't silently mix runs the way full recursion
            # would (see collect_frame_dirs's own comment).
            set _candidates {}
            foreach _sub [glob -nocomplain -directory $import_dir -type d *] {
                if {[llength [collect_frame_dirs $_sub]] > 0} { lappend _candidates $_sub }
            }
            if {[llength $_candidates] == 1} {
                set import_dir [lindex $_candidates 0]
                set state(import_dir) $import_dir
                set frame_dirs [collect_frame_dirs $import_dir]
                set state(status) "Import: no results directly under the chosen folder - using its subfolder instead: $import_dir"
            }
        }
        if {[llength $frame_dirs] == 0} { error "No frame_* folders found under $import_dir" }

        # The display molecule is only used to position 3-D surfaces. Accept
        # "top" (or blank) or an explicit molecule id; anything invalid falls
        # back to top.
        set imp_mid [string trim $state(import_molid)]
        if {$imp_mid eq "" || $imp_mid eq "top"} {
            set imp_mid [molinfo top]
        } elseif {[catch {molinfo $imp_mid get name}]} {
            set imp_mid [molinfo top]
        }
        set _why [_run_structure_mismatch $import_dir $imp_mid]
        if {$_why ne ""} {
            if {[_have_tk]} {
                if {[tk_messageBox -icon warning -type yesno -title "Load Saved Analysis" \
                        -message "$_why\n\nLoad it onto this molecule anyway?"] ne "yes"} {
                    error "Load cancelled: $_why"
                }
            } else {
                vmdcon -warn "VMDPathFinder: $_why"
            }
        }

        set imported [dict create]
        set imp_frames {}
        set fb 0
        set imp_run_id [incr ::VMDPathFinder::run_counter]
        # Pass 1: map frame -> dir for every folder that has a profile (raw txt or
        # parsed TSV). Cheap - just file-existence + name parsing.
        set fd_map [dict create]
        foreach fd [lsort $frame_dirs] {
            set frame [frame_from_dir $fd $fb]; incr fb
            set out_file [file join $fd hole_out.txt]
            set tsv_file [file join $fd hole_profile.tsv]
            if {![file exists $out_file] && ![file exists $tsv_file]} { continue }
            dict set fd_map $frame $fd
        }
        # Parse profiles SUMMARY-ONLY (full=0): min_radius/points for the frame
        # list, WITHOUT the per-frame xvalues/yvalues lists. Building, marshaling and
        # storing ~1000 points x N frames was the bulk of a large import's cost; the
        # full profile is loaded lazily (ensure_profile_full) when a frame is plotted
        # or the heatmap is built. Parsed in parallel across cores.
        set state(status) "Loading computed data: parsing [dict size $fd_map] profiles..."
        update idletasks
        set parsed [parse_profiles_batch [dict keys $fd_map] $fd_map 0]
        # Pass 2: assemble the results dict. Cheap: the profile is already parsed and
        # find_existing_asset only looks for existing surface files (never rebuilds).
        dict for {frame fd} $fd_map {
            if {![dict exists $parsed $frame]} continue
            set out_file [file join $fd hole_out.txt]
            set sph_file [file join $fd hole_out.sph]
            set tsv_file [file join $fd hole_profile.tsv]
            set asset [find_existing_asset $fd $sph_file $imp_mid $frame]
            # Timestamp from whichever artifact exists (txt is usually deleted).
            set calc_time [expr {[file exists $out_file] ? [file mtime $out_file] : \
                                 ([file exists $tsv_file] ? [file mtime $tsv_file] : [clock seconds])}]
            dict set imported $frame [dict create \
                frame $frame run_dir $fd output_file $out_file \
                sph_file $sph_file asset $asset temporary 0 \
                draw_molid $imp_mid profile [dict get $parsed $frame] \
                run_id $imp_run_id calc_time $calc_time]
            lappend imp_frames $frame
        }
        if {[llength $imp_frames] == 0} { error "No readable HOLE outputs under $import_dir" }

        # Scope the import to its display molecule so it does not overwrite a
        # different molecule's live results.
        activate_molecule $imp_mid
        # Drop any STALE surface left in VMD from a previous run/import on this molecule
        # (a different selection or older coordinates) - otherwise it keeps floating in
        # the view detached from the new data. Also clear the in-memory parsed-surface
        # cache so a reused file path can't replay an old mesh. refresh_results_list
        # (below) bumps plot_data_version + clears the binning cache.
        catch {clear_surface}
        variable plot_cache
        variable plot_cache_order
        variable _surface_mismatch_warned
        cache_clear plot
        set _surface_mismatch_warned 0
        set results      $imported
        set result_frames [lsort -integer -unique $imp_frames]
        set state(last_root_dir) [file normalize $import_dir]
        # Reload a previously-computed hydration profile if one was saved here, so the
        # Hydration tab shows it without re-running Compute (needs no trajectory).
        variable hydration_data
        set hydration_data {}
        catch {
            set _hf [file join $import_dir vmdpathfinder_hydration.dat]
            if {[file exists $_hf]} {
                set _fh [open $_hf r]; set _hd [read $_fh]; close $_fh
                if {[catch {dict size $_hd}] == 0 && [dict exists $_hd coords]} {
                    set hydration_data $_hd
                }
            }
        }
        # Reload any previously-computed Trends series (G-ellipse/Ellipse
        # Volume/etc.) saved here - each entry's own _hole_run_sig-based
        # signature (see _trend_series) is checked before it is trusted, so a reload
        # under different settings/re-run parameters just falls through to a fresh
        # per-metric recompute instead of serving stale data.
        cache_clear trend_cache
        catch {
            set _tf [file join $import_dir vmdpathfinder_trends.dat]
            if {[file exists $_tf]} {
                set _fh2 [open $_tf r]; set _td [read $_fh2]; close $_fh2
                if {[catch {dict size $_td}] == 0} { set trend_cache $_td }
            }
        }
        catch {refresh_property_scheme_menus}
        refresh_results_list
        update_frame_trace
        select_result [lindex $result_frames 0]
        # Show the surface immediately (same as a fresh run does after select_result).
        if {$state(display_mode) ne "none" && [llength $result_frames] > 0} {
            if {[catch {load_surface_for_frame [lindex $result_frames 0]} _sf_err]} {
                vmdcon -warn "VMDPathFinder: imported surface not available: $_sf_err"
            } else {
                catch {apply_material_now}
            }
        }
        # Property coloring: an import is USUALLY a fully-built prior run, so
        # base geometry already exists for every frame - proactively recolor
        # them too (see run_hole's matching call / property-recolor-prebuild-gap),
        # otherwise every frame stays uncached until its first visit, which is
        # exactly the per-frame "hot second to settle" delay on a large import.
        if {$state(surface_color) eq "property" && [llength $result_frames] > 1 && \
                $state(display_mode) ni {none centerline}} {
            catch {prebuild_surfaces_parallel}
        }
        set _hnote [expr {$hydration_data ne "" ? " (hydration profile reloaded)" : ""}]
        # Show run provenance from the manifest so the user can confirm they loaded
        # the right data (correct selection, correct source files).
        set _manifest_note ""
        catch {
            set _mf [file join $import_dir vmdpathfinder_manifest.dat]
            if {[file exists $_mf]} {
                set _fh [open $_mf r]
                set _ml [read $_fh]; close $_fh
                set _sel ""; set _ts ""; set _pm ""
                foreach _line [split $_ml "\n"] {
                    if {[regexp {^selection\s*=\s*(.+)$} $_line -> _v]} { set _sel [string trim $_v] }
                    if {[regexp {^timestamp\s*=\s*(.+)$} $_line -> _v]} { set _ts  [string trim $_v] }
                    if {[regexp {^pore_method\s*=\s*(.+)$} $_line -> _v]} { set _pm  [string trim $_v] }
                }
                # RESTORE THE PORE METHOD. state(pore_method) is not persisted
                # to ~/.vmdpathfinder_config, so a fresh VMD starts at "circular" and
                # an imported CONNOLLY run was then read as spherical by every
                # `_run_uses_card conn` gate: Ion Flow took the probe-radius
                # column instead of Requiv and applied a 3 A shell that is meant
                # to be 0 under CONNOLLY, the lateral-opening views went blank,
                # and the only apparent escape - setting the picker to Connolly -
                # calls _set_pore_method, which CLEARS the results you just
                # imported. Set the state directly (NOT via _set_pore_method) so
                # the import survives, then re-gate the method-dependent UI.
                if {$_pm ne "" && $_pm ne $state(pore_method)} {
                    set state(pore_method) $_pm
                    switch -- $_pm {
                        connolly { set state(pore_method_disp) "Connolly" }
                        capsule  { set state(pore_method_disp) "Capsule" }
                        default  { set state(pore_method_disp) "Spherical" }
                    }
                    catch {_update_method_dependent_controls}
                    catch {refresh_property_scheme_menus}
                }
                # RESTORE THE SELECTION, for exactly the pore_method reason
                # above: the run's own selection is authoritative for reading
                # its results, and everything downstream that interprets them
                # against atoms reads state(selection) - bottleneck-residue
                # labels, the lining/facing views, property averaging. This
                # block already PARSED the selection (for the status line) and
                # then dropped it: importing a "protein or glycan" run into a
                # fresh session left state(selection) at "protein", so a
                # bottleneck formed by the glycan crown resolved ZERO lining
                # residues - measured on a real glycosylated Nav run, frame 44:
                # 35 glycan vs 3 protein atoms within 7 A of the bottleneck,
                # labels {} with the stale selection, 2 residues with the
                # run's own. The status line was announcing a selection the
                # session was not actually using.
                if {$_sel ne "" && $_sel ne $state(selection)} {
                    vmdcon -info "VMDPathFinder: import set the analysis selection to this run's own: \"$_sel\" (was \"$state(selection)\")"
                    set state(selection) $_sel
                }
                if {$_sel ne "" || $_ts ne ""} {
                    set _manifest_note " - sel: '$_sel' / $_ts"
                    if {$_pm ne ""} { append _manifest_note " / $state(pore_method_disp)" }
                }
            }
        }
        set state(status) "Imported [llength $result_frames] frame result(s).$_hnote$_manifest_note"
        vmdcon -info "VMDPathFinder: imported [llength $result_frames] frame(s) from $import_dir$_manifest_note"
        if {$dialog ne "" && [winfo exists $dialog]} { destroy $dialog }
    } message]} {
        set state(status) $message
        # Headless: re-raise so a batch caller can catch it. Reporting through
        # tk_messageBox here meant the HANDLER itself died with "invalid command
        # name", replacing the real import error with a useless one and hiding
        # whatever actually went wrong. Carry the ORIGINAL -errorinfo through:
        # a bare `error $message` resets the stack trace to this line, which
        # throws away the only thing that says where the import really failed.
        if {![_have_tk]} { return -code error -errorinfo $::errorInfo $message }
        tk_messageBox -icon error -type ok -title "HOLE" -message $message
    }
}

proc ::VMDPathFinder::collect_tunnel_frame_dirs {path} {
    # Tunnel-mode analogue of collect_frame_dirs - intentionally non-recursive
    # for the same reason (see that proc's own comment). The glob is
    # deliberately "tunnel_?????" (exactly 5 digits), not a bare "tunnel_*":
    # the OUTPUT ROOT itself is also named tunnel_output_<mol>
    # (resolve_output_root's leaf) and a loose match would treat that root
    # folder as if it were one frame.
    set norm [file normalize $path]
    if {![file isdirectory $norm]} { return {} }
    if {[regexp {^tunnel_[0-9][0-9][0-9][0-9][0-9]$} [file tail $norm]]} { return [list $norm] }
    return [lsort [glob -nocomplain -directory $norm -type d "tunnel_?????"]]
}

proc ::VMDPathFinder::tunnel_frame_from_dir {frame_dir fallback} {
    if {[regexp {tunnel_0*([0-9]+)$} [file tail $frame_dir] -> f]} { return $f }
    return $fallback
}

proc ::VMDPathFinder::_hole_import_has_data {path} {
    # Mirrors ONLY the existence-check half of import_results_from_folder's
    # own probe (direct frame_* children, or exactly one immediate subfolder
    # that has them) - used to decide whether it is worth calling at all, so
    # choosing a tunnel-only folder never pops HOLE's own "no frame_*
    # folders found" messageBox. The real import logic stays untouched and
    # lives only in import_results_from_folder; if that proc's own fallback
    # rule ever changes, update this alongside it.
    if {[llength [collect_frame_dirs $path]] > 0} { return 1 }
    set n 0
    foreach sub [glob -nocomplain -directory $path -type d *] {
        if {[llength [collect_frame_dirs $sub]] > 0} { incr n }
    }
    return [expr {$n == 1}]
}

proc ::VMDPathFinder::_find_tunnel_import_root {chosen} {
    # The two plain layouts resolve_output_root actually produces, per its
    # own guarantee that tunnel output never shares a folder with HOLE's:
    #   1. $chosen itself has tunnel_NNNNN children - the user picked the
    #      tunnel root (or a work_dir/tunnels) directly.
    #   2. $chosen/tunnels has them - an explicit work_dir nests tunnel
    #      output under it and the user picked work_dir itself.
    #   3. A sibling tunnel_output_* of $chosen has them - the "auto" work_dir
    #      case, where hole_output_<mol> and tunnel_output_<mol> are siblings
    #      and the user picked the HOLE one.
    # Deliberately not a general search - see the advisor guidance this was
    # scoped from.
    if {[llength [collect_tunnel_frame_dirs $chosen]] > 0} { return $chosen }
    set nested [file join $chosen tunnels]
    if {[llength [collect_tunnel_frame_dirs $nested]] > 0} { return $nested }
    foreach sib [glob -nocomplain -directory [file dirname $chosen] -type d "tunnel_output_*"] {
        if {[llength [collect_tunnel_frame_dirs $sib]] > 0} { return $sib }
    }
    return ""
}

proc ::VMDPathFinder::_read_tunnel_manifest {root} {
    # Plain key=value text (_write_tunnel_manifest) - one dict entry per line.
    set out [dict create]
    set f [file join $root "vmdpathfinder_tunnel_manifest.txt"]
    if {![file exists $f] || [catch {open $f r} fh]} { return $out }
    set txt [read $fh]; close $fh
    foreach line [split $txt "\n"] {
        if {[regexp {^([a-zA-Z_]+)\s*=\s*(.*)$} $line -> k v]} {
            dict set out $k [string trim $v]
        }
    }
    return $out
}

proc ::VMDPathFinder::import_tunnel_results_from_folder {root} {
    # Tunnel-mode analogue of import_results_from_folder. Reconstructs
    # tunnel_results/tunnel_lining from EACH FRAME's out.dat ONLY - never
    # from .sph, whose centreline is trimmed by tunnel_render_maxr
    # (_tunnel_render_centers) for DISPLAY, while out.dat's own pts are the
    # untrimmed analysis series everything else (profile/trends/lining) is
    # built from. Substituting trimmed .sph geometry here would silently
    # shorten every imported tunnel and shift its bottleneck - so a frame
    # whose out.dat is missing is SKIPPED and named in the status message,
    # not backfilled from whatever asset happens to still be on disk.
    variable state
    variable tunnel_results
    variable tunnel_lining
    variable tunnel_result_frames
    variable tunnel_root
    variable tunnel_shown
    variable tunnel_shown_cid
    variable tunnel_clusters
    variable tunnel_xclusters
    variable tunnel_gear_color
    variable tunnel_gear_material
    variable tunnel_gear_wire
    variable tunnel_gear_prop
    variable tunnel_gear_colormode
    variable tunnel_gear_cid

    set root [file normalize $root]
    set frame_dirs [collect_tunnel_frame_dirs $root]
    if {[llength $frame_dirs] == 0} {
        set msg "No tunnel_NNNNN folders found under $root"
        if {![_have_tk]} { error $msg }
        tk_messageBox -icon error -type ok -title "Tunnel" -message $msg
        return
    }

    array unset tunnel_results;      array set tunnel_results {}
    array unset tunnel_lining;       array set tunnel_lining {}
    array unset tunnel_shown;        array set tunnel_shown {}
    array unset tunnel_clusters;     array set tunnel_clusters {}
    array unset tunnel_gear_color;   array set tunnel_gear_color {}
    array unset tunnel_gear_material; array set tunnel_gear_material {}
    array unset tunnel_gear_wire;    array set tunnel_gear_wire {}
    array unset tunnel_gear_prop;    array set tunnel_gear_prop {}
    array unset tunnel_gear_colormode; array set tunnel_gear_colormode {}
    # Cluster-keyed mirrors, same reason run_tunnel_analysis clears them: cids
    # are renumbered from scratch by this import (sequential, same as rank -
    # _tunnel_cluster_rows), so a stale entry from the previous result set
    # would silently reattach to whatever route the import now numbers with
    # that cid, instead of the tunnel it was actually set on.
    array unset tunnel_shown_cid;    array set tunnel_shown_cid {}
    array unset tunnel_gear_cid;     array set tunnel_gear_cid {}
    # Same as run_tunnel_analysis's reset: the averaged tube's build key
    # matches across result sets whenever cid 1 is re-pinned, and an open
    # per-route gear popup names a rank from the previous set.
    variable _tunnel_mean_built_cid
    unset -nocomplain _tunnel_mean_built_cid
    variable tunnel_mean_surface_mol
    if {$tunnel_mean_surface_mol >= 0} { catch {mol delete $tunnel_mean_surface_mol} }
    set tunnel_mean_surface_mol -1
    variable _gear_open_cid
    unset -nocomplain _gear_open_cid
    variable w
    catch {destroy $w.tunnel_gear}
    # Same rationale as run_tunnel_analysis: a remembered selected-cluster or a
    # curated show/hide default from the previous result set is meaningless
    # once the clusters themselves are rebuilt, and (tunnel_shown_default in
    # particular) would otherwise hide every imported route the moment
    # tunnel_shown_cid above is cleared - _tunnel_sync_shown_from_cluster falls
    # through to it for every cid with no recorded state.
    set state(tunnel_selected_cid) ""
    set state(tunnel_shown_default) 1
    set state(tunnel_shown_all) 1
    set tunnel_xclusters {}
    set tunnel_result_frames {}
    set tunnel_root $root

    set fb 0
    set skipped {}
    # Measured at 12.7 s for 100 frames on the Nav run, with nothing on screen
    # until the final "Imported N frames" line - which reads as the NEXT thing
    # the user clicks being slow. Abort on screen and a running count, on the
    # same 25-frame threshold collect_binned_radii uses.
    set _nfd [llength $frame_dirs]
    set _iprog [expr {$_nfd >= 25}]
    _begin_calc
    set _icode [catch {
    foreach fd [lsort $frame_dirs] {
        set frame [tunnel_frame_from_dir $fd $fb]; incr fb
        if {$_iprog && ($fb % 10 == 1)} {
            set state(status) "Importing tunnel results: frame $fb of $_nfd..."
            # Full update, not idletasks: idletasks delivers no button events,
            # so the Abort click this progress loop exists to honour sat in
            # the queue for the whole pass. Re-entry is covered by the
            # _op_in_progress guards (this loop runs inside _begin_calc).
            catch {update}
            if {[_abort_requested]} { break }
        }
        set of [file join $fd out.dat]
        if {![file exists $of]} { lappend skipped $frame; continue }
        if {[catch {open $of r} oh]} { lappend skipped $frame; continue }
        set txt [read $oh]; close $oh
        set tun [_tunnel_parse_text $txt]
        if {[llength $tun] == 0} { continue }
        set tunnel_results($frame) $tun
        lappend tunnel_result_frames $frame
        set lin [_tunnel_parse_lining $txt]
        if {[dict size $lin]} { set tunnel_lining($frame) $lin }
    }
    } _ierr]
    # _end_calc on EVERY path, error included - a leaked depth leaves the abort
    # flag raised for the rest of the session and poisons unrelated work.
    _end_calc
    if {$_icode} { return -code error $_ierr }
    set tunnel_result_frames [lsort -integer -unique $tunnel_result_frames]
    if {[llength $tunnel_result_frames] == 0} {
        set msg "No readable out.dat under $root ([llength $skipped] folder(s) had none)"
        if {![_have_tk]} { error $msg }
        tk_messageBox -icon error -type ok -title "Tunnel" -message $msg
        return
    }

    # Manifest values are used LOCALLY, for this reconstruction only - never
    # written into state(mole_*)/state(tunnel_*): the user's live panel
    # settings must survive an import unchanged (see feedback memory on
    # unprompted default changes). Falls back to the plugin's own shipped
    # defaults (matching sync_top_defaults) when the manifest is absent or a
    # field didn't parse.
    set man [_read_tunnel_manifest $root]
    set m_sel   [expr {[dict exists $man selection] ? [dict get $man selection] : ""}]
    set m_ts    [expr {[dict exists $man written] ? [dict get $man written] : ""}]
    set m_con   [expr {[dict exists $man cluster_on] && [dict get $man cluster_on] ne "" \
        ? [dict get $man cluster_on] : 1}]
    set m_th    [expr {[dict exists $man cluster_threshold] \
        && [string is double -strict [dict get $man cluster_threshold]] \
        ? [dict get $man cluster_threshold] : 3.0}]
    set m_cap   [expr {[dict exists $man xframe_max_ranks] \
        && [string is integer -strict [dict get $man xframe_max_ranks]] \
        ? [dict get $man xframe_max_ranks] : 10}]
    # Same split as run_tunnel_analysis: m_con (the manifest's historical
    # display-grouping choice) only gates the per-frame representative-
    # picking below. Cross-frame identity (_tunnel_xframe_build) is what
    # Trends/Over Time/Mean Profile/Histogram actually depend on and must be
    # rebuilt whenever there is more than one frame, regardless of m_con -
    # gating it on the display flag was the same bug this session fixed in
    # the live run path.
    if {$m_con} {
        # As in run_tunnel_analysis: built per frame on demand, not for all of
        # them up front. This loop alone dominated a 10 000-frame import.
        variable _tunnel_clusters_th
        set _tunnel_clusters_th $m_th
    }
    if {[llength $tunnel_result_frames] > 0} {
        # UNCONDITIONAL, even for a single imported frame - see run_tunnel_
        # analysis's own comment; the list has no rows at all without it.
        # _tunnel_xframe_build has no parameters of its own - it reads
        # state(tunnel_cluster)/state(tunnel_xframe_max) directly. Save and
        # restore around the call so the manifest's historical settings are
        # used for THIS reconstruction without leaving any trace in the
        # user's live settings afterward.
        set _sv_th  [expr {[info exists state(tunnel_cluster)] ? $state(tunnel_cluster) : ""}]
        set _sv_cap [expr {[info exists state(tunnel_xframe_max)] ? $state(tunnel_xframe_max) : ""}]
        set state(tunnel_cluster) $m_th
        set state(tunnel_xframe_max) $m_cap
        catch {_tunnel_xframe_build}
        if {$_sv_th eq ""} { unset -nocomplain state(tunnel_cluster) } else { set state(tunnel_cluster) $_sv_th }
        if {$_sv_cap eq ""} { unset -nocomplain state(tunnel_xframe_max) } else { set state(tunnel_xframe_max) $_sv_cap }
    }

    # Rebuild each tunnel's .sph so the existing .sph -> sph_process ->
    # sos_triangle -> render pipeline has something to draw - this file is a
    # pure geometry cache derived from out.dat's own pts, not a second source
    # of truth, so regenerating it here is idempotent.
    foreach fr $tunnel_result_frames {
        set fd [file join $root [format "tunnel_%05d" $fr]]
        set i 0
        foreach t $tunnel_results($fr) {
            incr i
            set centers [_tunnel_render_centers [lindex $t 4]]
            write_stock_sph_file $centers [file join $fd [format "tunnel_%02d.sph" $i]]
        }
    }

    activate_molecule [molinfo top]
    update_frame_trace
    set cur [molinfo top get frame]
    if {[lsearch -exact $tunnel_result_frames $cur] < 0} {
        set cur [lindex $tunnel_result_frames 0]
    }
    catch {render_tunnels_for_frame $cur}

    variable plot_data_version
    variable binned_cache
    incr plot_data_version
    set binned_cache [dict create]
    catch {_sync_mode_tabs}
    catch {refresh_tunnel_tab}
    catch {_on_tunnel_selection_changed}
    catch {_sync_exportbars_for_data}
    # activate_molecule (already run to get here - see the molecule load this
    # import follows) calls refresh_results_list itself and wipes the bottom
    # frame list to HOLE's (empty, pre-run) result_frames; repopulate it now
    # that tunnel_result_frames actually has this import's data.
    catch {refresh_results_list}

    set ntot 0
    foreach fr $tunnel_result_frames { incr ntot [llength $tunnel_results($fr)] }
    set _skip_note [expr {[llength $skipped] > 0 \
        ? "  ⚠ [llength $skipped] folder(s) had no out.dat and were skipped: [join [lrange $skipped 0 9] {, }][expr {[llength $skipped] > 10 ? {, ...} : {}}]." \
        : ""}]
    set _man_note [expr {$m_sel ne "" || $m_ts ne "" ? " - sel: '$m_sel' / $m_ts" : ""}]
    set state(status) "Imported [llength $tunnel_result_frames] tunnel frame(s), $ntot tunnel(s) total.$_man_note$_skip_note"
    vmdcon -info "VMDPathFinder tunnel: imported [llength $tunnel_result_frames] frame(s) from $root$_man_note"
}

proc ::VMDPathFinder::import_all_results_from_folder {{dialog {}}} {
    # Entry point for the "Load Folder" button: loads whichever of HOLE and
    # tunnel results exist under state(import_dir), so one folder selection
    # covers a run that saved both (resolve_output_root's own directory
    # separation guarantees they are never mixed in the same folder, but a
    # single parent - an explicit work_dir, or the common source directory -
    # can hold both as sibling/nested trees).
    variable state
    if {[_op_in_progress]} {
        set state(status) "Another operation is already in progress."
        return
    }
    set chosen [string trim $state(import_dir)]
    if {$chosen eq "" || ![file isdirectory $chosen]} {
        # Let import_results_from_folder's own validation produce the
        # familiar "choose a folder" / "folder not found" message.
        import_results_from_folder $dialog
        return
    }
    set chosen [file normalize $chosen]
    set have_hole [_hole_import_has_data $chosen]
    set tun_root [_find_tunnel_import_root $chosen]

    if {!$have_hole && $tun_root eq ""} {
        # Neither side found anything - let HOLE's own import produce its
        # normal, familiar error rather than inventing a second message.
        import_results_from_folder $dialog
        return
    }

    set _tnote ""
    if {$tun_root ne ""} {
        if {[catch {import_tunnel_results_from_folder $tun_root} _terr]} {
            set _tnote "  Tunnel: $_terr"
        } else {
            set _tnote "  Tunnel: [llength $::VMDPathFinder::tunnel_result_frames] frame(s) from $tun_root."
        }
    }
    if {$have_hole} {
        # A root holding several memories (mem_2, mem_3, ... beside the frame_*
        # of memory 1) loads all of them in this ONE action, so the picture the
        # user saved comes back whole rather than one pore at a time. The
        # multi-memory loader refuses a set whose runs disagree on sampling,
        # pore method or search engine, since those cannot be compared. A root
        # with only memory 1 in it is the ordinary case and takes the plain
        # path, unchanged.
        set _mpairs [_mem_discover_roots $chosen]
        set _mneeded [expr {[llength $_mpairs] > 1}]
        # A root holding ONLY mem_2 (memory 1 was never run) still has to go
        # through the memory loader: the plain import would find those frames
        # via its one-level fallback and drop them into whichever slot happens
        # to be active, so memory 2's analysis would come back as memory 1.
        foreach _mp $_mpairs { if {[lindex $_mp 0] != 1} { set _mneeded 1 } }
        if {$_mneeded} {
            import_memories_from_folder $chosen
            if {$dialog ne "" && [winfo exists $dialog]} { destroy $dialog }
        } else {
            # Owns dialog-closing and its own status/error messaging exactly as
            # the plain HOLE-only import always has.
            import_results_from_folder $dialog
        }
        if {$_tnote ne ""} { append state(status) $_tnote }
    } else {
        if {$_tnote ne ""} { set state(status) [string trimleft $_tnote] }
        if {$dialog ne "" && [winfo exists $dialog]} { destroy $dialog }
    }
}

proc ::VMDPathFinder::_ion_flow_forget {} {
    # Drop the Ion & Water result: it was measured against one run's pore
    # (axis from its reference frame, walls from its analysed frames), so a
    # new run, an import or a reset must not leave it on screen. The stash
    # that carries the result across a Pore/Tunnel mode switch is dropped for
    # the current mode too. The tab then shows its "Compute" placeholder.
    variable ion_flow_raw
    variable ion_flow_cache
    variable _mode_stash
    set ion_flow_raw ""; set ion_flow_cache ""
    if {[info exists _mode_stash]} { catch {dict unset _mode_stash [analysis_mode]} }
    catch {
        variable w
        if {[_have_tk] && [winfo exists $w.plotframe.nb] \
                && [string match "*.ionflow" [$w.plotframe.nb select]]} { draw_ion_flow_tab }
    }
}

proc ::VMDPathFinder::clear_results_for_new_settings {} {
    # Drop every computed result, surface and derived cache, WITHOUT the
    # confirmation dialog or the UI chatter reset_session adds. Called by
    # run_analysis when the run signature has changed, so a result set can never be
    # a mixture of two different settings (see the note at that call site).
    # reset_session delegates here so the list of things to clear lives in ONE place.
    variable results
    variable result_frames
    variable mol_results
    variable mol_result_frames
    variable hydration_data
    variable _hm_computed_scheme
    variable plot_data_version
    variable state
    catch {clear_surface}
    _ion_flow_forget
    set results [dict create]
    set result_frames {}
    catch {array unset mol_results};       array set mol_results {}
    catch {array unset mol_result_frames}; array set mol_result_frames {}
    set hydration_data {}
    cache_clear run
    set _hm_computed_scheme ""
    incr plot_data_version
    set state(selected_result_frame) {}
    catch {refresh_property_scheme_menus}
}

proc ::VMDPathFinder::reset_session {} {
    # User-facing safety valve: clear ALL loaded/computed HOLE results, surfaces and
    # caches and return the analysis tabs to empty, WITHOUT touching the user's settings
    # (exec paths, selection text, display prefs). For recovering from a bad import or a
    # wedged state ("I need to reset to be able to use it").
    # Refused mid-run: the pool pumps the full event loop, so this dialog was
    # deliverable while frames were still landing - a confirmed Reset wiped
    # results and caches out from under the run, which then reported frames
    # added that no longer exist.
    if {[_op_in_progress]} {
        variable state
        set state(status) "Another operation is already in progress - Abort it first, then Reset."
        return
    }
    variable results
    variable result_frames
    variable mol_results
    variable mol_result_frames
    variable hydration_data
    variable binned_cache
    variable hm_prop_cache
    variable hm_bundle_cache
    variable hm_ellipse_bundle_cache
    variable hm_render_cache
    variable plot_cache
    variable plot_cache_order
    variable sphere_hydro_values_cache
    variable fastpath_sphere_cache
    variable _hm_computed_scheme
    variable plot_data_version
    variable state
    # The topology cache holds persistent atomselect HANDLES that must be
    # deleted here too, plus three more result caches to clear.
    variable hydro_topo_cache
    variable sphere_atom_cache
    variable hydro3d_props_cache
    variable trend_cache
    variable ion_flow_cache
    if {[tk_messageBox -icon question -type yesno -title "Reset VMDPathFinder" \
        -message "Clear all loaded/computed results, surfaces and caches?\n\nThis does NOT change your settings - it only clears data so you can start from a clean state."] ne "yes"} {
        return
    }
    clear_results_for_new_settings
    set state(selected_result_frame) {}
    # Hydration data is gone - drop the water schemes from the property pickers.
    catch {refresh_property_scheme_menus}
    set state(status) "Reset - all results and caches cleared. Run HOLE or Import to start again."
    catch {refresh_results_list}
    catch {redraw_visible_analysis_tab}
    catch {redraw_profile_plot}
}

proc ::VMDPathFinder::_hole_seed {} {
    # The seed HOLE actually gets. Blank in the field means THIS default, not
    # HOLE's clock. HOLE's pore search is Monte Carlo, so an unseeded run is not
    # reproducible - and the unrolled map is a SECOND HOLE run, so an unseeded
    # map was traced from a different pore than the profile beside it: two runs
    # of one frame gave 73x311 and 73x304 slices, ~1.75 A of pore length apart.
    # At a fixed seed the 2dmaps card does not perturb the trace (verified: the
    # .sph is byte-identical with and without it), so one seed makes the map and
    # the profile the same pore.
    variable state
    set s [string trim $state(random_seed)]
    if {$s ne "" && [string is integer -strict $s]} { return $s }
    return 1
}

proc ::VMDPathFinder::write_control_file {path pdb_name sph_name {cpoint_in ""} {cvect_in ""} {strip_conn 0}} {
    # cpoint_in / cvect_in override state(cpoint)/state(cvect) for this frame (used
    # by the per-frame dynamic-axis path); blank means "use the static value".
    variable state
    set cpoint [validate_triplet CPOINT [expr {$cpoint_in ne "" ? $cpoint_in : $state(cpoint)}]]
    set cvect  [validate_triplet CVECT  [expr {$cvect_in  ne "" ? $cvect_in  : $state(cvect)}]]
    set fh [open $path w]
    # Use bare filenames so HOLE's 80-char line limit is never hit.
    # The caller must cd into the run_dir before invoking HOLE.
    puts $fh "coord  $pdb_name"
    # The radius path is written IN FULL, so it is the one card that can still
    # blow HOLE's 80-char FORTRAN record. A truncated path is not a warning: it
    # fails the whole run with "Cannot open bond/vdw radius input file" - no
    # profile, no .sph, no surface - and the user sees only "no pore found".
    # Latent for a short path like ~/hole2/rad/simple.rad, fatal for a deep one.
    # Stage a copy beside the control file (which is what the caller cd's into)
    # and name it bare, exactly as coord/sphpdb already are.
    set _radfile [_effective_radius_file]
    set radline "radius $_radfile"
    if {[string length $radline] > 80} {
        set staged [file join [file dirname $path] hole.rad]
        if {![catch {file copy -force $_radfile $staged}]} {
            set radline "radius [file tail $staged]"
        }
    }
    puts $fh $radline
    puts $fh "sphpdb $sph_name"
    puts $fh "sample $state(sample)"
    puts $fh "endrad $state(endrad)"
    puts $fh "shorto $state(shorto)"
    if {$cpoint ne {}} { puts $fh "cpoint [join $cpoint { }]" }
    if {$cvect  ne {}} { puts $fh "cvect  [join $cvect  { }]" }
    set ignore [string trim $state(ignore)]
    if {$ignore ne ""} { puts $fh "ignore $ignore" }
    puts $fh "raseed [_hole_seed]"
    # Monte Carlo search controls. Blank = omit the card entirely, so HOLE uses
    # its own defaults (1000 / 0.1 / 0.1) rather than us restating them.
    foreach {_k _card} {mcstep mcstep mcdisp mcdisp mckt mckt} {
        if {![info exists state($_k)]} continue
        set _v [string trim $state($_k)]
        if {$_v ne "" && [string is double -strict $_v]} { puts $fh "$_card $_v" }
    }
    # Pore-detection method (Settings): circular = plain HOLE (no card);
    # connolly / capsule emit the corresponding card here, so the user picks the
    # method instead of typing a card. Skipped if the user already put an
    # equivalent card in extra_cards (power users who need parameters like
    # "conn 1.15 0.85"), so it never emits a duplicate.
    switch -- $state(pore_method) {
        connolly {
            if {!$strip_conn && ![_extra_cards_has_card conn] && ![_extra_cards_has_card connolly]} {
                puts $fh "conn"
            }
        }
        capsule {
            if {![_extra_cards_has_card capsule]} { puts $fh "capsule" }
        }
    }
    # Any extra HOLE cards the GUI has no dedicated field for (CUT, CHARGE,
    # 2DMAPS, ...). Written verbatim, one per ';'-separated entry.
    foreach card [split $state(extra_cards) ";"] {
        set card [string trim $card]
        if {$card eq ""} continue
        if {$strip_conn && [string tolower [lindex $card 0]] in {conn connolly}} continue
        puts $fh $card
    }
    puts $fh "stop"
    close $fh
}

proc ::VMDPathFinder::_thread_parse_initscript {} {
    # Returns a self-contained Tcl script that defines thread_parse_frame in a
    # worker thread.  No VMDPathFinder namespace procs are called so the script works
    # in a plain Thread::create context without VMD present - the one shared
    # helper it needs, _resolve_conn_radii, is APPENDED below by copying the real
    # proc's body verbatim, so the CONNOLLY radius convention cannot drift between
    # this parser and the main one.
    set _init {
        proc thread_parse_frame {out_file tsv_file {full 1}} {
            if {![file exists $out_file] && [file exists $tsv_file]} {
                return [_thr_read_tsv $tsv_file $full]
            }
            if {![file exists $out_file]} {
                return [list valid 0 message {HOLE output file not found.} \
                    min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
            }
            set fh  [open $out_file r]
            # Same publish-by-rename as parse_profile: see the note there.
            set _tsv_pub $tsv_file
            set tsv_file "$tsv_file.part"
            if {[catch {open $tsv_file w} tsv]} { close $fh; error $tsv }
            puts $tsv "coord\tradius\tcen_line_d\tsum_s_over_area\trequiv\tconn_s_over_area\trequiv_estim\tcap_rad"
            set in_table 0; set caps_table 0; set points 0; set rows {}
            set caps_off 0.0; set caps_last ""
            set conn_table 0; set conn_raw ""; set conn_F_row ""; set restim_row ""
            set min_radius {}; set min_coord {}; set xvalues {}; set yvalues {}
            set caprvalues {}; set min_caprad {}; set cap_r {}
            # Same fatal-error capture as the non-threaded parse_profile: a
            # "***ERROR***" block (e.g. missing VDWR entry for an atom's
            # element) means HOLE bailed before computing anything, and the
            # real cause has nothing to do with CVECT/CPOINT.
            set collecting_error 0
            set error_lines {}
            while {[gets $fh line] >= 0} {
                if {[string match "***ERROR****" [string trim $line]]} {
                    set collecting_error 1
                    continue
                }
                if {[string match "Fortran runtime error:*" [string trim $line]]} {
                    set collecting_error 1
                    lappend error_lines [string trim $line]
                    continue
                }
                if {$collecting_error} {
                    set t [string trim $line]
                    if {$t eq "" || [string match "*normal completion*" $line]} {
                        set collecting_error 0
                    } else {
                        lappend error_lines $t
                    }
                }
                if {!$in_table} {
                    # Plain HOLE table: "cenxyz.cvec radius cen_line_D sum{s/area}".
                    # CAPSULE table: "cenxyz.cvec eff.rad area CAP.LEN cap.rad
                    # angle cen.line.di integ.s/area" - same coordinate + radius,
                    # but cen_line and s/area sit in later columns.
                    if {[string match "*cenxyz.cvec*radius*" $line] && [string match "*Requiv*" $line]} {
                        set in_table 1; set caps_table 0; set conn_table 1
                    } elseif {[string match "*cenxyz.cvec*radius*" $line]} {
                        set in_table 1; set caps_table 0
                    } elseif {[string match "*cenxyz.cvec*eff.rad*" $line]} {
                        set in_table 1; set caps_table 1
                    }
                    continue
                }
                if {$conn_table} {
                    set coord  [string trim [string range $line 0 11]]
                    set radius [string trim [string range $line 12 23]]
                    set cen_d  [string trim [string range $line 24 35]]
                    set area_t [string trim [string range $line 36 47]]
                    set conn_raw [string trim [string range $line 48 59]]
                    # Col 7 "Conn_s/Area" = CTORES, HOLE's CONNOLLY conductance factor
                    # (hograp.f writes '(4F12.5,3F12.3,A12)': Requiv 49-60,
                    # Requiv_estim 61-72, Conn_s/Area 73-84). Written on sampled rows
                    # only, so keep the last non-empty one.
                    set _re [string trim [string range $line 60 71]]
                    if {[string is double -strict $_re]} { set restim_row $_re }
                    set _cs [string trim [string range $line 72 83]]
                    if {[string is double -strict $_cs] && $_cs > 0 && $_cs < 1.0e7} { set conn_F_row $_cs }
                    set cap_r ""
                    set ok [expr {[string is double -strict $coord] && [string is double -strict $radius] \
                                  && [string is double -strict $cen_d] && [string is double -strict $area_t]}]
                } elseif {$caps_table} {
                    # CAPSULE prints TWO radii and they mean different things:
                    # eff.rad (col 2) is sqrt(area/pi), right for area-derived
                    # quantities (conductance, s/area); cap.rad (col 5) is the
                    # capsule's physical half-width, the only one that is a
                    # steric clearance. Capturing both keeps each consumer on
                    # the right one - on a real Nav frame they differ by 428%
                    # (1.008 A vs 0.191 A at the bottleneck).
                    set ok [regexp {^\s*([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+[-+0-9.Ee]+\s+[-+0-9.Ee]+\s+([-+0-9.Ee]+)\s+[-+0-9.Ee]+\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)} \
                        $line -> coord radius cap_r cen_d area_t]
                    # Same block-offset rule as parse_profile: integ.s/(area)
                    # restarts in the +ve block and HOLE's F is the two finals
                    # added.
                    if {$ok && [string is double -strict $area_t]} {
                        set caps_last $area_t
                        set area_t [format %.5f [expr {$area_t + $caps_off}]]
                    }
                } else {
                    set ok [regexp {^\s*([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)} \
                        $line -> coord radius cen_d area_t]
                    set cap_r ""
                }
                if {!$ok} {
                    # CAPSULE splits the profile into two blocks (-ve then +ve
                    # records) separated by a "(+ve records)****" line; skip it
                    # and keep reading. Any other non-data line ends the table.
                    if {[string match "*ve records*" $line]} {
                        if {$caps_last ne ""} {
                            set caps_off [expr {$caps_off + $caps_last}]
                            set caps_last ""
                        }
                        continue
                    }
                    if {$points > 0} break
                    continue
                }
                incr points
                if {![string is double -strict $cap_r]} { set cap_r "" }
                lappend rows [list $coord $radius $cen_d $area_t $conn_raw $conn_F_row $restim_row $cap_r]
                set conn_raw ""; set conn_F_row ""; set restim_row ""
            }
            # CAPSULE prints the two half-profiles each starting at the centre
            # point (one descending, one ascending); sort by channel coordinate
            # so the plot and TSV run monotonically like the plain-HOLE table.
            if {$caps_table} { set rows [lsort -real -index 0 $rows] }
            foreach row $rows {
                lassign $row coord radius cen_d area_t rq cs re cap_r
                puts $tsv "$coord\t$radius\t$cen_d\t$area_t\t$rq\t$cs\t$re\t$cap_r"
            }
            lassign [_resolve_conn_radii $rows] _res _src
            # cap.rad comes from the ORIGINAL row at this index: _resolve_conn_radii
            # returns 4-field rows under CONNOLLY, and the rows are 1:1 and in order.
            set _ri 0
            foreach row $_res {
                lassign $row coord radius
                set _cr [lindex [lindex $rows $_ri] 7]
                incr _ri
                lappend xvalues $coord; lappend yvalues $radius
                lappend caprvalues [expr {$_cr eq "" ? $radius : $_cr}]
                if {$_cr ne "" && ($min_caprad eq {} || $_cr < $min_caprad)} {
                    set min_caprad $_cr
                }
                if {$min_radius eq {} || $radius < $min_radius} {
                    set min_radius $radius; set min_coord $coord
                }
            }
            close $tsv; close $fh
            # Publish only a parse that produced rows: see parse_profile.
            if {$points == 0} {
                catch {file delete $tsv_file}
            } else {
                catch {file rename -force $tsv_file $_tsv_pub}
            }
            set tsv_file $_tsv_pub
            if {$points == 0} {
                if {[llength $error_lines] > 0} {
                    set errmsg [join $error_lines " "]
                    return [list valid 0 \
                        message "HOLE stopped with an error before building a profile: $errmsg [_hole_error_hint $errmsg]" \
                        min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
                }
                return [list valid 0 \
                    message {HOLE found no pore profile. Try setting CVECT or adjust CPOINT.} \
                    min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
            }
            return [list valid 1 message {} min_radius $min_radius min_coord $min_coord \
                points $points xvalues $xvalues yvalues $yvalues tsv_file $tsv_file \
                caprvalues $caprvalues min_caprad $min_caprad]
        }
        proc _thr_read_tsv {tsv_file {full 1}} {
            # full=0: scan for the summary (min_radius/points) only, WITHOUT
            # building the xvalues/yvalues lists. That avoids the list-building +
            # cross-thread marshaling of ~1000 points/frame, which is the bulk of a
            # large import's cost. The full profile is loaded lazily on demand.
            set fh [open $tsv_file r]
            gets $fh
            set points 0; set min_radius {}; set min_coord {}
            set xvalues {}; set yvalues {}; set caprvalues {}; set min_caprad {}
            set clvalues {}; set rsources {}; set _rows {}; set _caprraw {}
            while {[gets $fh line] >= 0} {
                set f [split $line "\t"]
                if {[llength $f] < 2} continue
                set coord [lindex $f 0]; set radius [lindex $f 1]
                if {![string is double -strict $coord] || ![string is double -strict $radius]} continue
                incr points
                # CAPSULE col 8, same rule as parse_profile_from_tsv: without it
                # an imported frame silently reverts every steric check to the
                # equivalent-area radius.
                set cr ""
                if {[llength $f] >= 8} { set cr [string trim [lindex $f 7]] }
                if {![string is double -strict $cr]} { set cr "" }
                if {$cr ne "" && ($min_caprad eq {} || $cr < $min_caprad)} { set min_caprad $cr }
                lappend _caprraw $cr
                # Collect the SAME six fields parse_profile_from_tsv collects,
                # so _resolve_conn_radii below can apply the CONNOLLY convention.
                # Column 2 alone is the spherical-probe radius; under CONNOLLY the
                # reported radius is Requiv, interpolated across HOLE's
                # un-evaluated mid-point rows. _thread_parse_initscript copies
                # _resolve_conn_radii into the worker for exactly this call, and
                # this reader is the one that runs once hole_out.txt has been
                # deleted - which is every normal run of >=8 frames.
                set _cl [expr {[llength $f] >= 3 && [string is double -strict [lindex $f 2]] ? [lindex $f 2] : $coord}]
                set _at [expr {[llength $f] >= 4 ? [lindex $f 3] : ""}]
                set _rq [expr {[llength $f] >= 5 ? [lindex $f 4] : ""}]
                set _cs [expr {[llength $f] >= 6 ? [lindex $f 5] : ""}]
                lappend _rows [list $coord $radius $_cl $_at $_rq $_cs]
            }
            close $fh
            if {$points == 0} {
                return [list valid 0 message {Saved profile (TSV) contained no data rows.} \
                    min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
            }
            lassign [_resolve_conn_radii $_rows] _rows rsources
            set _ri 0
            foreach _r $_rows {
                lassign $_r coord radius _cl
                set cr [lindex $_caprraw $_ri]
                incr _ri
                if {$full} {
                    lappend xvalues $coord; lappend yvalues $radius
                    lappend clvalues $_cl
                    lappend caprvalues [expr {$cr eq "" ? $radius : $cr}]
                }
                if {$min_radius eq {} || $radius < $min_radius} {
                    set min_radius $radius; set min_coord $coord
                }
            }
            return [list valid 1 message {} min_radius $min_radius min_coord $min_coord \
                points $points xvalues $xvalues yvalues $yvalues \
                clvalues $clvalues rsources $rsources \
                caprvalues $caprvalues min_caprad $min_caprad tsv_file $tsv_file]
        }
        proc thread_parse_chunk {triples {full 1}} {
            # Parse a whole batch of frames in ONE worker round-trip (the argument
            # is {frame out_file tsv_file} repeated). One send + one vwait per
            # WORKER instead of per FRAME. full=0 returns summary-only profiles.
            # Returns {frame profile frame profile ...}.
            set out {}
            foreach {frame out_file tsv_file} $triples {
                dict set out $frame [thread_parse_frame $out_file $tsv_file $full]
            }
            return $out
        }
    }
    append _init "\nproc _resolve_conn_radii {rows} {" [info body ::VMDPathFinder::_resolve_conn_radii] "}\n"
    # Same reason, same mechanism: the script above calls _hole_error_hint, and a
    # bare Thread::create interpreter has no ::VMDPathFinder:: namespace to find it in.
    append _init "\nproc _hole_error_hint {errmsg} {" [info body ::VMDPathFinder::_hole_error_hint] "}\n"
    # A thread created with a startup script EXITS as soon as that script ends
    # unless it enters thread::wait (Tcl Thread manual). Without this the
    # workers defined their procs and immediately died, so the async sends below
    # would hit "target thread died" - or, worse, the vwait would never return.
    append _init "\nthread::wait\n"
    return $_init
}

proc ::VMDPathFinder::parse_profiles_batch {frames frame_dirs {full 1}} {
    # Parse all per-frame profiles, using Thread-parallel I/O when possible.
    # full=0 returns summary-only profiles (min_radius/points, no xvalues/yvalues)
    # for a fast import; the full profile is loaded lazily later.
    # Returns a dict: {frame -> profile_dict}.
    set result {}
    set parse_list {}
    foreach frame $frames {
        if {![dict exists $frame_dirs $frame]} continue
        set rd  [dict get $frame_dirs $frame]
        set out [file join $rd hole_out.txt]
        set tsv [file join $rd hole_profile.tsv]
        if {![file exists $out] && ![file exists $tsv]} continue
        lappend parse_list $frame $out $tsv
    }
    if {[llength $parse_list] == 0} { return {} }

    set nframes [expr {[llength $parse_list] / 3}]
    set nw [expr {min([resolve_job_count], $nframes)}]

    # Only parallelize when there are enough frames to amortize thread startup,
    # and the Thread package with async send is available.
    if {$nframes >= 8 && $nw > 1 && ![catch {package require Thread}]} {
        set init [_thread_parse_initscript]
        set workers {}
        # Worker threads initialized with the self-contained parse script.
        if {![catch {
            for {set i 0} {$i < $nw} {incr i} {
                lappend workers [thread::create $init]
            }
        } err]} {
            # One contiguous batch per worker (round-robin), dispatched in a SINGLE
            # send each, so collection is nw vwaits instead of one per frame - the
            # per-frame thread round trips were the bottleneck on 10k-frame imports.
            for {set i 0} {$i < $nw} {incr i} { set wchunk($i) {} }
            set wi 0
            foreach {frame out_file tsv_file} $parse_list {
                lappend wchunk($wi) $frame $out_file $tsv_file
                set wi [expr {($wi + 1) % $nw}]
            }
            set pending {}
            set _thr_broke 0
            for {set i 0} {$i < $nw} {incr i} {
                if {[llength $wchunk($i)] == 0} continue
                set vname "::VMDPathFinder::_thr_c($i)"
                # A send to a dead worker raises rather than returning an error
                # code; catching it is what makes the serial fallback reachable.
                if {[catch {thread::send -async [lindex $workers $i] \
                        [list thread_parse_chunk $wchunk($i) $full] $vname}]} {
                    set _thr_broke 1
                    break
                }
                lappend pending $vname
            }
            if {!$_thr_broke} {
                foreach vname $pending {
                    # Watchdog. A bare vwait on a variable a dead worker will
                    # never set hangs the GUI forever with no way out; this
                    # turns that into a fallback to the serial path. Generous
                    # (10 min per worker) so a genuinely long chunk on a
                    # 10K-frame import is never mistaken for a dead one.
                    set _wd [after 600000 [list set $vname ::VMDPathFinder::_thr_dead]]
                    vwait $vname
                    after cancel $_wd
                    set _v [set $vname]
                    unset $vname
                    if {$_v eq "::VMDPathFinder::_thr_dead"} { set _thr_broke 1; break }
                    set result [dict merge $result $_v]
                }
            }
            foreach tid $workers { catch {thread::release $tid} }
            foreach _vn $pending { catch {unset $_vn} }
            if {!$_thr_broke} { return $result }
            # Threaded parse failed part-way: drop whatever it produced and let
            # the serial path below redo ALL frames, so the result set can never
            # be a partial merge of the two.
            vmdcon -warn "VMDPathFinder: threaded profile parse failed; falling back to serial."
            set result [dict create]
        }
        # Worker creation failed - release any partial workers and fall through.
        foreach tid $workers { catch {thread::release $tid} }
    }

    # Serial fallback.
    foreach {frame out_file tsv_file} $parse_list {
        dict set result $frame [parse_profile $out_file $tsv_file $full]
    }
    return $result
}

proc ::VMDPathFinder::binned_stats_for_mean {data} {
    # Per-bin {mean std min max count} for the Mean Profile views (2D curve + 3D
    # surface). HOLE's own .sph sphere file already clamps occasional negative
    # fully-occluded radii to 0; only the per-frame plots/CSV ever show the raw
    # signed value.
    #
    # RAW-POOLED (stats_raw), matching MDAnalysis HoleAnalysis.plot_mean_profile:
    # its bin_radii pools every individual radius sample from every frame into
    # the bin and takes mean/std over that pooled set. This used to return the
    # FRAME-WEIGHTED `stats` (one value per frame per bin), which answers a
    # different question - frame-to-frame variability rather than the scatter of
    # all observations - and made the band a different quantity from the
    # reference's. Measured on a real 100-frame run the two agree closely here
    # (mean 0.040 A apart, SD 0.037 A, band half-width 0.736 vs 0.751 A), so
    # this is a definition fix, not a visible jump; it diverges where bins are
    # wide or the radius changes steeply within a bin.
    return [dict get $data stats_raw]
}

proc ::VMDPathFinder::refresh_mean_surface_if_shown {} {
    # Rebuild the Mean Profile 3D surface if it is currently displayed, so a change
    # to the color scheme / surface color re-colors it in step with the per-frame
    # surfaces. No-op (and never resurrects a removed surface) when it isn't shown.
    variable state
    variable mean_surface_mol
    variable tunnel_mean_surface_mol
    if {![info exists state(show_mean_surface)] || !$state(show_mean_surface)} { return }
    # Tunnel mode's averaged tube lives in its OWN mol (tunnel_mean_surface_mol).
    # Keying only off mean_surface_mol - HOLE's, and -1 in tunnel mode - made
    # every Color/Material/Property change a silent no-op there.
    if {[analysis_mode] eq "tunnel"} {
        if {$tunnel_mean_surface_mol >= 0} { catch {build_and_show_tunnel_mean_surface} }
        return
    }
    # Volume and Isosurface share the one mean_surface_mol slot, so this must
    # rebuild whichever is actually on screen. Calling the tube builder
    # unconditionally REPLACED a displayed Volume with the tube on any setting
    # that routes here - the Mean Profile gear's "Accurate 3D" / "Render
    # smoothly", and every mean color/scheme write trace - which reads as the
    # volume vanishing for no reason.
    if {$mean_surface_mol >= 0} {
        catch {build_and_show_mean_surface}
    }
}

proc ::VMDPathFinder::_resolve_conn_radii {rows} {
    # THE single place the CONNOLLY radius convention is applied. rows are
    # {coord radius cen_line_d area_term requiv_raw}; returns {rows rsrc} with the
    # radius field replaced and rsrc parallel: 0 = HOLE spherical-probe radius,
    # 1 = CONNOLLY Requiv, 2 = Requiv interpolated. Requiv is the radius of a circle
    # with the same area as the slice's real Connolly cross-section. Three row
    # states:
    #   real value  -> use it.
    #   1e6         -> HOLE's "area goes infinite" marker (pore opened to bulk, no
    #                  Connolly radius exists) -> fall back to spherical, mark row.
    #   blank       -> an unevaluated "(mid-point)" row -> INTERPOLATE (these
    #                  alternate 1:1 with evaluated rows, so falling back would
    #                  saw-tooth the profile every half Angstrom). A blank whose
    #                  neighbours aren't BOTH real (edge of the Connolly region,
    #                  next to a 1e6) has nothing to interpolate between and also
    #                  falls back.
    # Rows with no 5th field (pre-v2 TSV, or non-Connolly run) are returned
    # untouched with rsrc all 0.
    set n [llength $rows]
    set kind {}; set val {}
    set anyconn 0
    foreach row $rows {
        set rq [expr {[llength $row] >= 5 ? [string trim [lindex $row 4]] : ""}]
        if {$rq eq ""} {
            lappend kind blank; lappend val {}
        } elseif {[string is double -strict $rq] && $rq >= 1.0e5} {
            lappend kind inf;   lappend val {}
        } elseif {[string is double -strict $rq] && $rq <= 0.0} {
            # 0 is NOT a measurement: coarea.f initialises REQUIV = 0D0 and leaves it
            # there when the slice's Connolly area calc bails out, so a failed slice
            # arrives looking like a perfectly closed pore. Treating it as real is why
            # CONNOLLY reported min_radius = 0.0 on 1GRM at a mouth whose spherical
            # radius was 11.4 A. Requiv derives from an AREA so it cannot be
            # legitimately negative (unlike the spherical radius, which HOLE does emit
            # negative - see the negative-radius clamp); <= 0 is therefore unusable in
            # every case, and falls back to the spherical probe like the 1e6 marker.
            lappend kind inf;   lappend val {}
        } elseif {[string is double -strict $rq]} {
            lappend kind fin;   lappend val $rq; set anyconn 1
        } else {
            lappend kind blank; lappend val {}
        }
    }
    if {!$anyconn} {
        set z {}
        for {set i 0} {$i < $n} {incr i} { lappend z 0 }
        return [list $rows $z]
    }
    set rsrc {}
    for {set i 0} {$i < $n} {incr i} {
        lappend rsrc [expr {[lindex $kind $i] eq "fin" ? 1 : 0}]
    }
    for {set i 0} {$i < $n} {incr i} {
        if {[lindex $kind $i] ne "blank"} continue
        set p -1
        for {set j [expr {$i-1}]} {$j >= 0} {incr j -1} {
            set k [lindex $kind $j]
            if {$k eq "fin"} { set p $j; break }
            if {$k eq "inf"} break
        }
        set q -1
        for {set j [expr {$i+1}]} {$j < $n} {incr j} {
            set k [lindex $kind $j]
            if {$k eq "fin"} { set q $j; break }
            if {$k eq "inf"} break
        }
        if {$p < 0 || $q < 0} continue
        set cp [lindex [lindex $rows $p] 0]
        set cq [lindex [lindex $rows $q] 0]
        set ci [lindex [lindex $rows $i] 0]
        set vp [lindex $val $p]
        set vq [lindex $val $q]
        set w [expr {$cq == $cp ? 0.0 : double($ci-$cp)/double($cq-$cp)}]
        lset val $i [format %.5f [expr {$vp + $w*($vq-$vp)}]]
        lset rsrc $i 2
    }
    set out {}
    for {set i 0} {$i < $n} {incr i} {
        set row [lindex $rows $i]
        lassign $row coord radius cen_line_d area_term
        set v [lindex $val $i]
        if {$v ne "" && [string is double -strict $v]} {
            set radius $v
        } else {
            lset rsrc $i 0
        }
        lappend out [list $coord $radius $cen_line_d $area_term]
    }
    return [list $out $rsrc]
}

proc ::VMDPathFinder::_hole_error_hint {errmsg} {
    # The follow-on advice for a fatal HOLE error. A crash inside HOLE is not a
    # radius-file problem, and telling the user to check their Radius file when
    # the binary hit a format-descriptor bug sends them somewhere there is
    # nothing to find.
    if {[string match "Fortran runtime error:*" $errmsg]} {
        return "(HOLE itself crashed - this is a fault in the HOLE binary, not in\
                your structure or settings. If a card in Extra HOLE parameters\
                triggered it, remove that card.)"
    }
    return "(usually a missing van der Waals radius entry for an atom's element\
            in your Radius file - see Settings - not a CPOINT/CVECT problem)."
}

proc ::VMDPathFinder::parse_profile {output_file tsv_file {full 1}} {
    # full=0 returns the summary (min_radius/points) without the xvalues/yvalues
    # lists - used for a fast import; the full profile is loaded lazily later.
    # If hole_out.txt has been removed (cleaned up after a prior run) but the
    # parsed TSV already exists, read from the TSV directly to reconstruct the
    # profile without re-running HOLE.
    if {![file exists $output_file] && [file exists $tsv_file]} {
        return [parse_profile_from_tsv $tsv_file $full]
    }
    if {![file exists $output_file]} {
        return [dict create valid 0 \
            message "HOLE output file not found." \
            min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
    }
    set fh  [open $output_file r]
    # Write the parsed table to a sibling temp and publish it by rename once the
    # parse has succeeded. Opening $tsv_file directly truncates an existing
    # profile before the outcome is known, so a failed parse of a stale
    # hole_out.txt destroys the good TSV beside it. The catch also closes $fh
    # when the write side cannot be opened at all - a read-only import tree.
    set _tsv_pub $tsv_file
    set tsv_file "$tsv_file.part"
    if {[catch {open $tsv_file w} tsv]} { close $fh; error $tsv }
    puts $tsv "coord\tradius\tcen_line_d\tsum_s_over_area\trequiv\tconn_s_over_area\trequiv_estim\tcap_rad"
    set in_table 0
    set caps_table 0
    set caps_off 0.0
    set caps_last ""
    set points 0
    set rows {}
    set min_radius {}
    set min_coord  {}
    set xvalues {}
    set yvalues {}
    # CAPSULE only: the physical half-width series and its minimum. Empty for
    # every other method, which has just one radius.
    set caprvalues {}
    set min_caprad {}
    set cap_r {}
    # HOLE prints a "***ERROR***" marker followed by one or more description
    # lines when it bails out before producing any profile at all (e.g. a
    # radius file with no VDWR entry for some atom's element). Capture that
    # text so a fatal-error run reports the real cause instead of the generic
    # "no pore found, try CVECT/CPOINT" message, which is actively misleading
    # when the failure has nothing to do with geometry.
    set collecting_error 0
    set error_lines {}
    # CONNOLLY extras (see the conn_table branch): per-row equivalent radius and
    # its state, plus HOLE's own Connolly conductance factor.
    set conn_table 0
    set conn_raw ""; set conn_F_row ""; set restim_row ""
    set conn_F {}
    while {[gets $fh line] >= 0} {
        if {[string match "***ERROR****" [string trim $line]]} {
            set collecting_error 1
            continue
        }
        # A Fortran runtime error is NOT in that format, so it used to fall
        # through to the generic "no pore found, try CVECT" message - actively
        # misleading when HOLE has crashed. The sphbox card does this: a
        # format-descriptor bug in HOLE 2 itself. The line names its own cause.
        if {[string match "Fortran runtime error:*" [string trim $line]]} {
            set collecting_error 1
            lappend error_lines [string trim $line]
            continue
        }
        if {$collecting_error} {
            set t [string trim $line]
            if {$t eq "" || [string match "*normal completion*" $line]} {
                set collecting_error 0
            } else {
                lappend error_lines $t
            }
        }
        if {!$in_table} {
            # Plain HOLE table: "cenxyz.cvec radius cen_line_D sum{s/area}".
            # CAPSULE table: "cenxyz.cvec eff.rad area CAP.LEN cap.rad angle
            # cen.line.di integ.s/area" - same coordinate + radius, but cen_line
            # and s/area sit in later columns.
            # CONNOLLY adds "Requiv Requiv_esti Conn_s/Area" after the plain four
            # columns. Must be tested FIRST - its header also contains "radius".
            if {[string match "*cenxyz.cvec*radius*" $line] && [string match "*Requiv*" $line]} {
                set in_table 1; set caps_table 0; set conn_table 1
            } elseif {[string match "*cenxyz.cvec*radius*" $line]} {
                set in_table 1; set caps_table 0
            } elseif {[string match "*cenxyz.cvec*eff.rad*" $line]} {
                set in_table 1; set caps_table 1
            }
            continue
        }
        if {$conn_table} {
            # FIXED-WIDTH, not whitespace. HOLE evaluates the Connolly area only on
            # its "(sampled)" rows and leaves columns 5-7 BLANK on the interleaved
            # "(mid-point)" rows, so a whitespace split silently shifts fields and
            # returns numbers from the wrong column. Verified against real output:
            # 12-char fields - coord[0:11] radius[12:23] cen.line[24:35]
            # integ.s/(ar[36:47] Requiv[48:59] Requiv_esti[60:71] Conn_s/Area[72:83].
            set coord      [string trim [string range $line 0 11]]
            set radius     [string trim [string range $line 12 23]]
            set cen_line_d [string trim [string range $line 24 35]]
            set area_term  [string trim [string range $line 36 47]]
            set _rq        [string trim [string range $line 48 59]]
            set _restim    [string trim [string range $line 60 71]]
            set _conn_s    [string trim [string range $line 72 83]]
            set ok [expr {[string is double -strict $coord] && [string is double -strict $radius] \
                          && [string is double -strict $cen_line_d] && [string is double -strict $area_term]}]
            if {$ok} {
                # Keep Requiv RAW here - "" (mid-point row HOLE did not evaluate),
                # "1000000.000" (its area-goes-infinite marker), or a real value.
                # Classifying and interpolating happens in ONE place,
                # _resolve_conn_radii, called by every reader - see the note there.
                set conn_raw $_rq
                if {[string is double -strict $_restim]} { set restim_row $_restim }
                if {[string is double -strict $_conn_s] && $_conn_s > 0 && $_conn_s < 1.0e7} {
                    set conn_F $_conn_s; set conn_F_row $_conn_s
                }
            }
            set cap_r ""
        } elseif {$caps_table} {
            # See the serial parser: col 2 is the equivalent-AREA radius, col 5
            # the physical half-width. Steric checks need col 5.
            set ok [regexp {^\s*([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+[-+0-9.Ee]+\s+[-+0-9.Ee]+\s+([-+0-9.Ee]+)\s+[-+0-9.Ee]+\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)} \
                $line -> coord radius cap_r cen_line_d area_term]
            # integ.s/(area) RESTARTS at zero in the +ve block, and HOLE's own F
            # is the two blocks' finals ADDED (measured on 1GRM: 0.78878 +
            # 8.16561 = 8.954, exactly the F it prints). Carry the offset here,
            # so the last row after the sort below is the whole channel's factor
            # and every reader of column 4 gets it without knowing about blocks.
            if {$ok && [string is double -strict $area_term]} {
                set caps_last $area_term
                set area_term [format %.5f [expr {$area_term + $caps_off}]]
            }
        } else {
            set ok [regexp {^\s*([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)\s+([-+0-9.Ee]+)} \
                $line -> coord radius cen_line_d area_term]
            set cap_r ""
        }
        if {!$ok} {
            # CAPSULE splits the profile into two blocks (-ve then +ve records)
            # separated by a "(+ve records)****" line; skip it and keep reading.
            # Any other non-data line ends the table.
            if {[string match "*ve records*" $line]} {
                if {$caps_last ne ""} {
                    set caps_off [expr {$caps_off + $caps_last}]
                    set caps_last ""
                }
                continue
            }
            if {$points > 0} { break }
            continue
        }
        incr points
        if {![string is double -strict $cap_r]} { set cap_r "" }
        lappend rows [list $coord $radius $cen_line_d $area_term $conn_raw $conn_F_row $restim_row $cap_r]
        set conn_raw ""; set conn_F_row ""; set restim_row ""
    }
    # CAPSULE prints the two half-profiles each starting at the centre point (one
    # descending, one ascending); sort by channel coordinate so the plot and TSV
    # run monotonically like the plain-HOLE table.
    if {$caps_table} { set rows [lsort -real -index 0 $rows] }
    # CONNOLLY: column 2 of the TSV stays HOLE's RAW spherical-probe radius and
    # column 5 its RAW Requiv text. The Connolly interpretation is applied by
    # _resolve_conn_radii at READ time, so the three different things that write
    # this file (here, the threaded parser, and run_analysis's awk fast path -
    # which is the one a trajectory actually uses) cannot drift apart.
    foreach row $rows {
        lassign $row coord radius cen_line_d area_term rq cs re cap_r
        puts $tsv "$coord\t$radius\t$cen_line_d\t$area_term\t$rq\t$cs\t$re\t$cap_r"
    }
    lassign [_resolve_conn_radii $rows] _res rsrc
    # _resolve_conn_radii returns 4-field rows under CONNOLLY, so cap.rad is read
    # back from the ORIGINAL row at the same index - it is 1:1 and in order.
    set _ri 0
    foreach row $_res {
        lassign $row coord radius
        set _cr [lindex [lindex $rows $_ri] 7]
        incr _ri
        if {$full} {
            lappend xvalues $coord
            lappend yvalues $radius
            lappend caprvalues [expr {$_cr eq "" ? $radius : $_cr}]
        }
        if {$_cr ne "" && ($min_caprad eq {} || $_cr < $min_caprad)} { set min_caprad $_cr }
        if {$min_radius eq {} || $radius < $min_radius} {
            set min_radius $radius
            set min_coord  $coord
        }
    }
    close $tsv
    close $fh
    # Publish only a parse that produced rows. Renaming unconditionally hands a
    # header-only .part to the destination on the no-rows path below, which is
    # the same truncation hazard the .part scheme exists to prevent - the
    # zero-point return is a failed parse, not a success with an empty table.
    if {$points == 0} {
        catch {file delete $tsv_file}
    } else {
        catch {file rename -force $tsv_file $_tsv_pub}
    }
    set tsv_file $_tsv_pub
    if {$points == 0} {
        if {[llength $error_lines] > 0} {
            set errmsg [join $error_lines " "]
            return [dict create valid 0 \
                message "HOLE stopped with an error before building a profile: $errmsg [_hole_error_hint $errmsg]" \
                min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
        }
        return [dict create valid 0 \
            message "HOLE found no pore profile. Try setting CVECT (e.g. \"0 0 1\" for Z-axis) or adjust CPOINT." \
            min_radius {} min_coord {} points 0 xvalues {} yvalues {} tsv_file $tsv_file]
    }
    return [dict create valid 1 message {} \
        min_radius $min_radius min_coord $min_coord \
        points $points xvalues $xvalues yvalues $yvalues \
        caprvalues $caprvalues min_caprad $min_caprad tsv_file $tsv_file]
}

proc ::VMDPathFinder::parse_profile_from_tsv {tsv_file {full 1}} {
    # Reconstruct a profile dict from an existing hole_profile.tsv (used when
    # hole_out.txt has been deleted after parsing to reclaim disk space).
    # full=0 returns the summary only (min_radius/points) without building the
    # xvalues/yvalues lists.
    set fh [open $tsv_file r]
    gets $fh  ;# skip header
    set points 0
    set min_radius {}
    set min_coord  {}
    set xvalues {}
    set yvalues {}
    # cen_line_d (arc length along the centerline, col 3) and sum_s_over_area
    # (HOLE's cumulative Sum ds/area, col 4) - used by the Channel Metrics feature:
    # clvalues gives the correct integration length for pore volume on curved pores
    # (coord is the projected cvec axis, NOT arc length), and the FINAL sum_s_over_area
    # IS HOLE's own conductance geometric factor F (so G matches HOLE's printed Gmacro).
    set clvalues {}
    set cond_F {}
    set conn_cond_F {}
    # CAPSULE col 8: the physical half-width. Absent on every other method and on
    # a pre-v4 TSV, which leaves min_caprad empty and every consumer on col 2.
    set caprvalues {}
    set min_caprad {}
    set _caprraw {}
    set _crows {}
    set rsources {}
    # Rows are collected first, then handed to _resolve_conn_radii, which applies
    # the CONNOLLY convention (Requiv where real, interpolated across HOLE's
    # un-evaluated mid-point rows, spherical-probe radius where the pore has opened
    # to bulk). A pre-v2 TSV has no 5th column, so it resolves to "all spherical
    # probe" - exactly what those files contain.
    set _rows {}
    while {[gets $fh line] >= 0} {
        set fields [split $line "\t"]
        if {[llength $fields] < 2} { continue }
        set coord  [lindex $fields 0]
        set radius [lindex $fields 1]
        if {![string is double -strict $coord] || ![string is double -strict $radius]} { continue }
        incr points
        set _cl [expr {[llength $fields] >= 3 && [string is double -strict [lindex $fields 2]] ? [lindex $fields 2] : $coord}]
        set _at [expr {[llength $fields] >= 4 ? [lindex $fields 3] : ""}]
        set _rq [expr {[llength $fields] >= 5 ? [lindex $fields 4] : ""}]
        set _cs [expr {[llength $fields] >= 6 ? [lindex $fields 5] : ""}]
        set _re [expr {[llength $fields] >= 7 ? [lindex $fields 6] : ""}]
        set _cr ""
        if {[llength $fields] >= 8} { set _cr [string trim [lindex $fields 7]] }
        if {![string is double -strict $_cr]} { set _cr "" }
        lappend _caprraw $_cr
        if {$_cr ne "" && ($min_caprad eq {} || $_cr < $min_caprad)} { set min_caprad $_cr }
        if {$_rq ne ""} { lappend _crows [list $coord $radius $_re] }
        lappend _rows [list $coord $radius $_cl $_at $_rq $_cs]
        if {[llength $fields] >= 4 && [string is double -strict [lindex $fields 3]]} {
            set cond_F [lindex $fields 3]
        }
        # DISTINCT key, never an overwrite of cond_F: a cached spherical profile
        # reused under CONNOLLY (or the reverse) must not silently serve the other
        # model's number. Absent column = not a CONNOLLY run, or a pre-v3 TSV.
        # Keep the last FINITE value, not the last parseable one: Tcl accepts "Infinity"
        # as a double, and HOLE emits it for any slice whose Connolly area calc failed.
        # A trailing Infinity would otherwise discard a perfectly good factor computed
        # over the rest of the channel and force a needless spherical fallback -
        # measured on 1GRM, that threw away 10.534 in 3 of 6 runs.
        if {[string is double -strict $_cs] && $_cs > 0 && $_cs < 1.0e7} { set conn_cond_F $_cs }
    }
    close $fh
    # PREFER the reconstruction over HOLE's own cumulative column, and use the column
    # only as a fallback. Validated on eight independent 1GRM runs: where HOLE's value
    # is COMPLETE the two agree to 0.0004 (its column is printed F12.3, so that is the
    # print precision, not a real difference). Where they disagree, HOLE's is the wrong
    # one - a failed slice makes its cumulative sum stop early, so the "last finite"
    # entry is a PARTIAL integral over only the rows before the failure. In one run the
    # failure was on the final row and HOLE's value silently omitted it; in three
    # others it was on the first row and the entire column was Infinity.
    if {[llength $_crows] > 2} {
        set _rf [_conn_F_from_rows $_crows]
        if {$_rf ne ""} { set conn_cond_F $_rf }
    }
    lassign [_resolve_conn_radii $_rows] _rows rsources
    # caprvalues is built under the SAME $full gate as yvalues: the alignment
    # check downstream compares their lengths, and a half-built pair would pass
    # it while handing out a series that does not line up with the radii.
    set _ri 0
    foreach _r $_rows {
        lassign $_r coord radius _cl
        set _cr [lindex $_caprraw $_ri]
        incr _ri
        if {$full} {
            lappend xvalues $coord
            lappend yvalues $radius
            lappend clvalues $_cl
            lappend caprvalues [expr {$_cr eq "" ? $radius : $_cr}]
        }
        if {$min_radius eq {} || $radius < $min_radius} {
            set min_radius $radius
            set min_coord  $coord
        }
    }
    if {$points == 0} {
        return [dict create valid 0 \
            message "Saved profile (TSV) contained no data rows." \
            min_radius {} min_coord {} points 0 xvalues {} yvalues {} clvalues {} cond_F {} conn_cond_F {} conn_run 0 tsv_file $tsv_file]
    }
    return [dict create valid 1 message {} \
        min_radius $min_radius min_coord $min_coord \
        points $points xvalues $xvalues yvalues $yvalues \
        clvalues $clvalues cond_F $cond_F conn_cond_F $conn_cond_F \
        caprvalues $caprvalues min_caprad $min_caprad \
        conn_run [expr {[llength $_crows] > 0}] rsources $rsources tsv_file $tsv_file]
}

proc ::VMDPathFinder::_prefetch_full_profiles {frames} {
    # Batch-load the full profiles for any of $frames that only hold the
    # summary, using parse_profiles_batch's thread pool. Falls through
    # silently: ensure_profile_full still parses whatever is left, so this is
    # a speedup with no new failure mode.
    variable results
    set want {}
    set dirs [dict create]
    foreach f $frames {
        if {![dict exists $results $f]} continue
        set p [dict get $results $f profile]
        if {[dict exists $p xvalues] && [llength [dict get $p xvalues]] > 0} continue
        if {![dict exists $p valid] || ![dict get $p valid]} continue
        if {![dict exists $results $f run_dir]} continue
        lappend want $f
        dict set dirs $f [dict get $results $f run_dir]
    }
    # Below the batch parser's own parallel threshold there is nothing to win.
    if {[llength $want] < 8} { return }
    if {[catch {parse_profiles_batch $want $dirs 1} got]} { return }
    dict for {f prof} $got {
        if {[dict exists $prof xvalues] && [llength [dict get $prof xvalues]] > 0} {
            dict set results $f profile $prof
        }
    }
}

proc ::VMDPathFinder::ensure_profile_full {frame} {
    # Return the FULL profile for $frame (with xvalues/yvalues), loading it lazily
    # from the TSV the first time and caching it back into results. Import stores
    # summary-only profiles to stay fast on large trajectories; this reads the full
    # per-frame data on demand (frame plot / heatmap / CSV export). Idempotent and
    # parses each frame's TSV at most once.
    variable results
    if {![dict exists $results $frame]} { return {} }
    set profile [dict get $results $frame profile]
    if {[dict exists $profile xvalues] && [llength [dict get $profile xvalues]] > 0} {
        return $profile
    }
    if {![dict exists $profile valid] || ![dict get $profile valid]} { return $profile }
    if {![dict exists $profile tsv_file]} { return $profile }
    set tsv [dict get $profile tsv_file]
    if {$tsv eq "" || ![file exists $tsv]} { return $profile }
    if {[catch {parse_profile_from_tsv $tsv 1} full]} { return $profile }
    dict set results $frame profile $full
    return $full
}

proc ::VMDPathFinder::shell_quote {value} {
    # Correctly escape embedded single quotes for POSIX sh single-quoted strings.
    # A bare ' inside a single-quoted string is illegal; the sequence '\'' is used:
    # close the quote, emit a backslash-escaped quote, reopen.
    return "'[string map [list ' {'\''}] $value]'"
}

proc ::VMDPathFinder::_note_untabled_resname {scheme resname value} {
    # A residue-scale property table is an AMINO-ACID table; anything else in
    # the selection (glycans, lipids, ligands, caps) silently took the default
    # and rendered mid-scale, which reads as a measured value. Say so ONCE per
    # (scheme, resname) per session - the tunnel-side MOLE table already warns
    # this way (mole_residue_property), the pore-side scales never did. The
    # value still stands (there IS no published KD/WW/Grantham number for a
    # sugar); the point is that the user knows the colour is a placeholder.
    # KR is atom-level (|q| < 0.25 e on real charges when a PSF is loaded) and
    # covers heteroatoms properly - it never routes through here.
    variable _untabled_resname_noted
    if {![info exists _untabled_resname_noted]} { set _untabled_resname_noted [dict create] }
    set key "$scheme|$resname"
    if {[dict exists $_untabled_resname_noted $key]} { return }
    dict set _untabled_resname_noted $key 1
    catch {vmdcon -warn "VMDPathFinder: residue \"$resname\" is not in the $scheme amino-acid table - using the neutral default ($value) for it. For non-protein residues prefer the Kapcha-Rossky (atom-level) or water schemes."}
}

proc ::VMDPathFinder::kd_hydrophobicity {resname} {
    # Kyte-Doolittle hydropathy index (dimensionless).
    # Positive = hydrophobic, negative = hydrophilic. Range: -4.5 (Arg) to +4.5 (Ile).
    # Kyte J, Doolittle RF. J Mol Biol. 1982;157(1):105-32.
    # doi:10.1016/0022-2836(82)90515-0
    # Verified against Table 2 of the paper (all 20 values match exactly).
    switch -- [string toupper $resname] {
        ILE { return  4.5 }
        VAL { return  4.2 }
        LEU { return  3.8 }
        PHE { return  2.8 }
        CYS { return  2.5 }
        MET { return  1.9 }
        ALA { return  1.8 }
        GLY { return -0.4 }
        THR { return -0.7 }
        SER { return -0.8 }
        TRP { return -0.9 }
        TYR { return -1.3 }
        PRO { return -1.6 }
        HIS - HSE - HSD - HSP - HID - HIE - HIP { return -3.2 }
        GLN       { return -3.5 }
        ASN       { return -3.5 }
        GLU - GLUP { return -3.5 }
        ASP - ASPP { return -3.5 }
        LYS       { return -3.9 }
        ARG       { return -4.5 }
        default   { _note_untabled_resname "Kyte-Doolittle" $resname 0.0; return 0.0 }
    }
}

proc ::VMDPathFinder::ww_hydrophobicity {resname} {
    # Wimley-White whole-residue interfacial hydrophobicity scale (kcal/mol).
    # Values are ΔG^residue_X from Table 1: free energy of transferring residue X
    # from POPC bilayer interface to water, relative to Gly, at pH 8.
    # Positive = hydrophobic (favours interface); negative = hydrophilic (favours water).
    # Sign is unchanged from the paper. Range: -2.02 (Glu) to +1.85 (Trp).
    # Wimley WC, White SH. Nat Struct Biol. 1996;3(10):842-8.
    # doi:10.1038/nsb1096-842
    # Verified against Table 1 of the paper (all 20 values match exactly).
    # Note: AAindex WIMW960101 stores absolute peptide ΔG, not per-residue ΔΔG,
    # and cannot be used to cross-check individual values here.
    switch -- [string toupper $resname] {
        TRP              { return  1.85 }
        PHE              { return  1.13 }
        TYR              { return  0.94 }
        LEU              { return  0.56 }
        ILE              { return  0.31 }
        MET              { return  0.23 }
        CYS              { return  0.24 }
        VAL              { return -0.07 }
        ALA              { return -0.17 }
        GLY              { return -0.01 }
        SER              { return -0.13 }
        THR              { return -0.14 }
        PRO              { return -0.45 }
        ASN              { return -0.42 }
        GLN              { return -0.58 }
        HIS - HSE - HSD - HSP - HID - HIE - HIP { return -0.17 }
        ARG              { return -0.81 }
        LYS              { return -0.99 }
        ASP - ASPP       { return -1.23 }
        GLU - GLUP       { return -2.02 }
        default { _note_untabled_resname "Wimley-White" $resname 0.0; return 0.0 }
    }
}

proc ::VMDPathFinder::chap_leu_hydrophobicity {} {
    # CHAP's shipped table normalises every residue by exactly -2.41 except LEU,
    # which repeats ILE's value: LEU's own raw -0.69 gives 0.28630705, not
    # 0.33609959. We use the correct value, EXCEPT in CHAP mode, where matching
    # a real CHAP run matters more than being right. "Fix LEU" overrides that.
    variable state
    set chap [expr {[info exists state(chap_mode)] && $state(chap_mode)}]
    set fix  [expr {[info exists state(chap_fix_leu)] && $state(chap_fix_leu)}]
    return [expr {($chap && !$fix) ? 0.33609959 : 0.28630705}]
}

proc ::VMDPathFinder::chap_ww_hydrophobicity {resname} {
    # CHAP's OWN normalized Wimley-White scale, [-1,1] - NOT ww_hydrophobicity's raw
    # kcal/mol interface scale, which CHAP does not use. Verbatim from CHAP's shipped
    # wimley_white_1996.json apart from LEU (see chap_leu_hydrophobicity).
    switch -- [string toupper $resname] {
        ILE              { return  0.33609959 }
        LEU              { return  [chap_leu_hydrophobicity] }
        PHE              { return  0.24066390 }
        VAL              { return  0.21991701 }
        MET              { return  0.18257261 }
        PRO              { return  0.12863071 }
        TRP              { return  0.09958506 }
        TYR              { return -0.09543568 }
        CYS              { return -0.09128631 }
        GLN              { return -0.07883817 }
        THR              { return -0.04564315 }
        ALA - SER        { return -0.13692946 }
        ASN              { return -0.17842324 }
        GLY              { return -0.47302905 }
        HIS - HSE - HSD - HSP - HID - HIE - HIP { return -0.56846473 }
        GLU - GLUP       { return -0.66804979 }
        LYS              { return -0.75103734 }
        ARG              { return -0.41493776 }
        ASP - ASPP       { return -1.00000000 }
        default { _note_untabled_resname "Wimley-White (CHAP)" $resname 0.0; return 0.0 }
    }
}

proc ::VMDPathFinder::charge_property {resname} {
    # Formal side-chain charge at pH 7 (standard biochemistry; pKa values from
    # Fersht AR. Structure and Mechanism in Protein Science. Freeman, 1999).
    # ARG/LYS +1; ASP/GLU -1; HIS neutral (protonated HSP/HIP +1).
    # This is a per-residue value - pore-facing selects which charged residues
    # face the lumen.
    # ASPP/GLUP (CHARMM) and ASH/GLH (AMBER) are the PROTONATED acid forms and
    # are formally NEUTRAL - they must NOT share ASP/GLU's -1 (only the FORMAL
    # CHARGE distinguishes them; the hydropathy/polarity/etc. tables below may
    # still treat them like their parent side chain, which is defensible there).
    switch -- [string toupper $resname] {
        ARG               { return  1.0 }
        LYS               { return  1.0 }
        HSP - HIP         { return  1.0 }
        ASP               { return -1.0 }
        GLU               { return -1.0 }
        ASPP - GLUP - ASH - GLH { return  0.0 }
        default           { return  0.0 }
    }
}

proc ::VMDPathFinder::polarity_property {resname} {
    # Grantham polarity index (p). Range 4.9 (Leu, least polar) to 13.0 (Asp, most polar).
    # Grantham R. Science. 1974;185(4154):862-4.
    # doi:10.1126/science.185.4154.862
    switch -- [string toupper $resname] {
        ASP - ASPP { return 13.0 }
        GLU - GLUP { return 12.3 }
        ASN        { return 11.6 }
        LYS        { return 11.3 }
        ARG        { return 10.5 }
        GLN        { return 10.5 }
        HIS - HSE - HSD - HSP - HID - HIE - HIP { return 10.4 }
        SER        { return  9.2 }
        GLY        { return  9.0 }
        ALA        { return  8.1 }
        THR        { return  8.6 }
        PRO        { return  8.0 }
        TYR        { return  6.2 }
        VAL        { return  5.9 }
        MET        { return  5.7 }
        CYS        { return  5.5 }
        TRP        { return  5.4 }
        ILE        { return  5.2 }
        PHE        { return  5.2 }
        LEU        { return  4.9 }
        default { _note_untabled_resname "Grantham polarity" $resname 8.0; return 8.0 }
    }
}

proc ::VMDPathFinder::lipophilicity_property {resname} {
    # Fauchere-Pliska side-chain lipophilicity (pi, octanol/water logP of
    # the side-chain analogue). Positive = lipophilic. Range -1.01 (Arg) to 2.25 (Trp).
    # Fauchere JL, Pliska V. Eur J Med Chem Chim Ther. 1983;18(4):369-75.
    # Verified against AAindex FAUJ830101 (all 20 values match exactly).
    switch -- [string toupper $resname] {
        TRP        { return  2.25 }
        ILE        { return  1.80 }
        PHE        { return  1.79 }
        LEU        { return  1.70 }
        CYS        { return  1.54 }
        MET        { return  1.23 }
        VAL        { return  1.22 }
        TYR        { return  0.96 }
        PRO        { return  0.72 }
        ALA        { return  0.31 }
        THR        { return  0.26 }
        HIS - HSE - HSD - HSP - HID - HIE - HIP { return  0.13 }
        GLY        { return  0.00 }
        SER        { return -0.04 }
        GLN        { return -0.22 }
        ASN        { return -0.60 }
        GLU - GLUP { return -0.64 }
        ASP - ASPP { return -0.77 }
        LYS        { return -0.99 }
        ARG        { return -1.01 }
        default { _note_untabled_resname "lipophilicity" $resname 0.00; return 0.00 }
    }
}

proc ::VMDPathFinder::kr_static {resname atomname} {
    # Kapcha-Rossky binary atomic hydrophobicity for structures WITHOUT partial charges (e.g.
    # a bare crystal/cryo-EM PDB): +1 hydrophobic, -1 polar. Kapcha LH, Rossky PJ. J Mol Biol.
    # 2014;426(2):484-98. The paper uses -1 hydrophobic / +1 polar; this proc flips the sign so
    # +1 is hydrophobic (the warm end of the diverging scale). Reproduces the paper's |q|<0.25 e
    # (OPLS-AA) rule from the atom name alone:
    #   N, O, S, P           -> polar  (-1)      (Pro N -> +1: tertiary amine, |q|~0.14)
    #   C (name "C" exactly) -> polar  (-1)      (backbone carbonyl)
    #   CA, CB, other C      -> hydrophobic (+1) (except ASN CG, GLN CD, ASP CG, GLU CD, ARG CZ)
    #   H on a heteroatom    -> polar  (-1);   H on carbon -> hydrophobic (+1)
    # When partial charges ARE loaded (PSF+DCD etc.), compute_sphere_hydro uses |q|<0.25
    # directly and never calls this proc.
    set nm [string toupper [string trim $atomname]]
    set rn [string toupper $resname]
    if {[string is digit [string index $nm 0]]} { set nm [string range $nm 1 end] }
    set el [string index $nm 0]
    # Pro N is a tertiary amine (no NH proton); OPLS-AA |q|~0.14 e < 0.25 → hydrophobic.
    # All other N, O, S, P atoms are polar (|q| > 0.25 in OPLS-AA).
    if {$rn eq "PRO" && $nm eq "N"} { return 1.0 }
    if {$el in {N O S P}} { return -1.0 }
    if {$el eq "C"} {
        if {$nm eq "C"} { return -1.0 }
        switch -- $rn {
            ASN        { if {$nm eq "CG"} { return -1.0 } }
            GLN        { if {$nm eq "CD"} { return -1.0 } }
            ASP - ASPP { if {$nm eq "CG"} { return -1.0 } }
            GLU - GLUP { if {$nm eq "CD"} { return -1.0 } }
            ARG        { if {$nm eq "CZ"} { return -1.0 } }
        }
        return 1.0
    }
    if {$el eq "H"} {
        if {$nm in {H HN H1 H2 H3 HZ HZ1 HZ2 HZ3 HH HH11 HH12 HH21 HH22 HD21 HD22 HE21 HE22}} {
            return -1.0
        }
        switch -- $rn {
            SER        { if {$nm eq "HG"}  { return -1.0 } }
            CYS        { if {$nm eq "HG"}  { return -1.0 } }
            THR        { if {$nm eq "HG1"} { return -1.0 } }
            TYR        { if {$nm eq "HH"}  { return -1.0 } }
            TRP        { if {$nm eq "HE1"} { return -1.0 } }
            ARG        { if {$nm eq "HE"}  { return -1.0 } }
            HIS - HSD - HSE - HSP - HID - HIE - HIP { if {$nm in {HD1 HE2}} { return -1.0 } }
        }
        return 1.0
    }
    return 1.0
}

proc ::VMDPathFinder::canonical_resname {rn} {
    # Map well-defined non-standard residue names to their standard parent so the
    # property scales use the correct value instead of falling through to the
    # neutral default. D-amino acids have an IDENTICAL side chain to their L form,
    # so they legitimately share every side-chain scale (kd/ww/polarity/lipo/charge)
    # - this matters for gramicidin (1GRM), where D-amino acids (DLE/DVA) make up
    # about half the residues. Extend this map for other unambiguous aliases; do
    # NOT add caps/ligands whose side-chain scale is a real scientific question
    # (e.g. FVA, ETA) - those should warn (below), not be guessed.
    switch -- [string toupper $rn] {
        DLE { return LEU }
        DVA { return VAL }
        default { return [string toupper $rn] }
    }
}

# Recognised residues (20 standard + common protonation/tautomer variants) - used
# only to decide whether an UNKNOWN residue deserves a one-time warning.
namespace eval ::VMDPathFinder {
    variable STD_RESIDUES_SET [dict create \
        ALA 1 ARG 1 ASN 1 ASP 1 CYS 1 GLN 1 GLU 1 GLY 1 HIS 1 ILE 1 \
        LEU 1 LYS 1 MET 1 PHE 1 PRO 1 SER 1 THR 1 TRP 1 TYR 1 VAL 1 \
        HSD 1 HSE 1 HSP 1 HID 1 HIE 1 HIP 1 ASH 1 GLH 1 ASPP 1 GLUP 1 CYX 1 CYM 1 LYN 1 TYM 1]
    variable _resname_warned [dict create]
    variable _mole_resname_warned [dict create]
}

proc ::VMDPathFinder::residue_property {prop resname} {
    # Single dispatch for every supported per-residue property scale. Values are
    # taken from the original papers, RAW (real units) - the color step normalizes
    # via the scale's range.
    variable STD_RESIDUES_SET
    variable _resname_warned
    set orig [string toupper $resname]
    set resname [canonical_resname $orig]
    # Warn ONCE about ANY non-standard residue name: prefer flagging likely modified
    # residues for the user to check over silently guessing a value. This fires
    # whether the name was mapped to a standard parent (a D-amino
    # acid - identical side chain, so the value is exact but the user should still
    # confirm it is really a D-form) or falls through to a neutral default (a genuinely
    # unknown residue whose color cannot be trusted). Only the well-established,
    # side-chain-identical D-amino acids are auto-mapped; everything else is defaulted
    # and flagged, never guessed.
    if {![dict exists $STD_RESIDUES_SET $orig] && ![dict exists $_resname_warned $orig]} {
        dict set _resname_warned $orig 1
        if {$resname ne $orig} {
            _note "Non-standard residue \"$orig\" is being colored as \"$resname\" (identical side chain, e.g. a D-amino acid). Verify this mapping before publishing." warn
        } else {
            _note "Residue \"$orig\" is not recognised and is using a NEUTRAL default property value, which is almost certainly wrong for its chemistry. Map it in canonical_resname, or exclude it from the property coloring." warn
        }
    }
    switch -- $prop {
        kd            { return [kd_hydrophobicity   $resname] }
        ww            { return [ww_hydrophobicity   $resname] }
        chap_ww       { return [chap_ww_hydrophobicity $resname] }
        charge        { return [charge_property      $resname] }
        polarity      { return [polarity_property    $resname] }
        lipophilicity { return [lipophilicity_property $resname] }
        logp - logd - logs - mutability - ionizable {
            # MOLE 2's own table (mole_lining.c), reused verbatim for pore mode
            # so the same residue reports the same number in both modes.
            # Deliberately NOT offered here: "hydropathy" (numerically identical
            # to kd - the same values under a second name), and MOLE's
            # "polarity"/"hydrophobicity" (different scales from the
            # grantham/kd/ww ones already listed, so sharing a picker with them
            # under near-identical names would invite silent mis-comparison).
            return [mole_residue_property $prop $resname]
        }
        default       { return [kd_hydrophobicity   $resname] }
    }
}

proc ::VMDPathFinder::mole_residue_property {prop resname} {
    # MOLE 2's own TunnelPhysicoChemicalPropertyTable (PhysicoChemicalProperties.cs),
    # transcribed from native/mole/mole_lining.c:34-54 - the exact per-residue
    # constants that C engine's per-layer aggregates are built from. Used ONLY by
    # write_tunnel_hydro3d_residue_sidecar for tunnel mode's per-residue accurate-3D
    # anchor value; Fill/Trends/the tunnel-level W/Y records keep reading
    # mole_lining.c's own length-weighted layer aggregates via _tunnel_parse_lining,
    # untouched by this table. property_meta's hydropathy/hydrophobicity/logp/logd/
    # logs/mutability bounds already equal this table's own true min/max (by
    # design - see property_meta's comment), so no separate range is needed to
    # normalize what this returns.
    variable _mole_resname_warned
    set rn [string toupper $resname]
    switch -- $rn {
        HSD - HSE - HSP - HID - HIE - HIP { set rn HIS }
        ASPP { set rn ASP }
        GLUP { set rn GLU }
        DLE  { set rn LEU }
        DVA  { set rn VAL }
    }
    switch -- $rn {
        ALA { set r {charge 0  ionizable 0 mutability 100 hydropathy  1.8 hydrophobicity  0.02 polarity  0.00 logp  1.08 logd  1.08 logs  0.59} }
        ARG { set r {charge 1  ionizable 1 mutability  83 hydropathy -4.5 hydrophobicity -0.42 polarity 52.00 logp -0.08 logd -2.49 logs  1.63} }
        ASN { set r {charge 0  ionizable 0 mutability 104 hydropathy -3.5 hydrophobicity -0.77 polarity  3.38 logp -1.03 logd -1.03 logs  0.54} }
        ASP { set r {charge -1 ionizable 1 mutability  86 hydropathy -3.5 hydrophobicity -1.04 polarity 49.70 logp -0.22 logd -3.00 logs  2.63} }
        CYS { set r {charge 0  ionizable 0 mutability  44 hydropathy  2.5 hydrophobicity  0.77 polarity  1.48 logp  0.84 logd  0.84 logs  0.16} }
        GLU { set r {charge -1 ionizable 1 mutability  77 hydropathy -3.5 hydrophobicity -1.14 polarity 49.90 logp  0.48 logd -2.12 logs  2.23} }
        GLN { set r {charge 0  ionizable 0 mutability  84 hydropathy -3.5 hydrophobicity -1.10 polarity  3.53 logp -0.33 logd -0.33 logs  0.13} }
        GLY { set r {charge 0  ionizable 0 mutability  50 hydropathy -0.4 hydrophobicity -0.80 polarity  0.00 logp  0.00 logd  0.00 logs  0.00} }
        HIS { set r {charge 0  ionizable 0 mutability  91 hydropathy -3.2 hydrophobicity  0.26 polarity 51.60 logp -0.01 logd -0.11 logs -0.20} }
        ILE { set r {charge 0  ionizable 0 mutability 103 hydropathy  4.5 hydrophobicity  1.81 polarity  0.13 logp  2.24 logd  2.24 logs -1.85} }
        LEU { set r {charge 0  ionizable 0 mutability  54 hydropathy  3.8 hydrophobicity  1.14 polarity  0.13 logp  2.08 logd  2.08 logs -1.79} }
        LYS { set r {charge 1  ionizable 1 mutability  72 hydropathy -3.9 hydrophobicity -0.41 polarity 49.50 logp  0.70 logd -1.91 logs  1.46} }
        MET { set r {charge 0  ionizable 0 mutability  93 hydropathy  1.9 hydrophobicity  1.00 polarity  1.43 logp  1.48 logd  1.48 logs -0.72} }
        PHE { set r {charge 0  ionizable 0 mutability  51 hydropathy  2.8 hydrophobicity  1.35 polarity  0.35 logp  2.49 logd  2.49 logs -1.81} }
        PRO { set r {charge 0  ionizable 0 mutability  58 hydropathy -1.6 hydrophobicity -0.09 polarity  1.58 logp  1.80 logd  1.80 logs -1.30} }
        SER { set r {charge 0  ionizable 0 mutability 117 hydropathy -0.8 hydrophobicity -0.97 polarity  1.67 logp -0.52 logd -0.52 logs  1.11} }
        THR { set r {charge 0  ionizable 0 mutability 107 hydropathy -0.7 hydrophobicity -0.77 polarity  1.66 logp -0.16 logd -0.16 logs  0.77} }
        TRP { set r {charge 0  ionizable 0 mutability  25 hydropathy -0.9 hydrophobicity  1.71 polarity  2.10 logp  2.59 logd  2.59 logs -2.48} }
        TYR { set r {charge 0  ionizable 0 mutability  50 hydropathy -1.3 hydrophobicity  1.11 polarity  1.61 logp  2.18 logd  2.18 logs -1.44} }
        VAL { set r {charge 0  ionizable 0 mutability  98 hydropathy  4.2 hydrophobicity  1.13 polarity  0.13 logp  1.80 logd  1.80 logs -1.30} }
        default {
            if {![dict exists $_mole_resname_warned $rn]} {
                dict set _mole_resname_warned $rn 1
                _note "Residue \"$rn\" is not in MOLE's physicochemical table and is using a NEUTRAL default value (0), which is almost certainly wrong for its chemistry." warn
            }
            set r {charge 0 ionizable 0 mutability 0 hydropathy 0.0 hydrophobicity 0.0 polarity 0.0 logp 0.0 logd 0.0 logs 0.0}
        }
    }
    if {[dict exists $r $prop]} { return [dict get $r $prop] }
    return 0.0
}

proc ::VMDPathFinder::property_meta {prop} {
    # Metadata for a property scale:
    #   label  full display name
    #   lo hi  scale extremes (lo at the low/-ve end)
    #   signed 1 = diverging around 0 (blue-white-red); 0 = sequential (white-red)
    #   loend hiend  end-cap labels for the scale bar
    #
    # dens/pfdens: the stored value is DEPLETION, clamp(1 - rho/rho_bulk, -1, 1),
    # not raw rho/rho_bulk - see _dens_at_z. +1 means fully DRY, not density 1x
    # bulk, so the label must not read as a plain density.
    #
    # NOTE these notes MUST stay outside the switch body. A switch body is
    # parsed as a LIST, so a '#' line inside it is not a comment - its words
    # become spurious pattern/body pairs, and a quoted phrase followed by a
    # comma is outright invalid list syntax ("list element in quotes followed
    # by \",\"").
    #
    # hydropathy/hydrophobicity/ionizable/logp/logd/logs/mutability below are
    # MOLE tunnel-lining properties, not HOLE surface ones - lo/hi are
    # mole_lining.c's own 20-residue table's true min/max (+ backbone
    # constants), the same kind of theoretical bound as kd/ww/etc above, not a
    # per-frame data range. hydropathy is numerically Kyte-Doolittle (that
    # table's own min/max is exactly -4.5/4.5) - reuse kd's entry rather than
    # restate the same numbers under a second name. charge and ionizable are
    # NOT in this "bounded average" sense - see _tunnel_property_range, which
    # keeps their lo/hi data-derived because mole_lining.c sums them over
    # every lining residue with no division by count; only signed matters
    # here for those two (ionizable is a non-negative count, charge a net sum
    # that legitimately spans zero).
    switch -- $prop {
        watermelon { return [dict create label "radius, watermelon bands" lo 0 hi 18 signed 0 loend closed hiend wide] }
        kd      { return [dict create label "kyte-doolittle hydropathy" lo -4.5  hi 4.5  signed 1 loend hydrophilic hiend hydrophobic] }
        ww      { return [dict create label "wimley-white interface hydrophobicity" lo -2.02 hi 1.85 signed 1 loend hydrophilic hiend hydrophobic] }
        kr      { return [dict create label "kapcha-rossky atomic" lo -1.0 hi 1.0 signed 1 loend polar hiend hydrophobic] }
        charge  { return [dict create label "formal charge (pH 7)" lo -1.0 hi 1.0 signed 1 loend negative hiend positive] }
        polarity { return [dict create label "grantham polarity" lo 4.9 hi 13.0 signed 0 loend nonpolar hiend polar] }

        lipophilicity { return [dict create label "fauchère-pliska lipophilicity" lo -1.01 hi 2.25 signed 1 loend hydrophilic hiend lipophilic] }
        esp           { return [dict create label "electrostatic potential (relative, kcal/mol/e)" lo 0.0 hi 300.0 signed 0 loend "cation-fav." hiend "anion-fav."] }
        gz            { return [dict create label "water free energy G(z)" lo -5.0 hi 5.0 signed 1 loend "wet / open" hiend "dry / gated"] }
        dens          { return [dict create label "water depletion 1 - ρ/ρ_bulk" lo -1.0 hi 1.0 signed 1 loend "dense" hiend "dry"] }
        pfdens        { return [dict create label "water depletion 1 - ρ/ρ_bulk, this frame" lo -1.0 hi 1.0 signed 1 loend "dense" hiend "dry"] }

        hydropathy      { return [property_meta kd] }
        hydrophobicity  { return [dict create label "MOLE hydrophobicity" lo -1.14 hi 1.81 signed 1 loend hydrophilic hiend hydrophobic] }
        ionizable       { return [dict create label "ionizable residue count" lo 0 hi 1 signed 0 loend "none" hiend "many"] }
        logp            { return [dict create label "MOLE LogP (lipophilicity)" lo -1.03 hi 2.59 signed 1 loend hydrophilic hiend lipophilic] }
        logd            { return [dict create label "MOLE LogD (distribution coeff.)" lo -3.00 hi 2.59 signed 1 loend hydrophilic hiend lipophilic] }
        logs            { return [dict create label "MOLE LogS (solubility)" lo -2.48 hi 2.63 signed 1 loend soluble hiend insoluble] }
        mutability      { return [dict create label "MOLE mutability" lo 25 hi 117 signed 0 loend conserved hiend variable] }

        default { return [dict create label "kyte-doolittle hydropathy" lo -4.5 hi 4.5 signed 1 loend hydrophilic hiend hydrophobic] }
    }
}

proc ::VMDPathFinder::scheme_display_label {key} {
    # Lower-case labels, acronyms/symbols kept as-is (JSON, G(z)). Shared with
    # the picker menus (_property_scheme_choices).
    switch -- $key {
        watermelon   { return "watermelon (radius)" }
        kd           { return "kyte-doolittle" }
        ww           { return "wimley-white" }
        chap_ww      { return "wimley-white (octanol-interface)" }
        kr           { return "kapcha-rossky" }
        charge       { return "formal charge" }
        polarity     { return "grantham polarity" }
        lipophilicity { return "fauchère-pliska" }
        esp          { return "electrostatic potential" }
        gz           { return "water G(z)" }
        dens         { return "water density" }
        pfdens       { return "water density, this frame" }
        logp         { return "MOLE logP" }
        logd         { return "MOLE logD" }
        logs         { return "MOLE logS" }
        mutability   { return "MOLE mutability" }
        ionizable    { return "MOLE ionizable" }
        default      { return $key }
    }
}

