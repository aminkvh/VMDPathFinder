# ==============================================================================
#  9. CLI
# ==============================================================================

proc hole::main {argv} {
    # -mclen/-mckt must NOT default to the exact double 0.1.
    # hole.f's own defaults are "MCLEN = 0.1" and "MCKTIN = 0.1" - bare REAL
    # literals (no D0 suffix), which Fortran evaluates in SINGLE precision
    # and then widens to double on assignment, i.e. the real binary's actual
    # default is DOUBLE(FLOAT32(0.1)) = 0.10000000149011612, not exact double
    # 0.1 - a ~1.5e-9 absolute difference that matters because it is fed
    # straight into honewp's per-step displacement scale and the Metropolis
    # PROB denominator, both leveraged points in a chaotic annealing walk.
    # Found the same way as hole::rng::kick_off: a step-by-step trace against
    # an instrumented holcal.f/honewp.f showed HONEWP's step-2 NEWCEN
    # disagreeing by ~1e-8 relative even with the RNG stream and CPOINT
    # exactly aligned; fixing MCLEN/MCKTIN to this value closed it to
    # print-precision noise (see vmdpathfinder/hole_tcl/README.md's HOLCAL trace section).
    # Any card-supplied -mclen/-mckt (or a real MCDISP/MCKT control card) is
    # unaffected - this only corrects the no-card DEFAULT path, which is what
    # "MCLEN 0.1, kT 0.1" in this file's own banner-matching claim means.
    array set o {
        -pdb "" -cpoint "" -cvect "" -sample 0.25 -endrad 22.0
        -rad "" -seed 1 -sph "" -csv "" -mcstep 1000 -mclen 0.10000000149011612
        -mckt 0.10000000149011612
        -method spherical -probe 1.15 -grid {}
    }
    if {[llength $argv] % 2 != 0} { error "hole.tcl: options must come in pairs" }
    array set o $argv
    if {$o(-pdb) eq ""} {
        puts stderr "usage: tclsh hole.tcl -pdb FILE ?-cpoint \"x y z\"? ?-cvect \"x y z\"?"
        puts stderr "                      ?-sample N? ?-endrad N? ?-rad FILE? ?-seed N?"
        puts stderr "                      ?-sph OUT.sph? ?-csv OUT.csv?"
        puts stderr "                      ?-method spherical|capsule|connolly?"
        puts stderr "                      ?-probe 1.15? ?-grid N?  (connolly only, CONNR(1)/CONNR(2))"
        exit 2
    }
    if {$o(-method) ni {spherical capsule connolly}} {
        error "hole.tcl: -method must be spherical, capsule or connolly, got $o(-method)"
    }
    hole::rng::seed_like_drand $o(-seed)
    # hole.f:549 - see hole::rng::kick_off's header. Ordered before CGUESS
    # below to match the real source (hole.f calls this at line 549, CGUESS
    # at line 625), though CGUESS itself draws nothing so the order has no
    # numeric effect - only the search calls after this point are offset.
    hole::rng::kick_off
    lassign [read_pdb $o(-pdb) $o(-rad)] n xs ys zs rs ans
    if {$n == 0} { error "hole.tcl: no atoms read from $o(-pdb)" }

    set cp $o(-cpoint)
    if {$cp eq ""} {
        # NOT a plain centre-of-geometry.
        # Real HOLE does NOT do that when CPOINT is absent - hole.f calls
        # CGUESS (cguess.f), which seeds from a CA (or all-atom) centroid and
        # then hill-climbs it on a 3x3x3/1-Angstrom grid for 5 cycles. See
        # hole::cguess_cpoint above.
        set cp [cguess_cpoint $n $xs $ys $zs $rs $ans]
    }
    # CVECT is guessed SEPARATELY, from whatever CPOINT we ended up with -
    # hole.f:623 enters CGUESS if EITHER card is missing, and cguess.f then
    # tests for each one independently.
    set cv $o(-cvect)
    if {$cv eq ""} {
        set cv [cguess_cvect [lindex $cp 0] [lindex $cp 1] [lindex $cp 2] \
                    $n $xs $ys $zs $rs]
    }

    set t0 [clock milliseconds]
    if {$o(-method) eq "capsule"} {
        lassign [capsule -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
            -cpoint $cp -cvect $cv -sample $o(-sample) -endrad $o(-endrad) \
            -mcstep $o(-mcstep) -mclen $o(-mclen) -mckt $o(-mckt)] rows discovery
        set dt [expr {[clock milliseconds] - $t0}]

        set minr 1e30; set minz 0.0
        foreach row $rows {
            lassign $row t cx cy cz lvx lvy lvz rad a1 a2
            if {$rad < $minr} { set minr $rad; set minz $t }
        }
        puts [format "hole.tcl %s (CAPSULE): %d atoms, %d slices, %d ms" \
            $hole::VERSION $n [llength $rows] $dt]
        puts [format "minimum effective radius %.4f A at axial coordinate %.3f" $minr $minz]
        if {$o(-sph) ne ""} {
            write_capsule_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
                -cvect $cv -sample $o(-sample) -endrad $o(-endrad)
            puts "wrote $o(-sph)"
        }
        if {$o(-csv) ne ""} { write_capsule_csv $rows $o(-csv); puts "wrote $o(-csv)" }
        return
    }

    # profile now returns TWO views of the same search - $rows sorted by
    # axial coordinate (unchanged contract; every consumer below still uses
    # this) and $discovery in the real binary's own discovery order/IREC
    # numbering, needed only by write_sph - see hole::profile's own header.
    lassign [profile -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
        -cpoint $cp -cvect $cv -sample $o(-sample) -endrad $o(-endrad) \
        -mcstep $o(-mcstep) -mclen $o(-mclen) -mckt $o(-mckt)] rows discovery
    set dt [expr {[clock milliseconds] - $t0}]

    if {$o(-method) eq "connolly"} {
        # CONN's own centre is holcal.f's LOWCEN for that slice - exactly what
        # $rows already holds (the annealed spherical answer), never a fresh
        # search - see concal.f/holcal.f, and connolly.tcl's header.
        lassign $cv cvx cvy cvz
        set cvn [expr {sqrt($cvx*$cvx + $cvy*$cvy + $cvz*$cvz)}]
        set cvx [expr {$cvx/$cvn}]; set cvy [expr {$cvy/$cvn}]; set cvz [expr {$cvz/$cvn}]
        set ncvect [list $cvx $cvy $cvz]
        lassign [calper $ncvect] perpve perpvn

        set t1 [clock milliseconds]
        set requivs {}
        foreach row $rows {
            lassign $row t x y z rad
            set res [connolly -centre [list $x $y $z] -cvect $ncvect \
                        -perpve $perpve -perpvn $perpvn \
                        -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
                        -endrad $o(-endrad) -probe $o(-probe) -grid $o(-grid) \
                        -sample $o(-sample)]
            lappend requivs [dict get $res requiv]
        }
        set dtconn [expr {[clock milliseconds] - $t1}]

        # CRATIO: mean(requiv/rad) over slices whose Connolly search did NOT
        # escape - hograp.f 233-247, needed BEFORE any RESTIM/CTORES below.
        set cratsum 0.0; set cratno 0
        foreach row $rows requiv $requivs {
            lassign $row t x y z rad
            if {$requiv < 1.0e6} {
                set cratsum [expr {$cratsum + $requiv/$rad}]
                incr cratno
            }
        }
        set cratio [expr {$cratno > 0 ? $cratsum/double($cratno) : 0.0}]

        set pi [expr {2.0*asin(1.0)}]
        set toresi 0.0; set ctores 0.0
        set minr 1e30; set minz 0.0
        set minequiv 1e30
        set connrows {}
        set sample [expr {abs($o(-sample))}]
        set prevrow {}
        foreach row $rows requiv $requivs {
            lassign $row t x y z rad
            if {$prevrow ne ""} {
                lassign $prevrow pt px py pz prad
                set mx [expr {0.5*($px+$x)}]; set my [expr {0.5*($py+$y)}]; set mz [expr {0.5*($pz+$z)}]
                lassign [holeen $mx $my $mz $n $xs $ys $zs $rs] meng
                set mrad [expr {-$meng}]
                set toresi [expr {$toresi + 0.5*$sample/($pi*$mrad*$mrad)}]
            }
            set toresi [expr {$toresi + 0.5*$sample/($pi*$rad*$rad)}]
            # RESTIM: hograp.f 336-343 - substitute CRATIO*rad for an escaped
            # (>=1e6) slice's Requiv so the running sum stays finite.
            if {$requiv > 0.999e6} {
                set restim [expr {$cratio*$rad}]
            } else {
                set restim $requiv
            }
            if {$restim > 0.0} {
                set ctores [expr {$ctores + $sample/($pi*$restim*$restim)}]
            }
            if {$rad < $minr} { set minr $rad; set minz $t }
            if {$requiv < $minequiv} { set minequiv $requiv }
            lappend connrows [list $t $x $y $z $rad $requiv $restim]
            set prevrow $row
        }
        set gmacro [expr {$toresi > 0 ? 1200.0/$toresi : 0.0}]
        set conngmacro [expr {$ctores > 0 ? 1200.0/$ctores : 0.0}]

        puts [format "hole.tcl %s (CONNOLLY): %d atoms, %d slices, %d ms search + %d ms connolly" \
            $hole::VERSION $n [llength $rows] $dt $dtconn]
        puts [format "minimum radius %.4f A at axial coordinate %.3f" $minr $minz]
        puts [format "minimum equivR found: %.4f A" $minequiv]
        puts [format "Gmacro (spherical)= %.4g pS/M   Conn_Gmacro= %.4g pS/M   (1M KCl, rho=1/12 ohm.m)" \
            $gmacro $conngmacro]
        if {$o(-sph) ne ""} {
            write_connolly_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
                -cvect $cv -sample $o(-sample) -endrad $o(-endrad) \
                -probe $o(-probe) -grid $o(-grid)
            puts "wrote $o(-sph)"
        }
        if {$o(-csv) ne ""} { write_connolly_csv $connrows $o(-csv); puts "wrote $o(-csv)" }
        return
    }

    set minr 1e30; set minz 0.0
    foreach row $rows {
        lassign $row t x y z rad
        if {$rad < $minr} { set minr $rad; set minz $t }
    }
    puts [format "hole.tcl %s: %d atoms, %d slices, %d ms" \
        $hole::VERSION $n [llength $rows] $dt]
    puts [format "minimum radius %.4f A at axial coordinate %.3f" $minr $minz]
    if {$o(-sph) ne ""} {
        write_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
            -cvect $cv -sample $o(-sample) -endrad $o(-endrad)
        puts "wrote $o(-sph)"
    }
    if {$o(-csv) ne ""} { write_csv $rows $o(-csv); puts "wrote $o(-csv)" }
}
# ===== END INLINED HOLE PURE-TCL ENGINE =====

proc ::VMDPathFinder::_hole_tcl_load {} {
    # As _mole_tcl_load: the engine is INLINED above, so this checks rather than
    # loads. Every caller must treat a 0 as "no HOLE fallback available" and say
    # so, not fail obscurely later.
    foreach p {::hole::profile ::hole::write_sph ::hole::read_pdb ::hole::holeen \
               ::hole::cguess_cpoint ::hole::rng::seed_like_drand} {
        if {![llength [info procs $p]]} { return 0 }
    }
    return 1
}

proc ::VMDPathFinder::_hole_tcl_exe {} {
    # Same auto_execok probe the AMISE workers use. A machine with no HOLE
    # binary usually still has tclsh; when it does not, the fallback declines
    # rather than freezing VMD with an in-process 40 s search.
    foreach c {tclsh tclsh8.6 tclsh8.5} {
        set p [auto_execok $c]
        if {$p ne ""} { return $p }
    }
    return ""
}

proc ::VMDPathFinder::_hole_tcl_engine_text {} {
    # The sentinel-delimited engine block, read back out of this file - the same
    # trick tests/mole_tcl_engine.tcl uses, and it fails the same way on
    # purpose: a silently empty extraction would look like a working fallback.
    variable plugin_dir
    set cands {}
    if {[info exists plugin_dir] && $plugin_dir ne ""} {
        lappend cands [file join $plugin_dir vmdpathfinder.tcl]
    }
    foreach d $::auto_path {
        lappend cands [file join $d vmdpathfinder.tcl] [file join $d vmdpathfinder vmdpathfinder.tcl]
    }
    set begin "# ===== BEGIN INLINED HOLE PURE-TCL ENGINE ====="
    set end   "# ===== END INLINED HOLE PURE-TCL ENGINE ====="
    foreach c $cands {
        if {![file readable $c]} continue
        if {[catch {open $c r} fh]} continue
        set text [read $fh]
        close $fh
        set lines [split $text "\n"]
        set b -1; set e -1; set nb 0; set ne 0; set i 0
        foreach ln $lines {
            set t [string trim $ln]
            if {$t eq $begin} { set b $i; incr nb }
            if {$t eq $end}   { set e $i; incr ne }
            incr i
        }
        # Exactly one of each, or this is not the expected region.
        if {$nb == 1 && $ne == 1 && $e > $b + 1} {
            return [join [lrange $lines [expr {$b+1}] [expr {$e-1}]] "\n"]
        }
    }
    return ""
}

proc ::VMDPathFinder::_hole_tcl_driver {} {
    # Appended to the extracted engine to make it a one-frame CLI. Lives here,
    # not in vmdpathfinder/hole_tcl/, because the profile TSV is the PLUGIN's format - the
    # standalone port writes its own CSV and knows nothing about this file.
    return {
proc ::vmdpathfinder_fb_usage {} {
    puts stderr "usage: tclsh SCRIPT -pdb F -rad F -sph F -tsv F ?-cpoint \"x y z\"?\
        ?-cvect \"x y z\"? ?-sample N? ?-endrad N? ?-seed N?\
        ?-method spherical|connolly|capsule? ?-probe N? ?-grid N?"
    puts stderr "       tclsh SCRIPT --sph-process DOTDEN COLOR IN.sph OUT.sos"
    puts stderr "       tclsh SCRIPT --sos-triangle IN.sos OUT.plot"
    puts stderr "       tclsh SCRIPT --sos-smooth OUT.sos RHO CENTRE.sos WITH.sos..."
    exit 2
}

proc ::_vmdpathfinder_fb_axial {cp cv} {
    # The CPOINT's coordinate along the channel axis, in the same frame the
    # profile's own "coord" column uses (an absolute projection, not a
    # displacement from CPOINT).
    lassign $cp px py pz
    lassign $cv vx vy vz
    set vn [expr {sqrt($vx*$vx + $vy*$vy + $vz*$vz)}]
    if {$vn <= 1.0e-12} { return 0.0 }
    return [expr {($px*$vx + $py*$vy + $pz*$vz)/$vn}]
}

proc ::vmdpathfinder_fb_tsv {rows path sample n xs ys zs rs {requivs {}} {t0 0.0}} {
    # HOLE's own printed profile table, rebuilt from the search instead of
    # parsed from its output: the sampled slices interleaved with the
    # "(mid-point)" rows HOLE also prints, cen_line_D as signed arc length along
    # the centre line zeroed at the CPOINT slice, and column 4 as its running
    # Sum ds/area. Verified column for column against the binary's own table -
    # tests/test_hole_tcl_fallback.sh.
    #
    # $requivs (one per row, CONNOLLY only) adds hograp.f's three extra columns.
    # They are filled on the SAMPLED rows only: HOLE leaves them blank on the
    # interleaved mid-points it never evaluates, and _resolve_conn_radii reads
    # that gap as "interpolate here", not as a zero.
    set pi [expr {2.0*asin(1.0)}]
    set samp [expr {abs($sample)}]
    set conn [expr {[llength $requivs] > 0}]
    # CRATIO = mean(Requiv/rad) over slices that did NOT escape (hograp.f
    # 232-244). Needed in full before any row is written - it is what the RESTIM
    # substitution below stands in with.
    set cratio 0.0
    if {$conn} {
        set csum 0.0; set cno 0
        foreach row $rows rq $requivs {
            if {$rq < 1.0e6} {
                set csum [expr {$csum + $rq/[lindex $row 4]}]
                incr cno
            }
        }
        if {$cno > 0} { set cratio [expr {$csum/double($cno)}] }
    }
    set all {}
    set prev ""
    set idx 0
    foreach row $rows {
        lassign $row t x y z rad
        if {$prev ne ""} {
            lassign $prev pt px py pz prad
            set mx [expr {0.5*($px+$x)}]
            set my [expr {0.5*($py+$y)}]
            set mz [expr {0.5*($pz+$z)}]
            lassign [hole::holeen $mx $my $mz $n $xs $ys $zs $rs] meng
            # -1 marks a mid-point: it carries no Requiv of its own.
            lappend all [list [expr {0.5*($pt+$t)}] $mx $my $mz [expr {-$meng}] -1]
        }
        lappend all [list $t $x $y $z $rad $idx]
        set prev $row
        incr idx
    }
    set all [lsort -real -index 0 $all]
    set cum 0.0
    set zero 0.0
    set zbest 1.0e30
    set prev ""
    set dists {}
    foreach r $all {
        lassign $r t x y z rad
        if {$prev ne ""} {
            lassign $prev px py pz
            set cum [expr {$cum + sqrt(($x-$px)*($x-$px) + ($y-$py)*($y-$py) \
                                       + ($z-$pz)*($z-$pz))}]
        }
        lappend dists $cum
        # cen.line.dis is arc length measured FROM THE CPOINT SLICE, so the zero
        # is the row at the CPOINT's own axial coordinate - not the row at
        # absolute coordinate 0. Those coincide only when CPOINT happens to
        # project onto the origin, which a pinned "cpoint 0 0 0" guarantees and
        # a GUESSED cpoint almost never does: HOLE's CGUESS returns the CA
        # centroid, and the whole column then came out shifted by the arc length
        # between the two (23.6 A on 1GRM). Nearest row rather than an exact
        # match, because $t is recomputed from the moved sample point.
        set _d0 [expr {abs($t - $t0)}]
        if {$_d0 < $zbest} { set zbest $_d0; set zero $cum }
        set prev [list $x $y $z]
    }
    # Truncating open with no .part/rename: sound ONLY because every caller
    # runs in a freshly created work dir and passes a relative -tsv path, so
    # no older good TSV can sit at $path. A caller handing this an existing
    # run_dir path must publish via a sibling temp instead (see parse_profile).
    set fh [open $path w]
    puts $fh "coord\tradius\tcen_line_d\tsum_s_over_area\trequiv\tconn_s_over_area\trequiv_estim\tcap_rad"
    set F 0.0
    set CF 0.0
    foreach r $all d $dists {
        lassign $r t x y z rad ri
        if {abs($rad) > 1.0e-9} { set F [expr {$F + 0.5*$samp/($pi*$rad*$rad)}] }
        set c5 ""; set c6 ""; set c7 ""
        if {$conn && $ri >= 0} {
            set rq [lindex $requivs $ri]
            # RESTIM (hograp.f 336-343): an escaped slice's Requiv is replaced by
            # CRATIO*rad, so the running Conn_s/Area stays finite.
            set re [expr {$rq > 0.999e6 ? $cratio*$rad : $rq}]
            if {$re > 0.0} { set CF [expr {$CF + $samp/($pi*$re*$re)}] }
            # F12.3 as HOLE prints them - _resolve_conn_radii keys on the literal
            # "1000000.000" escape marker, which %.5f would not produce.
            set c5 [format %.3f $rq]
            set c6 [format %.3f $CF]
            set c7 [format %.3f $re]
        }
        puts $fh [format "%.5f\t%.5f\t%.5f\t%.5f\t%s\t%s\t%s\t" \
                      $t $rad [expr {$d - $zero}] $F $c5 $c6 $c7]
    }
    close $fh
    return [llength $all]
}

proc ::vmdpathfinder_fb_tsv_capsule {disc path sample cvect n xs ys zs rs} {
    # hcapgr.f's table, which is NOT hograp.f's with different numbers:
    #   - the row centre is the capsule MID-point, 0.5*(STRCEN+STRLVC);
    #   - cen.line.dis and integ.s/(area) both RESTART at the "(+ve records)"
    #     split, so record 0 is printed twice and column 4 is not monotonic
    #     once the two halves are merged (parse_profile sorts them, and this
    #     writer emits them already sorted, so the shapes match);
    #   - integ.s/(area) takes a WHOLE sample step on sampled rows only
    #     (hcapgr.f 189: the 1/2 factor was removed in 1996), where the
    #     spherical table takes a half step on every row including mid-points.
    # $disc is hole::capsule's discovery-order twin, whose IREC numbering is
    # exactly hcapgr's SCOUNT - the sorted $rows view cannot address it.
    set pi [expr {2.0*asin(1.0)}]
    set samp [expr {abs($sample)}]
    lassign $cvect vx vy vz
    set vn [expr {sqrt($vx*$vx + $vy*$vy + $vz*$vz)}]
    set vx [expr {$vx/$vn}]; set vy [expr {$vy/$vn}]; set vz [expr {$vz/$vn}]

    array set C {}
    set hi 0; set lo 0
    foreach rec $disc {
        set irec [lindex $rec 0]
        set C($irec) [lrange $rec 2 9]
        if {$irec > $hi} { set hi $irec }
        if {$irec < $lo} { set lo $irec }
    }
    set out {}
    # -ve block first, then +ve - the order hcapgr prints, which decides where
    # the two coord-0 rows land under the stable sort below.
    # integ.s/(area) accumulates ACROSS the two blocks: hcapgr restarts its
    # printed column at the "(+ve records)" split, but HOLE's own F is the two
    # finals added, and parse_profile carries the offset for exactly that
    # reason. cen.line.dis genuinely does restart (it is signed by $dir), so
    # only this one is hoisted.
    set inarea 0.0
    foreach {dir last} [list -1 [expr {-$lo}] 1 $hi] {
        set dalong 0.0
        set prev ""
        for {set s 0} {$s <= $last} {incr s} {
            set i [expr {$dir * $s}]
            if {![info exists C($i)]} break
            lassign $C($i) cx cy cz lx ly lz effrad caprad
            set mx [expr {0.5*($cx+$lx)}]
            set my [expr {0.5*($cy+$ly)}]
            set mz [expr {0.5*($cz+$lz)}]
            set inarea [expr {$inarea + $samp/($pi*$effrad*$effrad)}]
            if {$prev ne ""} {
                lassign $prev px py pz
                set dalong [expr {$dalong + $dir*sqrt(($mx-$px)*($mx-$px) \
                    + ($my-$py)*($my-$py) + ($mz-$pz)*($mz-$pz))}]
            }
            lappend out [list [expr {$mx*$vx + $my*$vy + $mz*$vz}] \
                              $effrad $dalong $inarea $caprad]
            set prev [list $mx $my $mz]
            set j [expr {$i + $dir}]
            if {$s >= $last || ![info exists C($j)]} continue
            # Mid-point: the two capsules averaged, then re-evaluated by HCAPEN.
            # Its axis is whichever of the sum/difference mix is LONGER
            # (hcapgr.f 264-283) - the two records' own axes can point opposite
            # ways, and averaging those directly would collapse the capsule.
            lassign $C($j) qx qy qz qlx qly qlz
            set ax [expr {0.25*($cx+$lx) + 0.25*($qx+$qlx)}]
            set ay [expr {0.25*($cy+$ly) + 0.25*($qy+$qly)}]
            set az [expr {0.25*($cz+$lz) + 0.25*($qz+$qlz)}]
            set ux [expr {0.5*($cx-$lx) + 0.5*($qx-$qlx)}]
            set uy [expr {0.5*($cy-$ly) + 0.5*($qy-$qly)}]
            set uz [expr {0.5*($cz-$lz) + 0.5*($qz-$qlz)}]
            set wx [expr {0.5*($cx-$lx) - 0.5*($qx-$qlx)}]
            set wy [expr {0.5*($cy-$ly) - 0.5*($qy-$qly)}]
            set wz [expr {0.5*($cz-$lz) - 0.5*($qz-$qlz)}]
            if {$wx*$wx + $wy*$wy + $wz*$wz > $ux*$ux + $uy*$uy + $uz*$uz} {
                set ux $wx; set uy $wy; set uz $wz
            }
            lassign [hole::hcapen [expr {$ax - 0.5*$ux}] [expr {$ay - 0.5*$uy}] \
                         [expr {$az - 0.5*$uz}] [expr {$ax + 0.5*$ux}] \
                         [expr {$ay + 0.5*$uy}] [expr {$az + 0.5*$uz}] \
                         $n $xs $ys $zs $rs] teng tcaprad
            lassign $prev px py pz
            set dalong [expr {$dalong + $dir*sqrt(($ax-$px)*($ax-$px) \
                + ($ay-$py)*($ay-$py) + ($az-$pz)*($az-$pz))}]
            lappend out [list [expr {$ax*$vx + $ay*$vy + $az*$vz}] \
                              [expr {-$teng}] $dalong $inarea $tcaprad]
            set prev [list $ax $ay $az]
        }
    }
    set out [lsort -real -index 0 $out]
    # Truncating open with no .part/rename: sound ONLY because every caller
    # runs in a freshly created work dir and passes a relative -tsv path, so
    # no older good TSV can sit at $path. A caller handing this an existing
    # run_dir path must publish via a sibling temp instead (see parse_profile).
    set fh [open $path w]
    puts $fh "coord\tradius\tcen_line_d\tsum_s_over_area\trequiv\tconn_s_over_area\trequiv_estim\tcap_rad"
    # Column 8 is the capsule half-width, the only radius in this table that is
    # a steric clearance - eff.rad in column 2 is sqrt(area/pi) and reads wider.
    foreach r $out {
        lassign $r t rad cl ia cr
        puts $fh [format "%.5f\t%.5f\t%.5f\t%.5f\t\t\t\t%.5f" $t $rad $cl $ia $cr]
    }
    close $fh
    return [llength $out]
}

proc ::vmdpathfinder_fb_ignore_pdb {src dst ignres} {
    # HOLE's IGNORE card, as a pre-filter on the PDB rather than a flag inside
    # read_pdb: tsatr.f drops the atom before anything else sees it, so removing
    # the line is exactly equivalent, and this stays outside the inlined
    # engine's sentinel block.
    # The match is tsatr.f:169's own and is quirkier than "is this residue in
    # the list": the name is a FIXED 3-character field (columns 18-20,
    # blank-padded), upper-cased, tested against a CHARACTER*80 IGNRES with
    # Fortran INDEX - a SUBSTRING search. So "ignore SOL HOH" also drops a
    # residue named "OH", whose padded "OH " spans HOH's last two characters and
    # the following blank. Reproduced, not corrected: the point of the fallback
    # is to answer what the binary would have answered.
    set ig [format %-80.80s [string toupper [string trimleft $ignres]]]
    set in [open $src r]
    set out [open $dst w]
    set dropped 0
    while {[gets $in line] >= 0} {
        if {[string match "ATOM  *" $line] || [string match "HETATM*" $line]} {
            if {[string first [format %-3.3s [string toupper \
                    [string range $line 17 19]]] $ig] >= 0} {
                incr dropped
                continue
            }
        }
        puts $out $line
    }
    close $in
    close $out
    return $dropped
}

proc ::vmdpathfinder_fb_main {argv} {
    # The surface stages are the same two procs the binaries implement, so they
    # are plain subcommands rather than a second script - one extracted engine
    # serves the whole .sph -> .sos -> .plot chain.
    switch -- [lindex $argv 0] {
        --sph-process {
            if {[llength $argv] != 5} { ::vmdpathfinder_fb_usage }
            lassign $argv _ dotden color in out
            hole::sph_process $in $out $dotden $color
            puts "pure-Tcl sph_process: wrote $out"
            return
        }
        --sos-triangle {
            if {[llength $argv] != 3} { ::vmdpathfinder_fb_usage }
            lassign $argv _ in out
            hole::sos_triangle $in $out
            puts "pure-Tcl sos_triangle: wrote $out"
            return
        }
        --sos-smooth {
            if {[llength $argv] < 4} { ::vmdpathfinder_fb_usage }
            lassign $argv _ out rho centre
            set n [hole::sos_smooth $out $rho $centre [lrange $argv 4 end]]
            puts "pure-Tcl sos_smooth: wrote $out ($n dots)"
            return
        }
    }
    array set o {-pdb "" -rad "" -sph "" -tsv "" -cpoint "" -cvect "" \
                 -sample 0.25 -endrad 22.0 -seed 1 -method spherical \
                 -probe 1.15 -grid "" -ignore "" \
                 -mcstep 1000 -mclen 0.10000000149011612 -mckt 0.10000000149011612}
    if {[llength $argv] % 2 != 0} { ::vmdpathfinder_fb_usage }
    array set o $argv
    foreach k {-pdb -rad -sph -tsv} { if {$o($k) eq ""} { ::vmdpathfinder_fb_usage } }
    if {$o(-method) ni {spherical connolly capsule}} { ::vmdpathfinder_fb_usage }
    # hole::read_rad_file returns an EMPTY ruleset for a missing file rather
    # than failing, and every atom then falls back to element_radius - 0.25 A
    # out on every oxygen, per its own header. Real HOLE stops instead, and so
    # does this: a wrong-radii profile is indistinguishable from a right one.
    if {![file readable $o(-rad)]} { error "radius file not readable: $o(-rad)" }
    hole::rng::seed_like_drand $o(-seed)
    hole::rng::kick_off
    set pdb $o(-pdb)
    if {[string trim $o(-ignore)] ne ""} {
        set pdb [file join [file dirname $o(-pdb)] vmdpathfinder_ignored.pdb]
        set nd [::vmdpathfinder_fb_ignore_pdb $o(-pdb) $pdb $o(-ignore)]
        puts "ignore '$o(-ignore)': dropped $nd atom(s)"
    }
    lassign [hole::read_pdb $pdb $o(-rad)] n xs ys zs rs ans
    if {$n == 0} { error "no atoms read from $pdb" }
    set cp $o(-cpoint)
    if {$cp eq ""} { set cp [hole::cguess_cpoint $n $xs $ys $zs $rs $ans] }
    # CVECT too. The plugin's own CPOINT/CVECT fields both default to EMPTY, so
    # a control file with neither card is the ordinary case, and the binary
    # guesses both (hole.f:623 -> cguess.f). Hard-defaulting this to "0 0 1"
    # meant the fallback silently analysed a different pore whenever HOLE's own
    # guess was not the z axis - on 1GRM it guesses Y.
    set cv $o(-cvect)
    if {$cv eq ""} {
        set cv [hole::cguess_cvect [lindex $cp 0] [lindex $cp 1] [lindex $cp 2] \
                    $n $xs $ys $zs $rs]
    }
    # MCLEN/MCKT are hole.f's REAL literals widened to double, not exact 0.1;
    # hole::profile's own defaults are the exact values and anneal a different
    # path. These are the values hole::main passes - see its header.
    if {$o(-method) eq "capsule"} {
        lassign [hole::capsule -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
                     -cpoint $cp -cvect $cv -sample $o(-sample) \
                     -endrad $o(-endrad) -mcstep $o(-mcstep) \
                     -mclen $o(-mclen) -mckt $o(-mckt)] rows discovery
        hole::write_capsule_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys -zs $zs \
            -rs $rs -cvect $cv -sample $o(-sample) -endrad $o(-endrad)
        set nr [::vmdpathfinder_fb_tsv_capsule $discovery $o(-tsv) $o(-sample) \
                    $cv $n $xs $ys $zs $rs]
        puts "pure-Tcl HOLE (CAPSULE): $n atoms, [llength $rows] slices, $nr profile rows"
        return
    }
    lassign [hole::profile -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
                 -cpoint $cp -cvect $cv -sample $o(-sample) \
                 -endrad $o(-endrad) -mcstep $o(-mcstep) \
                 -mclen $o(-mclen) -mckt $o(-mckt)] rows discovery
    if {$o(-method) eq "connolly"} {
        # CONN's own centre is the annealed spherical answer for that slice,
        # never a fresh search (concal.f/holcal.f) - so this reuses $rows.
        lassign $cv cvx cvy cvz
        set cvn [expr {sqrt($cvx*$cvx + $cvy*$cvy + $cvz*$cvz)}]
        set ncvect [list [expr {$cvx/$cvn}] [expr {$cvy/$cvn}] [expr {$cvz/$cvn}]]
        lassign [hole::calper $ncvect] perpve perpvn
        set requivs {}
        foreach row $rows {
            lassign $row t x y z rad
            lappend requivs [dict get [hole::connolly -centre [list $x $y $z] \
                -cvect $ncvect -perpve $perpve -perpvn $perpvn -n $n -xs $xs \
                -ys $ys -zs $zs -rs $rs -endrad $o(-endrad) -probe $o(-probe) \
                -grid $o(-grid) -sample $o(-sample)] requiv]
        }
        hole::write_connolly_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys \
            -zs $zs -rs $rs -cvect $cv -sample $o(-sample) \
            -endrad $o(-endrad) -probe $o(-probe) -grid $o(-grid)
        set nr [::vmdpathfinder_fb_tsv $rows $o(-tsv) $o(-sample) $n $xs $ys $zs $rs \
                    $requivs [_vmdpathfinder_fb_axial $cp $cv]]
        puts "pure-Tcl HOLE (CONNOLLY): $n atoms, [llength $rows] slices, $nr profile rows"
        return
    }
    hole::write_sph $discovery $o(-sph) -n $n -xs $xs -ys $ys -zs $zs -rs $rs \
        -cvect $cv -sample $o(-sample) -endrad $o(-endrad)
    set nr [::vmdpathfinder_fb_tsv $rows $o(-tsv) $o(-sample) $n $xs $ys $zs $rs \
                {} [_vmdpathfinder_fb_axial $cp $cv]]
    puts "pure-Tcl HOLE: $n atoms, [llength $rows] slices, $nr profile rows"
}
}
}

proc ::VMDPathFinder::_hole_tcl_script {} {
    # The engine written out as a real file a tclsh subprocess can source, with
    # the driver appended. Cached per session. "" = no fallback; the caller says
    # why. The no-argument run is a real self-test: it exercises the extraction
    # AND parses the driver, so a broken block fails here rather than per frame.
    # Only SUCCESS is cached. Caching a failed probe pinned "unavailable" for the
    # whole session once before in this plugin, and the retry costs ~100 ms.
    variable _hole_tcl_script_cache
    if {[info exists _hole_tcl_script_cache]} { return $_hole_tcl_script_cache }
    set exe [_hole_tcl_exe]
    if {$exe eq ""} { return "" }
    set text [_hole_tcl_engine_text]
    if {$text eq ""} { return "" }
    set path [file join [get_temp_base] "vmdpathfinder_hole_engine_[pid].tcl"]
    if {[catch {
        set fh [open $path w]
        puts $fh $text
        puts $fh [_hole_tcl_driver]
        puts $fh "::vmdpathfinder_fb_main \$argv"
        close $fh
    } err]} {
        vmdcon -warn "VMDPathFinder: could not write the pure-Tcl HOLE engine: $err"
        return ""
    }
    set ok 0
    set out ""
    if {[catch {exec {*}$exe $path} out]} {
        if {[string match "*usage: tclsh SCRIPT*" $out]} { set ok 1 }
    }
    if {!$ok} {
        vmdcon -warn "VMDPathFinder: the pure-Tcl HOLE engine failed its self-check: $out"
        catch {file delete -force $path}
        return ""
    }
    set _hole_tcl_script_cache $path
    return $path
}

proc ::VMDPathFinder::_hole_tcl_args_from_inp {inp} {
    # Translate the control file the plugin just wrote into hole.tcl flags, so
    # the two paths cannot diverge on input. Returns {ok ARGS} or {refused WHY}.
    # A card this cannot translate REFUSES: silently ignoring one changes the
    # answer without changing anything the user can see.
    if {[catch {open $inp r} fh]} { return [list refused "cannot read $inp"] }
    set pdb ""; set rad ""; set sph ""; set sample ""; set endrad ""
    set cpoint ""; set cvect ""; set seed 1
    set method spherical; set probe ""; set grid ""; set ignore ""
    set mcstep ""; set mcdisp ""; set mckt ""
    while {[gets $fh line] >= 0} {
        set line [string trim $line]
        if {$line eq ""} continue
        if {![regexp {^(\S+)\s*(.*)$} $line -> card rest]} continue
        set rest [string trim $rest]
        switch -- [string tolower $card] {
            coord   { set pdb $rest }
            radius  { set rad $rest }
            sphpdb  { set sph $rest }
            sample  { set sample $rest }
            endrad  { set endrad $rest }
            cpoint  { set cpoint $rest }
            cvect   { set cvect $rest }
            raseed  { set seed $rest }
            shorto  { }
            stop    { }
            ignore  { set ignore $rest }
            mcstep  { set mcstep $rest }
            mcdisp  { set mcdisp $rest }
            mckt    { set mckt   $rest }
            conn - connolly {
                # rcontr.f: the first number is the probe radius, the second the
                # grid; the grid defaults to 0.7*probe, which hole::connolly
                # applies itself, so an absent one stays absent here.
                if {$method eq "capsule"} { close $fh; return [list refused \
                    "a run with both the conn and capsule cards"] }
                set method connolly
                set probe [lindex $rest 0]
                set grid  [lindex $rest 1]
                if {($probe ne "" && ![string is double -strict $probe]) ||
                    ($grid  ne "" && ![string is double -strict $grid])} {
                    close $fh
                    return [list refused "a conn card this cannot read: $line"]
                }
            }
            capsule - capsul {
                if {$method eq "connolly"} { close $fh; return [list refused \
                    "a run with both the conn and capsule cards"] }
                set method capsule
            }
            default { close $fh
                return [list refused "the '[string tolower $card]' card"] }
        }
    }
    close $fh
    foreach {v n} [list $pdb coord $rad radius $sph sphpdb] {
        if {$v eq ""} { return [list refused "a control file with no $n card"] }
    }
    set a [list -pdb $pdb -rad $rad -sph $sph -tsv hole_profile.tsv -seed $seed \
               -method $method]
    if {$cpoint ne ""} { lappend a -cpoint $cpoint }
    if {$cvect  ne ""} { lappend a -cvect  $cvect }
    if {$sample ne ""} { lappend a -sample $sample }
    if {$endrad ne ""} { lappend a -endrad $endrad }
    if {$probe  ne ""} { lappend a -probe  $probe }
    if {$grid   ne ""} { lappend a -grid   $grid }
    if {$ignore ne ""} { lappend a -ignore $ignore }
    if {$mcstep ne ""} { lappend a -mcstep $mcstep }
    if {$mcdisp ne ""} { lappend a -mclen  $mcdisp }
    if {$mckt   ne ""} { lappend a -mckt   $mckt }
    return [list ok $a]
}

proc ::VMDPathFinder::_dotden_arg {dd} {
    # A dot density that is safe to interpolate into a /bin/sh command line.
    # state(dot_density) is PERSISTED to ~/.vmdpathfinder_config, so a hand-edited or
    # corrupted config reaches these commands without ever passing through
    # validate_inputs. Range is sph_process's own accepted 1-100.
    if {![string is integer -strict $dd] || $dd < 1 || $dd > 100} { return 15 }
    return $dd
}

proc ::VMDPathFinder::_sph_process_cmd {dd cflag sph_file sos_file {njobs 1}} {
    # The sph_process command, from the binary or the inlined engine. One
    # builder so every call site gets the fallback, instead of each growing its
    # own branch - which is how half of them would have missed it.
    variable state
    set dd [_dotden_arg $dd]
    if {[string trim $state(sph_process_exec)] ne ""} {
        return "[_sph_omp_prefix $njobs][shell_quote $state(sph_process_exec)] -sos -dotden $dd\
                ${cflag}[shell_quote $sph_file] [shell_quote $sos_file]"
    }
    set color [expr {[string match "*-colour*" $cflag] ? 1 : 0}]
    return "[shell_quote [_hole_tcl_exe]] [shell_quote [_hole_tcl_script]] --sph-process\
            $dd $color [shell_quote $sph_file] [shell_quote $sos_file]"
}

proc ::VMDPathFinder::_sos_triangle_cmd {sos_file out_file} {
    # As _sph_process_cmd. Only the plain -s surface: --points, --batch,
    # --recolor, --hydro*, --asym* and --tunnel* are accelerator features with
    # no counterpart in the port, and sos_triangle_features already reports them
    # absent, so the paths that want them take their own existing Tcl route.
    variable state
    if {[string trim $state(sos_triangle_exec)] ne ""} {
        return "[shell_quote $state(sos_triangle_exec)] -s < [shell_quote $sos_file] >\
                [shell_quote $out_file]"
    }
    return "[shell_quote [_hole_tcl_exe]] [shell_quote [_hole_tcl_script]] --sos-triangle\
            [shell_quote $sos_file] [shell_quote $out_file] > /dev/null"
}


proc ::VMDPathFinder::_surface_tcl_fallback {} {
    # 1 when the surface stages will run in Tcl. Callers use it to say so once,
    # and to skip binary-only fast paths that would otherwise be probed per frame.
    variable state
    return [expr {[string trim $state(sph_process_exec)] eq "" ||
                  [string trim $state(sos_triangle_exec)] eq ""}]
}

proc ::VMDPathFinder::_surface_tcl_warn_once {} {
    # Once per session, not per frame: validate_inputs runs on every Run.
    variable state
    variable _surface_tcl_warned
    if {[info exists _surface_tcl_warned]} { return }
    set _surface_tcl_warned 1
    vmdcon -warn "VMDPathFinder: no sph_process/sos_triangle binary - building surfaces\
        with the inlined pure-Tcl engine. Output is byte-identical, but it costs\
        ~50 s per frame against ~0.1 s. Install HOLE 2 for normal speed."
}

proc ::VMDPathFinder::_hole_tcl_warn_once {nframes njobs} {
    # Once per run, naming the measured cost - a fallback that is 1800x slower
    # than the binary must not look like a normal run that is merely starting.
    # Divided by njobs, not the core count: one frame cannot be parallelised, so
    # the core count would quote a fraction of the real wait.
    variable state
    if {$njobs < 1} { set njobs 1 }
    set est [expr {int(ceil(40.0 * $nframes / double($njobs)))}]
    vmdcon -warn "VMDPathFinder: no HOLE binary - running the pure-Tcl HOLE engine.\
        It is ~1800x slower (~40 s per 1400-atom frame); $nframes frame(s) is\
        roughly ${est}s. Abort still works. Install HOLE 2 for normal speed."
    set state(status) "⚠ pure-Tcl HOLE (no binary): ~${est}s for $nframes frame(s)…"
}


proc ::VMDPathFinder::_mole_tcl_load {} {
    # The pure-Tcl engine is INLINED in this file (see the sentinel block
    # above), so it is defined by the time anything can call this - there is
    # nothing left to load on demand. Kept as a proc, and still checked rather
    # than assumed, because every caller treats a 0 here as "no Tcl fallback
    # available" and reports that honestly instead of failing obscurely later;
    # a partially-sourced file would still trip this.
    return [expr {[llength [info procs ::VMDPathFinder::Mole::find_tunnels]] > 0}]
}

# The lining of every tunnel, keyed by the 1-based id format_tunnels uses.
# Skipped entirely without an atom-name column, which is exactly when the C
# engine skips it too - the two files must agree line for line.
# <HetResidues> for every tunnel, keyed the same way. Unlike the lining this is
# NOT gated on has_names: MOLE's het test is a RESIDUE-name test, so it works
# from the columns every atom table has, and write_het emits the line always.
proc ::VMDPathFinder::_mole_het_all {tunnels invpiv np cxVar pres restab} {
    upvar 1 $cxVar C
    set het [dict create]
    set id 0
    foreach tn $tunnels {
        incr id
        lassign $tn length plen prof crank path
        set ids [::VMDPathFinder::Mole::het_residues $prof $invpiv $np C $path $pres $restab]
        set names {}
        foreach r $ids {
            lassign [lindex $restab $r] rn sq ch
            lappend names "$rn:$sq:$ch"
        }
        dict set het $id $names
    }
    return $het
}

proc ::VMDPathFinder::_mole_lining_all {tunnels piv np pres pbb restab has_names} {
    if {!$has_names} { return {} }
    set lining [dict create]
    set id 0
    foreach tn $tunnels {
        incr id
        lassign $tn length plen prof
        set L [::VMDPathFinder::Mole::lining $prof $piv $np $pres $pbb $restab]
        dict set lining $id [dict replace $L restab $restab]
    }
    return $lining
}

# The cavity block, in the id order MOLE assigns: channels ranked by DESCENDING
# volume, and only the ones that passed the depth filters, which are the ones a
# tunnel could come from.
proc ::VMDPathFinder::_mole_cavity_lines {cxVar cav pres restab mindepth mindeplen has_names} {
    upvar 1 $cxVar C
    if {!$has_names} { return {} }
    set rank {}
    for {set i 0} {$i < [llength $cav]} {incr i} {
        set vi [lindex [lindex $cav $i] 3]
        set r 0
        for {set q 0} {$q < [llength $cav]} {incr q} {
            set cq [lindex $cav $q]
            if {![lindex $cq 2]} continue
            set vq [lindex $cq 3]
            if {$vq > $vi || ($vq == $vi && $q < $i)} { incr r }
        }
        lappend rank $r
    }
    set out {}
    set nres [llength $restab]
    for {set c 0} {$c < [llength $cav]} {incr c} {
        lassign [lindex $cav $c] count depth has_boundary volume dlen
        if {!($has_boundary && $dlen > $mindeplen && $depth > $mindepth)} continue
        lassign [::VMDPathFinder::Mole::cavity_residues C $c $pres $nres] bnd inner
        foreach line [::VMDPathFinder::Mole::format_cavity [expr {[lindex $rank $c] + 1}] \
                          $volume $depth $dlen $bnd $inner $restab] {
            lappend out $line
        }
    }
    return $out
}

proc ::VMDPathFinder::_mole_fast_atoms_available {} {
    # The packed record is only readable by an engine carrying the packed-atoms
    # reader. The manifest sits beside the binaries the build script installed,
    # so it is read from the engine's OWN directory - pointing the engine
    # somewhere else reports honestly instead of inheriting HOLE's status.
    set exe [tool_path mole_engine]
    if {$exe eq ""} { return 0 }
    set m [file join [file dirname $exe] vmdpathfinder_accel.manifest]
    if {![file exists $m]} { return 0 }
    if {[catch {open $m r} fh]} { return 0 }
    set txt [read $fh]; catch {close $fh}
    foreach line [split $txt "\n"] {
        if {[lindex $line 0] eq "patch" && [lrange $line 2 end] eq "fast-atoms-read"} { return 1 }
    }
    return 0
}

proc ::VMDPathFinder::_mole_packed_identity {molid frame key} {
    # The 9 non-coordinate columns, packed once and reused for every frame. They
    # are taken from the SAME tails _tunnel_atoms_mole builds, so the element
    # fallback, the water test, the blank-chain rule and the altLoc/insertion
    # defaults all have exactly one implementation feeding both formats.
    # The cache is checked BEFORE that call: rebuilding the text lines per frame
    # is the ~41 ms this whole path exists to avoid.
    variable _mole_atom_tail
    variable _mole_pack_blob
    variable _mole_pack_key
    if {[info exists _mole_pack_key] && $_mole_pack_key eq $key} { return $_mole_pack_blob }
    _tunnel_atoms_mole $molid $frame
    if {![info exists _mole_atom_tail] || ![llength $_mole_atom_tail]} { return "" }
    set fixed {}; set wat {}; set seq {}; set bf {}
    foreach t $_mole_atom_tail {
        lassign $t el w ch ri rn b nm al ic
        append fixed [binary format a8a8a8a8a4a4 $el $ch $rn $nm $al $ic]
        lappend wat $w; lappend seq $ri; lappend bf $b
    }
    set _mole_pack_blob "$fixed[binary format i* $wat][binary format i* $seq][binary format d* $bf]"
    set _mole_pack_key $key
    return $_mole_pack_blob
}

proc ::VMDPathFinder::_tunnel_write_atoms_packed {molid frame dir} {
    # Per frame this is three bulk packs and one write - no per-atom Tcl at all.
    variable state
    set seltext [string trim $state(selection)]
    if {$seltext eq ""} { set seltext "protein" }
    if {[catch {atomselect $molid $seltext frame $frame} sel]} { return 0 }
    set n [$sel num]
    if {$n < 4} { $sel delete; return 0 }
    set key "$molid|$seltext|$n|[binary format i* [$sel get index]]"
    set blob [_mole_packed_identity $molid $frame $key]
    if {$blob eq ""} { $sel delete; return 0 }
    set fh [open [file join $dir atoms.txt] w]
    fconfigure $fh -translation binary
    puts -nonewline $fh "MOLEATM1"
    puts -nonewline $fh [binary format iii 1 $n 1]
    puts -nonewline $fh $blob
    puts -nonewline $fh [binary format d* [$sel get x]]
    puts -nonewline $fh [binary format d* [$sel get y]]
    puts -nonewline $fh [binary format d* [$sel get z]]
    close $fh
    $sel delete
    return 1
}

proc ::VMDPathFinder::_tunnel_write_atoms_file {molid frame dir} {
    # One frame's MOLE input. Raises on a selection too small to triangulate, so
    # the pool records that one frame as lost instead of letting the engine read
    # a stub or discarding every other frame over it.
    if {[_mole_fast_atoms_available]} {
        if {[_tunnel_write_atoms_packed $molid $frame $dir]} { return }
    }
    set lines [_tunnel_atoms_mole $molid $frame]
    if {[llength $lines] < 4} {
        error "fewer than 4 atoms in the selection in frame $frame"
    }
    set fh [open [file join $dir atoms.txt] w]
    foreach l $lines { puts $fh $l }
    close $fh
}

proc ::VMDPathFinder::_tunnel_search_mole_tcl {molid frame seed cfg} {
    if {![_mole_tcl_load]} {
        # The Tcl engine is inlined in this same file, so reaching this means
        # this file itself did not fully load - not that a sibling module is
        # missing, which is what a sibling-module message would mean if the engine shipped as
        # eight separate mole_*.tcl files.
        return [list unavailable "MOLE engine not found (expected mole_tunnel_engine\
                beside sos_triangle), and the inlined pure-Tcl MOLE engine is not\
                defined - this copy of vmdpathfinder.tcl did not load completely"]
    }
    set d [_mole_cfg $cfg]
    lassign [list [dict get $d probe] [dict get $d interior] [dict get $d mindepth] \
                  [dict get $d mindeplen] [dict get $d minlen] [dict get $d weight] \
                  [dict get $d orad]] probe interior mindepth mindeplen minlen weight orad
    set origin [expr {[llength $seed] == 3 ? $seed : {}}]

    if {[catch {
        # The SAME lines the compiled path writes to its atoms file, so the two
        # paths cannot diverge on input: the %.3f formatting there is what the C
        # engine parses, and the Tcl must start from the same numbers.
        ::VMDPathFinder::Mole::read_atom_lines [_tunnel_atoms_mole $molid $frame] A
        set piv [::VMDPathFinder::Mole::pivot_points A rad src pbfac pfree pbb pres restab]
        set np [expr {[llength $piv] / 3}]
        if {$np < 4} { error "only $np non-water atoms in the selection" }
        # MOLE's own triangulation: same cells as mole_delaunay, but also MOLE's
        # per-cell vertex order, which decides lining layer boundaries. The C
        # engine uses the same one, so the two stay byte-identical.
        ::VMDPathFinder::Mole::dh_build M $piv $np
        ::VMDPathFinder::Mole::complex_build_dh C M $piv $rad $probe $interior $mindepth \
            [dict get $d strict]
        lassign [::VMDPathFinder::Mole::cavities C cav $mindepth $mindeplen] nc nch nvd
        set tunnels [::VMDPathFinder::Mole::find_tunnels C $cav $piv $rad $np \
            [list probe $probe interior $interior min_depth $mindepth \
                  min_depth_length $mindeplen min_tunnel_length $minlen \
                  weight $weight origin $origin origin_radius $orad \
                  surface_cover [dict get $d cover] \
                  auto_origin_cover [dict get $d autocover] \
                  max_origins [dict get $d maxorig] \
                  bottleneck [dict get $d bottle] \
                  bottleneck_tolerance [dict get $d bottletol] \
                  max_similarity [dict get $d maxsim] \
                  filter_boundary [dict get $d fbl] \
                  exit_point [dict get $d exit] \
                  exits_only [dict get $d exitsonly] \
                  path_points [concat [dict get $d patha] [dict get $d pathb]]] \
            "" $pbfac $pfree $pres $restab]
        set lining [::VMDPathFinder::_mole_lining_all $tunnels $piv $np $pres $pbb \
                        $restab $A(has_names)]
        set cavlines [_mole_cavity_lines C $cav $pres $restab $mindepth $mindeplen \
                          $A(has_names)]
        set het [::VMDPathFinder::_mole_het_all $tunnels $A(invpiv) $np C $pres $restab]
        set payload [::VMDPathFinder::Mole::format_tunnels $A(n) $C(nt) $probe $interior \
                         $tunnels $A(has_names) $lining $cavlines $het]
    } err]} {
        # Same distinction as the C path: reaching this catch means the inlined
        # engine WAS loaded and DID run (_mole_tcl_load already passed) - it
        # threw partway through, which is not "unavailable" either.
        return [list failed $err]
    }
    return [list ok $payload "tunnel_mole (pure Tcl): $A(n) atoms, $C(nt)\
            tetrahedra, $nch channels, $nvd voids; [llength $tunnels] tunnels"]
}

# The subcommand that selects a tool inside the shipped sos_triangle; empty for
# a standalone build of the tool.
# Grid/neck entries mean nothing to sos_triangle; show them for the mesher only.
proc ::VMDPathFinder::_update_mesher_rows {} {
    variable _settings_d
    variable state
    if {![info exists _settings_d] || ![winfo exists $_settings_d.ms_vx]} { return }
    set csg [expr {$state(mesher) eq "csg"}]
    set _row $_settings_d.ms_row
    if {$csg} { pack $_settings_d.ms_vx -in $_row -side left -padx {6 0}; raise $_settings_d.ms_vx } \
    else { pack forget $_settings_d.ms_vx }
    if {[winfo exists $_settings_d.ms_dd]} {
        if {$csg} { pack forget $_settings_d.ms_dd } \
        else { pack $_settings_d.ms_dd -in $_row -side left -padx {6 0}; raise $_settings_d.ms_dd }
    }
    # dot density and the playback thinning belong to sph_process/sos_triangle
    if {[winfo exists $_settings_d.pb]} {
        if {$csg} { grid remove $_settings_d.pb } else { grid $_settings_d.pb }
        _update_conn_controls
    }
}

# Can the marching-cubes mesher (mesh_csg) build this run's geometry? A
# spherical run is a union of probe spheres, which is its input; a Connolly
# run too (the S-999 records are spheres, radius in the occupancy column); a
# capsule run is a union of capsules, which it reads as segments swept by a
# sphere. Tunnel and mean tubes are plain sphere unions under any method.
proc ::VMDPathFinder::_csg_can_mesh {{union 0}} {
    variable state
    if {![info exists state(mesher)] || $state(mesher) ne "csg"} { return 0 }
    if {!$union && $state(pore_method) ni {circular connolly capsule}} { return 0 }
    return [expr {[tool_path mesh_csg] ne ""}]
}

# Is it what DRAWS the surface right now? Property, lateral and lobe colouring
# go through sos_triangle's per-triangle recolour, which finds triangles by the
# literal "draw trinorm" - those runs still mesh with mesh_csg, through
# _csg_base_mesh below, but the file they colour is written in that form.
# Is it what DRAWS the surface right now? A colouring that recolours per
# triangle is excluded, and not because it cannot be done: mesh_csg's --draw
# mode writes the records sos_triangle's recolour modes read, and colouring a
# marching-cubes mesh that way was measured correct. It is excluded because
# the recolour costs ~9 us per triangle, several times what drawing costs, so
# the mesher's two-times-denser mesh made property colouring SLOWER end to end
# (149 ms against 93 ms per frame). Meshing was never the expensive half here.
proc ::VMDPathFinder::_csg_active {} {
    variable state
    if {![_csg_can_mesh]} { return 0 }
    return [expr {$state(display_mode) in {triangulated wireframe}}]
}

# HOLE's own records, rather than a molecule-addressed mesh. Needed by anything
# that reads the mesh back: conn_lobes' region split and sos_triangle's
# recolour modes both find triangles by the literal "draw trinorm".
proc ::VMDPathFinder::_csg_draw_form {} {
    variable state
    if {$state(pore_method) eq "connolly"} { return 1 }
    return [expr {$state(surface_color) in {property pore_lat pore_lobes}}]
}

# ---------------------------------------------------------------------------
# ONE surface pipeline. A mesh is a pure function of (sphere file, mesher, grid,
# form). Every mesh the plugin draws - the pore, a Connolly region, a tunnel, a
# mean tube, the dots display, the base a property colouring starts from - is
# built by surface_mesh (or surface_mesh_cmd for the job pools) and named by
# surface_plot_name. The mesher serves the run when it can; the legacy pair
# (sph_process + sos_triangle) otherwise, and as the fallback when the mesher
# fails on a file. Nothing else in the plugin runs those tools for a surface.
#   form: mol  - molecule-addressed records: the only form that is sourced
#         draw - HOLE's own records: anything that reads the mesh back
#         dots - one point per vertex, HOLE's records
#   union: 1 = the .sph is a plain sphere union from the plugin's writer (a tunnel,
#          a mean tube), so the mesher can take it under any pore method.

# ---- Surface smoothing: a local average of the surfaces in a window -------
# For frame f the window is the analysed frames f-N..f+N (clamped at the ends,
# as VMD clamps its own trajectory smoothing). Each mesher averages what it
# holds: the marching mesher the frames' distance fields on one grid, the
# legacy pair the dot clouds dot by dot (sos_triangle --sos-smooth, or the Tcl
# port). Neither averages coordinates or centrelines: a feature most frames
# share stays where it is, a flicker averages down, curvature and lateral
# openings survive. Analysis numbers stay per frame; this is the surface only.
#   surface_smooth: follow (VMD's own window of the shown representations),
#                   off, or an integer half-width.
# Tunnel mode uses the SAME window (_tunnel_smooth_frames/_tunnel_smooth_with,
# below the pore versions) but keyed by cross-frame CLUSTER rather than by
# frame's sph_file directly - a bare rank is not a stable identity across
# frames, so smoothing only applies to a tunnel that cross-frame clustering
# has actually resolved (see _tunnel_rank_in_frame's own note on why).
proc ::VMDPathFinder::_surface_smooth_window {} {
    variable state
    set v [expr {[info exists state(surface_smooth)] ? $state(surface_smooth) : "follow"}]
    if {$v eq "off" || $v eq ""} { return 0 }
    if {[string is integer -strict $v]} { return [expr {$v < 0 ? 0 : $v}] }
    set n 0
    catch {
        set molid [resolve_molid]
        for {set r 0} {$r < [molinfo $molid get numreps]} {incr r} {
            if {![mol showrep $molid $r]} continue
            set w [mol smoothrep $molid $r]
            if {[string is integer -strict $w] && $w > $n} { set n $w }
        }
    }
    return $n
}

proc ::VMDPathFinder::_smooth_watch_tick {} {
    # The window has TWO writers: the spinbox on the Frames row, and VMD's own
    # per-rep slider in Graphics > Representations. VMD never calls into the
    # plugin, so its side is polled - one `mol smoothrep` read per shown rep,
    # twice a second - and whichever moved last wins.
    #
    # Compared against what the PLUGIN holds, not against the previous poll. A
    # remembered previous value is seeded from VMD itself, so the very tick that
    # first sees a change also adopts it as the baseline and the change is then
    # never acted on.
    variable _smooth_watch_after
    variable state
    set _smooth_watch_after ""
    variable w
    if {![_have_tk] || ![winfo exists $w]} { return }
    if {[catch {_vmd_smooth_window} n]} { set n "" }
    # "" means no readable representation right now - no molecule, or every rep
    # hidden - and is NOT the same as VMD reporting a genuine 0. Treating it as
    # 0 zeroed the stored window (and every representation, via
    # _set_smooth_window) the moment the molecule momentarily had none, e.g.
    # before a structure is loaded at all.
    if {$n ne ""} {
        # A window stored as "follow" or "off" by an older config is migrated
        # to a plain number once, quietly - not through _set_smooth_window,
        # which would repaint on every tick until it happened to match.
        if {![string is integer -strict [expr {[info exists state(surface_smooth)] ? $state(surface_smooth) : ""}]]} {
            set state(surface_smooth) $n
        } elseif {$n ne [_surface_smooth_window]} {
            # Changed in VMD: adopt it, which also copies it to every other rep
            # so the molecule and the pore inside it stay on one window.
            catch {_set_smooth_window $n}
        }
    }
    # Never while the spinbox has keyboard focus: a plain -textvariable binding
    # already shows every keystroke, and overwriting it out from under the user
    # mid-edit erased digits they had just typed.
    variable _sm_spin_path
    set _has_focus 0
    catch {set _has_focus [expr {[info exists _sm_spin_path] && [focus] eq $_sm_spin_path}]}
    if {!$_has_focus} { catch {set state(smooth_window_disp) [_surface_smooth_window]} }
    _smooth_watch_start
}

proc ::VMDPathFinder::_smooth_watch_start {} {
    variable _smooth_watch_after
    if {[info exists _smooth_watch_after] && $_smooth_watch_after ne ""} {
        catch {after cancel $_smooth_watch_after}
    }
    set _smooth_watch_after [after 500 ::VMDPathFinder::_smooth_watch_tick]
}

proc ::VMDPathFinder::_smooth_watch_stop {} {
    variable _smooth_watch_after
    if {[info exists _smooth_watch_after] && $_smooth_watch_after ne ""} {
        catch {after cancel $_smooth_watch_after}
    }
    set _smooth_watch_after ""
}

proc ::VMDPathFinder::_surface_smooth_tag {} {
    set n [_surface_smooth_window]
    return [expr {$n > 0 ? "_s$n" : ""}]
}

proc ::VMDPathFinder::_surface_has_sph {frame} {
    # Does $frame have a usable sphere file to smooth against right now?
    # False for a frame HOLE hasn't reached yet (lazy) or whose run failed
    # (no sph_file at all) - either way there is nothing on disk to read.
    variable results
    if {![dict exists $results $frame sph_file]} { return 0 }
    return [file exists [dict get $results $frame sph_file]]
}

proc ::VMDPathFinder::_surface_smooth_frames {frame} {
    # The other frames in the smoothing window of `frame`. Walks outward one
    # index at a time on each side and skips any candidate with no usable
    # surface (failed run, not yet reached), reaching one index further to
    # backfill it - the window's half-width N promises N real neighbours, not
    # N index slots some of which may be empty. Still clamped at the ends of
    # the trajectory (running out of frames there is not a gap to backfill
    # across). {} when smoothing is off or the run is a tunnel search.
    variable result_frames
    set n [_surface_smooth_window]
    if {$n <= 0} { return {} }
    if {[analysis_mode] eq "tunnel"} { return {} }
    set order [lsort -integer $result_frames]
    set i [lsearch -exact $order $frame]
    if {$i < 0} { return {} }
    set nlist [llength $order]
    set out {}
    foreach dir {-1 1} {
        set got 0
        set j [expr {$i + $dir}]
        while {$j >= 0 && $j < $nlist && $got < $n} {
            set g [lindex $order $j]
            if {[_surface_has_sph $g]} { lappend out $g; incr got }
            incr j $dir
        }
    }
    return $out
}

proc ::VMDPathFinder::_smooth_union_sph {frame sph_file} {
    # The lining reference under smoothing: this frame's spheres plus every
    # window frame's, in one .sph beside the frame's own, so property colours
    # and the lining/facing tests follow the drawn wall. "" without a window.
    set with [_surface_smooth_with $frame]
    if {![llength $with] || ![file exists $sph_file]} { return "" }
    set out "[file rootname $sph_file][_surface_smooth_tag].sph"
    if {[file exists $out] && [file mtime $out] >= [file mtime $sph_file]} { return $out }
    if {[catch {open $out w} fh]} { return "" }
    foreach s [concat [list $sph_file] $with] {
        if {[catch {open $s r} in]} continue
        while {[gets $in line] >= 0} {
            if {[string match {ATOM  *} $line] || [string match {HETATM*} $line]} { puts $fh $line }
        }
        close $in
    }
    close $fh
    return $out
}

proc ::VMDPathFinder::_surface_smooth_with {frame} {
    # The window frames as the sphere files a mesher takes (a capsule run's
    # kept slices); a neighbour with no sphere file yet is skipped.
    variable results
    set with {}
    foreach g [_surface_smooth_frames $frame] {
        if {![dict exists $results $g sph_file]} continue
        set sph [dict get $results $g sph_file]
        if {![file exists $sph]} continue
        if {[_run_uses_card capsule]} { set sph [_capsule_sph_kept $sph] }
        lappend with $sph
    }
    return $with
}

proc ::VMDPathFinder::_surface_smooth_with_dir {run_dir} {
    # The same, for a caller that has the run directory but not the frame.
    variable results
    dict for {f d} $results {
        if {[dict exists $d run_dir] && [dict get $d run_dir] eq $run_dir} { return [_surface_smooth_with $f] }
    }
    return {}
}

# ---- Tunnel-mode smoothing: same window, keyed by CROSS-FRAME CLUSTER -----
# A bare rank is not a stable identity across frames (MOLE finds a different
# tunnel COUNT per frame - see _tunnel_rank_in_frame), so "the neighbour
# frame's version of this tunnel" only exists once cross-frame clustering has
# resolved one. Without it (clustering off, or this tunnel outside
# tunnel_xframe_max) smoothing has nothing safe to average against and is
# simply skipped for that tunnel - the mesh still draws, just unsmoothed.
proc ::VMDPathFinder::_tunnel_cluster_for_rank {frame rank} {
    # Reverse lookup of tunnel_xrank ({cid,frame} -> rank): which cluster is
    # $rank in $frame. "" if clustering is off or $rank is not one of its
    # tracked members.
    variable tunnel_xrank
    if {![array exists tunnel_xrank]} { return "" }
    foreach k [array names tunnel_xrank "*,$frame"] {
        if {$tunnel_xrank($k) == $rank} { return [lindex [split $k ,] 0] }
    }
    return ""
}

proc ::VMDPathFinder::_tunnel_smooth_frames {frame cid} {
    # {frame rank} pairs for cluster $cid in the smoothing window around
    # $frame - same reach-further-to-backfill policy as _surface_smooth_frames
    # (a frame the tunnel is simply absent from is skipped, not counted as a
    # used window slot), clamped at the ends of the frames actually searched.
    variable tunnel_result_frames
    variable tunnel_xrank
    set n [_surface_smooth_window]
    if {$n <= 0 || $cid eq ""} { return {} }
    set order [lsort -integer $tunnel_result_frames]
    set i [lsearch -exact $order $frame]
    if {$i < 0} { return {} }
    set nlist [llength $order]
    set out {}
    foreach dir {-1 1} {
        set got 0
        set j [expr {$i + $dir}]
        while {$j >= 0 && $j < $nlist && $got < $n} {
            set g [lindex $order $j]
            if {[info exists tunnel_xrank($cid,$g)]} {
                lappend out [list $g $tunnel_xrank($cid,$g)]
                incr got
            }
            incr j $dir
        }
    }
    return $out
}

proc ::VMDPathFinder::_tunnel_smooth_with {frame rank} {
    # The window's .sph files for the SAME cross-frame tunnel as (frame,
    # rank) - the mesher's --with field-average list, tunnel counterpart of
    # _surface_smooth_with. {} without a cross-frame cluster for this tunnel.
    variable tunnel_root
    set cid [_tunnel_cluster_for_rank $frame $rank]
    if {$cid eq ""} { return {} }
    set with {}
    foreach pair [_tunnel_smooth_frames $frame $cid] {
        lassign $pair g rk
        set sph [file join $tunnel_root [format "tunnel_%05d" $g] [format "tunnel_%02d.sph" $rk]]
        if {[file exists $sph]} { lappend with $sph }
    }
    return $with
}

proc ::VMDPathFinder::_vmd_smooth_window {} {
    # VMD's own trajectory smoothing window, as the widest of the shown
    # representations. Read straight from VMD, not from state(surface_smooth).
    # Returns "" when there is no readable representation to ask - no molecule,
    # or every rep hidden - which is NOT the same answer as "every visible rep
    # reports 0", and the caller must not treat them alike.
    set molid ""
    if {[catch {resolve_molid} molid] || $molid eq ""} { return "" }
    set n 0
    set saw 0
    catch {
        for {set r 0} {$r < [molinfo $molid get numreps]} {incr r} {
            if {![mol showrep $molid $r]} continue
            set wv [mol smoothrep $molid $r]
            if {[string is integer -strict $wv]} {
                set saw 1
                if {$wv > $n} { set n $wv }
            }
        }
    }
    return [expr {$saw ? $n : ""}]
}

proc ::VMDPathFinder::_set_smooth_window {n} {
    # ONE number for both smoothings: VMD's trajectory window on every
    # representation of the molecule, and the plugin's own frame averaging of
    # the surface. Setting them together is what keeps the protein and the pore
    # inside it on the same window.
    variable state
    variable last_geom_key
    if {![string is integer -strict $n] || $n < 0} { set n 0 }
    set state(surface_smooth) $n
    set state(smooth_window_disp) $n
    # Every representation, not only the shown ones - a rep turned on later
    # would otherwise carry a different window from the rest.
    catch {
        set molid [resolve_molid]
        for {set r 0} {$r < [molinfo $molid get numreps]} {incr r} {
            catch {mol smoothrep $molid $r $n}
        }
    }
    set last_geom_key ""
    catch {apply_display_change}
    catch {update_pore_lining_rep}
    catch {update_pore_facing_rep}
}

proc ::VMDPathFinder::_smooth_spin_changed {args} {
    variable state
    set n [string trim $state(smooth_window_disp)]
    if {![string is integer -strict $n] || $n < 0} { set n 0 }
    if {$n eq [_surface_smooth_window]} { set state(smooth_window_disp) $n; return }
    _set_smooth_window $n
}

# The dot-cloud smoother for the legacy pair: the shipped sos_triangle when it
# carries it, the pure-Tcl port otherwise.
proc ::VMDPathFinder::_sos_smooth_cmd {out rho centre wsos} {
    variable state
    set q {}
    foreach w $wsos { lappend q [shell_quote $w] }
    if {[sos_triangle_has_feature sossmooth]} {
        return "[shell_quote $state(sos_triangle_exec)] --sos-smooth [shell_quote $out] $rho [shell_quote $centre] [join $q]"
    }
    return "[shell_quote [_hole_tcl_exe]] [shell_quote [_hole_tcl_script]] --sos-smooth [shell_quote $out] $rho [shell_quote $centre] [join $q]"
}

# Neighbour dots move to their nearest same-facing dot within this distance.
proc ::VMDPathFinder::_surface_smooth_rho {} { return 2.0 }

# The centre frame's .sos, smoothed against its window when there is one:
# every window frame's cloud is built once per dot density (kept next to its
# sphere file) and the centre's dots are averaged against them in place.
proc ::VMDPathFinder::_legacy_sos {sph sos color dd with} {
    variable state
    if {[catch {run_sph_process $sph $sos $color $dd}]} { return 0 }
    if {![llength $with]} { return 1 }
    set ddn [expr {$dd ne "" ? $dd : $state(dot_density)}]
    set wsos {}
    foreach w $with {
        set ws "[file rootname $w]_dd${ddn}.sos"
        if {![file exists $ws] || [file mtime $ws] < [file mtime $w]} {
            if {[catch {run_sph_process $w $ws $color $dd}]} continue
        }
        if {[file exists $ws] && [file size $ws] > 0} { lappend wsos $ws }
    }
    if {![llength $wsos]} { return 1 }
    set sm "[file rootname $sos]_sm.sos"
    catch {exec sh -c "[_sos_smooth_cmd $sm [_surface_smooth_rho] $sos $wsos] > /dev/null 2>&1"}
    if {[file exists $sm] && [file size $sm] > 0} { file rename -force $sm $sos }
    return 1
}

proc ::VMDPathFinder::surface_mesh_tag {{union 0}} {
    if {![_csg_can_mesh $union]} { return "" }
    # "csg2": meshes written before the mesher dropped zero-area facets are
    # named "_csg<voxel>" and must not be served (OptiX shades them flat).
    return "_csg2_[string map {/ _} [_csg_voxel_spec]]"
}

proc ::VMDPathFinder::surface_plot_name {dir base form {union 0}} {
    set tag [surface_mesh_tag $union]
    if {$tag ne "" && $form eq "draw"} { append tag "_draw" }
    if {$tag ne "" && $form eq "dots"} { append tag "_dots" }
    # Smoothing tag is independent of $union (which only ever gates the CSG
    # voxel tag above) - every mesh this proc names, tunnels included, needs
    # a filename that varies with the smoothing window so a cached mesh built
    # under one window size is never silently reused under another.
    return [file join $dir "$base[_surface_smooth_tag]$tag.vmd_plot"]
}

proc ::VMDPathFinder::surface_mesh {sph plot form {dotden ""} {color 1} {union 0} {with {}}} {
    variable state
    if {![file exists $sph]} { return 0 }
    if {[_csg_can_mesh $union]} {
        set verb [dict get {mol mesh draw meshdraw dots meshdots} $form]
        set spec [_csg_voxel_spec]
        set _mopts [_csg_mesh_opts $sph]
        if {[llength $with]} { lappend _mopts --with {*}$with }
        if {[llength $_mopts]} { append spec \t [join $_mopts \t] }
        if {[_csg_server_mesh $sph $plot $spec $verb] > 0 && [surface_has_geometry $plot]} { return 1 }
        catch {file delete $plot}
        catch {vmdcon -warn "VMDPathFinder: the mesher failed on [file tail $sph]; using sph_process + sos_triangle."}
    }
    set sos [file rootname $plot].sos
    set dd $dotden
    if {![_legacy_sos $sph $sos $color $dd $with]} { catch {file delete $sos}; return 0 }
    if {$form eq "dots"} {
        if {[fast_available points]} {
            run_sos_triangle_points $sos $plot
        } else {
            set tmp [file rootname $plot]_trinorm.tmp
            catch {run_sos_triangle $sos $tmp}
            catch {dots_from_trinorm $tmp $plot}
            catch {file delete $tmp}
        }
        catch {file delete $sos}
        return [surface_has_geometry $plot]
    }
    catch {run_sos_triangle $sos $plot}
    # sos_triangle's fixed polygon budget: step the density down until it fits
    if {$dd eq ""} { set dd $state(dot_density) }
    if {![string is integer -strict $dd] || $dd < 1} { set dd 15 }
    set retry 0
    while {![surface_has_geometry $plot] && $dd > 2 && $retry < 4} {
        set dd [expr {max(2, $dd / 2)}]
        incr retry
        catch {vmdcon -info "VMDPathFinder: sos_triangle produced no surface; retrying at dot density $dd."}
        if {![_legacy_sos $sph $sos $color $dd $with]} { break }
        catch {run_sos_triangle $sos $plot}
    }
    catch {file delete $sos}
    return [surface_has_geometry $plot]
}

# The same build as one shell command, for run_shell_pool.
proc ::VMDPathFinder::surface_mesh_cmd {sph plot form {dotden ""} {color 1} {union 0} {with {}}} {
    variable state
    # Pool jobs share the cores: one OpenMP thread each, or fifteen meshers
    # spawn eight threads apiece and the pool runs 2.6x slower than pinned.
    set _nj [resolve_job_count]
    set _pin [expr {$_nj > 1 ? "OMP_NUM_THREADS=1 " : ""}]
    if {[_csg_can_mesh $union]} {
        set flag [dict get {mol {} draw --draw dots --dots} $form]
        set wflag ""
        if {[llength $with]} { set wflag "--with"; foreach w $with { append wflag " [shell_quote $w]" } }
        return "$_pin[shell_quote [tool_path mesh_csg]] [tool_args mesh_csg] [shell_quote $sph]\
            [shell_quote $plot] [_csg_voxel_spec] $flag [_csg_mesh_opts $sph] $wflag > /dev/null 2>&1"
    }
    set sos [file rootname $plot].sos
    set dd [expr {$dotden ne "" ? $dotden : $state(dot_density)}]
    set cflag [expr {$color ? "-colour " : ""}]
    set tri [expr {$form eq "dots" && [fast_available points]
        ? "[shell_quote $state(sos_triangle_exec)] -s --points < [shell_quote $sos] > [shell_quote $plot]"
        : [_sos_triangle_cmd $sos $plot]}]
    set chain "rm -f [shell_quote $sos]; [_sph_process_cmd $dd $cflag $sph $sos $_nj] > /dev/null 2>&1"
    if {[llength $with]} {
        # window clouds are shared between neighbouring frames' jobs: written
        # to a private name and renamed into place, so two workers cannot
        # half-write the same file
        set wsos {}
        foreach w $with {
            set ws "[file rootname $w]_dd${dd}.sos"
            set tmp "$ws.tmp[expr {int(rand()*1e9)}]"
            append chain " && { \[ -s [shell_quote $ws] \] || { [_sph_process_cmd $dd $cflag $w $tmp] > /dev/null 2>&1 && mv -f [shell_quote $tmp] [shell_quote $ws]; }; }"
            lappend wsos $ws
        }
        set sm "[file rootname $sos]_sm.sos"
        append chain " && [_sos_smooth_cmd $sm [_surface_smooth_rho] $sos $wsos] > /dev/null 2>&1 && mv -f [shell_quote $sm] [shell_quote $sos]"
    }
    return "$chain && $tri 2>/dev/null; rm -f [shell_quote $sos]"
}

# This run's mesh, built if it is not already on disk. "" when the mesher
# cannot serve the run, and the caller then falls back to sos_triangle.
proc ::VMDPathFinder::_csg_base_mesh {run_dir sph_file} {
    if {![_csg_can_mesh]} { return "" }
    set form [expr {[_csg_draw_form] ? "draw" : "mol"}]
    set plot [surface_plot_name $run_dir "hole_triangulated[_conn_surface_suffix]" $form]
    if {[file exists $plot] && [file exists $sph_file] && [file mtime $plot] >= [file mtime $sph_file] \
            && [surface_has_geometry $plot]} { return $plot }
    return [expr {[surface_mesh $sph_file $plot $form "" 1 0 [_surface_smooth_with_dir $run_dir]] ? $plot : ""}]
}

# 0 = the grid used everywhere, 1 = the finer grid around small pore spheres.
# A tunnel is a plain union of spheres with no clip records, so the mesher takes
# its .sph unchanged. Tunnel meshes are written in HOLE's own records rather
# than addressed to a molecule: a route is always drawn in its own colour, so it
# never takes the sourcing path anyway, and a property-coloured route has to be
# readable by sos_triangle's per-triangle recolour.
proc ::VMDPathFinder::_csg_tunnel_active {} {
    variable state
    if {![info exists state(mesher)] || $state(mesher) ne "csg"} { return 0 }
    return [expr {[tool_path mesh_csg] ne ""}]
}


proc ::VMDPathFinder::_tunnel_wants_csg {i} {
    if {![_csg_tunnel_active]} { return 0 }
    return [expr {[_tunnel_effective_repr $i] ne "centerline"}]
}

# A route's mesh: the plain name under sos_triangle, the tagged one under the mesher.
proc ::VMDPathFinder::_tunnel_plot {fd i} {
    return [surface_plot_name $fd [format "tunnel_%02d" $i] draw 1]
}

proc ::VMDPathFinder::_csg_voxel {fine} {
    variable state
    set v [expr {$fine ? $state(csg_voxel_fine) : $state(csg_voxel)}]
    if {![string is double -strict $v] || $v < 0.15 || $v > 3.0} { set v [expr {$fine ? 0.7 : 1.4}] }
    return [format %.2f $v]
}

# ONE mesh serves playback and the settled view: mesh_csg's "OUTER/NECK" grid
# (coarse cells everywhere, fine cells around the small pore spheres). A
# playback mesh that differs from the settled one makes the surface visibly
# change shape when playback stops, which is worse than either mesh alone.
proc ::VMDPathFinder::_capsule_run_axis {run_dir} {
    # This run's ACTUALLY-RESOLVED axis (vmdpathfinder_frame_axis.dat, written
    # unconditionally by run_analysis - see _frame_axis_persisted), not the
    # live state(cpoint)/cvect: those are the RUN's nominal fields, blank when
    # the user lets HOLE guess (CGUESS), or stale once a redraw is requested
    # (a different frame, a colour or display change) without a fresh run.
    # Every capsule consumer of the axis (the mesher, the legacy sph_process
    # pair, the two-track centreline) goes through this one proc so they
    # cannot drift onto three different answers for "what is the axis".
    # Falls back to the live fields for a run_dir that predates the manifest.
    variable state
    set fa [_frame_axis_persisted $run_dir]
    if {[llength $fa] == 6} {
        lassign $fa cx cy cz vx vy vz
        return [list [list $cx $cy $cz] [list $vx $vy $vz]]
    }
    return [list $state(cpoint) $state(cvect)]
}

proc ::VMDPathFinder::_csg_mesh_opts {sph_file} {
    # A capsule run hands the mesher its axis. HOLE's capsule search leaves
    # escaped slices in the .sph with nothing marking them; the mesher keeps a
    # slice only within ENDRAD of the axis (mesh_csg --axis), the rule HOLE's
    # own profile applies.
    #
    # The axis this frame's search ACTUALLY used, not state(cpoint)/cvect:
    # those are the RUN's nominal fields - blank when the user lets HOLE guess
    # (CGUESS), or stale once a redraw is requested (a different frame, a
    # colour or display change) without a fresh run. Filtering slices by a
    # blank or stale field instead of the real axis is exactly the failure
    # this avoids: it rejects a real slice as off-axis, so the tube shows only
    # in a few places instead of its full length. run_analysis writes the
    # real per-frame result to vmdpathfinder_frame_axis.dat next to the .sph
    # unconditionally - see _frame_axis_persisted.
    variable state
    if {![_run_uses_card capsule]} { return {} }
    lassign [_capsule_run_axis [file dirname $sph_file]] _cp _cv
    lassign $_cp cx cy cz
    lassign $_cv vx vy vz
    foreach v [list $cx $cy $cz $vx $vy $vz $state(endrad)] {
        if {![string is double -strict $v]} { return {} }
    }
    return [list --axis $cx $cy $cz $vx $vy $vz $state(endrad)]
}

proc ::VMDPathFinder::_capsule_sph_kept {sph_file} {
    # A capsule .sph with only the kept slices (the rule the mesher applies
    # with --axis), as QC1/QC2 pairs. sph_process - HOLE's or the Tcl port -
    # meshes the escaped records too, as blobs tens of A wide.
    # Axis: this frame's actually-resolved one, not the live state fields - see
    # _csg_mesh_opts, which this mirrors so the legacy pair and the mesher
    # agree on exactly which slices are real.
    variable state
    set out "[file rootname $sph_file]_kept.sph"
    if {[file exists $out] && [file mtime $out] >= [file mtime $sph_file]} { return $out }
    lassign [_capsule_run_axis [file dirname $sph_file]] cpoint cvect
    set slices [_capsule_rings $sph_file $cvect $cpoint $state(endrad)]
    if {![llength $slices]} { return $sph_file }
    if {[catch {set fh [open $out w]}]} { return $sph_file }
    set i 0
    foreach sl $slices {
        lassign [lindex $sl 2] x1 y1 z1 x2 y2 z2 R
        puts $fh [format "ATOM      1  QC1 SPH S%4d    %8.3f%8.3f%8.3f%6.2f%6.2f" $i $x1 $y1 $z1 $R 0.0]
        puts $fh [format "ATOM      1  QC2 SPH S%4d    %8.3f%8.3f%8.3f%6.2f%6.2f" $i $x2 $y2 $z2 $R 0.0]
        incr i
    }
    close $fh
    return $out
}

proc ::VMDPathFinder::_csg_voxel_spec {args} {
    variable state
    # A Connolly surface is at probe scale everywhere - there is no narrow neck
    # to refine, and refining by sphere radius would refine the whole thing.
    if {$state(pore_method) eq "connolly"} { return [_csg_voxel 0] }
    set o [_csg_voxel 0]
    set n [_csg_voxel 1]
    if {$n < $o} { return "$o/$n" }
    return $o
}





proc ::VMDPathFinder::_set_mesher {val disp} {
    variable state
    variable last_geom_key
    if {[info exists state(mesher)] && $state(mesher) eq $val} { return }
    set state(mesher) $val
    set state(mesher_disp) $disp
    set last_geom_key ""
    _update_mesher_rows
    catch {apply_display_change}
    catch {_render_tunnels_now}
}

# Persistent mesher: one `mesh_csg --serve` child per session, one request per
# line, so a frame costs a pipe round-trip instead of a process spawn.
# Returns the triangle count, or -1 (caller falls back to sos_triangle).
namespace eval ::VMDPathFinder {
    variable _csg_chan;   if {![info exists _csg_chan]}   { set _csg_chan "" }
    # Plot files THIS session's mesher wrote, path -> mtime. Only these take the
    # fast draw path below; anything read back from disk (a saved run reopened
    # later, an imported result directory) keeps the parse-as-data path, so
    # opening someone else's output can still never execute Tcl.
    variable _csg_owned;  if {![info exists _csg_owned]}  { set _csg_owned {} }
    # -1 not asked yet, 1 the resident mesher answers the tunnel kernels, 0 it does not
    variable _tunnel_serve; if {![info exists _tunnel_serve]} { set _tunnel_serve -1 }
}

proc ::VMDPathFinder::_csg_own_plot {path} {
    variable _csg_owned
    set mt 0
    catch {set mt [file mtime $path]}
    if {$mt != 0} { dict set _csg_owned $path $mt }
}

# SOURCE a mesh_csg mesh instead of parsing it into entries and issuing one
# `graphics` call per triangle. mesh_csg writes its records as
# `graphics $::VMDPathFinder::_gmol ...`, so setting that variable and sourcing the
# file replays the surface with no parse and no rewrite: 4.56 -> 2.57 us per
# triangle on a cold file, which is what playback draws (a new mesh every
# frame). ONLY files this session's own mesher wrote are eligible - a saved
# run reopened later, or an imported result directory, keeps the
# parse-as-data path, so opening someone else's output can never execute Tcl.
proc ::VMDPathFinder::_csg_fast_render {plot_file mol ov material} {
    variable _csg_owned
    if {$ov ne ""} { return 0 }
    if {![dict exists $_csg_owned $plot_file]} { return 0 }
    set mt 0
    catch {set mt [file mtime $plot_file]}
    if {$mt == 0 || $mt != [dict get $_csg_owned $plot_file]} { return 0 }
    catch {graphics $mol materials on}
    catch {graphics $mol material $material}
    variable _gmol
    set _gmol $mol
    if {[catch {uplevel #0 [list source $plot_file]} err]} {
        catch {graphics $mol delete all}
        catch {vmdcon -warn "VMDPathFinder: fast surface draw failed ($err); using the parsed path."}
        return 0
    }
    return 1
}

# Persistent mesher: one `mesh_csg --serve` child per session, one request per
# line, so a frame costs a pipe round-trip instead of a process spawn.
# Returns the triangle count, or -1 (caller falls back to sos_triangle).
proc ::VMDPathFinder::_csg_server_ask {request} {
    # One request line to the resident mesher; its reply, "" when it could not
    # be reached (the channel is reopened once).
    variable _csg_chan
    set exe [tool_path mesh_csg]
    if {$exe eq ""} { return "" }
    for {set attempt 0} {$attempt < 2} {incr attempt} {
        if {$_csg_chan eq ""} {
            if {[catch {
                set _csg_chan [open [list |$exe {*}[tool_args mesh_csg] --serve] r+]
                fconfigure $_csg_chan -buffering line -blocking 1 -translation lf
            }]} { set _csg_chan ""; return "" }
        }
        set reply ""
        if {[catch {
            puts $_csg_chan $request
            set reply [gets $_csg_chan]
        }] || $reply eq ""} {
            _csg_server_close
            continue
        }
        return $reply
    }
    return ""
}

proc ::VMDPathFinder::_csg_server_mesh {sph plot voxel {verb mesh}} {
    set reply [_csg_server_ask "$verb\t$sph\t$plot\t$voxel"]
    if {[string match "OK *" $reply]} {
        if {$verb eq "mesh"} { _csg_own_plot $plot }
        return [lindex $reply 1]
    }
    if {[string match "EXT *" $reply]} { return [lrange $reply 1 end] }
    return -1
}

proc ::VMDPathFinder::_csg_server_close {} {
    variable _csg_chan
    if {$_csg_chan eq ""} { return }
    catch { puts $_csg_chan quit; flush $_csg_chan }
    catch { close $_csg_chan }
    set _csg_chan ""
    variable _tunnel_serve
    set _tunnel_serve -1
}

# Native classify+cluster: same dict shape _conn_classify_sph's Tcl body
# returns (plus a "lobes" key _conn_frame_lobes reads straight off, so the
# clustering pass runs once, inside this same process). Empty dict ({}) on
# any problem - the caller re-does the whole thing in pure Tcl, so a stale
# or missing binary degrades to the old behaviour, never a wrong answer.
proc ::VMDPathFinder::_conn_classify_native {in_sph cvect_s cpoint_s margin {basis_s ""}} {
    set exe [tool_path conn_lobes]
    if {$exe eq "" || ![file exists $in_sph]} { return {} }
    lassign $cvect_s ux uy uz
    lassign $cpoint_s ox oy oz
    foreach v {ux uy uz ox oy oz} { if {![string is double -strict [set $v]]} { return {} } }
    if {![string is double -strict $margin]} { return {} }
    set cmd [list $exe {*}[tool_args conn_lobes] classify $in_sph $ox $oy $oz $ux $uy $uz $margin]
    if {$basis_s ne "" && [llength $basis_s] == 6} {
        set _allnum 1
        foreach _b $basis_s { if {![string is double -strict $_b]} { set _allnum 0; break } }
        if {$_allnum} { lappend cmd {*}$basis_s }
    }
    if {[catch {exec {*}$cmd} out]} { return {} }
    set lines [split $out "\n"]
    set i 0
    proc _cln_block {lines i} {
        set hdr [lindex $lines $i]
        set cnt [lindex $hdr 1]
        if {![string is integer -strict $cnt]} { return [list {} $i] }
        incr i
        set block [lrange $lines $i [expr {$i+$cnt-1}]]
        return [list $block [expr {$i+$cnt}]]
    }
    if {[catch {
        lassign [_cln_block $lines $i] pore i
        lassign [_cln_block $lines $i] keep i
        lassign [_cln_block $lines $i] lat  i
        lassign [_cln_block $lines $i] escr i
        set esc_ranges {}
        foreach r $escr { lassign $r lo hi; lappend esc_ranges [list $lo $hi] }
        set lobehdr [lindex $lines $i]
        set nlobe [lindex $lobehdr 1]
        if {![string is integer -strict $nlobe]} { error "bad LOBE header" }
        incr i
        set lobes {}
        for {set k 0} {$k < $nlobe} {incr k} {
            set fields [lindex $lines $i]
            incr i
            set z  [lindex $fields 0]
            set a  [lindex $fields 1]
            set nn [lindex $fields 2]
            set ef [lindex $fields 3]
            set kb [lindex $fields 4]
            set at 5
            # An older engine prints a neck before the stretch; skip it.
            if {![string is integer -strict [lindex $fields $at]]} { set kb [lindex $fields $at]; incr at }
            if {$kb eq "-"} { set kb "" }
            set idx [lrange $fields $at end]
            lappend lobes [list $z $a $nn $idx $ef {} $kb]
        }
        set marked [dict create]
        if {$i < [llength $lines] && [lindex [lindex $lines $i] 0] eq "MARKED"} {
            lassign [_cln_block $lines $i] mk i
            foreach l $mk { dict set marked $l 1 }
        }
    } _err]} { return {} }
    return [dict create pore $pore lateral $lat keep $keep \
        n_pore [llength $pore] n_lat [llength $lat] escaped_ranges $esc_ranges lobes $lobes marked $marked]
}

# Engine for a run: "" = HOLE only; nm = Nelder-Mead search; nmconn = Nelder-Mead
# + ported Connolly (HOLE's conn cannot run on foreign centres); mcconn = HOLE's
# search + ported Connolly on HOLE's centres (the Settings > Connolly surface option).
proc ::VMDPathFinder::_nm_mode_for_run {tcl_fallback} {
    variable state
    if {$tcl_fallback} { return "" }
    set want_nm [expr {[info exists state(search_engine)] && $state(search_engine) eq "nm"}]
    set want_cf [expr {[info exists state(conn_engine)] && $state(conn_engine) eq "fast"}]
    switch -- $state(pore_method) {
        circular { return [expr {$want_nm ? "nm" : ""}] }
        connolly {
            if {$want_nm} { return "nmconn" }
            return [expr {$want_cf ? "mcconn" : ""}]
        }
    }
    return ""
}

proc ::VMDPathFinder::_set_search_engine {val disp} {
    variable state
    variable result_frames
    if {[info exists state(search_engine)] && $state(search_engine) eq $val} { return }
    set had [llength $result_frames]
    set state(search_engine) $val
    set state(search_engine_disp) $disp
    if {$had > 0} { clear_results_for_new_settings }
    _update_search_rows
}

proc ::VMDPathFinder::_set_conn_engine {val disp} {
    variable state
    variable result_frames
    if {[info exists state(conn_engine)] && $state(conn_engine) eq $val} { return }
    set had [llength $result_frames]
    set state(conn_engine) $val
    set state(conn_engine_disp) $disp
    if {$had > 0 && $state(pore_method) eq "connolly"} { clear_results_for_new_settings }
}

# The MC rows apply only to HOLE's search: shown for Monte Carlo and capsule
# (always HOLE), removed under Nelder-Mead; the picker is greyed under capsule.
proc ::VMDPathFinder::_update_search_rows {} {
    variable state
    variable _hp_frame
    if {![info exists _hp_frame] || ![winfo exists $_hp_frame]} { return }
    set hp $_hp_frame
    set capsule [expr {$state(pore_method) eq "capsule"}]
    set mc [expr {$capsule || $state(search_engine) ne "nm"}]
    foreach w {ms_l ms_e md_l md_e mk_l mk_e rs_l rs_e sh_l sh_e ex_l ex_e} {
        if {![winfo exists $hp.$w]} continue
        if {$mc} { grid $hp.$w } else { grid remove $hp.$w }
    }
    set conn [expr {$state(pore_method) eq "connolly"}]
    foreach w {ce_l ce_mb cgate_c} {
        if {![winfo exists $hp.$w]} continue
        if {$conn} { grid $hp.$w } else { grid remove $hp.$w }
    }
    if {[winfo exists $hp.se_mb]} {
        $hp.se_mb configure -state [expr {$capsule ? "disabled" : "normal"}]
    }
}

# Shell lines that run the Nelder-Mead engine for one frame, or "" when the
# control file has something the engine cannot take (then HOLE runs as usual).
proc ::VMDPathFinder::_nm_run_lines {mode exe inp coord_name njobs} {
    variable state
    lassign [_hole_tcl_args_from_inp $inp] st a
    if {$st ne "ok"} { return "" }
    set d [dict create {*}$a]
    foreach k {-cpoint -cvect} { if {![dict exists $d $k]} { return "" } }
    lassign [dict get $d -cpoint] cx cy cz
    lassign [dict get $d -cvect] vx vy vz
    foreach v [list $cx $cy $cz $vx $vy $vz] { if {![string is double -strict $v]} { return "" } }
    set sample [expr {[dict exists $d -sample] ? [dict get $d -sample] : 0.25}]
    set endrad [expr {[dict exists $d -endrad] ? [dict get $d -endrad] : 22.0}]
    set rad [dict get $d -rad]
    set cmd "[shell_quote $exe] [tool_args nm_search] [shell_quote $coord_name] [shell_quote $rad] $cx $cy $cz $vx $vy $vz $sample $endrad"
    append cmd " --sph hole_out.sph --tsv hole_profile.tsv --quiet"
    if {$mode ne "nm"} {
        set probe [expr {[dict exists $d -probe] ? [dict get $d -probe] : 1.15}]
        set grid  [expr {[dict exists $d -grid]  ? [dict get $d -grid]  : 0}]
        append cmd " --conn $probe $grid"
    }
    if {[dict exists $d -ignore] && [string trim [dict get $d -ignore]] ne ""} {
        append cmd " --ignore [shell_quote [join [dict get $d -ignore] ,]]"
    }
    # one frame per core in a pool: the engine must not fan out on its own
    set pre [expr {$njobs > 1 ? "OMP_NUM_THREADS=1 " : ""}]
    set lines [list "rm -f hole_out.txt hole_out.sph hole_profile.tsv 2>/dev/null"]
    if {$mode eq "mcconn"} {
        set awk {/^ATOM/ {r=substr($0,23,4)+0; if (r==-999 || r==-888) next; if (seen[r]++) next; x=substr($0,31,8)+0; y=substr($0,39,8)+0; z=substr($0,47,8)+0; o=substr($0,55,6)+0; printf "%.4f %.3f %.3f %.3f %.2f\n", (x-cx)*vx+(y-cy)*vy+(z-cz)*vz, x, y, z, o}}
        set vn [expr {sqrt($vx*$vx + $vy*$vy + $vz*$vz)}]
        if {$vn < 1e-9} { return "" }
        lappend lines "[_hole_omp_prefix $njobs][shell_quote $state(hole_exec)] < hole_sph.inp > hole_sph_out.txt 2>/dev/null"
        lappend lines "_vh_rc=\$?"
        lappend lines "if \[ \"\$_vh_rc\" -eq 0 \]; then"
        lappend lines "awk -v cx=$cx -v cy=$cy -v cz=$cz -v vx=[expr {$vx/$vn}] -v vy=[expr {$vy/$vn}] -v vz=[expr {$vz/$vn}] '$awk' hole_out.sph > nm_centres.txt"
        lappend lines "$pre$cmd --centres nm_centres.txt > nm_search.log 2>&1"
        lappend lines "_vh_rc=\$?"
        lappend lines "fi"
    } else {
        lappend lines "$pre$cmd > nm_search.log 2>&1"
        lappend lines "_vh_rc=\$?"
    }
    return $lines
}

proc ::VMDPathFinder::_tunnel_parse_text {txt} {
    # "T id bottleneck length cost throughput" starts a tunnel, "P id x y z rho"
    # adds a point. BOTH engines emit this grammar - the MOLE engine was written
    # to, deliberately - so one reader serves the lattice search, the MOLE
    # binary, the pure-Tcl MOLE fallback and the frame-parallel pool, and none
    # of them can drift from the others.
    set res {}
    set cur ""; set pts {}; set cav ""
    foreach line [split $txt "\n"] {
        set f [split [string trim $line]]
        if {[lindex $f 0] eq "T"} {
            # A TRUNCATED file (engine killed mid-write) ends in a partial
            # record, and lindex past the end returns "" - which became a
            # tunnel with an empty bottleneck rather than a parse failure.
            # "T id bottleneck length cost throughput" is 6 fields; anything
            # shorter is not a usable record.
            if {[llength $f] < 6} { continue }
            if {$cur ne ""} { lappend res [linsert $cur end $pts $cav] }
            set cur [list [lindex $f 2] [lindex $f 3] [lindex $f 4] [lindex $f 5]]
            # Field 6 = cavity id (0 = surface cavity "C0", 1.. = ranked buried
            # cavities), so a tunnel can be labelled the way MOLE labels it. Older
            # output has no such field; "" then means "unknown", not "surface".
            set cav [expr {[llength $f] > 6 ? [lindex $f 6] : ""}]
            set pts {}
        } elseif {[lindex $f 0] eq "P"} {
            # As for T: a partial final line would otherwise append empty
            # strings as coordinates, and a point at ""/""/"" survives every
            # downstream check until something tries arithmetic on it.
            if {[llength $f] < 6} { continue }
            lappend pts [lindex $f 2] [lindex $f 3] [lindex $f 4] [lindex $f 5]
        }
    }
    if {$cur ne ""} { lappend res [linsert $cur end $pts $cav] }
    return $res
}

# The lining block, as a dict keyed by tunnel id: layers, flow, props, wprops.
#
# Separate from _tunnel_parse_text rather than folded into it, because that proc
# returns a fixed-shape list every caller unpacks positionally - the frame pool
# and the surface code among them - and widening it to carry the lining would
# mean touching all of them for data none of them wants. Callers that DO want it
# ask for it; the profile parser stays exactly as it was, and an engine run
# without an atom-name column simply yields an empty dict.
#
# The record layout is mole_main.c's;
proc ::VMDPathFinder::_tunnel_parse_lining {txt} {
    set out [dict create]
    set pkeys {charge ionizable npos nneg hydropathy hydrophobicity polarity
               logp logd logs mutability}
    foreach line [split $txt "\n"] {
        set f [split [string trim $line]]
        set id [lindex $f 1]
        switch -exact -- [lindex $f 0] {
            L {
                set res {}
                foreach tok [lrange $f 21 end] {
                    lassign [split $tok ":"] rn sq ch bb fi
                    lappend res [dict create resname $rn resid $sq chain $ch \
                                     backbone $bb flow $fi]
                }
                set layer [dict create layer [lindex $f 2] start [lindex $f 3] \
                    end [lindex $f 4] radius [lindex $f 5] \
                    freeradius [lindex $f 6] bradius [lindex $f 7] \
                    localmin [lindex $f 8] residues $res]
                foreach k $pkeys v [lrange $f 9 19] { dict set layer $k $v }
                dict lappend out $id.layers $layer
            }
            P {
                # Per-POINT FreeRadius / BRadius (fields 6-7). _tunnel_parse_text
                # keeps only x y z r for its fixed-shape tuple; these ride here
                # so the MOLE-layout CSV export can fill its FreeRadius/BRadius
                # columns per point instead of leaving them blank.
                if {[llength $f] >= 8} {
                    dict lappend out $id.pfree [lindex $f 6]
                    dict lappend out $id.pbr   [lindex $f 7]
                }
            }
            V {
                # "V id type volume depth depthlength nboundary ninner" - a
                # cavity (or a Void: no boundary residues), MOLE's cavities.xml.
                if {[llength $f] < 8} { continue }
                dict set out cav.$id [dict create type [lindex $f 2] \
                    volume [lindex $f 3] depth [lindex $f 4] depthlen [lindex $f 5] \
                    nboundary [lindex $f 6] ninner [lindex $f 7] \
                    bprops {} iprops {} bres {} ires {} spheres {} origins {} \
                    nsph 0 sx 0.0 sy 0.0 sz 0.0 maxr 0.0]
            }
            VB - VI {
                # Boundary / inner residue set of cavity $id with its properties:
                # "VB id charge ionizable npos nneg hydropathy hydrophobicity
                # polarity logp logd logs mutability nres resn:seq:chain..."
                if {![dict exists $out cav.$id]} { continue }
                set p [dict create]
                foreach k $pkeys v [lrange $f 2 12] { dict set p $k $v }
                set res {}
                foreach tok [lrange $f 14 end] {
                    lassign [split $tok ":"] rn sq ch
                    lappend res [dict create resname $rn resid $sq chain $ch]
                }
                set which [expr {[lindex $f 0] eq "VB" ? "b" : "i"}]
                dict set out cav.$id ${which}props $p
                dict set out cav.$id ${which}res $res
            }
            VP {
                # "VP id x y z r" - one cavity tetrahedron as a centre+clearance
                # sphere, the same quantity a tunnel's P points carry, so a
                # cavity drawn as a sphere union matches a tunnel drawn one.
                if {[llength $f] < 6 || ![dict exists $out cav.$id]} { continue }
                set _sp [dict get $out cav.$id spheres]
                lappend _sp [lrange $f 2 5]
                dict set out cav.$id spheres $_sp
                # Running centroid and largest radius, accumulated HERE because
                # this loop already touches every sphere. Walking them again per
                # cavity per frame is what made the Cavities window slow to open
                # on a real trajectory: frames x cavities x hundreds of spheres.
                set _n  [expr {[dict get $out cav.$id nsph] + 1}]
                dict set out cav.$id nsph $_n
                dict set out cav.$id sx [expr {[dict get $out cav.$id sx] + [lindex $f 2]}]
                dict set out cav.$id sy [expr {[dict get $out cav.$id sy] + [lindex $f 3]}]
                dict set out cav.$id sz [expr {[dict get $out cav.$id sz] + [lindex $f 4]}]
                if {[lindex $f 5] > [dict get $out cav.$id maxr]} {
                    dict set out cav.$id maxr [lindex $f 5]
                }
            }
            O {
                # "O id rank x y z depthlength" - an origin MOLE itself would
                # pick for that cavity (local DepthLength maxima, deepest
                # first). Emitted on every run, so "start the search here" can
                # offer the engine's OWN answer rather than a lookalike.
                if {[llength $f] < 7 || ![dict exists $out cav.$id]} { continue }
                set _og [dict get $out cav.$id origins]
                lappend _og [list [lindex $f 2] [lrange $f 3 5] [lindex $f 6]]
                dict set out cav.$id origins $_og
            }
            H {
                # Tunnel.FindHetResidues - the HET residues the tunnel passes
                # through. Kept apart from the lining: MOLE computes it with a
                # different radius (1.2 x Radius, not the nearest five) and does
                # not split it by backbone, so folding it into the lining rows
                # would misreport both.
                set hets {}
                foreach tok [lrange $f 3 end] {
                    lassign [split $tok ":"] rn sq ch
                    lappend hets [dict create resname $rn resid $sq chain $ch]
                }
                dict set out $id.het $hets
            }
            F {
                set flow {}
                foreach tok [lrange $f 3 end] {
                    lassign [split $tok ":"] rn sq ch bb
                    lappend flow [dict create resname $rn resid $sq chain $ch \
                                      backbone $bb]
                }
                dict set out $id.flow $flow
            }
            Y - W {
                set p [dict create]
                foreach k $pkeys v [lrange $f 2 12] { dict set p $k $v }
                dict set out $id.[expr {[lindex $f 0] eq "Y" ? "props" : "wprops"}] $p
            }
        }
    }
    return $out
}

# ---- MOLE cavities: table, draw toggles, residues ---------------------------
# A cavity is what MOLE's cavities.xml reports: a buried pocket (Cavity, has
# boundary residues) or a Void (none), with volume, depth, boundary/inner
# residue sets and their properties, plus - from this engine - the tetrahedra
# as centre+clearance spheres, so it can be DRAWN the way a tunnel is: the
# same sphere-union mesher, on the tunnel track. Parsed by
# _tunnel_parse_lining into tunnel_lining($frame) under cav.<id>.
proc ::VMDPathFinder::_tunnel_cavities {frame} {
    # {id dict ...} for $frame, ids ascending. {} without cavity records (an
    # engine older than the VP/V lines, or the pure-Tcl port).
    variable tunnel_lining
    if {$frame eq "" || ![info exists tunnel_lining($frame)]} { return {} }
    set out {}
    set ids {}
    dict for {k v} $tunnel_lining($frame) {
        if {[string match "cav.*" $k]} { lappend ids [string range $k 4 end] }
    }
    foreach id [lsort -integer $ids] { lappend out $id [dict get $tunnel_lining($frame) cav.$id] }
    return $out
}

proc ::VMDPathFinder::_cavity_centroid {cv} {
    # Mean of the cavity's tetrahedra centres - its position, for matching the
    # same cavity across frames. Cheaper and steadier than the origin, which
    # can hop between two nearly equal DepthLength maxima from frame to frame.
    if {[dict exists $cv nsph]} {
        set n [dict get $cv nsph]
        if {$n == 0} { return {} }
        return [list [expr {[dict get $cv sx]/$n}] [expr {[dict get $cv sy]/$n}] \
                     [expr {[dict get $cv sz]/$n}]]
    }
    set n 0; set sx 0.0; set sy 0.0; set sz 0.0
    foreach sp [dict get $cv spheres] {
        lassign $sp x y z
        set sx [expr {$sx+$x}]; set sy [expr {$sy+$y}]; set sz [expr {$sz+$z}]
        incr n
    }
    if {$n == 0} { return {} }
    return [list [expr {$sx/$n}] [expr {$sy/$n}] [expr {$sz/$n}]]
}

proc ::VMDPathFinder::_cavity_max_probe {cv} {
    # The largest clearance sphere the cavity holds - CAVER Analyst's "Max.
    # Probe". An upper bound on what fits inside the pocket at all.
    if {[dict exists $cv maxr]} { return [dict get $cv maxr] }
    set m 0.0
    foreach sp [dict get $cv spheres] {
        set r [lindex $sp 3]
        if {[string is double -strict $r] && $r > $m} { set m $r }
    }
    return $m
}

proc ::VMDPathFinder::_cavity_origin {cv {rule ""}} {
    # Where a search started from this cavity would begin.
    #   mole  - the engine's OWN first automatic origin (deepest point by
    #           DepthLength). This is the point MOLE would have used in
    #           automatic mode, read from its O record, not recomputed here.
    #   caver - centre of the cavity's largest inscribed sphere, which is what
    #           CAVER Analyst's "Create Starting Point" uses.
    # Falls back to the other rule when one is unavailable, so the button
    # always has something to give.
    variable state
    if {$rule eq ""} {
        set rule [expr {[info exists state(cavity_origin_rule)] \
            ? $state(cavity_origin_rule) : "mole"}]
    }
    set og [dict get $cv origins]
    set mole {}
    if {[llength $og]} {
        set best {}; set brank 1e30
        foreach o $og {
            lassign $o rank pt _dl
            if {[string is integer -strict $rank] && $rank < $brank} { set brank $rank; set best $pt }
        }
        set mole $best
    }
    set caver {}
    set bestr -1.0
    foreach sp [dict get $cv spheres] {
        set r [lindex $sp 3]
        if {[string is double -strict $r] && $r > $bestr} { set bestr $r; set caver [lrange $sp 0 2] }
    }
    if {$rule eq "caver"} { return [expr {[llength $caver] == 3 ? $caver : $mole}] }
    return [expr {[llength $mole] == 3 ? $mole : $caver}]
}

proc ::VMDPathFinder::_cavity_origin_short {cv} {
    # The chosen rule's start point, short enough for a table cell.
    set pt [_cavity_origin $cv]
    if {[llength $pt] != 3} { return "-" }
    return [format "%.1f %.1f %.1f" {*}$pt]
}

proc ::VMDPathFinder::_cavity_tracks {} {
    # Cavities followed ACROSS FRAMES, each with a STABLE id of its own.
    #
    # MOLE recomputes cavities independently per frame and ranks them by
    # volume, so a rank is not an identity: two pockets that swap volume order
    # swap ids between frames. Keying anything user-facing on the rank has the
    # defect the routes already had - tick a cavity, step a frame, and the tick
    # lands on a different pocket. So each cavity gets a track, and the track
    # is what the panel, the checkbox and the colour key on.
    #
    # Identity is by CENTROID PROXIMITY, frame by frame: a cavity joins the
    # nearest existing track whose running centroid is within the cutoff, else
    # it starts one. Track ids are assigned by mean volume once every frame has
    # been walked, so the largest pocket is track 1 in every frame.
    #
    # Memoised: this walks every frame's cavities and is called from the
    # renderer, which runs on every frame change.
    variable tunnel_lining
    variable tunnel_result_frames
    variable state
    variable plot_data_version
    variable _cavity_track_cache
    set cut [expr {[info exists state(cavity_track_cutoff)] \
        ? $state(cavity_track_cutoff) : 6.0}]
    if {![string is double -strict $cut] || $cut <= 0} { set cut 6.0 }
    set key "[llength $tunnel_result_frames]|$plot_data_version|$cut"
    if {[info exists _cavity_track_cache] && [dict exists $_cavity_track_cache $key]} {
        return [dict get $_cavity_track_cache $key]
    }
    set tracks {}
    set nfr 0
    # The match loop runs (frames x cavities x tracks) times - 830k on a
    # 50-frame run - so its body is kept off dicts: centroids live in three flat
    # lists and "already matched this frame" is an integer compare instead of a
    # dict lookup. Squared distances, no pow/sqrt. Same matches either way.
    set tcx {}; set tcy {}; set tcz {}; set tlast {}
    set cut2 [expr {$cut * $cut}]
    foreach fr $tunnel_result_frames {
        if {![info exists tunnel_lining($fr)]} { continue }
        incr nfr
        foreach {id cv} [_tunnel_cavities $fr] {
            set c [_cavity_centroid $cv]
            if {[llength $c] != 3} { continue }
            lassign $c cx cy cz
            set best -1; set bestd $cut2
            set i -1
            foreach ax $tcx ay $tcy az $tcz lf $tlast {
                incr i
                # one cavity per track per frame - the nearest wins
                if {$lf == $fr} { continue }
                set dx [expr {$cx - $ax}]; set dy [expr {$cy - $ay}]; set dz [expr {$cz - $az}]
                set d [expr {$dx*$dx + $dy*$dy + $dz*$dz}]
                if {$d < $bestd} { set bestd $d; set best $i }
            }
            if {$best < 0} {
                lappend tracks [dict create frames [list $fr] \
                    ids [dict create $fr $id] centroid $c \
                    volumes [list [dict get $cv volume]] \
                    maxprobe [_cavity_max_probe $cv] type [dict get $cv type]]
                lappend tcx $cx; lappend tcy $cy; lappend tcz $cz; lappend tlast $fr
            } else {
                set t [lindex $tracks $best]
                dict lappend t frames $fr
                dict set t ids $fr $id
                dict lappend t volumes [dict get $cv volume]
                set mp [_cavity_max_probe $cv]
                if {$mp > [dict get $t maxprobe]} { dict set t maxprobe $mp }
                # running centroid, so a slowly drifting cavity keeps matching
                set n [llength [dict get $t frames]]
                set tc [dict get $t centroid]
                set nc {}
                foreach a $tc b $c { lappend nc [expr {$a + ($b-$a)/double($n)}] }
                dict set t centroid $nc
                lset tracks $best $t
                lset tcx $best [lindex $nc 0]
                lset tcy $best [lindex $nc 1]
                lset tcz $best [lindex $nc 2]
                lset tlast $best $fr
            }
        }
    }
    # statistics, then a stable id by mean volume (largest = 1) so the same
    # pocket carries the same number and colour in every frame
    set stat {}
    foreach t $tracks {
        set v [dict get $t volumes]
        set n [llength $v]
        set sum 0.0
        foreach x $v { set sum [expr {$sum+$x}] }
        set mean [expr {$n ? $sum/$n : 0.0}]
        set sd 0.0
        if {$n > 1} {
            set acc 0.0
            foreach x $v { set acc [expr {$acc + ($x-$mean)*($x-$mean)}] }
            set sd [expr {sqrt($acc/($n-1))}]
        }
        dict set t vol_mean $mean
        dict set t vol_sd $sd
        dict set t seen [expr {$nfr ? 100.0*$n/$nfr : 0.0}]
        dict set t nframes $nfr
        lappend stat $t
    }
    # No lmap here: VMD ships stock Tcl 8.5, where it does not exist.
    set _pairs {}
    foreach t $stat { lappend _pairs [list $t [dict get $t vol_mean]] }
    set stat [lsort -real -decreasing -index 1 $_pairs]
    set out {}
    set tid 0
    foreach pair $stat {
        incr tid
        set t [lindex $pair 0]
        dict set t tid $tid
        lappend out $t
    }
    if {![info exists _cavity_track_cache]} { set _cavity_track_cache [dict create] }
    dict set _cavity_track_cache $key $out
    return $out
}

proc ::VMDPathFinder::_cavity_track_by_tid {tid} {
    foreach t [_cavity_tracks] { if {[dict get $t tid] == $tid} { return $t } }
    return {}
}

proc ::VMDPathFinder::_cavity_rank_in_frame {tid frame} {
    # The per-frame cavity RANK belonging to track $tid, or "" when that track
    # has no cavity in this frame - the cavity counterpart of
    # _tunnel_rank_in_frame, and for the same reason.
    set t [_cavity_track_by_tid $tid]
    if {![llength $t] || ![dict exists $t ids $frame]} { return "" }
    return [dict get $t ids $frame]
}

proc ::VMDPathFinder::_cavity_track_for {frame id} {
    # The cross-frame track a given frame's cavity belongs to, or {}.
    foreach t [_cavity_tracks] {
        if {[dict exists $t ids $frame] && [dict get $t ids $frame] == $id} { return $t }
    }
    return {}
}

proc ::VMDPathFinder::_tunnel_cavity_shown {tid} {
    # Keyed on the TRACK id, so ticking a cavity keeps that same pocket drawn
    # as the trajectory plays. Keyed on the per-frame rank it would have
    # followed whatever pocket happened to hold that rank next frame.
    variable tunnel_cavity_shown
    return [expr {[info exists tunnel_cavity_shown($tid)] && $tunnel_cavity_shown($tid)}]
}

proc ::VMDPathFinder::ensure_cavity_mol {protein_mol} {
    # Cavities get a track of their OWN, not the routes'. Routes are cross-frame
    # tracked objects and cavity ids are per-frame ranks: sharing one molecule
    # meant a route display change or a hide-all also disturbed the cavities,
    # and neither could be given its own material.
    variable cavity_mols
    if {![info exists cavity_mols]} { array set cavity_mols {} }
    if {[info exists cavity_mols($protein_mol)] && \
            ![catch {molinfo $cavity_mols($protein_mol) get name}]} {
        set m $cavity_mols($protein_mol)
        catch {sync_surface_view $m $protein_mol}
        return $m
    }
    set pv {}
    catch {set pv [molinfo $protein_mol get \
        {center_matrix rotate_matrix scale_matrix global_matrix}]}
    set prev [molinfo top]
    set m [mol new]
    mol rename $m "Cavities (mol $protein_mol)"
    set cavity_mols($protein_mol) $m
    if {$pv ne ""} {
        catch {molinfo $m set {center_matrix rotate_matrix scale_matrix global_matrix} $pv}
    }
    catch {sync_surface_view $m $protein_mol}
    # `mol new` steals top, and VMD drives playback off top - see
    # ensure_tunnel_surface_mol's own note.
    catch {mol top $prev}
    return $m
}

proc ::VMDPathFinder::_cavity_structure_molid {} {
    # A molecule that actually carries atoms: what resolve_molid gives, unless
    # that resolved to one of the plugin's own graphics molecules (see
    # _render_cavities_for_frame), in which case the molecule this run's
    # tunnel track was created for.
    variable tunnel_surface_mols
    variable tunnel_run_molid
    # The molecule the RESULTS belong to wins: the cavity lining names residues
    # of that structure, and resolving them against any other molecule finds
    # nothing.
    if {[info exists tunnel_run_molid] && $tunnel_run_molid ne "" \
            && ![catch {molinfo $tunnel_run_molid get numatoms} n0] && $n0 > 0} {
        return $tunnel_run_molid
    }
    set m [resolve_molid_or -1]
    if {$m >= 0 && ![catch {molinfo $m get numatoms} n] && $n > 0} { return $m }
    if {[info exists tunnel_surface_mols]} {
        foreach k [array names tunnel_surface_mols] {
            if {[string is integer -strict $k] && ![catch {molinfo $k get numatoms} n2] && $n2 > 0} {
                return $k
            }
        }
    }
    return -1
}

proc ::VMDPathFinder::_cavity_effective_color {tid} {
    # This pocket's flat colour: its own gear override, else the rank colour.
    # The gear stored an override that nothing read, so every pocket drew in
    # the rank colour whatever the menu said.
    variable cavity_gear_color
    if {[info exists cavity_gear_color] && [dict exists $cavity_gear_color $tid]} {
        set v [dict get $cavity_gear_color $tid]
        if {$v ne "auto" && $v ne ""} { return $v }
    }
    return [_tunnel_color [expr {$tid+11}]]
}

proc ::VMDPathFinder::_cavity_effective_material {tid} {
    # This pocket's material: its own gear override, else the window default.
    variable cavity_gear_material
    variable state
    if {[info exists cavity_gear_material] && [dict exists $cavity_gear_material $tid]} {
        set v [dict get $cavity_gear_material $tid]
        if {$v ne "auto" && $v ne ""} { return $v }
    }
    return [expr {[info exists state(cavity_solid)] && $state(cavity_solid) \
        ? "Opaque" : "Transparent"}]
}

proc ::VMDPathFinder::_cavity_effective_spheres {tid} {
    # 1 to draw the clearance spheres themselves, 0 to mesh a surface over
    # them. Gear override first, then the window default.
    variable cavity_gear_style
    variable state
    if {[info exists cavity_gear_style] && [dict exists $cavity_gear_style $tid]} {
        switch -exact -- [dict get $cavity_gear_style $tid] {
            spheres { return 1 }
            surface { return 0 }
        }
    }
    return [expr {[info exists state(cavity_spheres)] && $state(cavity_spheres)}]
}

proc ::VMDPathFinder::_cavity_show_lining_track {tid} {
    # Act on the pocket in the frame being viewed, not the frame the window was
    # built on. MOLE re-ranks cavities every frame, so a rank frozen into the
    # button pointed at a different pocket - or at nothing - after a scrub.
    set frame [_tunnel_display_frame]
    set id [_cavity_rank_in_frame $tid $frame]
    if {$id eq ""} { return }
    _cavity_show_lining $frame $id
}

proc ::VMDPathFinder::_cavity_use_as_start_track {tid} {
    set frame [_tunnel_display_frame]
    set id [_cavity_rank_in_frame $tid $frame]
    if {$id eq ""} { return }
    _cavity_use_as_start $frame $id
}

proc ::VMDPathFinder::_cavity_residues_track {tid} {
    set frame [_tunnel_display_frame]
    set id [_cavity_rank_in_frame $tid $frame]
    if {$id eq ""} { return }
    _tunnel_cavity_residues $frame $id
}

proc ::VMDPathFinder::_render_cavities_for_frame {frame {m ""} {fd ""}} {
    # Draw every ticked cavity of $frame onto the CAVITY track. One .sph + mesh
    # per cavity beside the frame's tunnel files, reused on the mtime rule the
    # routes use. Drawn transparent by default so a route can be seen passing
    # through the pocket it starts from; Solid is a per-window toggle.
    variable state
    variable tunnel_cavity_shown
    variable tunnel_root
    # The STRUCTURE, and it must really be one. state(molid) defaults to "top",
    # and the tracks/cavities are drawn into graphics molecules that briefly
    # become top - so resolve_molid can hand back an atom-less molecule, and
    # every atomselect against it then finds nothing ("no lining residues
    # resolved to atoms", with the property colouring silently falling back to
    # a flat colour). Fall back to the molecule this run's tunnels belong to.
    set molid [_cavity_structure_molid]
    if {$molid < 0} { return "" }
    set cavs [_tunnel_cavities $frame]
    set any 0
    foreach t [_cavity_tracks] { if {[_tunnel_cavity_shown [dict get $t tid]]} { set any 1; break } }
    if {!$any} {
        # nothing ticked: clear the track rather than leave the last frame's
        variable cavity_mols
        if {[info exists cavity_mols($molid)] && ![catch {molinfo $cavity_mols($molid) get name}]} {
            catch {graphics $cavity_mols($molid) delete all}
            return $cavity_mols($molid)
        }
        return ""
    }
    set cm [ensure_cavity_mol $molid]
    catch {graphics $cm delete all}
    if {$fd eq ""} { set fd [file join $tunnel_root [format "tunnel_%05d" $frame]] }
    # A CAP on how many pockets are meshed at once. Each one is a full
    # sph_process/mesher build, and nothing else bounded this: ticking every
    # pocket with the filter lifted asked for 315 meshes in one pass and took
    # the plugin down. The cap lives HERE rather than on the checkbox because
    # any path that sets many ticks - a restored config, a frame change - lands
    # in this loop.
    set _cap [_cavity_draw_cap]
    set _drawn 0; set _skipped 0
    foreach t [_cavity_tracks] {
        set tid [dict get $t tid]
        if {![_tunnel_cavity_shown $tid]} continue
        if {$_drawn >= $_cap} { incr _skipped; continue }
        # the ticked TRACK's cavity in THIS frame - absent from some frames is
        # normal, and simply means nothing to draw here
        set id [_cavity_rank_in_frame $tid $frame]
        if {$id eq "" || ![dict exists $cavs $id]} continue
        set cv [dict get $cavs $id]
        set spheres [dict get $cv spheres]
        if {![llength $spheres]} continue
        set sph [file join $fd [format "cavity_%02d.sph" $id]]
        if {![file exists $sph]} {
            if {[catch {write_stock_sph_file $spheres $sph}]} continue
        }
        # Per pocket, so one pocket's gear cannot decide how the others draw.
        set mat [_cavity_effective_material $tid]
        set col [_cavity_effective_color $tid]
        set prop [_cavity_effective_prop $tid]
        if {[_cavity_effective_spheres $tid]} {
            # CAVER Analyst's "Locked Probes": the clearance spheres themselves
            # rather than a surface over them, which is the cavity as the
            # engine actually represents it.
            catch {render_sph_points_to_mol $sph $cm $col 0.6}
            continue
        }
        set plot [surface_plot_name $fd [format "cavity_%02d" $id] draw 1]
        if {![_tunnel_mesh_current $plot $sph]} {
            if {![surface_mesh $sph $plot draw 6 1 1]} continue
        }
        # Property colouring goes through the SAME mesh and the same recolour
        # kernel a route uses: one mesh, recoloured, never a second surface
        # built a different way. Cached beside it on the mesh's own mtime, as
        # the route colouring is, so a redraw is not a re-recolour.
        set done 0
        if {$prop ne "none"} {
            set cplot [file join $fd [format "cavity_%02d_%s_v1.plot" $id $prop]]
            if {[surface_has_geometry $cplot] && [file mtime $cplot] >= [file mtime $plot]} {
                # color_mode "property": the plot carries its OWN per-triangle
                # colours, and render_vmd_plot_to_mol overrides them for any
                # mode outside its data-driven set - so leaving this blank let
                # pore mode's flat surface_color repaint a cavity that had just
                # been coloured by a property.
                catch {render_vmd_plot_to_mol $cplot $cm 1 "" property $mat 0 0}
                set done 1
            } else {
                # Why a fallback happened is worth saying: a cavity silently
                # drawn in its flat colour looks like the property picker did
                # nothing.
                variable _cavity_color_why
                set rfile [file join $fd [format "cavity_%02d_%s.txt" $id $prop]]
                if {[catch {write_cavity_property_sidecar $molid $frame $id $rfile $prop} _e1]} {
                    set _cavity_color_why "sidecar: $_e1"
                } else {
                    lassign [_cavity_property_range $prop] plo phi
                    set psigned [dict get [property_meta $prop] signed]
                    if {[catch {run_sos_triangle_3d_recolor $plot $cplot $sph $rfile $psigned $plo $phi 0} _e2]} {
                        set _cavity_color_why "recolor: $_e2"
                    } elseif {![surface_has_geometry $cplot]} {
                        set _cavity_color_why "recolor produced no geometry"
                    } else {
                        set _cavity_color_why ""
                        catch {render_vmd_plot_to_mol $cplot $cm 1 "" property $mat 0 0}
                        set done 1
                    }
                }
                catch {file delete $rfile}
                if {!$done && $_cavity_color_why ne ""} {
                    set state(status) "Cavity $id: property colouring fell back to a flat colour ($_cavity_color_why)."
                }
            }
        }
        if {!$done} {
            catch {render_vmd_plot_to_mol $plot $cm 1 $col "" $mat 0 0}
        }
        incr _drawn
    }
    if {$_skipped > 0} {
        set state(status) "Drew $_drawn pockets; $_skipped more are ticked but not drawn (cap $_cap). Untick some, or raise the cap in Settings."
    }
    return $cm
}

proc ::VMDPathFinder::_tunnel_cavity_toggle {} {
    # A tick changed: redraw the shown frame's track (tunnels + cavities).
    variable state
    variable w
    set fr [_tunnel_display_frame]
    if {$fr eq ""} { return }
    # Say so in the title and repaint before the redraw starts. Meshing a
    # pocket on a large structure is seconds with no event processing, and the
    # cavities window sat blank under its title bar for all of it.
    set t $w.tuncav
    set _title ""
    if {[winfo exists $t]} {
        set _title [wm title $t]
        catch {wm title $t "$_title - calculating..."}
    }
    set state(status) "Drawing pockets for frame $fr..."
    catch {update}
    catch {render_tunnels_for_frame $fr}
    if {$_title ne "" && [winfo exists $t]} { catch {wm title $t $_title} }
}

proc ::VMDPathFinder::_lining_residue_value {prop resname} {
    # ONE rule for "what is this residue worth under this property", for every
    # per-residue colour anchor (a route's and a cavity's).
    #
    # The two tables are deliberately NOT aliased onto each other - MOLE's
    # charge/polarity/hydropathy are its own constants, not the HOLE scales of
    # similar name (see _tunnel_prop_label) - so the token decides which table
    # answers. mole_residue_property returns 0.0 for a token it does not carry,
    # which is why a HOLE scale asked of it produced a uniformly zero, flat
    # surface rather than an error.
    if {$prop in [_tunnel_scale_tokens]} { return [residue_property $prop $resname] }
    return [mole_residue_property $prop $resname]
}

proc ::VMDPathFinder::write_cavity_property_sidecar {molid frame id out_file prop} {
    # One "x y z value" row per residue lining this cavity - the same sidecar
    # format write_tunnel_hydro3d_residue_sidecar writes for a route, so a
    # cavity surface is coloured by the SAME kernel that colours a tunnel and a
    # pore wall (run_sos_triangle_3d_recolor's nearest-residue interpolation)
    # rather than by a second, parallel colouring path.
    #
    # A cavity's residues come from MOLE's own Boundary and Inner sets rather
    # than from per-layer lining: a volume has no layers. Both sets are used -
    # the boundary residues are what the surface actually touches, and the
    # inner ones fill the interior so a point deep in the pocket still has a
    # residue to take its value from.
    variable tunnel_lining
    if {![info exists tunnel_lining($frame)]} { error "no cavity data for this frame" }
    set lin $tunnel_lining($frame)
    if {![dict exists $lin cav.$id]} { error "no cavity $id in frame $frame" }
    set cv [dict get $lin cav.$id]
    set out [open $out_file w]
    set n 0
    set _last_sel "(none)"
    foreach which {bres ires} {
        foreach r [dict get $cv $which] {
            set rn [dict get $r resname]
            set sq [dict get $r resid]
            set ch [dict get $r chain]
            set seltext "resname $rn and resid $sq"
            if {$ch ne "" && $ch ne "-"} { append seltext " and chain $ch" }
            set _last_sel $seltext
            if {[catch {atomselect $molid $seltext frame $frame} sel]} { continue }
            if {[$sel num] == 0} { $sel delete; continue }
            # UNWEIGHTED centroid, as the tunnel sidecar uses - not a centre of
            # mass, so a heavy atom cannot drag the residue's colour anchor.
            set c [measure center $sel]
            $sel delete
            set val [_lining_residue_value $prop $rn]
            if {![string is double -strict $val]} { continue }
            lassign $c cx cy cz
            puts $out [format "%.4f %.4f %.4f %.6f" $cx $cy $cz $val]
            incr n
        }
    }
    close $out
    if {$n == 0} {
        set _na "?"
        catch {set _na [molinfo $molid get numatoms]}
        error "no lining residues resolved to atoms (mol $molid, $_na atoms;\
            [llength [dict get $cv bres]] boundary + [llength [dict get $cv ires]] inner\
            residues; first tried: \"$_last_sel\")"
    }
    return $n
}

proc ::VMDPathFinder::_cavity_prop_tokens {} {
    # The properties a CAVITY can be coloured by: the residue-table scales, since
    # a cavity's value comes from its lining residues. MOLE's own per-layer
    # columns are not here - those are computed per tunnel layer and a volume
    # has no layers - and neither is esp, which is evaluated at a route's own
    # points.
    # kr is excluded: Kapcha-Rossky is ATOM-level, so a residue has no single
    # value to anchor a colour with (a route gets one only by averaging a
    # layer's atoms, and a volume has no layers).
    set out {}
    foreach t [_tunnel_scale_tokens] { if {$t ne "kr"} { lappend out $t } }
    return [concat $out \
                   {charge polarity hydropathy hydrophobicity ionizable logp logd logs mutability}]
}

proc ::VMDPathFinder::_cavity_property_range {prop} {
    # Same convention the tunnel property scale uses: fixed theoretical bounds
    # where the quantity has them, so a colour means the same thing in every
    # frame and every cavity.
    if {$prop eq "polarity"} { return [list 0.0 52.0] }
    set m [property_meta $prop]
    if {[dict exists $m lo] && [dict exists $m hi]} {
        return [list [dict get $m lo] [dict get $m hi]]
    }
    return {0.0 1.0}
}

proc ::VMDPathFinder::_sync_cavity_header_columns {t} {
    # Keep the frozen header lined up with the scrolling body. They are two
    # independent grids, so Tk sizes each from its own content and "Volume" over
    # a column of 1234.5s drifts apart on its own.
    #
    # Copied from _sync_tunlist_header_columns, including its two hard-won
    # rules: the LAST column is left unpinned to absorb the slack (header labels
    # are wider than their data, and pinning every column pushes the rightmost
    # ones out of the canvas), and the header follows the body, never the
    # reverse.
    if {![_have_tk]} { return }
    set hf $t.hdr
    set bf $t.sc.c.inner
    if {![winfo exists $hf] || ![winfo exists $bf]} { return }
    catch {update idletasks}
    set nc 0
    foreach m [list $hf $bf] {
        set sz [grid size $m]
        if {[llength $sz] == 2 && [lindex $sz 0] > $nc} { set nc [lindex $sz 0] }
    }
    for {set c 0} {$c < $nc-1} {incr c} {
        set wmax 0
        foreach {m r} [list $hf 0 $bf 1] {
            if {[catch {grid bbox $m $c $r} bb]} { continue }
            if {[llength $bb] == 4 && [lindex $bb 2] > $wmax} { set wmax [lindex $bb 2] }
        }
        if {$wmax > 0} {
            catch {grid columnconfigure $hf $c -minsize $wmax}
            catch {grid columnconfigure $bf $c -minsize $wmax}
        }
    }
    if {$nc > 0} {
        catch {grid columnconfigure $hf [expr {$nc-1}] -minsize 0 -weight 1}
        catch {grid columnconfigure $bf [expr {$nc-1}] -minsize 0 -weight 1}
    }
    # The header must not drive the window's width: it is a direct child, while
    # the body is insulated inside the canvas.
    set cvw $t.sc.c
    if {[winfo exists $cvw]} {
        set _hh [winfo reqheight $hf]
        set _cw [winfo width $cvw]
        if {$_hh > 0 && $_cw > 1} {
            catch {grid propagate $hf 0}
            catch {$hf configure -height $_hh -width $_cw}
        }
    }
}

proc ::VMDPathFinder::_cavity_plot_export_csv {tid} {
    # The plotted series itself: one row per frame this pocket appears in.
    variable state
    set tr [_cavity_track_by_tid $tid]
    if {$tr eq ""} { return }
    set f [tk_getSaveFile -title "Export pocket $tid volume series" \
        -initialdir [export_initial_dir] \
        -initialfile "cavity_[format %02d $tid]_volume_vs_frame.csv" \
        -defaultextension .csv -filetypes {{"CSV" .csv} {"All files" *}}]
    if {$f eq ""} { return }
    if {[catch {open $f w} fh]} { set state(status) "Export failed: $fh"; return }
    puts $fh "# pocket $tid, mean [format %.3f [dict get $tr vol_mean]] +/- [format %.3f [dict get $tr vol_sd]] A^3"
    puts $fh "frame,volume_A3"
    foreach fr [dict get $tr frames] v [dict get $tr volumes] {
        puts $fh "$fr,[format %.3f $v]"
    }
    close $fh
    set state(status) "Pocket $tid series written to [file tail $f]."
}

proc ::VMDPathFinder::_cavity_draw_cap {} {
    # How many pockets may be meshed at once. One definition, read by the
    # renderer and quoted in the tooltip.
    variable state
    if {[info exists state(cavity_draw_cap)] \
            && [string is integer -strict $state(cavity_draw_cap)] \
            && $state(cavity_draw_cap) > 0} {
        return $state(cavity_draw_cap)
    }
    return 24
}

proc ::VMDPathFinder::_cavity_set_rule {rule disp} {
    # Picking a start-point rule changes ONE column, so it refreshes in place
    # rather than rebuilding the window.
    variable state
    set state(cavity_origin_rule) $rule
    set state(cavity_rule_disp) $disp
    _cavity_refresh
}

proc ::VMDPathFinder::_cavity_refresh {} {
    # Update the OPEN cavity window in place. Rebuilding the whole toplevel for
    # a lining click or a start-rule change destroyed and recreated the window -
    # it visibly closed and reopened, lost the scroll position, and paid for a
    # full row build every time. Only sort and the persistence filter change
    # which rows exist; everything else changes cell text or a button's relief,
    # which is all this touches.
    variable w
    variable state
    variable _cavity_row_map
    if {![_have_tk]} { return }
    set t $w.tuncav
    if {![winfo exists $t] || ![info exists _cavity_row_map]} { return }
    set g $t.sc.c.inner
    set frame [_tunnel_display_frame]
    set cavs [_tunnel_cavities $frame]
    catch {wm title $t "Cavities - frame $frame"}
    # Column index for each per-frame KEY, read off the header. By key, not by a
    # fixed index: the Type column is conditional, so every index after it moves.
    set _ci [dict create]
    foreach {_k _hdr} {vol Volume seen "Seen %" depth Depth res "Boundary / Inner" \
                       rank "Rank here" start "Start pt"} {
        for {set c 0} {$c < 20} {incr c} {
            if {[winfo exists $t.hdr.h$c] && [string match "$_hdr*" [$t.hdr.h$c cget -text]]} {
                dict set _ci $_k $c; break
            }
        }
    }
    # Collected, then written back after the loop - editing the dict being
    # iterated is not safe.
    set _remap [dict create]
    dict for {r pair} $_cavity_row_map {
        lassign $pair tid _stale_id
        # MOLE re-ranks cavities in every frame, so the rank captured when the
        # window was built is not this frame's rank. Re-resolving it is what
        # makes the Seen light and the row buttons follow the frame: a pocket
        # missing from the build frame had no rank at all, so it stayed red and
        # greyed out for the whole trajectory.
        set id [_cavity_rank_in_frame $tid $frame]
        dict set _remap $r [list $tid $id]
        set here [expr {$id ne "" && [dict exists $cavs $id]}]
        set cv [expr {$here ? [dict get $cavs $id] : {}}]
        # Every value that depends on the frame, refreshed together. Only
        # Start pt used to update, so scrubbing left the Seen colour, the
        # volume and the rank describing whichever frame the window opened on.
        foreach {k txt} [list \
                vol   [expr {$here ? [format %.1f [dict get $cv volume]] : "-"}] \
                depth [expr {$here ? [dict get $cv depth] : "-"}] \
                res   [expr {$here ? "[dict get $cv nboundary]/[dict get $cv ninner]" : "-"}] \
                rank  [expr {$here ? $id : "absent"}] \
                start [expr {$here ? [_cavity_origin_short $cv] : "-"}]] {
            if {![dict exists $_ci $k]} { continue }
            set _cell $g.v${r}_[dict get $_ci $k]
            if {[winfo exists $_cell]} { catch {$_cell configure -text $txt} }
        }
        # The traffic light: green when this pocket exists in the frame being
        # viewed, red when it does not. This is the whole point of the column.
        if {[dict exists $_ci seen]} {
            set _cell $g.v${r}_[dict get $_ci seen]
            if {[winfo exists $_cell]} {
                catch {$_cell configure -foreground [expr {$here ? "#2a9d3f" : "#c0392b"}]}
            }
        }
        # The volume cell is a link only while the pocket is here to plot.
        if {[dict exists $_ci vol]} {
            set _cell $g.v${r}_[dict get $_ci vol]
            if {[winfo exists $_cell]} {
                catch {$_cell configure -foreground [expr {$here ? "#1a5fb4" : "black"}] \
                                        -cursor [expr {$here ? "hand2" : ""}] \
                                        -font [expr {$here ? {Helvetica 9 underline} : {Helvetica 9}}]}
            }
        }
        # Per-frame buttons follow the same presence test the row build used.
        foreach _b {lin use res} {
            if {[winfo exists $g.$_b$r]} {
                catch {$g.$_b$r configure -state [expr {$here ? "normal" : "disabled"}]}
            }
        }
        if {[winfo exists $g.lin$r]} { _cavity_lining_btn_sync $g.lin$r $tid }
    }
    set _cavity_row_map $_remap
    # A lining drawn from another frame shows that frame's residues. Redraw the
    # ones that are on, so the overlay follows the structure like everything
    # else in this window.
    variable _cavity_lining_on
    if {[info exists _cavity_lining_on]} {
        dict for {_ltid _on} $_cavity_lining_on {
            if {!$_on} continue
            set _lid [_cavity_rank_in_frame $_ltid $frame]
            if {$_lid eq ""} continue
            catch {_cavity_redraw_lining $frame $_lid $_ltid}
        }
    }
}

proc ::VMDPathFinder::_cavity_show_all_tracks {} {
    # The filter can take the table from a dozen rows to several hundred, which
    # is seconds of widget building. Say so first, and keep the window where it
    # is: it used to resize itself around the new row set with no warning.
    variable w
    variable state
    set t $w.tuncav
    set _geom ""
    catch {set _geom [wm geometry $t]}
    set state(status) [expr {$state(cavity_all_tracks)
        ? "Listing every pocket - this can be several hundred rows..."
        : "Listing the pockets seen in at least $state(cavity_min_seen)% of frames..."}]
    catch {update idletasks}
    show_tunnel_cavities
    if {$_geom ne "" && [winfo exists $t]} {
        # Same size, same place: only the rows inside change.
        catch {wm geometry $t $_geom}
    }
    set state(status) ""
}

proc ::VMDPathFinder::_cavity_show_all_toggle {} {
    # The header tick over the per-row ones: draw or hide every LISTED pocket.
    # It drives only the pockets the filter is actually showing - ticking it
    # must not silently switch on 300 transients the list is hiding.
    variable state
    variable tunnel_cavity_shown
    set on [expr {[info exists state(cavity_shown_all)] && $state(cavity_shown_all)}]
    foreach tr [_cavity_visible_tracks] {
        set tunnel_cavity_shown([dict get $tr tid]) $on
    }
    _tunnel_cavity_toggle
    catch {_cavity_refresh}
}

proc ::VMDPathFinder::_cavity_visible_tracks {} {
    # The tracks the filter currently admits - one definition, used by the
    # master checkbox and the table so they cannot disagree.
    variable state
    set out {}
    foreach tr [_cavity_tracks] {
        if {[info exists state(cavity_all_tracks)] && $state(cavity_all_tracks)} {
            lappend out $tr
            continue
        }
        set floor [expr {[info exists state(cavity_min_seen)] ? $state(cavity_min_seen) : 50}]
        if {[dict get $tr seen] >= $floor} { lappend out $tr }
    }
    return $out
}

proc ::VMDPathFinder::_cavity_lining_btn_sync {btn tid} {
    # The Lining button is a toggle, so it has to LOOK toggled - otherwise the
    # only way to know it is on is that the structure changed.
    variable _cavity_lining_on
    if {![_have_tk] || ![winfo exists $btn]} { return }
    set on [expr {[info exists _cavity_lining_on] && [dict exists $_cavity_lining_on $tid] \
                  && [dict get $_cavity_lining_on $tid]}]
    catch {$btn configure -relief [expr {$on ? "sunken" : "raised"}]}
}

proc ::VMDPathFinder::_cavity_material_names {} {
    # Whatever VMD actually has, including any the user defined. A hardcoded
    # list left most of the stock materials unreachable here while the tunnel
    # gear offered all of them.
    set mats {}
    catch {set mats [material list]}
    if {![llength $mats]} {
        set mats {Opaque Transparent BrushedMetal Diffuse Ghost Glass1 Glass2 Glass3
                  Glossy HardPlastic MetallicPastel Steel Translucent Edgy EdgyShiny
                  EdgyGlass Goodsell AOShiny AOChalky AOEdgy BlownGlass GlassBubble RTChrome}
    }
    return $mats
}

proc ::VMDPathFinder::show_cavity_gear_settings {tid} {
    # Per-pocket display override, the cavity counterpart of
    # show_tunnel_gear_settings. Colour and material ride the same
    # render_vmd_plot_to_mol parameters the tunnel gear uses; "surface vs
    # spheres" is a different MESH, so it is stored here and read by
    # _render_cavities_for_frame when it builds this pocket's geometry.
    variable w
    variable state
    variable cavity_gear_color
    variable cavity_gear_material
    variable cavity_gear_style
    variable cavity_gear_prop
    if {![_have_tk]} { return }
    foreach _a {cavity_gear_color cavity_gear_material cavity_gear_style cavity_gear_prop} {
        if {![info exists ${_a}]} { set $_a [dict create] }
    }
    set d $w.cavgear
    if {[winfo exists $d]} { destroy $d }
    toplevel $d
    wm withdraw $d
    wm title $d "Pocket $tid display"
    set state(cavgear_tid) $tid
    set state(cavgear_material) [expr {[dict exists $cavity_gear_material $tid] ? [dict get $cavity_gear_material $tid] : "auto"}]
    set state(cavgear_style)    [expr {[dict exists $cavity_gear_style $tid]    ? [dict get $cavity_gear_style $tid]    : "auto"}]
    set r 0
    # ONE colour control. Two menus - a flat "Color" and a "Color by" with its
    # own "none" - meant every choice had to be made twice and one of the two
    # was always dead.
    set state(cavgear_by) [_cavity_gear_by_value $tid]
    foreach {_v _val} [list cavgear_by $state(cavgear_by) \
                            cavgear_material $state(cavgear_material) \
                            cavgear_style $state(cavgear_style)] {
        set state(${_v}_disp) [expr {$_val in [_cavity_prop_tokens] ? [_tunnel_prop_label $_val] : $_val}]
    }
    foreach {var label opts tip} [list \
        cavgear_by "Color by" [concat auto [_vmd_color_names {white black}] [_cavity_prop_tokens]] \
            "How this pocket is coloured: auto follows the window, a colour paints it flat, a property colours it by that property of its lining residues." \
        cavgear_material "Material" [concat auto [_cavity_material_names]] \
            "VMD material for this pocket's surface." \
        cavgear_style "Draw as" {auto surface spheres} \
            "surface = one mesh over the clearance spheres. spheres = the clearance spheres themselves (CAVER Analyst's \"Locked Probes\"). auto follows the window default."] {
        label $d.l$r -text $label
        set _mb $d.m$r
        menubutton $_mb -textvariable ::VMDPathFinder::state(${var}_disp) -relief raised \
            -indicatoron 1 -menu $_mb.m -width 18
        menu $_mb.m -tearoff 0
        foreach o $opts {
            $_mb.m add command -label [expr {$o in [_cavity_prop_tokens] ? [_tunnel_prop_label $o] : $o}] \
                -command [list ::VMDPathFinder::_cavity_gear_set $var $o]
        }
        if {$var eq "cavgear_by"} { _menu_two_columns $_mb.m }
        grid $d.l$r -row $r -column 0 -sticky w -padx {8 4} -pady 1
        grid $_mb   -row $r -column 1 -sticky w -padx {0 8} -pady 1
        add_tooltip $_mb $tip
        incr r
    }
    button $d.all -text "Color all pockets by this" -font {Helvetica 8} -padx 4 -pady 0 \
        -command ::VMDPathFinder::_cavity_prop_to_all
    grid $d.all -row $r -column 0 -columnspan 2 -sticky w -padx 8 -pady {2 1}
    add_tooltip $d.all "Make this pocket's Color by the shared setting and clear every other pocket's own choice."
    incr r
    button $d.close -text "Close" -command [list destroy $d]
    grid $d.close -row $r -column 0 -columnspan 2 -sticky e -padx 8 -pady {2 6}
    _center_toplevel $d
    wm deiconify $d
}

proc ::VMDPathFinder::_cavity_gear_by_value {tid} {
    # What the single Color by menu shows for this pocket: its property if it
    # has one, else its flat colour, else auto.
    variable cavity_gear_prop
    variable cavity_gear_color
    if {[info exists cavity_gear_prop] && [dict exists $cavity_gear_prop $tid]} {
        set p [dict get $cavity_gear_prop $tid]
        if {$p in [_cavity_prop_tokens]} { return $p }
    }
    if {[info exists cavity_gear_color] && [dict exists $cavity_gear_color $tid]} {
        set c [dict get $cavity_gear_color $tid]
        if {$c ne "" && $c ne "auto"} { return $c }
    }
    return "auto"
}

proc ::VMDPathFinder::_cavity_gear_set {var value} {
    # One handler for all three fields: store the override (or drop it on
    # "auto") and redraw, so the viewer follows the menu immediately.
    variable state
    variable cavity_gear_color
    variable cavity_gear_material
    variable cavity_gear_style
    variable cavity_gear_prop
    set state($var) $value
    set tid $state(cavgear_tid)
    # One menu, two stores: a property goes to the property store and clears
    # the flat colour, a colour does the reverse, auto clears both.
    if {$var eq "cavgear_by"} {
        variable cavity_gear_prop
        variable cavity_gear_color
        set cavity_gear_prop  [dict remove $cavity_gear_prop $tid]
        set cavity_gear_color [dict remove $cavity_gear_color $tid]
        if {$value in [_cavity_prop_tokens]} {
            dict set cavity_gear_prop $tid $value
        } elseif {$value ne "auto"} {
            dict set cavity_gear_color $tid $value
        }
        set state(cavgear_by) $value
        set state(cavgear_by_disp) [expr {$value in [_cavity_prop_tokens] ? [_tunnel_prop_label $value] : $value}]
        variable tunnel_cavity_shown
        set tunnel_cavity_shown($tid) 1
        _tunnel_cavity_toggle
        catch {_cavity_refresh}
        return
    }
    switch -exact -- $var {
        cavgear_color    { set _which cavity_gear_color }
        cavgear_material { set _which cavity_gear_material }
        cavgear_style    { set _which cavity_gear_style }
        cavgear_prop     { set _which cavity_gear_prop }
        default          { return }
    }
    if {$value eq "auto"} {
        catch {dict unset $_which $tid}
        set $_which [dict remove [set $_which] $tid]
    } else {
        dict set $_which $tid $value
        set $_which [set $_which]
    }
    set state(${var}_disp) $value
    # Changing how a pocket looks means showing it: on an unticked pocket the
    # menu appeared to do nothing at all.
    variable tunnel_cavity_shown
    set tunnel_cavity_shown($tid) 1
    _tunnel_cavity_toggle
    catch {_cavity_refresh}
}

proc ::VMDPathFinder::_cavity_volume_plot {tid} {
    # This pocket's volume across the trajectory, following its TRACK - the same
    # rule draw_tunnel_trends_plot follows for a route, and for the same reason:
    # MOLE's per-frame rank is not an identity.
    variable w
    variable tunnel_result_frames
    set tr [_cavity_track_by_tid $tid]
    if {$tr eq ""} { return }
    set t $w.tuncavplot
    if {[winfo exists $t]} { destroy $t }
    toplevel $t
    wm withdraw $t
    wm title $t "Pocket $tid volume over time"
    set cw 640; set ch 340
    canvas $t.cv -width $cw -height $ch -background white -highlightthickness 0
    frame $t.bar
    # Same Export menubutton and the same stem rule as every other plot, so a
    # saved pocket curve is named like the rest and never overwrites another
    # view's file.
    _build_export_menu $t.bar.exp \
        [list ::VMDPathFinder::_cavity_plot_export_csv $tid] \
        [list ::VMDPathFinder::export_figure_dialog $t.cv "cavity_[format %02d $tid]_volume_vs_frame"]
    pack $t.bar.exp -side right
    pack $t.bar -side bottom -fill x -padx 6 -pady {0 6}
    pack $t.cv -fill both -expand 1 -padx 6 -pady 6
    set cv $t.cv
    set frames [dict get $tr frames]
    set vols   [dict get $tr volumes]
    if {[llength $frames] < 2} {
        $cv create text [expr {$cw/2}] [expr {$ch/2}] -anchor center -justify center \
            -width [expr {$cw-40}] -text \
            "Pocket $tid appears in only [llength $frames] analysed frame.\nToo few occurrences to plot."
        _center_toplevel $t $cw $ch
        wm deiconify $t
        return
    }
    set ml 62; set mr 20; set mt 34; set mb 40
    set pw [expr {$cw-$ml-$mr}]; set ph [expr {$ch-$mt-$mb}]
    set xmin [lindex $tunnel_result_frames 0]
    set xmax [lindex $tunnel_result_frames end]
    if {$xmax <= $xmin} { set xmax [expr {$xmin+1}] }
    set ymin 1e30; set ymax -1e30
    foreach v $vols { if {$v < $ymin} { set ymin $v }; if {$v > $ymax} { set ymax $v } }
    set mean [dict get $tr vol_mean]; set sd [dict get $tr vol_sd]
    if {$mean-$sd < $ymin} { set ymin [expr {$mean-$sd}] }
    if {$mean+$sd > $ymax} { set ymax [expr {$mean+$sd}] }
    if {$ymax <= $ymin} { set ymax [expr {$ymin+1.0}] }
    set ypad [expr {($ymax-$ymin)*0.08 + 0.01}]
    set ymin [expr {$ymin-$ypad}]; set ymax [expr {$ymax+$ypad}]
    if {$ymin < 0} { set ymin 0.0 }
    # mean +/- SD as a band: "is this frame typical?" answered by eye.
    set yb1 [_tpp_y [expr {$mean+$sd}] $ymin $ymax $mt $ph]
    set yb2 [_tpp_y [expr {$mean-$sd}] $ymin $ymax $mt $ph]
    $cv create rectangle $ml $yb1 [expr {$ml+$pw}] $yb2 -fill "#eaf1fb" -outline ""
    set ymn [_tpp_y $mean $ymin $ymax $mt $ph]
    $cv create line $ml $ymn [expr {$ml+$pw}] $ymn -fill "#1a5fb4" -dash {4 3}
    $cv create rectangle $ml $mt [expr {$ml+$pw}] [expr {$mt+$ph}] -outline "#999999"
    # Break the line where the pocket is absent: a straight segment across
    # missing frames reads as continuity that is not there.
    set seg {}; set prev ""
    set _ai -1
    foreach fr $tunnel_result_frames {
        incr _ai
        set k [lsearch -exact $frames $fr]
        if {$k < 0} { continue }
        set v [lindex $vols $k]
        if {$prev ne "" && $_ai != $prev + 1} {
            if {[llength $seg] >= 4} { $cv create line $seg -fill "#c01c28" -width 2 }
            set seg {}
        }
        lappend seg [_tpp_x $fr $xmin $xmax $ml $pw] [_tpp_y $v $ymin $ymax $mt $ph]
        set prev $_ai
    }
    if {[llength $seg] >= 4} { $cv create line $seg -fill "#c01c28" -width 2 }
    foreach fr $frames v $vols {
        set xx [_tpp_x $fr $xmin $xmax $ml $pw]; set yy [_tpp_y $v $ymin $ymax $mt $ph]
        $cv create oval [expr {$xx-2}] [expr {$yy-2}] [expr {$xx+2}] [expr {$yy+2}] \
            -fill "#c01c28" -outline ""
    }
    for {set k 0} {$k <= 4} {incr k} {
        set xv [expr {round($xmin + ($xmax-$xmin)*$k/4.0)}]
        set xx [_tpp_x $xv $xmin $xmax $ml $pw]
        $cv create line $xx [expr {$mt+$ph}] $xx [expr {$mt+$ph+4}] -fill "#666666"
        $cv create text $xx [expr {$mt+$ph+6}] -anchor n -font {Helvetica 7} -text [_frame_tick_text $xv]
        set yv [expr {$ymin + ($ymax-$ymin)*$k/4.0}]
        set yy [_tpp_y $yv $ymin $ymax $mt $ph]
        $cv create line [expr {$ml-4}] $yy $ml $yy -fill "#666666"
        $cv create text [expr {$ml-6}] $yy -anchor e -font {Helvetica 7} -text [format %.0f $yv]
    }
    $cv create text [expr {$ml+$pw/2}] 12 -anchor n -font {Helvetica 10 bold} \
        -text "Pocket $tid volume over time"
    $cv create text [expr {$ml+$pw/2}] 26 -anchor n -font {Helvetica 7} -fill "#555555" \
        -text [format "mean %.0f +/- %.0f A^3 (band); present in %d of %d analysed frames" \
               $mean $sd [llength $frames] [llength $tunnel_result_frames]]
    $cv create text 6 [expr {$mt+$ph/2}] -anchor w -font {Helvetica 7} -fill "#555555" \
        -text "A^3"
    _center_toplevel $t $cw [expr {$ch+16}]
    wm deiconify $t
}

proc ::VMDPathFinder::_cavity_show_lining {frame id} {
    # Boundary and inner lining as TWO reps in different colours, on the user's
    # own molecule - the split is the whole point, so one rep over both sets
    # would hide it. Same rep-index bookkeeping as the pore/tunnel lining reps:
    # track the INDEX, not VMD's auto-generated rep name.
    variable state
    variable tunnel_lining
    variable _cavity_lining_rep
    if {![info exists tunnel_lining($frame)] \
            || ![dict exists $tunnel_lining($frame) cav.$id]} { return }
    set molid [_cavity_structure_molid]
    if {$molid eq "" || $molid < 0} {
        set state(status) "Cavity lining: no structure molecule to draw on."
        return
    }
    if {![info exists _cavity_lining_rep]} { set _cavity_lining_rep [dict create] }
    # A toggle: clicking the button that drew this lining takes it away again.
    # There was no way to undo it, so the reps accumulated on the structure with
    # no route back to a clean view.
    variable _cavity_lining_on
    if {![info exists _cavity_lining_on]} { set _cavity_lining_on [dict create] }
    set _trk [_cavity_track_for $frame $id]
    set _key_tid [expr {[llength $_trk] ? [dict get $_trk tid] : $id}]
    if {[dict exists $_cavity_lining_on $_key_tid] && [dict get $_cavity_lining_on $_key_tid]} {
        # Keyed by POCKET too, not just molid - see _cavity_redraw_lining for
        # why sharing one pair of reps across every pocket is the bug this
        # fixes.
        foreach which {bres ires} {
            set _k "$molid|$_key_tid|$which"
            if {[dict exists $_cavity_lining_rep $_k]} {
                catch {mol showrep $molid [dict get $_cavity_lining_rep $_k] 0}
            }
        }
        dict set _cavity_lining_on $_key_tid 0
        set state(status) "Pocket $_key_tid lining: hidden."
        catch {_cavity_refresh}
        return
    }
    dict set _cavity_lining_on $_key_tid 1
    _cavity_redraw_lining $frame $id $_key_tid
    set cv [dict get $tunnel_lining($frame) cav.$id]
    set state(status) "Pocket $_key_tid lining: [llength [dict get $cv bres]] boundary (yellow) + [llength [dict get $cv ires]] inner (red) residues on molecule $molid."
    # The SHOW path has to sync the button too, or it stays raised while the
    # lining is on and the only way to tell is that the structure changed.
    catch {_cavity_refresh}
}

proc ::VMDPathFinder::_cavity_redraw_lining {frame id key_tid} {
    # Point the two lining reps at THIS frame's residues. Split out of
    # _cavity_show_lining, which is a toggle: the frame-change path has to
    # redraw a lining that is already on, not turn it off. It must not call
    # _cavity_refresh - refresh is what calls this.
    variable state
    variable tunnel_lining
    variable _cavity_lining_rep
    if {![info exists tunnel_lining($frame)] \
            || ![dict exists $tunnel_lining($frame) cav.$id]} { return }
    set molid [_cavity_structure_molid]
    if {$molid eq "" || $molid < 0} { return }
    if {![info exists _cavity_lining_rep]} { set _cavity_lining_rep [dict create] }
    set _key_tid $key_tid
    set cv [dict get $tunnel_lining($frame) cav.$id]
    set n 0
    # 4 is yellow, 1 is red - matches what the button tooltip and the status
    # line below both say.
    foreach {which colour} {bres 4 ires 1} {
        set sel {}
        foreach e [dict get $cv $which] {
            lappend sel "(resid [dict get $e resid] and chain [dict get $e chain])"
        }
        # Keyed by POCKET, not just molid+which - two pockets shown at once
        # otherwise shared the SAME pair of reps, so redrawing one on a frame
        # step silently repainted it over whichever pocket's lining was drawn
        # there last, and only the most-recently-drawn pocket's lining was
        # ever actually visible.
        set key "$molid|$_key_tid|$which"
        if {![llength $sel]} {
            if {[dict exists $_cavity_lining_rep $key]} {
                catch {mol showrep $molid [dict get $_cavity_lining_rep $key] 0}
            }
            continue
        }
        set selstr "([join $sel { or }]) and noh"
        incr n [llength $sel]
        if {[dict exists $_cavity_lining_rep $key]} {
            set idx [dict get $_cavity_lining_rep $key]
            if {![catch {molinfo $molid get numreps} nr] && $idx < $nr} {
                catch {mol modselect $idx $molid $selstr}
                catch {mol showrep $molid $idx 1}
                continue
            }
        }
        mol representation Licorice 0.2 12.0 12.0
        mol color ColorID $colour
        mol selection $selstr
        mol material Opaque
        mol addrep $molid
        dict set _cavity_lining_rep $key [expr {[molinfo $molid get numreps] - 1}]
    }
    # No status-bar line here - _cavity_refresh calls this once per shown
    # pocket on every settled frame, and each call would overwrite whichever
    # pocket's message the previous call in that same pass had just set.
    # _cavity_show_lining, the interactive toggle, sets its own message once.
}

proc ::VMDPathFinder::_cavity_export_csv {} {
    # Three tables, because cavity data is three shapes: one row per tracked
    # pocket, one row per pocket PER FRAME, and one row per lining residue.
    # Flattening them into a single sheet would repeat the per-pocket columns
    # on every residue.
    variable state
    variable tunnel_result_frames
    variable tunnel_lining
    set tracks [_cavity_tracks]
    if {![llength $tracks]} { set state(status) "Cavity export: nothing to export."; return }
    set base [tk_getSaveFile -title "Export cavity data (writes three CSV files)" \
        -initialdir [export_initial_dir] -initialfile "cavities.csv" \
        -defaultextension .csv -filetypes {{"CSV" .csv} {"All files" *}}]
    if {$base eq ""} { return }
    set root [file rootname $base]
    set written {}
    # 1. per tracked pocket
    set fh [open "${root}.csv" w]
    puts $fh "tracked_id,type,n_frames_seen,seen_pct,volume_mean_A3,volume_sd_A3,max_probe_A"
    foreach tr $tracks {
        puts $fh [format "%s,%s,%d,%.1f,%.3f,%.3f,%.3f" [dict get $tr tid] [dict get $tr type] \
            [llength [dict get $tr frames]] [dict get $tr seen] \
            [dict get $tr vol_mean] [dict get $tr vol_sd] [dict get $tr maxprobe]]
    }
    close $fh
    lappend written [file tail ${root}.csv]
    # 2. per pocket per frame
    set fh [open "${root}_per_frame.csv" w]
    puts $fh "tracked_id,frame,mole_rank_in_frame,volume_A3,depth,n_boundary,n_inner"
    foreach tr $tracks {
        set tid [dict get $tr tid]
        foreach fr [dict get $tr frames] {
            set rk [_cavity_rank_in_frame $tid $fr]
            if {$rk eq "" || ![dict exists $tunnel_lining($fr) cav.$rk]} { continue }
            set cv [dict get $tunnel_lining($fr) cav.$rk]
            puts $fh [format "%s,%s,%s,%.3f,%s,%d,%d" $tid $fr $rk [dict get $cv volume] \
                [dict get $cv depth] [dict get $cv nboundary] [dict get $cv ninner]]
        }
    }
    close $fh
    lappend written [file tail ${root}_per_frame.csv]
    # 3. one row per lining residue, in the displayed frame
    set dfr [_tunnel_display_frame]
    set fh [open "${root}_lining.csv" w]
    puts $fh "tracked_id,frame,mole_rank_in_frame,role,resname,resid,chain"
    if {[info exists tunnel_lining($dfr)]} {
        foreach tr $tracks {
            set tid [dict get $tr tid]
            set rk [_cavity_rank_in_frame $tid $dfr]
            if {$rk eq "" || ![dict exists $tunnel_lining($dfr) cav.$rk]} { continue }
            set cv [dict get $tunnel_lining($dfr) cav.$rk]
            foreach {which role} {bres boundary ires inner} {
                foreach e [dict get $cv $which] {
                    puts $fh "$tid,$dfr,$rk,$role,[dict get $e resname],[dict get $e resid],[dict get $e chain]"
                }
            }
        }
    }
    close $fh
    lappend written [file tail ${root}_lining.csv]
    set state(status) "Cavity export: wrote [join $written {, }] to [file dirname $root]."
}

proc ::VMDPathFinder::_cavity_sort {col} {
    variable state
    if {[info exists state(cavity_sort_col)] && $state(cavity_sort_col) eq $col} {
        set state(cavity_sort_dir) [expr {[info exists state(cavity_sort_dir)] \
            && $state(cavity_sort_dir) eq "asc" ? "desc" : "asc"}]
    } else {
        set state(cavity_sort_col) $col
        set state(cavity_sort_dir) [expr {$col eq "id" ? "asc" : "desc"}]
    }
    show_tunnel_cavities
}

proc ::VMDPathFinder::_cavity_set_prop {prop} {
    # The Color by every pocket shares unless its own gear says otherwise.
    variable state
    set state(cavity_prop) $prop
    set state(cavity_prop_disp) [_tunnel_prop_label_short $prop]
    _tunnel_cavity_toggle
}

proc ::VMDPathFinder::_cavity_prop_to_all {} {
    # The open gear's Color by becomes the shared one; own choices are cleared.
    variable state
    variable cavity_gear_prop
    variable cavity_gear_color
    set v [expr {[info exists state(cavgear_by)] ? $state(cavgear_by) : "auto"}]
    set cavity_gear_prop  [dict create]
    set cavity_gear_color [dict create]
    set state(cavgear_by) auto
    set state(cavgear_by_disp) auto
    _cavity_set_prop [expr {$v in [_cavity_prop_tokens] ? $v : "none"}]
}

proc ::VMDPathFinder::_cavity_effective_prop {tid} {
    # This pocket's Color by: its own gear choice, else the shared one.
    variable state
    variable cavity_gear_prop
    set p [expr {[info exists state(cavity_prop)] ? $state(cavity_prop) : "none"}]
    if {[info exists cavity_gear_prop] && [dict exists $cavity_gear_prop $tid]} { set p [dict get $cavity_gear_prop $tid] }
    if {$p eq "" || $p ni [_cavity_prop_tokens]} { return "none" }
    return $p
}

proc ::VMDPathFinder::_cavity_graphics_clear {} {
    # Take every drawn pocket off the screen; the ticks stay, so returning to
    # tunnel mode draws them again.
    variable cavity_mols
    set molid [_cavity_structure_molid]
    if {$molid < 0 || ![info exists cavity_mols($molid)]} { return }
    if {![catch {molinfo $cavity_mols($molid) get name}]} { catch {graphics $cavity_mols($molid) delete all} }
}

proc ::VMDPathFinder::_cavity_use_as_start {frame id} {
    # Put this cavity's start point in the tunnel Start point field, so the
    # next run searches from THIS pocket. The point comes from the rule the
    # user picked: MOLE's own automatic origin (its O record - the point the
    # engine itself would have used), or CAVER Analyst's centre-of-largest-
    # inscribed-sphere. Whichever it is, it is reported in the status line, so
    # what went into the field is never a mystery.
    variable state
    set cavs [_tunnel_cavities $frame]
    if {![dict exists $cavs $id]} { return }
    set cv [dict get $cavs $id]
    set rule [expr {[info exists state(cavity_origin_rule)] ? $state(cavity_origin_rule) : "mole"}]
    set pt [_cavity_origin $cv $rule]
    if {[llength $pt] != 3} {
        set state(status) "Cavity $id has no usable start point (no origins and no spheres)."
        return
    }
    set state(tunnel_start) [format_triplet $pt]
    set state(tunnel_auto_origin) 0
    set _lbl [expr {$rule eq "caver" ? "largest inscribed sphere (CAVER Analyst rule)" \
                                     : "deepest point (MOLE's own automatic origin)"}]
    set state(status) "Start point set from cavity $id of frame $frame: $_lbl."
    catch {_sync_point_marker tunnel_start show_tunnel_start_marker}
}

proc ::VMDPathFinder::show_tunnel_cavities {} {
    variable w
    variable state
    variable tunnel_cavity_shown
    if {![_have_tk]} { return }
    set frame [_tunnel_display_frame]
    set cavs [_tunnel_cavities $frame]
    set t $w.tuncav
    # Rebuild INTO the existing window. Destroying the toplevel made a sort or
    # a filter change look like the window closing and reopening - and with a
    # few hundred pockets the row build between the two is long enough to read
    # as a hang.
    #
    # _rebuild (skip centering/deiconify) is NOT the same question as "does
    # the toplevel already exist" (skip `toplevel $t`, which errors on a
    # duplicate path). Closing the MAIN window withdraws every child dialog
    # without destroying them (_withdraw_child_dialogs), so after that this
    # window exists but is not visible - and re-showing it must deiconify it
    # again, or it stays invisible forever while still updating underneath.
    set _existed [winfo exists $t]
    set _rebuild [expr {$_existed && [wm state $t] ne "withdrawn"}]
    if {$_existed} {
        foreach _c [winfo children $t] { catch {destroy $_c} }
    } else {
        toplevel $t
        wm withdraw $t
    }
    wm title $t "Cavities - frame $frame"
    if {![llength $cavs]} {
        pack [label $t.none -justify left -wraplength 420 -text \
            "No cavity records for this frame.\n\nCavities come from the compiled MOLE engine (mole_tunnel_engine); a run made with an older build, or the pure-Tcl fallback, has none. Re-run the tunnel search."] -padx 12 -pady 12
        if {!$_rebuild} { wm deiconify $t }
        return
    }
    foreach {k d} {cavity_sort_col vol cavity_sort_dir desc cavity_origin_rule mole
                   cavity_prop none cavity_all_tracks 0 cavity_min_seen 50
                   cavity_shown_all 0} {
        if {![info exists state($k)]} { set state($k) $d }
    }
    set state(cavity_prop_disp) [_tunnel_prop_label_short $state(cavity_prop)]

    # ---- controls -------------------------------------------------------
    frame $t.ctl
    # One checkbox over the per-row ones, as the tunnel list has - two buttons
    # for the same pair of states was a control the checkbox already is.
    label $t.ctl.rl -text "Start point:"
    set state(cavity_rule_disp) [expr {$state(cavity_origin_rule) eq "caver" \
        ? "largest sphere (CAVER)" : "deepest point (MOLE)"}]
    menubutton $t.ctl.rm -textvariable ::VMDPathFinder::state(cavity_rule_disp) \
        -relief raised -indicatoron 1 -menu $t.ctl.rm.m -width 20
    menu $t.ctl.rm.m -tearoff 0
    $t.ctl.rm.m add command -label "deepest point (MOLE)" \
        -command [list ::VMDPathFinder::_cavity_set_rule mole "deepest point (MOLE)"]
    $t.ctl.rm.m add command -label "largest sphere (CAVER)" \
        -command [list ::VMDPathFinder::_cavity_set_rule caver "largest sphere (CAVER)"]
    pack $t.ctl.rl $t.ctl.rm -side left -padx {0 6}
    grid $t.ctl -row 0 -column 0 -sticky w -padx 8 -pady {6 2}
    add_tooltip $t.ctl.rl "A pocket is where a tunnel search begins. \"Use as start\" copies this point into the Start point box. The two rules pick the point differently."
    add_tooltip $t.ctl.rm "Where inside the pocket a search would start.\n\ndeepest point (MOLE): furthest from the surface.\nlargest sphere (CAVER): centre of the biggest ball that fits.\n\nThe Start pt column shows the point you would get."

    # ---- table ----------------------------------------------------------
    # ONE grid for the header and the rows, inside a scrolling frame. Two
    # grids in two frames cannot share column widths, so every row drifted out
    # of line with its heading the moment a cell's text changed length.
    set _every [_cavity_tracks]
    # Most tracks are transient: on a 50-frame run 108 of 315 appear in <=5% of
    # frames. Listing them all buries the dozen pockets that persist, which is
    # what a trajectory is actually described by. Rebuilding the row set is the
    # only cost the toggle has - the pockets themselves were found by the run.
    if {$state(cavity_sort_col) eq "mean"} { set state(cavity_sort_col) vol }
    set _tracks [_cavity_visible_tracks]
    # Same control the tunnel list has, same name: it decides which rows are
    # LISTED, not what is drawn.
    checkbutton $t.ctl.allt -text "Show all" \
        -variable ::VMDPathFinder::state(cavity_all_tracks) \
        -command ::VMDPathFinder::_cavity_show_all_tracks
    label $t.ctl.cnt -foreground gray40 -font {Helvetica 8} \
        -text "[llength $_tracks] of [llength $_every] listed"
    button $t.ctl.exp -text "Export CSV" -command ::VMDPathFinder::_cavity_export_csv
    pack $t.ctl.allt $t.ctl.cnt -side left -padx {6 0}
    pack $t.ctl.exp -side right -padx {6 0}
    add_tooltip $t.ctl.exp "Write three CSVs: one row per tracked pocket, one row per pocket per frame, and one row per lining residue in the displayed frame."
    add_tooltip $t.ctl.allt "List every pocket, including ones found in a single frame. Off, only those seen in at least $state(cavity_min_seen)% of frames are listed."
    set _rowh 22
    set _want [expr {[llength $_tracks]*$_rowh + 30}]
    set _hmax 340
    set _th [expr {$_want < $_hmax ? $_want : $_hmax}]
    frame $t.hdr
    grid $t.hdr -row 1 -column 0 -sticky ew -padx 8 -pady {2 0}
    frame $t.sc
    grid $t.sc -row 2 -column 0 -sticky nsew -padx 8 -pady {0 2}
    grid rowconfigure $t 2 -weight 1
    grid columnconfigure $t 0 -weight 1
    _scrollable_fixed $t.sc $_th
    set g $t.sc.c.inner
    set hg $t.hdr

    # MOLE only exports a cavity that HAS boundary residues, so a Void - which by
    # definition has none - almost never survives to us (0 of 2108 records on a
    # 50-frame run). Carrying a column that reads "Cavity" on every row is
    # clutter, so it appears only when the data actually holds a Void.
    set _has_void 0
    foreach _tr $_every { if {[dict get $_tr type] eq "Void"} { set _has_void 1; break } }
    set _cols {draw "" "Tick to draw this pocket in the 3D view. The box above the column ticks or unticks them all."
               id "Id" "This pocket's number. It stays the same in every frame, so pocket 3 is the same piece of empty space all the way through the trajectory - and it keeps the same colour. Pocket 1 is the largest on average."}
    if {$_has_void} {
        lappend _cols type "Type" "Cavity: opens to the surface. Void: fully enclosed, no boundary residues."
    }
    lappend _cols \
        vol "Volume" "How big this pocket is in the frame you are looking at, in cubic Angstroms. CLICK A VOLUME to plot how it changes over the whole trajectory. Click this heading to sort." \
        seen "Seen %" "How often this pocket exists. 100% means it is there in every frame analysed; a low number means it opens and closes as the protein moves. Green = present in the frame you are viewing, red = absent from it. Click to sort." \
        probe "Max probe" "The radius of the biggest ball that fits inside this pocket, in Angstroms. Compare it with the size of your ligand or ion to see whether it could sit here. Click to sort." \
        depth "Depth" "How far inside the protein the pocket sits, counted in layers of the geometric mesh MOLE builds. A bigger number means more buried." \
        res "Boundary / Inner" "Its lining, split in two. BOUNDARY residues sit on a face where the pocket opens outward - they line the mouth. INNER residues touch the pocket only on faces fully inside it - they line the wall. Both are computed from the Delaunay tetrahedra, not from a distance cutoff. The Residues button lists them." \
        rank "Rank here" "MOLE numbers pockets separately in each frame, biggest first, so this number changes as the protein moves. It is shown only so you can match a row against MOLE's own output - use Id to follow a pocket over time. \"absent\" means this pocket does not exist in the frame you are viewing." \
        start "Start pt" "The x y z point a tunnel search would start from if you used this pocket, chosen by the rule in the Start point menu above. \"Use as start\" copies it into the Start point box."
    set c 0
    foreach {key label tip} $_cols {
        set _sortable [expr {$key in {id vol mean seen probe depth}}]
        set _txt $label
        if {$_sortable && $state(cavity_sort_col) eq $key} {
            append _txt [expr {$state(cavity_sort_dir) eq "asc" ? " \u25b2" : " \u25bc"}]
        }
        if {$key eq "draw"} {
            # Column 0 is the draw ticks, so the tick-them-all control belongs
            # here - directly above them and left of Id - not off in the
            # controls lane where it read as unrelated.
            checkbutton $hg.h$c -variable ::VMDPathFinder::state(cavity_shown_all) \
                -command ::VMDPathFinder::_cavity_show_all_toggle -padx 0 -pady 0
            grid $hg.h$c -row 0 -column $c -sticky w -padx 4 -pady {0 3}
            add_tooltip $hg.h$c "Tick to draw every pocket in the list; untick to hide them all.\
                Only the pockets currently listed are affected, and at most [_cavity_draw_cap] are drawn at once."
            incr c
            continue
        }
        label $hg.h$c -text $_txt -font {Helvetica 9 bold} -anchor w
        if {$_sortable} {
            $hg.h$c configure -cursor hand2
            bind $hg.h$c <Button-1> [list ::VMDPathFinder::_cavity_sort $key]
        }
        grid $hg.h$c -row 0 -column $c -sticky w -padx 4 -pady {0 3}
        add_tooltip $hg.h$c $tip
        incr c
    }

    # rows are TRACKS, not this frame's ranks: the row means the same pocket in
    # every frame, which is what makes the checkbox and the colour stable. A
    # track absent from the displayed frame still gets a row - that absence is
    # information (see its Seen %) - with this frame's columns blank.
    set rows {}
    foreach tr $_tracks {
        set tid [dict get $tr tid]
        set id [_cavity_rank_in_frame $tid $frame]
        set cv [expr {$id ne "" && [dict exists $cavs $id] ? [dict get $cavs $id] : {}}]
        lappend rows [list $tid $cv $tr $id]
    }
    set rows [lsort -command [list ::VMDPathFinder::_cavity_row_cmp $state(cavity_sort_col)] $rows]
    if {$state(cavity_sort_dir) eq "desc"} { set rows [lreverse $rows] }

    variable _cavity_row_map
    set _cavity_row_map [dict create]
    set r 0
    foreach row $rows {
        incr r
        # rows still start at grid row 1: _sync_cavity_header_columns measures
        # the body on row 1, and row 0 stays empty so the two grids can be
        # compared the way the tunnel list does it.
        lassign $row tid cv tr id
        dict set _cavity_row_map $r [list $tid $id]
        if {![info exists tunnel_cavity_shown($tid)]} { set tunnel_cavity_shown($tid) 0 }
        checkbutton $g.d$r -variable ::VMDPathFinder::tunnel_cavity_shown($tid) \
            -command ::VMDPathFinder::_tunnel_cavity_toggle -padx 0 -pady 0
        grid $g.d$r -row $r -column 0 -sticky w -padx 4
        set _here [expr {[llength $cv] > 0}]
        set _v [dict create \
            id $tid \
            type [expr {$_here ? [dict get $cv type] : [dict get $tr type]}] \
            vol [expr {$_here ? [format %.1f [dict get $cv volume]] : "-"}] \
            seen [format "%.0f" [dict get $tr seen]] \
            probe [format %.2f [dict get $tr maxprobe]] \
            depth [expr {$_here ? [dict get $cv depth] : "-"}] \
            res [expr {$_here ? "[dict get $cv nboundary]/[dict get $cv ninner]" : "-"}] \
            rank [expr {$_here ? $id : "absent"}] \
            start [expr {$_here ? [_cavity_origin_short $cv] : "-"}]]
        # Emitted BY KEY, in the header's own order: an index-based alignment
        # mask silently shifts the moment a column is dropped.
        set _right {id vol seen probe depth rank}
        set c 1
        foreach {key _lbl _tip} [lrange $_cols 3 end] {
            set _num [expr {[lsearch -exact $_right $key] >= 0}]
            # Absence is carried by the Seen colour, as the tunnel list does it -
            # greying the whole row made every value look unreliable when only
            # the per-frame ones are blank.
            set _fg black
            if {$key eq "seen"} {
                set _fg [expr {$_here ? "#2a9d3f" : "#c0392b"}]
            }
            label $g.v${r}_$c -text [dict get $_v $key] -anchor [expr {$_num ? "e" : "w"}] \
                -font {Helvetica 9} -foreground $_fg
            grid $g.v${r}_$c -row $r -column $c -sticky [expr {$_num ? "e" : "w"}] -padx 4
            if {$key eq "vol" && $_here} {
                # The volume itself opens its trend. A separate column with a
                # chart emoji was both an extra column and an unrenderable
                # glyph: \U0001F4C8 is outside Tk 8.5's BMP.
                $g.v${r}_$c configure -cursor hand2 -foreground "#1a5fb4" \
                    -font {Helvetica 9 underline}
                bind $g.v${r}_$c <Button-1> [list ::VMDPathFinder::_cavity_volume_plot $tid]
                add_tooltip $g.v${r}_$c [format "Click to plot pocket %s's volume across the trajectory. It averages %.0f +/- %.0f A^3 over the %d frame(s) it appears in." \
                    $tid [dict get $tr vol_mean] [dict get $tr vol_sd] [llength [dict get $tr frames]]]
            }
            incr c
        }
        button $g.lin$r -text "Lining" -font {Helvetica 8} -padx 3 -pady 0 \
            -command [list ::VMDPathFinder::_cavity_show_lining_track $tid]
        if {!$_here} { $g.lin$r configure -state disabled }
        _cavity_lining_btn_sync $g.lin$r $tid
        grid $g.lin$r -row $r -column $c -sticky w -padx {2 2}
        add_tooltip $g.lin$r "Draw this pocket's lining on the structure: boundary residues yellow, inner red. Click again to remove it."
        incr c
        button $g.use$r -text "Use as start" -font {Helvetica 8} -padx 3 -pady 0 \
            -command [list ::VMDPathFinder::_cavity_use_as_start_track $tid]
        if {!$_here} { $g.use$r configure -state disabled }
        grid $g.use$r -row $r -column $c -sticky w -padx {8 2}
        add_tooltip $g.use$r "Put this cavity's start point into the tunnel Start point field, by the rule chosen above."
        incr c
        button $g.res$r -text "Residues" -font {Helvetica 8} -padx 3 -pady 0 \
            -command [list ::VMDPathFinder::_cavity_residues_track $tid]
        if {!$_here} { $g.res$r configure -state disabled }
        grid $g.res$r -row $r -column $c -sticky w -padx {2 4}
        incr c
        # Gear LAST, past the buttons: it is per-pocket appearance, not data, so
        # it belongs at the end of the row rather than between the values and
        # the actions.
        button $g.gear$r -text "\u2699" -font {Helvetica 10} -padx 2 -pady 0 -relief flat \
            -command [list ::VMDPathFinder::show_cavity_gear_settings $tid]
        grid $g.gear$r -row $r -column $c -sticky w -padx {6 4}
        add_tooltip $g.gear$r "This pocket's display: colour by property, flat colour, material, surface or spheres."
    }

    # The wheel reaches a widget only, never its ancestors, so every label and
    # button in the table needs the binding or the list looks stuck wherever
    # the pointer happens to rest.
    catch {_bind_wheel_subtree $t.sc.c $g}
    # Pin the columns FIRST, then size the canvas to the table. Pinning the
    # body's columns to the wider header labels grows the table (564 -> 780
    # px on 1BL8); measured before it, the canvas came out short by exactly
    # the button columns and every row's Lining / Use as start / Residues /
    # gear sat past the right edge.
    _sync_cavity_header_columns $t
    update idletasks
    set _cw [expr {[winfo reqwidth $g] + 4}]
    $t.sc.c configure -width $_cw
    catch {grid propagate $t.hdr 0}
    catch {$t.hdr configure -width $_cw -height [winfo reqheight $t.hdr]}
    # Height follows the table, capped so a structure with many pockets scrolls
    # instead of growing a window taller than the screen.
    # Only on a first open: re-centring on every sort would move the window
    # out from under the pointer.
    if {!$_rebuild} {
        _center_toplevel $t
        wm deiconify $t
    }
}

proc ::VMDPathFinder::_cavity_row_cmp {col a b} {
    # Sort helper: {id cv track} rows by one column, numerically where the
    # column is a number and by string otherwise.
    lassign $a tida cva tra ranka
    lassign $b tidb cvb trb rankb
    switch -- $col {
        id    { set x $tida; set y $tidb }
        vol   { set x [expr {[llength $cva] ? [dict get $cva volume] : -1}]
                set y [expr {[llength $cvb] ? [dict get $cvb volume] : -1}] }
        depth { set x [expr {[llength $cva] ? [dict get $cva depth] : -1}]
                set y [expr {[llength $cvb] ? [dict get $cvb depth] : -1}] }
        probe { set x [dict get $tra maxprobe]; set y [dict get $trb maxprobe] }
        mean  { set x [dict get $tra vol_mean]; set y [dict get $trb vol_mean] }
        seen  { set x [dict get $tra seen];     set y [dict get $trb seen] }
        default { set x $tida; set y $tidb }
    }
    if {[string is double -strict $x] && [string is double -strict $y]} {
        return [expr {$x < $y ? -1 : ($x > $y ? 1 : 0)}]
    }
    return [string compare $x $y]
}

proc ::VMDPathFinder::_tunnel_cavity_residues {frame id} {
    # Boundary and inner residue sets with their MOLE properties, and a
    # selection string for VMD, in a text window.
    variable w
    variable tunnel_lining
    if {![_have_tk] || ![info exists tunnel_lining($frame)] \
            || ![dict exists $tunnel_lining($frame) cav.$id]} { return }
    set cv [dict get $tunnel_lining($frame) cav.$id]
    set t $w.tuncavres
    if {[winfo exists $t]} { destroy $t }
    toplevel $t
    wm withdraw $t
    wm title $t "Cavity $id residues - frame $frame"
    text $t.txt -width 84 -height 24 -wrap word -font {Courier 9}
    $t.txt tag configure hdr -font {Courier 9 bold}
    foreach {which lbl} {b "Boundary residues" i "Inner residues"} {
        set res [dict get $cv ${which}res]
        set p [dict get $cv ${which}props]
        $t.txt insert end "$lbl ([llength $res])\n" hdr
        if {[dict size $p]} {
            $t.txt insert end [format "  charge %s (%s positive, %s negative)  ionizable %s  hydropathy %s  hydrophobicity %s\n  polarity %s  logP %s  logD %s  logS %s  mutability %s\n" \
                [dict get $p charge] [dict get $p npos] [dict get $p nneg] [dict get $p ionizable] \
                [dict get $p hydropathy] [dict get $p hydrophobicity] [dict get $p polarity] \
                [dict get $p logp] [dict get $p logd] [dict get $p logs] [dict get $p mutability]]
        }
        set names {}; set sel {}
        foreach e $res {
            lappend names "[dict get $e resname][dict get $e resid][dict get $e chain]"
            lappend sel "(resid [dict get $e resid] and chain [dict get $e chain])"
        }
        $t.txt insert end "  [join $names { }]\n"
        if {[llength $sel]} { $t.txt insert end "  VMD selection: [join $sel { or }]\n" }
        $t.txt insert end "\n"
    }
    $t.txt configure -state disabled
    pack $t.txt -fill both -expand 1 -padx 6 -pady 6
    _center_toplevel $t 700 420
    wm deiconify $t
}

proc ::VMDPathFinder::_tunnel_parse_out {of} {
    if {![file exists $of] || [catch {open $of r} rh]} { return {} }
    set txt [read $rh]
    close $rh
    return [::VMDPathFinder::_tunnel_parse_text $txt]
}

# The lining of the landed frame's tunnels, as a report.
#
# MOLE reports per LAYER - a run of centreline samples whose lining residues do
# not change - not per profile point, so this is the one view where the residues
# and the physico-chemical numbers line up with what MOLE's own CSV/XML export
# would say. A text window rather than a grid: the residue list is the point,
# it is variable-width, and it is what a user copies into a figure caption.
proc ::VMDPathFinder::show_tunnel_lining {} {
    # Scoped to the SELECTED tunnel by default (state(tunnel_lining_show_all)
    # off) rather than an undifferentiated dump of every tunnel in the frame -
    # "I don't know what's expected to be seen in the lining" was a real
    # complaint about this window, and most of it was simply too much text
    # with no indication which part corresponded to what the user had just
    # picked. The "show all" checkbox restores the old full-dump view.
    variable w
    variable state
    variable tunnel_lining
    if {![_have_tk]} { return }
    set frame [_tunnel_display_frame]
    if {$frame eq "" || ![info exists tunnel_lining($frame)]} {
        set state(status) "No lining for this frame - run the MOLE\
            engine with an atom-name column (the plugin always supplies one)."
        return
    }
    set t $w.tunlining
    if {[winfo exists $t]} { destroy $t }
    toplevel $t
    wm withdraw $t
    wm title $t "Tunnel lining - frame $frame"
    _center_toplevel $t 900 620

    frame $t.ctl
    checkbutton $t.ctl.all -text "Show all tunnels in this frame" \
        -variable ::VMDPathFinder::state(tunnel_lining_show_all) \
        -command ::VMDPathFinder::_refresh_tunnel_lining_body
    # ONE export, not two - a CSV of the table shown here and
    # MOLE's own column layout - and picking between them was a decision the
    # window could not explain. MOLE's format is the one worth having: it is
    # what a reader can diff against a real MOLE run, and it carries the same
    # lining table plus its companion files. With only one button it is just
    # "Export...".
    button $t.ctl.export -text "Export..." -command ::VMDPathFinder::export_mole_native_format
    pack $t.ctl.all -side left
    pack $t.ctl.export -side right
    grid $t.ctl -row 0 -column 0 -columnspan 2 -sticky ew -padx 6 -pady {6 2}
    add_tooltip $t.ctl.all "Off: only the tunnel selected in the left panel. On: every tunnel in this frame."
    add_tooltip $t.ctl.export "Exports tunnels.csv and its companion files in MOLE's own column layout - directly comparable with a real MOLE run."

    set txt $t.txt
    text $txt -wrap none -font TkFixedFont -yscrollcommand [list $t.vs set] \
        -xscrollcommand [list $t.hs set]
    scrollbar $t.vs -orient vertical -command [list $txt yview]
    scrollbar $t.hs -orient horizontal -command [list $txt xview]
    grid $txt $t.vs -row 1 -column 0 -sticky nsew
    grid $t.vs -row 1 -column 1 -sticky ns
    grid $t.hs -row 2 -column 0 -sticky ew
    grid rowconfigure $t 1 -weight 1
    grid columnconfigure $t 0 -weight 1
    $txt tag configure hdr -font {Helvetica -12 bold} -foreground "#1a5fb4"
    # The column header MUST render in the body's exact font or its %-5s/%8s
    # slots do not line up with the rows underneath - even a same-family/size
    # bold measures ~1.25x wider (DejaVu Sans Mono's bold is not
    # metric-compatible here). Distinguish it by color and underline instead,
    # neither of which changes advance width.
    $txt tag configure colhdr -foreground "#1a5fb4" -underline 1
    $txt tag configure minrow -background "#fff2cc"

    ::VMDPathFinder::_refresh_tunnel_lining_body
}

proc ::VMDPathFinder::_refresh_tunnel_lining_body {} {
    # Fills $w.tunlining.txt from tunnel_lining, scoped per state(tunnel_
    # lining_show_all) - split out of show_tunnel_lining so the "show all"
    # checkbox can re-render in place without rebuilding the whole window.
    variable w
    variable state
    variable tunnel_lining
    set t $w.tunlining
    if {![winfo exists $t.txt]} { return }
    set txt $t.txt
    set frame [_tunnel_display_frame]
    if {$frame eq "" || ![info exists tunnel_lining($frame)]} { return }
    set lin $tunnel_lining($frame)
    set show_all [expr {[info exists state(tunnel_lining_show_all)] && $state(tunnel_lining_show_all)}]
    set sel [expr {[info exists state(tunnel_selected_id)] ? $state(tunnel_selected_id) : ""}]

    $txt configure -state normal
    $txt delete 1.0 end
    set ids {}
    # TUNNEL ids only: the same dict also carries the frame's cavities under
    # "cav.<id>" (their own window shows those), and those keys are not tunnel
    # ranks - feeding one to lsort -integer threw and took the whole window
    # with it.
    foreach k [dict keys $lin] {
        set _id [lindex [split $k .] 0]
        if {[string is integer -strict $_id]} { lappend ids $_id }
    }
    set ids [lsort -unique -integer $ids]
    if {!$show_all && $sel ne ""} {
        set ids [expr {[lsearch -exact $ids $sel] >= 0 ? [list $sel] : {}}]
    }
    if {[llength $ids] == 0} {
        $txt insert end [expr {$show_all ? "No lining data for this frame.\n" \
            : "No lining for the selected tunnel. Pick one in the left panel,\nor tick \"Show all tunnels\" above.\n"}]
        $txt configure -state disabled
        return
    }
    foreach id $ids {
        if {![dict exists $lin $id.layers]} continue
        set wp [dict get $lin $id.wprops]
        $txt insert end [format "Tunnel %s   %d layers\n" $id \
                             [llength [dict get $lin $id.layers]]] hdr
        # The weighted properties are what MOLE's tunnels.csv prints.
        $txt insert end [format "  charge %s (%s positive, %s negative)  ionizable %s  hydropathy %s\
 hydrophobicity %s  polarity %s\n  logP %s  logD %s  logS %s  mutability %s\n" \
            [dict get $wp charge] \
            [expr {[dict exists $wp npos] ? [dict get $wp npos] : "?"}] \
            [expr {[dict exists $wp nneg] ? [dict get $wp nneg] : "?"}] \
            [dict get $wp ionizable] \
            [dict get $wp hydropathy] [dict get $wp hydrophobicity] \
            [dict get $wp polarity] [dict get $wp logp] [dict get $wp logd] \
            [dict get $wp logs] [dict get $wp mutability]]
        set flow {}
        foreach e [dict get $lin $id.flow] {
            lappend flow "[dict get $e resname][dict get $e resid][dict get $e chain][expr {[dict get $e backbone] ? {(bb)} : {}}]"
        }
        $txt insert end "  lining: [join $flow {, }]\n"
        # HET residues, on their own line: they are a different measurement from
        # the lining (1.2 x Radius against the un-jittered coordinates), and a
        # user reading "lining" should not have to guess which is which.
        if {[dict exists $lin $id.het] && [llength [dict get $lin $id.het]]} {
            set hs {}
            foreach e [dict get $lin $id.het] {
                lappend hs "[dict get $e resname] [dict get $e resid] [dict get $e chain]"
            }
            $txt insert end "  het:    [join $hs {, }]\n"
        }
        $txt insert end "\n"
        $txt insert end [format "  %-5s %8s %8s %8s %8s %8s %s\n" \
                             layer start end radius freeR bR "residues"] colhdr
        foreach y [dict get $lin $id.layers] {
            set rs {}
            foreach r [dict get $y residues] {
                lappend rs "[dict get $r resname][dict get $r resid][dict get $r chain][expr {[dict get $r backbone] ? {(bb)} : {}}]"
            }
            set is_min [dict get $y localmin]
            # MOLE's own layer records carry full float precision (5 decimals,
            # sometimes 7-8+ characters and unbounded for a long enough
            # tunnel) - %8s only sets a MINIMUM width, so a value wider than
            # its slot silently pushes every later column out of line for
            # just that one row, which read as "the columns don't match the
            # data" since most rows still lined up. Round to a fixed, bounded
            # precision first (matching the tunnel list's own Bneck/Len
            # formatting), same as every other numeric column here already
            # gets from MOLE's own W-record en route to this window.
            $txt insert end [format "  %-5s %8s %8s %8s %8s %8s %s%s\n" \
                [dict get $y layer] [format %.2f [dict get $y start]] \
                [format %.2f [dict get $y end]] \
                [format %.3f [dict get $y radius]] [format %.3f [dict get $y freeradius]] \
                [format %.3f [dict get $y bradius]] [join $rs {, }] \
                [expr {$is_min ? "   <- local min" : ""}]] \
                [expr {$is_min ? "minrow" : ""}]
        }
        $txt insert end "\n"
    }
    $txt configure -state disabled
}

proc ::VMDPathFinder::export_mole_native_format {} {
    # Writes tunnels.csv / tunnel_N.csv / tunnel_N_physchem.csv in MOLE's OWN
    # column layout and naming (verbatim headers from a real MOLE 2 run -
    # vmdpathfinder/tests/fixtures/mole_reference/*/tunnels.csv etc.), scoped to the
    # displayed frame, so a user can point a diff tool straight at the plugin's output
    # against a real MOLE reference directory without translating columns by
    # hand. "MOLE format" means the FILE LAYOUT and COLUMN NAMES; it makes no
    # claim about matching a specific historical MOLE run byte-for-byte -
    # atom order and upstream bugs are separate questions (see
    #
    # Per-point Radius is written; FreeRadius/BRadius are NOT tracked per
    # point in this build (only per LAYER, in tunnel_lining) - written as
    # empty fields rather than fabricated, so a diff shows what is genuinely
    # comparable and what is not.
    variable state
    variable tunnel_results
    variable tunnel_lining
    set frame [_tunnel_display_frame]
    if {$frame eq "" || ![info exists tunnel_results($frame)]} { return }
    set dir [tk_chooseDirectory -title "Export MOLE-format CSVs to…" \
        -initialdir [export_initial_dir]]
    if {$dir eq ""} { return }
    set have_lin [info exists tunnel_lining($frame)]
    set lin [expr {$have_lin ? $tunnel_lining($frame) : [dict create]}]

    set tfh [open [file join $dir tunnels.csv] w]
    puts $tfh "Id,Length,Charge,Ionizable,Hydropathy,Hydrophobicity,Polarity,LogP,LogD,LogS,Mutability"

    set id 0
    foreach t $tunnel_results($frame) {
        incr id
        lassign $t bott len cost thr pts cav
        set cavlab [expr {[string is integer -strict $cav] ? $cav : "?"}]
        set wp [expr {[dict exists $lin $id.wprops] ? [dict get $lin $id.wprops] : ""}]
        set row [list "T${id}C${cavlab}" [format %.2f $len]]
        foreach k {charge ionizable hydropathy hydrophobicity polarity logp logd logs mutability} {
            lappend row [expr {$wp ne "" && [dict exists $wp $k] \
                ? [format %.2f [dict get $wp $k]] : ""}]
        }
        # MOLE's own column order is Id,Length,Charge,Ionizable,Hydropathy,
        # Hydrophobicity,Polarity,LogP,LogD,LogS,Mutability - reorder to match.
        lassign $row rid rlen rcharge rion rhp rhb rpol rlp rld rls rmut
        puts $tfh "$rid,$rlen,$rcharge,$rion,$rhp,$rhb,$rpol,$rlp,$rld,$rls,$rmut"

        set pfh [open [file join $dir "tunnel_${id}.csv"] w]
        puts $pfh {"T","Distance","Radius","FreeRadius","BRadius","X","Y","Z"}
        set n [expr {[llength $pts]/4}]
        set d 0.0; set px ""; set py ""; set pz ""
        for {set i 0} {$i < $n} {incr i} {
            set b [expr {$i*4}]
            set x [lindex $pts $b]; set y [lindex $pts [expr {$b+1}]]
            set z [lindex $pts [expr {$b+2}]]; set r [lindex $pts [expr {$b+3}]]
            if {$px ne ""} {
                set d [expr {$d + sqrt(($x-$px)*($x-$px)+($y-$py)*($y-$py)+($z-$pz)*($z-$pz))}]
            }
            # Per-point FreeRadius/BRadius come from the engine's P records
            # (kept by _tunnel_parse_lining as $id.pfree / $id.pbr); blank only
            # when the run predates them or used an atom table without names.
            set _fr ""; set _br ""
            if {$have_lin && [dict exists $lin $id.pfree]} {
                set _fr [lindex [dict get $lin $id.pfree] $i]
                set _br [lindex [dict get $lin $id.pbr] $i]
                if {![string is double -strict $_fr]} { set _fr "" } else { set _fr [format %.4f $_fr] }
                if {![string is double -strict $_br]} { set _br "" } else { set _br [format %.4f $_br] }
            }
            puts $pfh [format {%d,%.3f,%.4f,%s,%s,%.3f,%.3f,%.3f} $id $d $r $_fr $_br $x $y $z]
            set px $x; set py $y; set pz $z
        }
        close $pfh

        if {$have_lin && [dict exists $lin $id.layers]} {
            set lfh [open [file join $dir "tunnel_${id}_physchem.csv"] w]
            puts $lfh {"LayerId","Radius","FreeRadius","BRadius","LocalMinimum","StartDistance","EndDistance","Charge","Ionizable","Hydropathy","Hydrophobicity","Polarity","Mutability","LogP","LogD","LogS"}
            foreach y [dict get $lin $id.layers] {
                puts $lfh [format {%s,%.2f,%.2f,%.2f,%d,%.2f,%.2f,%s,%s,%.2f,%.2f,%.2f,%s,%.2f,%.2f,%.2f} \
                    [dict get $y layer] [dict get $y radius] [dict get $y freeradius] \
                    [dict get $y bradius] [dict get $y localmin] [dict get $y start] [dict get $y end] \
                    [dict get $wp charge] [dict get $wp ionizable] [dict get $wp hydropathy] \
                    [dict get $wp hydrophobicity] [dict get $wp polarity] [dict get $wp mutability] \
                    [dict get $wp logp] [dict get $wp logd] [dict get $wp logs]]
            }
            close $lfh
        }
    }
    close $tfh
    set state(status) "MOLE-format CSVs written to $dir (frame $frame, $id tunnel(s))."
}

proc ::VMDPathFinder::tunnel_search {molid frame seed cfg {outdir ""}} {
    # MOLE, and only MOLE: CAVER's own Voronoi search is out of scope. See
    #
    # No fallback to a different algorithm when MOLE is unavailable.
    # _tunnel_search_mole reports "unavailable" only when the binary AND the
    # Tcl modules are both missing (a broken install) and "failed" when the
    # engine was found, ran, and then refused the input or crashed (e.g. a
    # multi-conformer atom set - mole_pivots' own guard) - two different
    # problems with two different fixes, so they must not share one message:
    # "unavailable" sent a user with a perfectly good install looking for a
    # missing binary when the real, actionable cause (and its exact fix) was
    # already sitting in $payload.
    lassign [_tunnel_search_mole $molid $frame $seed $cfg] st payload diag
    if {$st eq "unavailable"} { error "tunnel: MOLE engine unavailable - $payload" }
    if {$st ne "ok"} { error "tunnel: MOLE engine refused this input - $payload" }
    if {$diag ne ""} { catch {vmdcon -info "VMDPathFinder tunnel (MOLE): $diag"} }
    # mole-c / mole-tcl: the same tunnels either way, but one is ~120x slower
    # and the status line has to say which ran.
    set tag [expr {[string match "*pure Tcl*" $diag] ? "mole-tcl" : "mole-c"}]
    # The lining rides along rather than widening the return: every caller
    # unpacks this list positionally.
    variable tunnel_lining
    set lin [_tunnel_parse_lining $payload]
    if {[dict size $lin]} { set tunnel_lining($frame) $lin }
    # Persist the SAME payload the multi-frame compiled path writes to its own
    # out.dat (run_tunnel_analysis, the $have_c && $nfr > 1 branch) so a
    # single-frame or Tcl-fallback run leaves a reloadable file behind too,
    # instead of the raw text existing only for the length of this call.
    # $outdir is the frame's own tunnel_%05d dir when the caller has one;
    # empty for ad hoc callers, which get in-memory-only behaviour.
    if {$outdir ne ""} {
        catch {
            set _ofh [open [file join $outdir out.dat] w]
            puts -nonewline $_ofh $payload
            close $_ofh
        }
    }
    return [list $tag [_tunnel_parse_text $payload] $diag]
}

proc ::VMDPathFinder::_tunnel_cfg {} {
    # Panel values, guarded. Every mole_* key falls back to MOLE's own default
    # rather than to something of ours, so a blank or nonsense entry gives MOLE's
    # documented behaviour rather than a quietly different search.
    #
    # The lattice search's probe/shell/spacing/cap are gone with it. Its probe
    # widget was NOT rewired to ProbeRadius: they are different quantities (0.6
    # against 3.0 - MOLE's sets what counts as OUTSIDE the structure), and
    # tunnel_probe was persisted and absent from skip_keys, so any user with a
    # saved 0.6 would have got MOLE at ProbeRadius 0.6 - no error, plausible
    # output, wrong cavities. mole_probe is a NEW key for that reason.
    variable state
    set clus [_num_or tunnel_cluster 3.0 1]
    return [dict create cluster $clus \
        mole_probe        [_num_or mole_probe 3.0 1] \
        mole_interior     [_num_or mole_interior 1.25 1] \
        mole_mindepth     [_int_or mole_mindepth 8] \
        mole_mindeplen    [_num_or mole_mindeplen 5.0 1] \
        mole_minlen       [_num_or mole_minlen 0.0 0] \
        mole_originradius [_num_or mole_originradius 5.0 1] \
        mole_cover        [_num_or mole_cover 10.0 1] \
        mole_autocover    [_num_or mole_autocover 10.0 1] \
        mole_maxorigins   [_int_clamped mole_maxorigins 5 1 16] \
        mole_bottleneck   [_num_or mole_bottleneck 1.25 1] \
        mole_bottletol    [_num_or mole_bottletol 0.0 0] \
        mole_maxsim       [_num_or mole_maxsim 0.9 1] \
        mole_fbl          [expr {[info exists state(mole_fbl)] && $state(mole_fbl) ? 1 : 0}] \
        mole_strict_interior [expr {[info exists state(mole_strict_interior)] \
                                    && $state(mole_strict_interior) ? 1 : 0}] \
        mole_exit         [_xyz_or mole_exit] \
        mole_exits_only   [expr {[info exists state(mole_exits_only)] && $state(mole_exits_only) ? 1 : 0}] \
        mole_exit_text    [expr {[info exists state(mole_exit)] ? [string trim $state(mole_exit)] : ""}] \
        mole_vdw          [_mole_vdw_spec] \
        mole_path_a       [_xyz_or mole_path_a] \
        mole_path_b       [_xyz_or mole_path_b] \
        mole_weight       [_mole_weight_index]]
}

# Panel-entry guards. `positive` rejects <= 0 as well as non-numeric, which is
# what every MOLE radius wants; MinTunnelLength legitimately takes 0.
proc ::VMDPathFinder::_metrics_water_probe {} {
    # THE reader for the Channel-metrics water-probe field: the one metrics
    # entry with no validation - an emptied or mistyped field ("1,15") killed
    # the profile plot's whole metrics pass on the next redraw.
    variable state
    set p [expr {[info exists state(metrics_water_probe)] ? [string trim $state(metrics_water_probe)] : ""}]
    if {![_is_finite $p] || $p < 0} { return 1.15 }
    return $p
}

proc ::VMDPathFinder::_frame_time_dt {} {
    # Simulation time per saved frame, in the chosen unit; 0 when the field is
    # empty, not a number, or not positive (plots then show frame numbers).
    variable state
    if {![info exists state(frame_time)]} { return 0 }
    set v [string trim $state(frame_time)]
    if {![_is_finite $v] || $v <= 0} { return 0 }
    return $v
}

proc ::VMDPathFinder::_frame_time_unit {} {
    variable state
    set u [expr {[info exists state(frame_time_unit)] ? $state(frame_time_unit) : "ns"}]
    if {$u ni {fs ps ns us ms}} { set u ns }
    return $u
}

proc ::VMDPathFinder::_frame_time_unit_label {} {
    set u [_frame_time_unit]
    return [expr {$u eq "us" ? "\u00b5s" : $u}]
}

proc ::VMDPathFinder::_frame_axis_label {} {
    # The x-axis title of a per-frame plot: "Frame", or the time unit.
    if {[_frame_time_dt] > 0} { return "Time ([_frame_time_unit_label])" }
    return "Frame"
}

proc ::VMDPathFinder::_frame_to_time {frame} {
    # frame index x time per frame; the frame number itself when no time is set.
    set dt [_frame_time_dt]
    if {$dt <= 0 || ![string is double -strict $frame]} { return $frame }
    return [expr {$frame * $dt}]
}

proc ::VMDPathFinder::_frame_tick_text {frame} {
    # Tick label for one frame on a per-frame axis: the frame number, or its
    # time with the decimals the step needs.
    set dt [_frame_time_dt]
    if {$dt <= 0 || ![string is double -strict $frame]} { return $frame }
    set t [expr {$frame * $dt}]
    if {abs($t) >= 100} { return [format %.0f $t] }
    if {abs($t) >= 10} { return [format %.1f $t] }
    return [format %.2f $t]
}

proc ::VMDPathFinder::_frame_time_ns {} {
    # Time per frame in nanoseconds, for the permeation rate; "" when unset.
    set dt [_frame_time_dt]
    if {$dt <= 0} { return "" }
    set f [dict get {fs 1e-6 ps 1e-3 ns 1.0 us 1e3 ms 1e6} [_frame_time_unit]]
    return [expr {$dt * $f}]
}

proc ::VMDPathFinder::_csv_time_header {} {
    # ",time_<unit>" for a frame-indexed CSV when a time per frame is set, else "".
    if {[_frame_time_dt] <= 0} { return "" }
    return ",time_[_frame_time_unit]"
}

proc ::VMDPathFinder::_csv_time_cell {frame} {
    if {[_frame_time_dt] <= 0} { return "" }
    return ",[format %.6g [_frame_to_time $frame]]"
}

proc ::VMDPathFinder::_frame_list_time_hdr {} {
    # Frame-list column header for the simulation time, "" when unset.
    if {[_frame_time_dt] <= 0} { return "" }
    return [format "  %10s" "Time([_frame_time_unit_label])"]
}

proc ::VMDPathFinder::_frame_list_time_cell {frame} {
    if {[_frame_time_dt] <= 0} { return "" }
    return [format "  %10s" [_frame_tick_text $frame]]
}

proc ::VMDPathFinder::_frame_time_validate {new} {
    # Entry validator: digits and one decimal point only, so a negative or a
    # word can never be typed.
    return [regexp {^[0-9]*\.?[0-9]*$} $new]
}

proc ::VMDPathFinder::_frame_time_unit_pick {u} {
    variable state
    set state(frame_time_unit) $u
    set state(frame_time_unit_disp) [_frame_time_unit_label]
    _frame_time_changed
}

proc ::VMDPathFinder::_frame_time_changed {args} {
    # Redraw whatever per-frame plot is on screen and refresh the Frames list
    # header, so the axis follows the field at once.
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    catch {refresh_results_list}
    catch {redraw_visible_analysis_tab}
}

proc ::VMDPathFinder::_num_or {key def positive} {
    variable state
    set v [string trim [set state($key)]]
    if {![_is_finite $v]} { return $def }
    if {$positive && $v <= 0} { return $def }
    if {!$positive && $v < 0} { return $def }
    return $v
}

proc ::VMDPathFinder::_int_clamped {key def lo hi} {
    # Like _int_or, but also bounds the value. Used for max origins/cavity:
    # the C engine writes them into a fixed 16-element stack array
    # (MOLE_MAX_ORIGINS in mole_tunnel.h), so an unbounded field here could
    # overwrite the engine's stack. The engine clamps too - this just means the
    # value the user sees and the value it runs with are the same number.
    set v [_int_or $key $def]
    if {$v < $lo} { return $lo }
    if {$v > $hi} { return $hi }
    return $v
}

proc ::VMDPathFinder::_int_or {key def} {
    variable state
    set v [string trim [set state($key)]]
    if {![string is integer -strict $v] || $v < 0} { return $def }
    return $v
}

# TunnelWeightFunction, name -> the enum value the engine reads. VoronoiScale is
# 0 and is MOLE's default; an unrecognised name falls back to it rather than to
# whatever index a lookup happened to return.
proc ::VMDPathFinder::_mole_weight_index {} {
    variable state
    set names {VoronoiScale LengthAndRadius Length Constant}
    set i [lsearch -exact $names [string trim $state(mole_weight_disp)]]
    return [expr {$i < 0 ? 0 : $i}]
}

proc ::VMDPathFinder::ensure_tunnel_surface_mol {protein_mol} {
    # Tunnels get a track of their own, separate from ensure_surface_mol's HOLE
    # surface, so neither mode's geometry can clobber the other's and either can
    # be toggled or deleted alone.
    variable tunnel_surface_mols
    if {[info exists tunnel_surface_mols($protein_mol)] && \
            ![catch {molinfo $tunnel_surface_mols($protein_mol) get name}]} {
        set m $tunnel_surface_mols($protein_mol)
        catch {sync_surface_view $m $protein_mol}
        return $m
    }
    set pv {}
    catch {set pv [molinfo $protein_mol get \
        {center_matrix rotate_matrix scale_matrix global_matrix}]}
    set m [mol new]
    mol rename $m "Tunnels (mol $protein_mol)"
    set tunnel_surface_mols($protein_mol) $m
    if {$pv ne ""} {
        catch {molinfo $m set \
            {center_matrix rotate_matrix scale_matrix global_matrix} $pv}
    }
    catch {sync_surface_view $m $protein_mol}
    # `mol new` makes this 0-frame graphics mol VMD's TOP molecule, and VMD drives
    # `animate forward` off top - so playback could not advance the trajectory at
    # all in tunnel mode (the Play button appeared dead). It also breaks the frame
    # trace: with state(molid) left at "top", resolve_molid returns THIS mol, so
    # frame_changed dropped every write for the protein and _tunnel_display_frame
    # read a molecule that only ever has frame 0 - the per-frame tunnels never
    # changed. Restore the TRAJECTORY as top, not the previous top (which could
    # itself be a 0-frame surface mol). ensure_surface_mol and the ellipse mol
    # already do exactly this; this one was missed.
    if {![catch {molinfo $protein_mol get name}]} { catch {mol top $protein_mol} }
    return $m
}

proc ::VMDPathFinder::_tunnel_color_names {} {
    # All of VMD's own named colors except white/black (which vanish
    # against a light or dark viewer background respectively) - queried live
    # via colorinfo, not a hardcoded literal, so a VMD build shipping a
    # different named-color set is picked up automatically. Cached:
    # colorinfo's own list is fixed for the life of the process.
    return [_vmd_color_names {white black}]
}

proc ::VMDPathFinder::_tunnel_color {i} {
    # Distinct, stable color per tunnel rank; rank 1 is the widest route.
    # Exhausts VMD's FULL named-color set (currently 31, all but white/
    # black) before repeating - a 10-entry literal repeats as early
    # as tunnel 11, reading as "everything is the same color" on any
    # multi-cavity structure with more than a handful of routes.
    set names [_tunnel_color_names]
    set nm [lindex $names [expr {$i % [llength $names]}]]
    if {[catch {colorinfo index $nm} idx]} { set idx 1 }
    return $idx
}

proc ::VMDPathFinder::_write_tunnel_manifest {root molid frames cfg seed auto_origin engine} {
    # A self-contained record of WHAT produced this run, written next to the
    # results. Without it a saved tunnel directory cannot be reproduced or even
    # interpreted later: the selection, the MOLE parameters, the origin and the
    # engine build are all invisible in the .sph/out.dat files themselves.
    # Plain key=value text, one run per file, so it greps and diffs.
    variable state
    variable version
    set f [file join $root "vmdpathfinder_tunnel_manifest.txt"]
    if {[catch {open $f w} fh]} { return }
    set struct ""
    catch {set struct [molinfo $molid get filename]}
    set nm ""
    catch {set nm [get_molecule_basename $molid]}
    set eng [tool_path mole_engine]
    set engstamp ""
    if {$eng ne "" && [file exists $eng]} {
        catch {set engstamp "[file size $eng]:[file mtime $eng]"}
    }
    puts $fh "# VMDPathFinder tunnel run manifest - regenerated on every run"
    puts $fh "written           = [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}]"
    puts $fh "plugin_version    = $version"
    puts $fh "engine            = $engine"
    puts $fh "engine_path       = $eng"
    puts $fh "engine_stamp      = $engstamp"
    puts $fh "structure_files   = $struct"
    puts $fh "structure_name    = $nm"
    puts $fh "molid             = $molid"
    puts $fh "selection         = $state(selection)"
    puts $fh "frames_analysed   = [llength $frames]"
    puts $fh "frame_spec        = [expr {[info exists state(frame_spec)] ? $state(frame_spec) : {}}]"
    puts $fh "frame_list        = $frames"
    puts $fh "origin_mode       = [expr {$auto_origin ? {auto-detect} : {explicit}}]"
    puts $fh "origin_point      = $seed"
    puts $fh "start_point_field = [expr {[info exists state(tunnel_start)] ? $state(tunnel_start) : {}}]"
    # The field can be a VMD selection or a ";" list, re-evaluated per frame, so
    # the text alone no longer reproduces the run. Record what it actually
    # resolved to, per frame - CAVER 3.0 (Chovancova 2012, s1.3) makes the point
    # that the start point must be reported with the results for the run to be
    # reproducible, and that is exactly the case a moving origin breaks.
    if {!$auto_origin && $seed ne ""} {
        foreach _f $frames {
            set _pts [_mole_points_from_text $seed $molid $_f]
            if {[llength $_pts]} {
                puts $fh "origin_resolved_f$_f = [join $_pts { ; }]"
            }
        }
    }
    puts $fh "align_trajectory  = [expr {[info exists state(tunnel_align)] ? $state(tunnel_align) : {}}]"
    puts $fh "align_selection   = [expr {[info exists state(align_sel)] ? $state(align_sel) : {}}]"
    puts $fh "cluster_on        = [expr {[info exists state(tunnel_cluster_on)] ? $state(tunnel_cluster_on) : {}}]"
    puts $fh "cluster_threshold = [expr {[info exists state(tunnel_cluster)] ? $state(tunnel_cluster) : {}}]"
    puts $fh "xframe_max_ranks  = [expr {[info exists state(tunnel_xframe_max)] ? $state(tunnel_xframe_max) : {}}]"
    puts $fh "lining_shell_A    = [lining_dist_thresh_value]"
    puts $fh "mole_parameters   = [_mole_cfg_args $cfg] [_mole_cfg_flags $cfg]"
    close $fh
}

proc ::VMDPathFinder::run_tunnel_analysis {} {
    # H3: the body below is ~430 lines with nine hand-written `set busy 0`
    # restore points and NO catch. Anything that throws in between - a bare
    # `file mkdir` on an unwritable parent (resolve_output_root), `open $sh w`,
    # write_stock_sph_file, render_tunnels_for_frame - leaves `busy` stuck at 1.
    # `busy` is the SAME flag run_analysis guards on, and `_calc_depth` is left
    # incremented so _begin_calc never re-clears abort_requested: every later
    # run in that VMD session then returns 0 with "already in progress",
    # producing no output and raising no error. The GUI is insulated because
    # run_current_mode already wraps this call; the exposed surface is the
    # headless entry documented in docs/scripting.md.
    #
    # run_analysis restores both on its own error path; the catch below gives
    # the tunnel path the same guarantee. The body stays inline so that its
    # nine existing exits keep working unchanged - and so that the assertions
    # in headless_smoke.tcl which read `info body run_tunnel_analysis` still
    # see the code they are checking.
    variable busy
    variable w
    set _rc [catch {
    # Tunnel mode's Run. Deliberately parallel to run_analysis but sharing none
    # of its storage: separate results, separate output root, separate surface
    # track. Reuses the .sph -> sph_process -> sos_triangle -> render pipeline,
    # since a tunnel is a list of {x y z r} - exactly HOLE's .sph format.
    variable state
    variable tunnel_results
    variable tunnel_lining
    variable tunnel_result_frames
    variable tunnel_root
    variable tunnel_shown
    variable tunnel_gear_color
    variable tunnel_gear_material
    variable tunnel_gear_wire
    variable tunnel_gear_prop
    variable tunnel_gear_colormode
    variable tunnel_gear_cid
    variable busy

    # Same re-entrancy guard run_analysis has, and for the same reason: the job
    # pool calls [update], so a second Run click could otherwise re-enter here,
    # clear the shared tunnel_* arrays mid-run and launch a second set of
    # engines against the very same output directories.
    if {[_op_in_progress]} {
        set state(status) "A run is already in progress."
        return
    }
    # Held for the whole run. Cleared at EVERY exit below - this proc has eight
    # early returns and each one has to hand the flag back.
    set busy 1
    # Pairs with every _end_calc below: without it the Abort button never
    # appeared for a tunnel run, even though the frame loop already honours
    # _abort_requested. Ten exit paths, each one hands both flags back.
    _begin_calc

    set molid [string trim $state(molid)]
    # Remember WHICH molecule this run's results describe. The cavity residue
    # lookups resolve atom selections, and by the time they run the user (or a
    # test) may have loaded other molecules, leaving state(molid) - especially
    # at its "top" default - pointing somewhere the lining does not exist.
    variable tunnel_run_molid
    catch {set tunnel_run_molid [resolve_molid]}
    if {[catch {molinfo $molid get numframes}]} {
        set state(status) "Tunnel: molecule '$molid' does not exist."
        set busy 0
        _end_calc
        return
    }
    set auto_origin [expr {[info exists state(tunnel_auto_origin)] && $state(tunnel_auto_origin)}]
    # An empty seed IS a real, supported mode downstream (tunnel_search / MOLE's
    # own auto-origin scan of every cavity in the structure) - not just "no
    # point was given yet". Auto-detect forces it regardless of whatever the
    # (disabled but not cleared) Start point field still shows.
    set seed [expr {$auto_origin ? "" : [string trim $state(tunnel_start)]}]
    # The seed stays TEXT from here on - "x y z", a VMD selection, or a ";"
    # list of either - and is resolved per frame inside _tunnel_search_mole
    # (a residue-defined origin moves with the trajectory). Only check here
    # that it resolves in the current frame at all, so a typo is caught before
    # the run rather than as N silent empty frames.
    # A seed whose first token is a number is a LITERAL attempt ("x y z",
    # or a typo like "12.3 4.5 nan_typo"): it needs no molecule and is
    # checked element by element below, exactly as before. Anything else is
    # resolved through the molecule (selections, ";" lists).
    set _seed_literal [expr {!$auto_origin && [llength $seed] == 3 \
        && [string is double -strict [lindex $seed 0]]}]
    set _seed_ok 1
    set _sm ""; set _sf 0
    if {!$auto_origin && !$_seed_literal} {
        catch {set _sm [resolve_molid]}
        catch {set _sf [molinfo $_sm get frame]}
        if {$_sm eq "" || ![llength [_mole_points_from_text $seed $_sm $_sf]]} { set _seed_ok 0 }
    }
    if {!$_seed_ok} {
        set state(status) "Tunnel: set a start point first - \"x y z\", a VMD selection, or several separated by \";\" (Start point / From Sel) - or check Auto-detect origins."
        set busy 0
        _end_calc
        return
    }
    # Every OTHER coordinate triple in this file goes through _xyz_or, which
    # rejects a non-double. This one did not: it was guarded on element COUNT
    # alone and then interpolated raw into run.sh and into `exec sh -c`. Two
    # consequences, both silent - "12.3 4.5 nan_typo" is a valid 3-element list
    # and the engine's atof turns it into 0.0, searching every frame from an
    # origin on z=0; and `{0 0 {1; touch /tmp/x}}` is also a valid 3-element
    # list, and lands as a command separator. Reject non-numeric here, and
    # shell_quote each component at both interpolation sites below.
    # The seed is now free text (selections, ";" lists) resolved per frame by
    # _mole_points_from_text; what reaches run.sh / exec are the RESOLVED
    # numbers, each shell_quote'd. So the finiteness check applies to those,
    # on the current frame - the same injection and nan cases are still
    # refused, a selection is not.
    if {!$auto_origin} {
        if {$_seed_literal} {
            set _flat $seed
        } else {
            set _rs {}
            catch {set _rs [_mole_points_from_text $seed $_sm $_sf]}
            set _flat {}
            foreach _p $_rs { lappend _flat {*}$_p }
        }
        foreach _c $_flat {
            if {![_is_finite $_c]} {
                set state(status) "Tunnel: start point must be three finite numbers, a VMD selection, or a \";\" list of them (got '$state(tunnel_start)')."
                set busy 0
                _end_calc
                return
            }
        }
    }
    if {[catch {parse_frame_spec $molid $state(frame_spec)} frames] || [llength $frames] == 0} {
        set state(status) "Tunnel: no frames matched '$state(frame_spec)'."
        set busy 0
        _end_calc
        return
    }

    set cfg [_tunnel_cfg]
    lassign [resolve_output_root $molid tunnel] root is_tmp
    set tunnel_root $root
    # Same confirm-before-clobber HOLE mode has had all along. Tunnel mode wrote
    # straight over an existing result set with no prompt - a long trajectory
    # search silently destroyed by a mis-clicked Run. Mirrors run_analysis: only
    # for a real (non-temporary) output root, only when there is something to
    # lose, and only when Overwrite is on; declining cancels the run and leaves
    # the results untouched. tunnel_* dirs, not frame_* - the two output trees
    # are deliberately separate.
    # _have_tk gates the PROMPT: confirm_overwrite_dialog is modal, so a headless
    # or scripted run (batch import, the test suite) would block forever on a
    # dialog nobody can answer. Without a GUI the existing results are left
    # alone and the run proceeds - never destroy data no one was asked about.
    if {!$is_tmp && [_have_tk] && [winfo exists $w]} {
        set _existing [glob -nocomplain -directory $root -type d "tunnel_*"]
        if {[llength $_existing] > 0 \
                && [info exists state(overwrite_results)] && $state(overwrite_results)} {
            if {![confirm_overwrite_dialog $root [llength $_existing]]} {
                set state(status) "Tunnel run cancelled - existing results preserved."
                set busy 0
                _end_calc
                return
            }
            foreach _ef $_existing { catch {file delete -force $_ef} }
        }
    }
    # NOTE: last_root_dir / import_dir are deliberately NOT set here. They drive
    # HOLE's Import, and pointing that at tunnel output is exactly the mix-up
    # this separation exists to prevent. Frame folders are named tunnel_%05d,
    # not frame_%05d, so collect_frame_dirs cannot pick them up either.

    array unset tunnel_results
    array set tunnel_results {}
    array unset tunnel_lining
    array set tunnel_lining {}
    array unset tunnel_shown
    array set tunnel_shown {}
    _ion_flow_forget
    variable tunnel_shown_cid
    array unset tunnel_shown_cid
    array set tunnel_shown_cid {}
    # Cluster ids are rebuilt from scratch by this run, so a remembered
    # selected-cluster or a curated default from the previous one is meaningless
    # (and would hide everything on a fresh result).
    set state(tunnel_selected_cid) ""
    set state(tunnel_shown_default) 1
    set state(tunnel_shown_all) 1
    # A re-run renumbers tunnels (rank order can shift) - a stale gear override
    # from the previous run would silently land on whatever new route now has
    # that index, so clear rather than carry forward.
    array unset tunnel_gear_color
    array set tunnel_gear_color {}
    array unset tunnel_gear_material
    array set tunnel_gear_material {}
    array unset tunnel_gear_wire
    array set tunnel_gear_wire {}
    array unset tunnel_gear_prop
    array set tunnel_gear_prop {}
    array unset tunnel_gear_colormode
    array set tunnel_gear_colormode {}
    # The cluster-keyed mirror (tunnel_gear_cid, see _tunnel_global_gear_reset)
    # is what _tunnel_sync_gear_from_cluster actually consults first - missing
    # here, a stale override from the previous run silently reapplied to
    # whatever route the fresh run now numbers with the same cid (cids are
    # sequential per run, same as rank - see _tunnel_cluster_rows). Mirrors
    # the clear import_tunnel_results_from_folder must also do.
    array unset tunnel_gear_cid
    array set tunnel_gear_cid {}
    # The averaged tube is cluster-keyed the same way. Its build key is
    # 'cid|colormode|prop|material|color', identical across runs whenever the
    # fresh run pins cid 1 again - so without this reset the PREVIOUS run's
    # tube stayed on screen over the new results. The per-route gear popup
    # carries a rank from the previous run's list; close it with the rest.
    variable _tunnel_mean_built_cid
    unset -nocomplain _tunnel_mean_built_cid
    variable tunnel_mean_surface_mol
    if {$tunnel_mean_surface_mol >= 0} { catch {mol delete $tunnel_mean_surface_mol} }
    set tunnel_mean_surface_mol -1
    unset -nocomplain _gear_open_cid
    variable w
    catch {destroy $w.tunnel_gear}
    set tunnel_result_frames {}

    set nfr [llength $frames]
    set state(status) "Tunnel: preparing $nfr frame(s)..."
    update idletasks
    # Phase wall-times, reported in the status line and the console. The Tcl
    # fallback is ~100x the compiled path and single-threaded, so a silent
    # fallback reads as "the plugin is slow" with nothing pointing at the cause.
    set _t_start [clock milliseconds]
    set _t_mark  $_t_start
    set _engine  "mole-c"
    variable _mole_tcl_warned
    set _mole_tcl_warned 0

    # Cross-frame tunnel identity is GEOMETRIC (clusters are cut on distances
    # between tunnel axes in the molecule's own coordinate frame), so an
    # unaligned trajectory silently destroys it: rigid-body drift or rotation
    # moves every tunnel together and they stop clustering, or cluster by pose
    # rather than by pathway. Wrapping/centering is NOT sufficient. Aligning is
    # therefore the default, and it MODIFIES the loaded coordinates - so it is
    # announced rather than done quietly, and can be turned off in the tunnel
    # advanced settings for an already-aligned trajectory.
    if {[llength $frames] > 1 && [info exists state(tunnel_align)] && $state(tunnel_align)
            && ![_align_already_done $molid [string trim $state(align_sel)] \
                    $state(align_ref_frame) [molinfo $molid get numframes]]} {
        set state(status) "Aligning trajectory before the tunnel search…"
        catch {update idletasks}
        if {[catch {align_trajectory $molid} _alerr]} {
            set state(status) "Tunnel: alignment failed - $_alerr"
            set busy 0
            _end_calc
            return
        }
        catch {vmdcon -info "VMDPathFinder: aligned $_alerr frame(s) before the tunnel search (Align trajectory is ON)."}
    }

    # Phase 1 - one atom file per frame. atomselect is main-thread only, so this
    # part is serial no matter how the search itself is scheduled.
    #
    # MOLE's own table: the ELEMENT, not a radius, and hydrogens kept. The whole
    # selection, not a sphere around the start point - MOLE triangulates the
    # structure, and the search_radius that used to bound this belonged to the
    # lattice engine's Tcl fallback, which is gone.
    # Only the per-frame DIRECTORIES are made here. atoms.txt itself is written
    # by the pool, one frame at a time, just before that frame's engine starts -
    # building it costs ~41 ms/frame at 18.7k atoms, so writing every frame's
    # copy first would leave the search idle behind seconds of formatting on a
    # long trajectory. The two paths that skip the pool (a lone frame, or the
    # pure-Tcl engine) need no file here at all: _tunnel_search_mole writes its
    # own under _scratch_base.
    set fdirs [dict create]
    foreach fr $frames {
        set fd [file join $root [format "tunnel_%05d" $fr]]
        file mkdir $fd
        dict set fdirs $fr $fd
    }

    # Phase 2 - search. One core per frame beats all cores on one frame
    # monotonically (measured 1.80x, byte-identical either way): only the
    # clearance sweep parallelises, so the serial remainder is paid once per
    # frame however many threads a single run is given. A LONE frame is the
    # exception - there are no siblings to fill the cores, so it takes them all.
    set _t_prep [expr {([clock milliseconds]-$_t_mark)/1000.0}]; set _t_mark [clock milliseconds]
    # Auto shell is gone with the lattice engine: "bulk shell" is a grid notion
    # and MOLE has no grid - it peels from the convex hull with ProbeRadius.
    set have_c [expr {[tool_path mole_engine] ne ""}]
    set _engine [expr {$have_c ? "mole-c" : "mole-tcl"}]
    # When the binary is missing _tunnel_search_mole prints the reason itself,
    # once per run, and the pure-Tcl engine takes over.

    lassign $seed sx sy sz
    if {$have_c && $nfr > 1} {
        set jobs {}
        foreach fr $frames {
            set fd [dict get $fdirs $fr]
            set sh [file join $fd run.sh]
            set fh [open $sh w]
            puts $fh "#!/bin/sh"
            # MOLE's own parameters under MOLE's own names, and the origin only
            # when the panel supplied one - without it the engine uses its
            # computed origins, which is MOLE's automatic mode.
            # Start point(s), custom exits and the vdW override, resolved for
            # THIS frame (a residue-defined origin moves with the trajectory) -
            # the same helper the single-frame path uses.
            set _o [_mole_engine_point_args $seed $cfg $molid $fr]
            # Remove any previous run's out.dat FIRST. The engine only opens
            # (and truncates) its output after it has finished computing, so a
            # crashed or rejected run left the old file completely intact and
            # the parser below happily read those stale tunnels back as this
            # frame's new result.
            puts $fh "rm -f [shell_quote [file join $fd out.dat]]"
            puts $fh "OMP_NUM_THREADS=1 [shell_quote [tool_path mole_engine]] \\"
            puts $fh "  [shell_quote [file join $fd atoms.txt]] [shell_quote [file join $fd out.dat]] \\"
            puts $fh "  [_mole_cfg_args $cfg]$_o [_mole_cfg_flags $cfg] >/dev/null 2>&1"
            close $fh
            lappend jobs [list "tunnel f$fr" [list |sh $sh] \
                [list ::VMDPathFinder::_tunnel_write_atoms_file $molid $fr $fd]]
        }
        # Track run_shell_pool's failure count rather than discarding it: a
        # frame whose engine died (bad conformer, allocation failure, malformed
        # input) simply produces no out.dat, and skipping it silently would
        # present the trajectory as complete, biasing occupancy, mean profiles
        # and every cross-frame frequency. Track both kinds of loss (nonzero
        # exit, and exited-0-but-no-tunnels) and name the frames afterwards.
        set _nfailed [run_shell_pool $jobs [resolve_job_count] "Tunnel search"]
        set _empty_frames {}
        foreach fr $frames {
            set _of [file join [dict get $fdirs $fr] out.dat]
            set tun [_tunnel_parse_out $_of]
            if {[llength $tun] == 0} { lappend _empty_frames $fr }
            if {[llength $tun] > 0} {
                set tunnel_results($fr) $tun
                lappend tunnel_result_frames $fr
                if {![catch {open $_of r} _lh]} {
                    set _lin [_tunnel_parse_lining [read $_lh]]
                    close $_lh
                    if {[dict size $_lin]} { set tunnel_lining($fr) $_lin }
                }
            }
        }
    } else {
        set n 0
        foreach fr $frames {
            if {[_abort_requested]} { break }
            incr n
            set state(status) "Tunnel: frame $fr ($n / $nfr)..."
            update idletasks
            if {[catch {tunnel_search $molid $fr $seed $cfg [dict get $fdirs $fr]} out]} {
                set state(status) "Tunnel: frame $fr failed - $out"
                set busy 0
                _end_calc
                return
            }
            lassign $out engine tun diag
            set _engine $engine
            if {[info exists diag] && $diag ne ""} { set _last_diag $diag }
            if {[llength $tun] > 0} {
                set tunnel_results($fr) $tun
                lappend tunnel_result_frames $fr
            }
        }
    }

    catch {_write_tunnel_manifest $root $molid $frames $cfg $seed $auto_origin $_engine}

    # Name what was lost. A trajectory statistic computed over "all frames" that
    # silently rests on a subset is the failure mode this reports.
    set _loss_note ""
    if {[info exists _empty_frames] && [llength $_empty_frames] > 0} {
        set _shown [lrange $_empty_frames 0 9]
        set _more [expr {[llength $_empty_frames] > 10 \
            ? ", +[expr {[llength $_empty_frames]-10}] more" : ""}]
        set _loss_note [format \
            "  ⚠ %d of %d frame(s) produced NO tunnel%s and are excluded from every trajectory view: %s%s." \
            [llength $_empty_frames] [llength $frames] \
            [expr {[info exists _nfailed] && $_nfailed > 0 ? " ($_nfailed engine failure(s))" : ""}] \
            [join $_shown {, }] $_more]
        catch {vmdcon -warn "VMDPathFinder:$_loss_note"}
    }
    set _t_search [expr {([clock milliseconds]-$_t_mark)/1000.0}]; set _t_mark [clock milliseconds]
    if {[llength $tunnel_result_frames] == 0} {
        set _msg [expr {$auto_origin ? "Tunnel: no tunnel found (auto-detected origins)." \
            : "Tunnel: no tunnel found from that start point."}]
        if {[info exists _last_diag] && $_last_diag ne ""} { set _msg "Tunnel: $_last_diag" }
        set state(status) $_msg
        set busy 0
        _end_calc
        return
    }

    # Two INDEPENDENT mechanisms. Only the first is user-switchable:
    #
    # - tunnel_cluster_on ("Cluster within frame", default OFF, checkbox above
    #   the tunnel list): DISPLAY-only, within one frame. Groups near-duplicate
    #   routes in the LANDED frame into one representative row/3D object, per
    #   CAVER's published method. Every route stays in tunnel_results either
    #   way - this only changes what the list/3D view show, and does not touch
    #   cross-frame identity at all (CAVER
    #   itself has no such per-frame "cluster for display" step, only a hard
    #   discard inside the search, which is MaxTunnelSimilarity's job here).
    #
    # - cross-frame clustering (_tunnel_xframe_build): UNCONDITIONAL, no user
    #   switch by design. Pools every snapshot's pathways and clusters once,
    #   which is what gives a tunnel an IDENTITY over the trajectory - Trends,
    #   Over Time, Mean Profile and Histogram all depend on it, since a fixed
    #   per-frame rank is not an identity.
    #   and "off" here would only mean silently averaging unrelated channels.
    #   tunnel_xframe_max bounds its cost instead.
    # A new run invalidates any clusters cached from the previous one; they are
    # rebuilt here when the toggle is already on, and lazily by
    # _tunnel_ensure_clusters if the user ticks it later (which is the normal
    # case, since the toggle defaults to off).
    variable tunnel_clusters
    variable _tunnel_clusters_th
    array unset tunnel_clusters
    array set tunnel_clusters {}
    set _tunnel_clusters_th [dict get $cfg cluster]
    if {[info exists state(tunnel_cluster_on)] && $state(tunnel_cluster_on)} {
        # No eager pass: _tunnel_list_rows builds the frame it is about to draw
        # and caches it. Clustering every frame here cost ~20 ms x every frame
        # of the trajectory before anything appeared on screen.
        set _tunnel_clusters_th [dict get $cfg cluster]
    }
    if {[llength $tunnel_result_frames] > 0} {
        # UNCONDITIONAL, even for a single-frame run: the tunnel LIST is the
        # cross-frame cluster set now (refresh_tunnel_tab/_tunnel_cluster_
        # rows), so without this a one-frame result had no clusters and
        # therefore no rows at all - _tunnel_xframe_build already handles a
        # pool of one frame as the same code path (see its own comment).
        if {[llength $tunnel_result_frames] > 1} {
            # Name BOTH numbers here, not only in the summary below: this is the
            # long step, and "clustering across 8986 frames" after a 10000-frame
            # run reads as lost data unless the gap is explained where it is
            # first seen. Frames with cavities but no route are the normal
            # cause - they have nothing to cluster.
            set _cn [llength $tunnel_result_frames]
            set _ct [llength $frames]
            set state(status) [expr {$_cn == $_ct \
                ? "Clustering tunnels across $_cn frames…" \
                : "Clustering tunnels across $_cn of $_ct frames ([expr {$_ct-$_cn}] had no tunnel)…"}]
            catch {update idletasks}
        }
        catch {_tunnel_xframe_build}
    }

    # Phase 3 - write each tunnel as a .sph so the existing surface pipeline can
    # render it, and show the landed frame.
    foreach fr $tunnel_result_frames {
        set fd [dict get $fdirs $fr]
        set i 0
        foreach t $tunnel_results($fr) {
            incr i
            set pts [lindex $t 4]
            set centers [_tunnel_render_centers $pts]
            # stock sph_process, so the QSS/SPH/S record form - write_cl_sph_file's
            # CA/SPH/A only satisfies the enhanced sos_triangle_fast reader and
            # yields an empty .sos here.
            write_stock_sph_file $centers [file join $fd [format "tunnel_%02d.sph" $i]]
        }
    }

    # Mesh EVERY frame's tunnels now, in ONE pool, instead of letting each
    # frame pay for its own cost on first arrival (a frame change, with no
    # progress bar and the UI blocked). One pool across all frames also
    # saturates the cores better than N per-frame pools each starved of jobs.
    # BUDGETED (tunnel_premesh_budget), not unconditional: meshing costs far
    # more than the MOLE search itself, so pre-meshing every frame of a long
    # run would dominate the run instead of the frame change - over budget,
    # rendering stays lazy exactly as before.
    set _prejobs {}
    set _prebudget [_num_or tunnel_premesh_budget 400 1]
    if {$_prebudget > 0} {
        foreach fr $tunnel_result_frames {
            set fd [dict get $fdirs $fr]
            set nt [llength $tunnel_results($fr)]
            for {set i 1} {$i <= $nt} {incr i} {
                lappend _prejobs {*}[_tunnel_mesh_jobs $fd $fr [list $i] "f$fr "]
            }
            if {[llength $_prejobs] > $_prebudget} { break }
        }
    }
    if {[llength $_prejobs] > $_prebudget} {
        catch {vmdcon -info "VMDPathFinder tunnel: [llength $tunnel_result_frames] frames exceed the pre-mesh budget ($_prebudget surfaces) - surfaces will be built per frame on first view instead. Raise state(tunnel_premesh_budget) to pre-mesh more."}
        set _prejobs {}
    }
    if {[llength $_prejobs] > 1} {
        set state(status) "Meshing [llength $_prejobs] tunnel surface(s)…"
        catch {update idletasks}
        catch {run_shell_pool $_prejobs [resolve_job_count] "Meshing tunnels" "tunnel(s)"}
    }

    update_frame_trace
    set cur [molinfo $molid get frame]
    if {[lsearch -exact $tunnel_result_frames $cur] < 0} {
        set cur [lindex $tunnel_result_frames 0]
    }
    render_tunnels_for_frame $cur
    set ntot 0
    foreach fr $tunnel_result_frames { incr ntot [llength $tunnel_results($fr)] }
    set _t_render [expr {([clock milliseconds]-$_t_mark)/1000.0}]
    set _t_all    [expr {([clock milliseconds]-$_t_start)/1000.0}]
    # Four cases, not two. Labelling anything that is not "c" as pure-Tcl said
    # "pure-Tcl (SLOW)" for a 0.1 s compiled MOLE run.
    switch -- $_engine {
        c        { set _eng_txt "compiled" }
        mole-c   { set _eng_txt "MOLE (compiled)" }
        mole-tcl { set _eng_txt "MOLE (pure Tcl - SLOW, see console)" }
        default  { set _eng_txt "pure-Tcl (SLOW - see console)" }
    }
    # $_natoms was read here and assigned NOWHERE in the file, so [format] raised
    # "no such variable" inside the bare catch and the entire line vanished -
    # taking with it the only report of which engine ran. That matters most in
    # the case the four-way switch above exists for: a pure-Tcl fallback running
    # ~100x slower than expected left no record naming the cause.
    catch {vmdcon -info [format "VMDPathFinder tunnel: %s engine | prep %.2fs  search %.2fs  render %.2fs  total %.2fs" \
        $_eng_txt $_t_prep $_t_search $_t_render $_t_all]}
    # With clustering on, $ntot (every raw route, every frame) and what the
    # landed frame's list/3D view actually show (_tunnel_candidates, one
    # representative per cluster) are legitimately different numbers - a bare
    # "N tunnel(s)" here was read as a discrepancy/bug ("status bar says 6,
    # list and 3D view show only 4"). Note the landed frame's real visible
    # count alongside it whenever the two differ.
    set _clustered_note ""
    if {[info exists state(tunnel_cluster_on)] && $state(tunnel_cluster_on)} {
        set _cand_cur [_tunnel_candidates $cur]
        if {[llength $_cand_cur] != [llength $tunnel_results($cur)]} {
            set _clustered_note [format " (%d shown after clustering on the landed frame)" \
                [llength $_cand_cur]]
        }
    }
    set state(status) [format "Tunnel: %d tunnel(s) over %d frame(s) in %.1fs (%s).%s Output: %s%s" \
        $ntot [llength $tunnel_result_frames] $_t_all $_eng_txt $_clustered_note $root $_loss_note]
    # A new tunnel run must invalidate the binned/heatmap caches the same way
    # refresh_results_list does for HOLE: those caches are keyed off
    # plot_data_version, which this proc never bumped before - a tunnel run at
    # the same version as the prior HOLE (or prior tunnel) run would silently
    # serve stale/foreign data to Over Time, Mean Profile, or Histogram the
    # first time they're opened in tunnel mode.
    variable plot_data_version
    variable binned_cache
    incr plot_data_version
    set binned_cache [dict create]
    catch {_sync_mode_tabs}
    catch {refresh_tunnel_tab}
    catch {_on_tunnel_selection_changed}
    catch {_sync_exportbars_for_data}
    # refresh_results_list is the sole writer of the bottom frame-list widget
    # and only ever read HOLE's result_frames/results - a tunnel run left it
    # showing whatever HOLE run (or nothing) came before, or empty after a
    # fresh import (activate_molecule wipes it on the way in).
    catch {refresh_results_list}
    set busy 0
    _end_calc
    } _res _opts]
    if {$_rc == 1} {
        set busy 0
        _end_calc
        return -options $_opts $_res
    }
    return $_res
}

proc ::VMDPathFinder::_blank_tunnels_for_frame {frame} {
    # Clear the tunnel track for a trajectory frame that was never searched, so
    # scrubbing past unanalysed frames shows nothing rather than the previous
    # frame's tunnels - the same honesty blank_surface_for_frame gives HOLE.
    variable state
    variable tunnel_surface_mols
    if {[catch {resolve_molid} molid]} { return }
    if {![info exists tunnel_surface_mols($molid)]} { return }
    set m $tunnel_surface_mols($molid)
    if {[catch {molinfo $m get name}]} { return }
    catch {graphics $m delete all}
    catch {mol rename $m "VMDPathFinder tunnels (frame $frame: not searched)"}
    # The property scale bar is drawn into its own mol by render_tunnels_for_
    # frame, so deleting the tunnel graphics does not touch it - it stayed on
    # screen over unsearched frames, labelling a coloring that was no longer
    # displayed. HOLE's blank_surface_for_frame already does this.
    catch {remove_hydro_scalebar}
}

proc ::VMDPathFinder::_tunnel_candidates {frame} {
    # The raw tunnel indices actually reachable this frame: every route with
    # clustering off, or one representative per cluster (widest bottleneck)
    # with it on - this is CAVER's one_tunnel_in_snapshot behaviour, and it
    # is what makes the display readable: routes inside a cluster are near-
    # duplicates by definition, so drawing/listing/selecting all of them is
    # both slower and less informative.
    #
    # THE shared source of truth for "which tunnel ids exist right now" -
    # render_tunnels_for_frame (what's drawn), refresh_tunnel_tab (what's
    # listed), _tunnel_toggle_all_shown, _tunnel_select_step and
    # on_tunnel_visibility_changed's all-shown recompute all consume it, so
    # that with clustering on, "select all" and the prev/next arrows can
    # never reach a tunnel id with no list row that is not actually drawn.
    variable state
    variable tunnel_results
    variable tunnel_clusters
    if {![info exists tunnel_results($frame)]} { return {} }
    # DERIVED from _tunnel_list_rows rather than re-deriving representatives
    # here, so the two can never independently disagree about which tunnel a
    # cluster's row represents.
    set candidates {}
    foreach row [_tunnel_list_rows $frame] { lappend candidates [lindex $row 0] }
    return [lsort -integer -unique $candidates]
}

proc ::VMDPathFinder::_tunnel_mesh_current {plot sph} {
    # Is this .plot still the mesh of this .sph? Geometry alone is not enough:
    # a re-run into the same output root (Overwrite off, headless, or a
    # temporary root - none of which clear tunnel_* dirs) rewrites the .sph in
    # place, so reusing on "has geometry" drew the PREVIOUS run's tube. Same
    # mtime rule the HOLE surface cache already uses.
    if {![surface_has_geometry $plot]} { return 0 }
    # Only PROVABLY stale counts: with no .sph there is nothing to rebuild
    # from, so the mesh on disk is the only thing that can be drawn.
    if {![file exists $sph]} { return 1 }
    return [expr {[file mtime $plot] >= [file mtime $sph]}]
}

proc ::VMDPathFinder::_tunnel_mesh_jobs {fd frame ids {tag ""}} {
    # run_shell_pool job list that meshes tunnel $ids of $frame (dir $fd): one
    # sph_process + sos_triangle pair per tunnel, each independent, so they
    # parallelise cleanly. Shared by render_tunnels_for_frame (meshing the
    # frame being shown) and run_tunnel_analysis (pre-meshing every frame in
    # one pool) so the two cannot drift in flags or file naming.
    # $tag only distinguishes job labels when several frames share one pool.
    # $frame is needed (not just derivable from $fd) to resolve each id's own
    # smoothing window (_tunnel_smooth_with) - a different cluster per id, so
    # each gets its own --with list rather than sharing one for the batch.
    variable state
    # Tunnels are thin tubes, not a pore lumen: the main surface's density
    # produced ~42k primitives EACH, 2.5M for one frame's clusters, which is
    # what made drawing and toggling slow. Capped well below it.
    # Dot density for the tunnel meshes: capped well below the pore surface's
    # own default (20) because tunnels are thin tubes, but not so low that
    # neighbouring spheres go unmerged and the tube renders as disconnected
    # blobs. 15 matches the pore surface's own non-manifold-edge fraction, the
    # cleanest a sos_triangle mesh gets. Exposed as its own tunable so the
    # cost/quality trade-off can be moved for a long trajectory without
    # touching code.
    set dd [_num_or tunnel_dot_density 15 1]
    if {![string is integer -strict $dd] || $dd < 1} { set dd 6 }
    set jobs {}
    foreach i $ids {
        set plot [_tunnel_plot $fd $i]
        set sph  [file join $fd [format "tunnel_%02d.sph" $i]]
        if {[_tunnel_mesh_current $plot $sph]} { continue }
        if {![file exists $sph]} { continue }
        lappend jobs [list "mesh $tag$i" \
            [list |sh -c [surface_mesh_cmd $sph $plot draw $dd 1 1 [_tunnel_smooth_with $frame $i]]]]
    }
    return $jobs
}

proc ::VMDPathFinder::render_tunnels_for_frame {frame {draft 0}} {
    # Draw every tunnel of one frame onto the tunnel track, one color each.
    # Uses the same .sph -> sph_process -> sos_triangle -> vmd_plot path as the
    # HOLE surface, so Color / Material / IsoSurface behave identically.
    variable state
    variable tunnel_results
    variable tunnel_root
    variable tunnel_shown
    variable tunnel_gear_color
    variable tunnel_gear_material
    variable tunnel_gear_wire
    variable tunnel_gear_prop
    if {![info exists tunnel_results($frame)]} { return }
    set molid [string trim $state(molid)]
    set m [ensure_tunnel_surface_mol $molid]
    catch {graphics $m delete all}
    set fd [file join $tunnel_root [format "tunnel_%05d" $frame]]

    # Which tunnels still need a mesh. Meshing is color-independent and the
    # geometry never changes for a given frame, so a .plot already on disk is
    # reused - that makes show/hide toggles and frame scrubbing instant instead
    # of re-running two binaries per tunnel every time.
    # With clustering on, draw ONE representative per cluster - the widest
    # bottleneck in it - rather than every route (see _tunnel_candidates).
    set candidates [_tunnel_candidates $frame]
    # Clusters the panel lists: a route hidden below the Seen floor is not
    # drawn either, or the picture and the list disagree.
    set _listed [expr {[info exists state(tunnel_cluster_on)] && $state(tunnel_cluster_on) \
        ? [_tunnel_visible_cids] : [dict create]}]
    # Draft (playback) keeps EVERY shown tunnel and thins each one instead of
    # drawing a subset, matching what HOLE's own draft does for its one
    # surface (_draft_render_frame draws every Nth triangle via
    # render_vmd_plot_to_mol's stride) - dropping tunnels instead would make
    # scrubbing cheap but show the wrong thing, since shown tunnels would
    # vanish while the frame moved.
    #
    # Its own knob rather than reusing state(draft_stride): HOLE thins ONE
    # surface, tunnel mode thins N of them, so the useful stride is larger.
    #
    # Defaults to 1 = OFF: decimating a THIN TUBE is not like decimating
    # HOLE's single large pore surface - dropping most triangles leaves
    # isolated facets floating rather than a coarser tube, and it buys little
    # once the meshes exist (the expensive part is the one-time mesh build,
    # not the draw). Kept as a knob for a pathological structure; >1 will
    # look sparse by design.
    set _stride 1
    if {$draft} {
        set _stride [_num_or tunnel_draft_stride 1 1]
        if {![string is integer -strict $_stride] || $_stride < 1} { set _stride 1 }
    }
    set want {}
    foreach i $candidates {
        # Resolve show/hide through the cross-frame cluster HERE, not only when
        # the list rebuilds: tunnel_shown is keyed by bare rank, and
        # frame_changed_settle (which refreshes the list) deliberately returns
        # early while playing, so during playback the checked tunnel must
        # still resolve to its cross-frame cluster rather than "whatever holds
        # that RANK in this frame". Idempotent: same source (tunnel_shown_cid)
        # as the row-build call, so the two cannot disagree.
        _tunnel_sync_shown_from_cluster $frame $i
        _tunnel_sync_gear_from_cluster $frame $i
        if {[_tunnel_hidden_by_list $frame $i $_listed]} { continue }
        if {[info exists tunnel_shown($i)] && !$tunnel_shown($i)} { continue }
        if {![file exists [file join $fd [format "tunnel_%02d.sph" $i]]]} { continue }
        lappend want $i
    }
    set todo {}
    foreach i $want {
        if {![_tunnel_mesh_current [_tunnel_plot $fd $i] \
                                   [file join $fd [format "tunnel_%02d.sph" $i]]]} {
            lappend todo $i
        }
    }

    # Meshing is one independent sph_process+sos_triangle pair per tunnel, so it
    # goes through the job pool rather than a serial loop - it dominates a
    # single-frame run (measured ~90% of wall time) and is otherwise the one
    # single-threaded stretch the user sees.
    # Marching-cubes tunnels go through the session's own mesher process, which
    # costs a pipe round trip each. Pooling them instead would spawn one process
    # per tunnel, and process creation from a loaded VMD is ~16 ms - more than
    # meshing a tunnel takes. Whatever it cannot serve falls through to the pool.
    set _todo_pool {}
    foreach i $todo {
        set _ok 0
        if {[_tunnel_wants_csg $i]} {
            set _ok [surface_mesh [file join $fd [format "tunnel_%02d.sph" $i]] [_tunnel_plot $fd $i] \
                draw "" 1 1 [_tunnel_smooth_with $frame $i]]
        }
        if {!$_ok} { lappend _todo_pool $i }
    }
    if {[llength $_todo_pool] > 1} {
        run_shell_pool [_tunnel_mesh_jobs $fd $frame $_todo_pool] [resolve_job_count] \
            "Meshing tunnels" "tunnel(s)"
    }

    # Anything the pool did not produce (or that was skipped above) is rebuilt
    # serially through run_sph_process, whose dot-budget retry the flat pool
    # command deliberately does not replicate.
    foreach i $want {
        set sph  [file join $fd [format "tunnel_%02d.sph" $i]]
        set plot [_tunnel_plot $fd $i]
        if {![_tunnel_mesh_current $plot $sph]} {
            if {![surface_mesh $sph $plot draw 6 1 1 [_tunnel_smooth_with $frame $i]]} { continue }
        }
        # Per-tunnel gear overrides (show_tunnel_gear_settings): material and
        # wireframe are orthogonal to color source and apply to EVERY branch
        # below (property-baked or flat); color only applies to the flat
        # fallback (_gcolor, used at the bottom of this loop) - a property-
        # colored plot's per-triangle colors already come from the cached
        # .plot file itself, which a solid force_color would simply overwrite.
        # A tunnel with no OWN material override falls back to the tunnel-mode
        # GLOBAL material (state(tunnel_display_material), set from the header
        # gear) - same trap _gwire below already guards against. Passing ""
        # would let render_vmd_plot_to_mol's own fallback read state(surface_
        # material), which is HOLE mode's unrelated material picker: every
        # un-overridden tunnel would silently follow whatever material HOLE
        # mode's surface happened to be set to.
        set _gmat [expr {[info exists tunnel_gear_material($i)] && $tunnel_gear_material($i) ne "" \
            ? $tunnel_gear_material($i) \
            : ([info exists state(tunnel_display_material)] && $state(tunnel_display_material) ne "" \
                ? $state(tunnel_display_material) : "Opaque")}]
        # A tunnel with no OWN wire override falls back to the tunnel-mode
        # GLOBAL representation (state(tunnel_display_mode), set from the
        # header gear), never "" - passing "" would let render_vmd_plot_to_
        # mol's own fallback read state(display_mode), which is HOLE mode's
        # unrelated setting: a user with the PORE surface set to wireframe
        # would silently get every un-overridden TUNNEL drawn as wireframe
        # too. This is the real, always-resolved default; per-tunnel
        # tunnel_gear_wire only needs to be set to DEVIATE from it.
        # Representation resolves to iso / wire / centerline (own override,
        # else global) - see _tunnel_effective_repr.
        set _repr [_tunnel_effective_repr $i]
        set _gwire [expr {$_repr eq "wire"}]
        # Mirrors HOLE's own state(surface_color): ONE explicit choice per
        # tunnel (auto rank color / a flat color / property), not an implicit
        # "property wins whenever it's globally on" rule - a tunnel with its
        # OWN colormode set to a flat color now stays that color even while
        # the global/other tunnels are property-colored, and vice versa.
        # _tunnel_effective_prop only matters once colormode says "property".
        set cmode [_tunnel_effective_colormode $i]
        set prop [_tunnel_effective_prop $i]
        # _gcolor MUST be derived from cmode (which already resolves per-
        # tunnel-override-or-global-default correctly), not re-read from
        # tunnel_gear_color($i) directly - that array is only ever set for a
        # tunnel with its OWN override, so reading it directly would leave a
        # GLOBAL flat color (state(tunnel_display_color) = a literal name, no
        # per-tunnel override anywhere) unresolved and fall back to auto rank
        # color instead.
        set _gcolor [expr {($cmode ni {auto property watermelon}) ? $cmode : ""}]
        # esp has no per-residue value to bake, only per-point ones - it always
        # takes the sphere-interpolated path below, whatever the 3D switch says.
        set use3d [expr {[info exists state(tunnel_hydro3d_accurate)] \
            && $state(tunnel_hydro3d_accurate) && [sos_triangle_has_feature hydro3d] \
            && $prop ne "esp"}]
        # Centerline representation draws the path and NOTHING else. It is a
        # different way of drawing the tunnel, not an overlay, so the surface
        # is skipped rather than drawn underneath - that is what makes it a
        # peer of Isosurface/Wireframe instead of a checkbox layered on them.
        if {$_repr eq "centerline"} {
            set _clc [expr {$_gcolor ne "" ? $_gcolor \
                : [_tunnel_color [_tunnel_palette_index $frame $i]]}]
            catch {render_sph_points_to_mol $sph $m $_clc 0.25}
            continue
        }
        set done 0
        if {$cmode eq "property" && $prop ne "none" && $prop ne ""} {
            # The filename encodes a cache-format version (_v2/_3d) rather than
            # just the property token: a coloring-logic change does not touch
            # $plot's geometry or mtime, so the mtime check below cannot by
            # itself detect a stale cache from an older encoding, and
            # tunnel_root can persist across runs (state(work_dir),
            # save_results, or the same VMD process). The axial and true-3D
            # paths get their OWN cache files (not a shared $cplot with a
            # suffix picked by $use3d): if the 3D attempt below fails and
            # falls back to axial, the result must not be written under the
            # 3D-suffixed name, or a later render with use3d still on would
            # find it, pass its mtime-reuse check, and display stale axial
            # data mislabeled as true-3D.
            set cplot3d [file join $fd [format "tunnel_%02d_%s_3d_v1.plot" $i $prop]]
            set cplot2d [file join $fd [format "tunnel_%02d_%s_v2.plot" $i $prop]]
            # colorize_by_sphere_values is pure Tcl (no C fallback), and the
            # caller (render_tunnels_for_frame) always re-runs this for every
            # SHOWN tunnel regardless of which one triggered the redraw
            # (e.g. a plain show/hide toggle) - so it gets the same
            # reuse-if-still-valid check meshing already gets a few lines up:
            # a colorized plot the base mesh has not outrun is exactly as
            # reusable as the mesh itself.
            if {$use3d && [surface_has_geometry $cplot3d] \
                    && [file mtime $cplot3d] >= [file mtime $plot]} {
                catch {render_vmd_plot_to_mol $cplot3d $m $_stride "" "" $_gmat 0 $_gwire}
                set done 1
            } elseif {$use3d} {
                set rfile [file join $fd [format "tunnel_%02d_%s_hydro3d.txt" $i $prop]]
                if {![catch {write_tunnel_hydro3d_residue_sidecar $molid $frame [list $i] $rfile $prop $sph}]} {
                    lassign [_tunnel_property_range $frame $prop] plo phi
                    set psigned [dict get [property_meta $prop] signed]
                    if {![catch {run_sos_triangle_3d_recolor $plot $cplot3d $sph $rfile $psigned $plo $phi 0}] \
                            && [surface_has_geometry $cplot3d]} {
                        catch {render_vmd_plot_to_mol $cplot3d $m $_stride "" "" $_gmat 0 $_gwire}
                        set done 1
                    }
                }
                catch {file delete $rfile}
            }
            if {!$done && !$use3d && [surface_has_geometry $cplot2d] \
                    && [file mtime $cplot2d] >= [file mtime $plot]} {
                catch {render_vmd_plot_to_mol $cplot2d $m $_stride "" "" $_gmat 0 $_gwire}
                set done 1
            }
            if {!$done} {
                set sp [_tunnel_property_spheres $frame $i $prop]
                if {[llength $sp]} {
                    lassign [_tunnel_property_range $frame $prop] plo phi
                    # Was hardcoded 0 (always the unsigned white-yellow-orange-
                    # red palette) regardless of the property - so a genuinely
                    # diverging one (hydropathy, hydrophobicity, charge) drew
                    # in the wrong palette family entirely, while Fill (hydro_
                    # hex, below) correctly looked this up per property. That
                    # was the dominant cause of "very different colors in
                    # Fill and the isosurface" - not merely the along-path
                    # step-function coarseness this same function's own
                    # comment documents. (Also the fallback when use3d's own
                    # sidecar/recolor attempt above fails, e.g. no lining -
                    # written to cplot2d even though use3d is on, so it is
                    # recomputed every time rather than mistaken for a valid
                    # true-3D cache entry.)
                    set psigned [dict get [property_meta $prop] signed]
                    # C first: colorize_by_sphere_values is pure Tcl and cost
                    # ~75 ms per tunnel on a 2000-triangle mesh, paid on the
                    # FIRST visit to every (tunnel, property, frame) - which is
                    # once per shown tunnel per frame during playback, and the
                    # single reason changing a property, playing a trajectory
                    # and Show-all were all slow. Same threaded --recolor pass
                    # the main HOLE surface and the Mean Profile tube already
                    # use; the Tcl path stays as the fallback.
                    set _cdone 0
                    if {[fast_available values]} {
                        set _vf [file join $fd [format "tunnel_%02d_%s_values.dat" $i $prop]]
                        if {![catch {
                            set _vals [_tunnel_property_values $frame $i $prop]
                            if {[llength $_vals] == 0} { error "no aligned values" }
                            set _vfh [open $_vf w]
                            foreach _v $_vals { puts $_vfh [format "%.6f" $_v] }
                            close $_vfh
                            run_sos_triangle_values_recolor $plot $cplot2d $sph $_vf $psigned $plo $phi
                        }] && [surface_has_geometry $cplot2d]} {
                            catch {render_vmd_plot_to_mol $cplot2d $m $_stride "" "" $_gmat 0 $_gwire}
                            set done 1; set _cdone 1
                        }
                        catch {file delete $_vf}
                    }
                    if {!$_cdone && ![catch {colorize_by_sphere_values $plot $cplot2d $sp $psigned $plo $phi}]} {
                        catch {render_vmd_plot_to_mol $cplot2d $m $_stride "" "" $_gmat 0 $_gwire}
                        set done 1
                    }
                }
            }
        }
        if {!$done && $cmode eq "watermelon"} {
            set _wm [_watermelon_plot $sph $plot 1 0 0]
            if {$_wm ne ""} {
                catch {render_vmd_plot_to_mol $_wm $m $_stride "" watermelon $_gmat 0 $_gwire}
                set done 1
            }
        }
        if {!$done} {
            set _flatcolor [expr {$_gcolor ne "" ? $_gcolor \
                : [_tunnel_color [_tunnel_palette_index $frame $i]]}]
            catch {render_vmd_plot_to_mol $plot $m $_stride $_flatcolor "" $_gmat 0 $_gwire}
        }
    }
    foreach f [glob -nocomplain -directory $fd "mesh_*.sh"] { catch {file delete $f} }
    catch {_update_surface_vis_buttons}

    # 3D scale bar: same single global bar HOLE mode and Mean Profile already
    # share (draw_hydro_scalebar takes scheme as an explicit override for
    # exactly this reason), matching Fill's legend since both read _tunnel_
    # property_range for the same property. With per-tunnel property overrides
    # there is no longer one property for the whole frame, so this
    # shows the SELECTED tunnel's own effective property - the one tunnel a
    # user is actually looking at in Pore Profile/Trends/Lining too.
    # Drawn once per prop/visibility change, not every redraw, for the same
    # reason HOLE mode's own call site gives (draw_hydro_scalebar does
    # resetview - redoing it every frame during playback would flicker).
    variable hydro_scalebar_mol
    variable hydro_scalebar_scheme
    # Recomputed rather than reused from the per-tunnel loop above: that loop's
    # $prop does not survive an empty $want (every tunnel hidden).
    set _sb_prop [_tunnel_scalebar_prop]
    if {$_sb_prop ne "none" && $_sb_prop ne ""} {
        set need_scalebar [expr {
            [info exists state(show_hydro_scalebar)] && $state(show_hydro_scalebar) && (
                $hydro_scalebar_mol < 0 ||
                [catch {molinfo $hydro_scalebar_mol get name}] ||
                $hydro_scalebar_scheme ne $_sb_prop
            )
        }]
        if {$need_scalebar} { catch {draw_hydro_scalebar "tunnel" $_sb_prop} }
    } else {
        remove_hydro_scalebar
    }
    # Cavities ride on the same track (the `graphics $m delete all` above
    # cleared them with the tunnels), so a frame change redraws the ticked
    # ones for the NEW frame here. Cavity ids are per-frame ranks - MOLE
    # recomputes them independently each frame - so a tick means "cavity N
    # of whichever frame is shown".
    catch {_render_cavities_for_frame $frame}
}

# Per-triangle color for a tunnel, from its MOLE lining properties.
#
# MOLE reports a property per LAYER - a distance RANGE along the centreline.
# Each profile point's value is linearly interpolated between the two nearest
# layer MIDPOINTS (clamped to the first/last layer's value beyond the ends),
# rather than a flat per-layer step - a step function drew as big, uniform,
# hard-edged blocks along the tube where Fill (which plots the same property
# at the same arc-length resolution) shows a smooth curve, which read as the
# 3D view and Fill disagreeing even though they share the same data and the
# same color bands (see the signed-flag fix at render_tunnels_for_frame's
# call to colorize_by_sphere_values - that was the bigger part of the
# mismatch; this closes the rest of it). Reusing colorize_by_sphere_values's
# nearest-sphere lookup for the actual 3D placement is unchanged - only the
# VALUE assigned to each point changes here.
#
# Returns {} when there is no lining for this tunnel, which is what the caller
# treats as "fall back to the flat per-tunnel color".
proc ::VMDPathFinder::_tunnel_property_values {frame id prop} {
    # The same per-sphere property values _tunnel_property_spheres carries, but
    # in the order the tunnel's .sph file is WRITTEN in, which is what the C
    # recolor indexes by.
    #
    # Those two orders are NOT the same list: the .sph comes from
    # _tunnel_render_centers, which trims runaway terminal spheres off each
    # end, while _tunnel_property_spheres returns one entry per point of the
    # FULL profile. Feeding the untrimmed values to the binary would shift
    # every color along the tube by however many spheres were trimmed.
    # _tunnel_render_centers already reports the surviving index range through
    # its spanvar (the Mean Profile tube relies on the same thing), so the two
    # are derived from one source and cannot drift.
    variable tunnel_results
    if {![info exists tunnel_results($frame)]} { return {} }
    set sp [_tunnel_property_spheres $frame $id $prop]
    if {[llength $sp] == 0} { return {} }
    set pts [lindex [lindex $tunnel_results($frame) [expr {$id-1}]] 4]
    set centers [_tunnel_render_centers $pts _span]
    lassign $_span lo hi
    if {$lo eq "" || $hi eq "" || $hi < $lo} { return {} }
    set out {}
    foreach s [lrange $sp $lo $hi] { lappend out [lindex $s 4] }
    # A length mismatch here means the two derivations have diverged; coloring
    # on it would silently misalign the tube, so refuse and let the caller fall
    # back to the Tcl path.
    if {[llength $out] != [llength $centers]} { return {} }
    return $out
}

proc ::VMDPathFinder::_tunnel_esp_spheres {frame id pts} {
    # {x y z r esp} per route point: the in-vacuo Coulomb potential of the
    # structure's formal charges (HOLE's helefi model, the same charge set the
    # pore-mode ESP readout and overlay use) evaluated AT each point through
    # sos_triangle --esp-points. Memoised per (frame, tunnel): the kernel call
    # is cheap but this is re-read on every redraw of a shown tunnel.
    variable state
    variable _tunnel_esp_cache
    set molid ""; catch {set molid [resolve_molid]}
    if {$molid eq ""} { return {} }
    set key "$molid|$frame|$id|[llength $pts]"
    if {[info exists _tunnel_esp_cache($key)]} { return $_tunnel_esp_cache($key) }
    set q [_esp_formal_charges $molid $frame]
    if {$q eq ""} { return {} }
    lassign $q qx qy qz qc
    set centers {}
    foreach {x y z r} $pts { lappend centers [list $x $y $z $r] }
    set base [file join [_scratch_base] "tesp_[pid]_[clock clicks]"]
    set sph "$base.sph"; set ov "$base.esp"
    if {[catch {write_stock_sph_file $centers $sph}]} { return {} }
    set out {}
    if {[_esp_points_c $sph $qx $qy $qz $qc $ov] && ![catch {open $ov r} fh]} {
        set vals [split [string trim [read $fh]] "\n"]; close $fh
        if {[llength $vals] == [llength $centers]} {
            foreach c $centers v $vals {
                set v [string trim $v]
                if {![string is double -strict $v]} { set v 0.0 }
                lappend out [concat $c [list $v]]
            }
        }
    }
    catch {file delete $sph}; catch {file delete $ov}
    if {[llength $out]} { set _tunnel_esp_cache($key) $out }
    return $out
}

proc ::VMDPathFinder::_tunnel_property_spheres {frame id prop} {
    variable tunnel_results
    variable tunnel_lining
    if {![info exists tunnel_lining($frame)]
        || ![info exists tunnel_results($frame)]} { return {} }
    set lin $tunnel_lining($frame)
    if {![dict exists $lin $id.layers]} { return {} }
    set layers [dict get $lin $id.layers]
    set pts [lindex [lindex $tunnel_results($frame) [expr {$id-1}]] 4]
    if {[llength $pts] < 8} { return {} }
    if {$prop eq "esp"} { return [_tunnel_esp_spheres $frame $id $pts] }
    # Anchors: one (midpoint, value) pair per layer, in the layers' own order
    # (already arc-length ordered, same as the layer list everywhere else in
    # this file is walked).
    set mids {}
    set vals {}
    # MOLE's own columns come straight out of out.dat; a HOLE scale is not in
    # there and is averaged from the layer's residue list instead.
    set _isscale [expr {$prop in [_tunnel_scale_tokens]}]
    foreach ly $layers {
        if {$_isscale} {
            set _v [_tunnel_layer_scale $ly $prop]
        } elseif {[dict exists $ly $prop]} {
            set _v [dict get $ly $prop]
        } else {
            set _v ""
        }
        # A layer with no lining residues has no value; carry 0.0 rather than
        # aborting the whole tunnel, matching how an absent MOLE column reads.
        if {![string is double -strict $_v]} { set _v 0.0 }
        lappend mids [expr {0.5 * ([dict get $ly start] + [dict get $ly end])}]
        lappend vals $_v
    }
    set nly [llength $mids]
    set out {}
    set d 0.0
    set px ""; set py ""; set pz ""
    foreach {x y z r} $pts {
        if {$px ne ""} {
            set d [expr {$d + sqrt(($x-$px)*($x-$px) + ($y-$py)*($y-$py)
                                   + ($z-$pz)*($z-$pz))}]
        }
        set px $x; set py $y; set pz $z
        # Walk to the first anchor at or past d (small nly - a handful of
        # layers per tunnel - so a linear scan costs nothing next to the
        # sqrt just above).
        set j 0
        while {$j < $nly && [lindex $mids $j] < $d} { incr j }
        if {$j == 0} {
            set v [lindex $vals 0]
        } elseif {$j >= $nly} {
            set v [lindex $vals end]
        } else {
            set m0 [lindex $mids [expr {$j-1}]]; set m1 [lindex $mids $j]
            set v0 [lindex $vals [expr {$j-1}]]; set v1 [lindex $vals $j]
            set f [expr {($m1 == $m0) ? 0.5 : ($d - $m0) / double($m1 - $m0)}]
            set v [expr {$v0 + $f * ($v1 - $v0)}]
        }
        lappend out [list $x $y $z $r $v]
    }
    return $out
}

# True per-triangle tunnel coloring source: one "x y z value" row per
# DISTINCT lining residue (deduplicated across every layer/tunnel it
# occurs in), for the given tunnel id(s) of one frame. Position is that
# residue's own atom-selection centroid (measure center, UNWEIGHTED - not a
# centre of mass) in THIS frame; value is
# mole_residue_property's raw per-residue lookup (MOLE's own 20-residue
# table, mole_lining.c:34-54) - NOT the layer's length-weighted aggregate
# that Fill/the axial path read from the L record. One row per residue, not
# per layer: a residue lining several layers has one (x,y,z), so one row per
# layer would carry several different, contradictory values at the identical
# point for run_sos_triangle_3d_recolor's nearest-point kernel to arbitrarily
# resolve. This intentionally drops mole_lining.c's per-sample
# side-chain-vs-backbone-touched split (see its own header comment) -
# matching the level of approximation pore mode's own accurate-3D
# fallback (write_hydro3d_residue_sidecar) already uses: a flat per-
# residue table lookup, not a per-sample reclassification.
proc ::VMDPathFinder::write_tunnel_hydro3d_residue_sidecar {molid frame tunnel_ids out_file prop {cl_sph ""}} {
    # cl_sph: the tunnel's own centreline .sph. Present only so the "Pore facing"
    # filter can be applied here the way the C binary applies it for a pore -
    # keep a residue only when its centroid is closer to the channel than its CA.
    # That checkbox lives in the shared Scale/Cutoff dialog and is not gated by
    # mode, so before this it was visible in tunnel mode and did nothing.
    # Skipped for kr, which is atom-level and has no residue centroid to test.
    variable tunnel_lining
    variable state
    if {![info exists tunnel_lining($frame)]} { error "no tunnel lining for this frame" }
    set lin $tunnel_lining($frame)
    set _face [expr {$prop ne "kr" && $cl_sph ne "" && [file exists $cl_sph]
                     && [info exists state(hydro_facing)] && $state(hydro_facing)}]
    set _cc {}
    if {$_face} {
        if {![catch {open $cl_sph r} _fh]} {
            while {[gets $_fh _l] >= 0} {
                if {![string match {ATOM  *} $_l] && ![string match {HETATM*} $_l]} continue
                set _x [string trim [string range $_l 30 37]]
                set _y [string trim [string range $_l 38 45]]
                set _z [string trim [string range $_l 46 53]]
                if {[string is double -strict $_x]} { lappend _cc [list $_x $_y $_z] }
            }
            catch {close $_fh}
        }
        if {![llength $_cc]} { set _face 0 }
    }
    set com_cache [dict create]
    set seen [dict create]
    set out [open $out_file w]
    set n_written 0
    foreach id $tunnel_ids {
        if {![dict exists $lin $id.layers]} { continue }
        foreach ly [dict get $lin $id.layers] {
            foreach r [dict get $ly residues] {
                set resid [dict get $r resid]
                set chain [dict get $r chain]
                set key "$chain|$resid"
                if {[dict exists $seen $key]} { continue }
                dict set seen $key 1
                if {![dict exists $com_cache $key]} {
                    set seltext [expr {$chain ne "" \
                        ? "resid $resid and chain \"$chain\"" : "resid $resid"}]
                    if {[catch {atomselect $molid $seltext frame $frame} sel]} { continue }
                    if {[$sel num] == 0} { $sel delete; continue }
                    set pos [$sel get {x y z}]
                    set _canm [$sel get name]
                    $sel delete
                    set _ca ""
                    foreach _p $pos _n $_canm { if {$_n eq "CA"} { set _ca $_p; break } }
                    set sx 0.0; set sy 0.0; set sz 0.0
                    set n [llength $pos]
                    foreach p $pos {
                        lassign $p px py pz
                        set sx [expr {$sx+$px}]; set sy [expr {$sy+$py}]; set sz [expr {$sz+$pz}]
                    }
                    dict set com_cache $key \
                        [list [expr {$sx/double($n)}] [expr {$sy/double($n)}] [expr {$sz/double($n)}] $_ca]
                }
                if {![dict exists $com_cache $key]} { continue }
                lassign [dict get $com_cache $key] cx cy cz _cap
                if {$_face && $_cap ne ""} {
                    lassign $_cap _ax _ay _az
                    set _dc 1e300; set _da 1e300
                    foreach _c $_cc {
                        lassign $_c _px _py _pz
                        set _d [expr {($_px-$cx)*($_px-$cx)+($_py-$cy)*($_py-$cy)+($_pz-$cz)*($_pz-$cz)}]
                        if {$_d < $_dc} { set _dc $_d }
                        set _d [expr {($_px-$_ax)*($_px-$_ax)+($_py-$_ay)*($_py-$_ay)+($_pz-$_az)*($_pz-$_az)}]
                        if {$_d < $_da} { set _da $_d }
                    }
                    if {$_dc >= $_da} { continue }
                }
                set val [_lining_residue_value $prop [dict get $r resname]]
                puts $out [format "%.4f %.4f %.4f %.6f" $cx $cy $cz $val]
                incr n_written
            }
        }
    }
    close $out
    if {$n_written == 0} { error "no lining residues resolved to atoms" }
    return $n_written
}

# Scale bounds for a lining property, shared by every tunnel of the frame so
# two tunnels in one view are comparable (and so Fill and the 3D isosurface,
# which both call this, always agree).
proc ::VMDPathFinder::_tunnel_property_range {frame prop} {
    # Fixed theoretical bounds for the length-weighted AVERAGES (hydropathy,
    # hydrophobicity, logp, logd, logs, mutability), matching HOLE mode's own
    # convention (property_meta) rather than a per-frame data range - a scale
    # should read the same regardless of which frame or how much of the
    # structure is in view. charge and ionizable are excluded on purpose:
    # mole_lining.c sums them over every lining residue with no division by
    # count (count_block), so they legitimately grow with how many residues
    # line a stretch - a fixed bound would clip a real high-count tunnel to
    # whatever ceiling was picked. Those two keep the data-derived range below.
    # polarity is the one token whose NAME is shared with a DIFFERENT scale:
    # property_meta's is Grantham (4.9..13.0), tunnel mode's values come from
    # MOLE's own table (0..52). Normalising one by the other put all 20 standard
    # residues outside the range - 5 pinned to the top, 15 to the bottom - so the
    # gradient collapsed to two colours. _tunnel_prop_label already calls this
    # "MOLE polarity"; only the bounds were still Grantham's.
    if {$prop eq "polarity"} { return [list 0.0 52.0] }
    if {$prop eq "esp"} {
        # Same adaptive per-frame spread pore mode's ESP colouring uses
        # (_esp_percentile_range): the fixed property_meta scale clips nearly
        # every real value to one end. Pooled over every tunnel of the frame,
        # so two shown tunnels read on one scale.
        variable tunnel_results
        set vals {}
        if {[info exists tunnel_results($frame)]} {
            set _n [llength $tunnel_results($frame)]
            for {set _i 1} {$_i <= $_n} {incr _i} {
                foreach e [_tunnel_property_spheres $frame $_i esp] { lappend vals [lindex $e 4] }
            }
        }
        set _er [_esp_percentile_range $vals]
        if {$_er ne "" && [llength $_er] == 2} { return $_er }
        set m [property_meta esp]
        return [list [dict get $m lo] [dict get $m hi]]
    }
    if {$prop ni {charge ionizable}} {
        set m [property_meta $prop]
        if {[dict exists $m lo] && [dict exists $m hi]} {
            return [list [dict get $m lo] [dict get $m hi]]
        }
    }
    variable tunnel_lining
    set lo 1e300; set hi -1e300
    if {[info exists tunnel_lining($frame)]} {
        set lin $tunnel_lining($frame)
        foreach k [dict keys $lin] {
            if {![string match "*.layers" $k]} continue
            foreach ly [dict get $lin $k] {
                set v [dict get $ly $prop]
                if {$v < $lo} { set lo $v }
                if {$v > $hi} { set hi $v }
            }
        }
    }
    if {$lo > $hi} { return {0.0 1.0} }
    if {$lo == $hi} { set hi [expr {$lo + 1.0}] }
    return [list $lo $hi]
}

proc ::VMDPathFinder::_tunnel_property_range_pooled {prop} {
    # _tunnel_property_range is deliberately per-frame (charge/ionizable are
    # data-derived), so every TRAJECTORY-WIDE view - Mean Profile's Fill, its
    # averaged tube, Over Time's property heatmap - has to pool it or the same
    # property reads on a different scale in each. Returns {lo hi}, or "" when
    # no frame yielded a range (caller falls back to its own default).
    variable tunnel_result_frames
    set lo 1e300; set hi -1e300
    foreach frm $tunnel_result_frames {
        lassign [_tunnel_property_range $frm $prop] flo fhi
        if {$flo < $lo} { set lo $flo }
        if {$fhi > $hi} { set hi $fhi }
    }
    if {$lo > $hi} { return "" }
    return [list $lo $hi]
}

proc ::VMDPathFinder::build_run_panel {parent} {
    variable _runpanel
    variable _mem_row
    set _runpanel $parent
    set row 0

    # ---- Memory: several spherical pores held and drawn at once ----
    # One structure can have five channels; this keeps five analyses alive side
    # by side instead of each run replacing the last. Spherical only - Connolly
    # and Capsule build a different kind of surface and Tunnel keeps its own
    # result store, so the row hides itself outside spherical rather than
    # offering slots that cannot hold what those modes produce.
    frame $parent.mem
    label $parent.mem.l -text "Memory" -font {Helvetica 9 bold}
    frame $parent.mem.slots
    button $parent.mem.sync -text "Sync" -padx 4 -pady 0 \
        -command ::VMDPathFinder::_mem_sync_clicked
    button $parent.mem.del -text "\u2715" -padx 3 -pady 0 \
        -command ::VMDPathFinder::_mem_delete_clicked
    pack $parent.mem.l     -side left
    pack $parent.mem.slots -side left -padx {6 0}
    pack $parent.mem.del   -side right
    pack $parent.mem.sync  -side right -padx {0 3}
    set _mem_row $parent.mem
    add_tooltip $parent.mem.l "Each memory is one complete pore analysis - its own start point, direction, selection and results - drawn alongside the others. Click a number to go back to it."
    add_tooltip $parent.mem.sync "Copy this memory's colour, material and dot density to every other\
        memory and redraw them, so all the pores on screen read as one picture."
    add_tooltip $parent.mem.del "Delete the current memory and its surface. The last memory cannot be deleted."

    # ---- HOLE parameters: what the pore search is run on (through CVECT below);
    # the "Graphics" header further down separates these from the render controls.
    # Gear opens the extra HOLE input cards (ENDRAD/SAMPLE/SHORTO/...) + Appearance -
    # moved here from the Settings dialog so it sits where the user actually asked
    # for it, right on this header, not buried in the general prefs. ----
    frame $parent.hp_hdr
    label $parent.hp_hdr.l -text "HOLE parameters" -font {Helvetica 9 bold}
    button $parent.hp_hdr.gear -text "⚙" -width 2 -relief flat \
        -command ::VMDPathFinder::show_hole_params_settings
    pack $parent.hp_hdr.l -side left
    pack $parent.hp_hdr.gear -side left -padx {4 0}
    grid $parent.hp_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {2 2}
    incr row
    add_tooltip $parent.hp_hdr.gear "Extra HOLE input cards: ENDRAD, SAMPLE, dot density, SHORTO, seed,\
        IGNORE, Monte Carlo search, pore method - plus Trim, Hide spill, Rename and ionic-radii fallback."

    label $parent.molid_l -text "Molecule"
    entry $parent.molid_e -textvariable ::VMDPathFinder::state(molid) -width 12
    button $parent.molid_b -text "Use Top" -command ::VMDPathFinder::sync_top_defaults
    # Switch the live view when the molecule is committed (Enter / focus-out),
    # so each molecule keeps its own results and surface track.
    bind $parent.molid_e <Return>   ::VMDPathFinder::on_molid_changed
    bind $parent.molid_e <FocusOut> ::VMDPathFinder::on_molid_changed
    grid $parent.molid_l -row $row -column 0 -sticky w  -padx 8 -pady 2
    grid $parent.molid_e -row $row -column 1 -sticky ew -padx 8 -pady 2
    grid $parent.molid_b -row $row -column 2 -sticky ew -padx 8 -pady 2
    add_tooltip $parent.molid_b "Set Molecule to VMD's current top molecule."
    incr row

    label $parent.frame_l    -text "Frames"
    entry $parent.frame_e    -textvariable ::VMDPathFinder::state(frame_spec) -width 14
    # Two one-click shortcuts for the most common cases (a greyed syntax hint
    # like "now, all, 0:10, 0:2:20" showed the format but couldn't set it for
    # you). Custom ranges (0:10, 0:2:20) still just get
    # typed into the entry directly - explained in its own tooltip.
    frame $parent.frame_hint
    button $parent.frame_hint.all -text "All" \
        -command {set ::VMDPathFinder::state(frame_spec) all}
    button $parent.frame_hint.now -text "Now" \
        -command {set ::VMDPathFinder::state(frame_spec) now}
    pack $parent.frame_hint.all -side left -fill x -expand 1
    pack $parent.frame_hint.now -side left -padx {4 0} -fill x -expand 1
    grid $parent.frame_l    -row $row -column 0 -sticky w  -padx 8 -pady 2
    grid $parent.frame_e    -row $row -column 1 -sticky ew -padx 8 -pady 2
    grid $parent.frame_hint -row $row -column 2 -sticky ew -padx 8 -pady 2
    add_tooltip $parent.frame_e "Which frames to run HOLE on: now, all, or a range like 0:10 or 0:2:20."
    add_tooltip $parent.frame_hint.all "Analyze every frame."
    add_tooltip $parent.frame_hint.now "Analyze only the current frame."
    incr row

    label  $parent.sel_l   -text "Selection"
    entry  $parent.sel_e   -textvariable ::VMDPathFinder::state(selection) -width 22
    button $parent.align_b -text "Align traj" -command ::VMDPathFinder::show_align_dialog
    grid $parent.sel_l    -row $row -column 0 -sticky w  -padx 8 -pady 2
    grid $parent.sel_e    -row $row -column 1 -sticky ew -padx 8 -pady 2
    grid $parent.align_b  -row $row -column 2 -sticky ew -padx 8 -pady 2
    add_tooltip $parent.sel_e "Atom selection HOLE analyzes, e.g. protein."
    add_tooltip $parent.align_b "Align every kept frame onto a reference frame before running HOLE."
    incr row

    label $parent.cp_l -text "CPOINT"
    entry $parent.cp_e -textvariable ::VMDPathFinder::state(cpoint) -width 14
    # Two independent ways to fill CPOINT:
    #   COG  centre of GEOMETRY of the analysis Selection - measure center with
    #        no mass weighting. Labelled COM, which was simply wrong.
    #   COR  VMD's current Center Of Rotation (molinfo ... get center - set by
    #        Mouse > Center click, "Display > Reset View", or a manual molinfo set).
    frame $parent.cp_box
    # The stick sits first and tight; COG/COR share whatever width is left.
    button $parent.cp_box.stk -text "⌖" -font {Helvetica 14} -padx 1 -pady 0 -relief flat \
        -command [list ::VMDPathFinder::show_axis_stick_dialog cpoint]
    button $parent.cp_box.com -text "COG" -command ::VMDPathFinder::use_selection_center
    button $parent.cp_box.cor -text "COR" -command ::VMDPathFinder::use_view_center
    pack $parent.cp_box.stk -side left
    pack $parent.cp_box.com -side left -padx {4 0} -fill x -expand 1
    pack $parent.cp_box.cor -side left -padx {4 0} -fill x -expand 1
    grid $parent.cp_l   -row $row -column 0 -sticky w  -padx 8 -pady 2
    grid $parent.cp_e   -row $row -column 1 -sticky ew -padx 8 -pady 2
    grid $parent.cp_box -row $row -column 2 -sticky ew -padx 8 -pady 2
    incr row

    add_tooltip $parent.cp_box.com "Fill with the centre of geometry of the selection typed here. Blank\
        uses the main Selection."
    add_tooltip $parent.cp_box.cor "Fill CPOINT with VMD's current center of rotation."
    add_tooltip $parent.cp_box.stk "Move CPOINT with an on-screen stick or step buttons, relative to the\
        current view."

    # Per-frame CPOINT handling (Stabilize/Track and their scope fields) lives in
    # the stick dialog only - the panel row duplicated it.

    label $parent.cv_l  -text "CVECT"
    entry $parent.cv_e  -textvariable ::VMDPathFinder::state(cvect) -width 14
    frame  $parent.cv_box
    button $parent.cv_box.stk -text "⌖" -font {Helvetica 14} -padx 1 -pady 0 -relief flat \
        -command [list ::VMDPathFinder::show_axis_stick_dialog cvect]
    pack $parent.cv_box.stk -side left
        grid $parent.cv_l   -row $row -column 0 -sticky w  -padx 8 -pady 2
    grid $parent.cv_e   -row $row -column 1 -sticky ew -padx 8 -pady 2
    grid $parent.cv_box -row $row -column 2 -sticky ew -padx 8 -pady 2
    add_tooltip $parent.cv_box.stk "Set CVECT from two points: pick Point 1 or Point 2, then place it with an on-screen stick or step buttons, relative to the current view."
    incr row

    # (Align traj… button now lives on the Selection row, near the selection it fits.)
    # Any change to CVECT (manual edit, Z-axis, guess) drops a stale two-point
    # definition; the two-point dialog re-sets it immediately afterwards.
    _trace_once ::VMDPathFinder::state(cvect) write ::VMDPathFinder::_clear_cvect_def
    _trace_once ::VMDPathFinder::state(cpoint) write [list ::VMDPathFinder::_sync_point_marker cpoint show_cpoint_marker]
    _trace_once ::VMDPathFinder::state(show_cpoint_marker) write [list ::VMDPathFinder::_sync_point_marker cpoint show_cpoint_marker]

    # ---- Graphics header: everything above computes the pore (HOLE parameters);
    # everything below is HOW to render it. (Output directory moved to
    # File > Settings > Output & Files.) ----
    label $parent.gfx_hdr -text "Graphics" -font {Helvetica 9 bold}
    grid $parent.gfx_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {8 2}
    incr row

    # Display + Material share ONE row, Display FIRST then Material (per
    # user) - both are "how to render" choices, independent of coloring.
    # Children of mc_box; kept as one frame/row so a resize can't split them.
    frame $parent.mc_box
    # Display: narrower custom menubutton (friendly labels; "triangulated" is
    # still the underlying persisted value everywhere else - see
    # display_mode_display_label) instead of tk_optionMenu's wide auto-sized
    # button, so it fits on the same line as Material without widening the panel.
    label $parent.mc_box.dl -text "Display"
    menubutton $parent.mc_box.dm -textvariable ::VMDPathFinder::state(display_mode_disp) \
        -menu $parent.mc_box.dm.m -relief raised -indicatoron 1 -width 9
    menu $parent.mc_box.dm.m -tearoff 0
    foreach {_dmval _dmlabel} {
        none none  centerline centerline  dots dots  wireframe wireframe
        triangulated isosurface
    } {
        $parent.mc_box.dm.m add radiobutton -label $_dmlabel -value $_dmval \
            -variable ::VMDPathFinder::state(display_mode)
    }
    _trace_once ::VMDPathFinder::state(display_mode) write ::VMDPathFinder::_sync_display_mode_disp
    label $parent.mc_box.ml -text "Material"
    set mats {Opaque Transparent BrushedMetal GlassBubble Glass1 Glass2 Glass3 \
              Glossy Diffuse Ghost AOChalky AOShiny AOEdgy BlownGlass RTChrome \
              MetallicPastel Steel Translucent Edgy EdgyShiny EdgyGlass}
    catch {set mats [material list]}
    if {[lsearch -exact $mats $::VMDPathFinder::state(surface_material)] < 0} {
        set ::VMDPathFinder::state(surface_material) [lindex $mats 0]
    }
    menubutton $parent.mc_box.mat -textvariable ::VMDPathFinder::state(surface_material) \
        -menu $parent.mc_box.mat.m -relief raised -indicatoron 1
    menu $parent.mc_box.mat.m -tearoff 0
    foreach _matval $mats {
        $parent.mc_box.mat.m add radiobutton -label $_matval -value $_matval \
            -variable ::VMDPathFinder::state(surface_material)
    }
    # Property-coloring thresholds (pore lining distance, hydrophobicity smoothing
    # bandwidth, pore-facing filter) - reached via this gear button, positioned as
    # the LAST button on the Display/Material row, after Material. Scale-bar
    # appearance lives behind the HOLE parameters header's own gear instead.
    button $parent.mc_box.gear -text "⚙️" -relief flat -padx 4 \
        -command ::VMDPathFinder::show_scale_cutoff_settings
    # Display, Material, then gear last.
    pack $parent.mc_box.dl   -side left
    pack $parent.mc_box.dm   -side left -padx {4 0}
    pack $parent.mc_box.ml   -side left -padx {12 0}
    pack $parent.mc_box.mat  -side left -padx {4 0}
    pack $parent.mc_box.gear -side left -padx {12 0}
    grid $parent.mc_box -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady 2
    add_tooltip $parent.mc_box.dm "How to draw the pore: none, centerline, dots, wireframe, or isosurface."
    add_tooltip $parent.mc_box.mat "VMD material applied to any drawn surface."
    add_tooltip $parent.mc_box.gear "Pore-lining distance, hydrophobicity smoothing, and the pore-facing filter."
    incr row

    # Color + Property share the NEXT row - both are "how to
    # color" choices, kept together and separate from the Display/Material
    # rendering row above. Color only matters for surface geometries, so its
    # widgets (cl + sc) are hidden within the row for centerline display;
    # Property only matters when Color is "property" - see
    # update_color_row_visibility. No outer row label (redundant with the
    # widgets' own inline labels, matching Display/Material above).
    frame $parent.hs_box
    label $parent.hs_box.cl -text "Color"
    # A scrolling combobox, not a menubutton+menu - 35 entries make a Tk menu
    # unpost the moment it reaches a screen edge (see _color_menu).
    # hole_def and property FIRST: they are the two data-driven modes (HOLE's
    # own radius banding, and color-by-property), not colors, so they lead
    # rather than being lost inside the color list. Values are shown lowercase
    # so "property" matches its siblings rather than standing out title-cased.
    _color_menu $parent.hs_box.sc ::VMDPathFinder::state(surface_color_disp) \
        [concat {hole_def property watermelon pore_lat pore_lobes} [_vmd_color_names]] \
        ::VMDPathFinder::_set_surface_color 12
    label $parent.hs_box.pl -text "Property"
    # Custom menubutton: stores raw key (kd/ww/…) in hydro_scheme, shows
    # hydro_scheme_disp (friendly name updated by _sync_scheme_disp trace).
    menubutton $parent.hs_box.m -textvariable ::VMDPathFinder::state(hydro_scheme_disp) \
        -menu $parent.hs_box.m.m -relief raised -indicatoron 1 -width 20
    menu $parent.hs_box.m.m -tearoff 0
    # Populated (and re-populated on hydration change) by refresh_property_scheme_menus:
    # lower-case labels, water schemes only when hydration data exists.
    _populate_scheme_menu $parent.hs_box.m.m hydro_scheme [_surface_scheme_choices]
    pack $parent.hs_box.cl  -side left
    pack $parent.hs_box.sc  -side left -padx {4 2}
    pack $parent.hs_box.pl  -side left
    pack $parent.hs_box.m   -side left -padx {4 0}
    grid $parent.hs_box -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady 2
    add_tooltip $parent.hs_box.sc "Color the pore surface by a fixed color, HOLE's own default, or a Property."
    add_tooltip $parent.hs_box.m "Which scale colours the surface and profile when Color is set to Property. Under Connolly the radius is the equivalent-area one, so values are not comparable with spherical mode."
    incr row

    # "Scale bar" and "Accurate 3D" moved OFF this row into the ⚙ Property Coloring
    # Settings popup (show_scale_cutoff_settings) to declutter the main panel - their
    # state vars (show_hydro_scalebar / hydro_3d_accurate) still drive the same
    # write-traces, so toggling them from the popup redraws exactly as before.

    # Visualize row: one exclusive choice (None / Lining / Facing), not two checkboxes - these
    # are geometric overlays, independent of the color scheme and of the Pore-facing ANALYSIS
    # setting (state(hydro_facing)), and always visible. Both use _lining_facing_sets (lining:
    # any atom within lining_dist_thresh of the pore surface; facing: lining AND the residue's
    # centroid closer to the centerline than its CA, a subset of lining). Drives the two
    # persistent Licorice/noh reps - see on_pore_lining_view_changed.
    frame $parent.showlining_box
    label $parent.showlining_box.l -text "Show nearby"
    # Menubutton displays a friendly label (pore_lining_view_disp) while the
    # real value (pore_lining_view: None/Lining/Facing) stays unchanged -
    # every read/compare site (on_pore_lining_view_changed etc.) keeps
    # working untouched. Same shadow-variable pattern as display_mode_disp.
    menubutton $parent.showlining_box.mb \
        -textvariable ::VMDPathFinder::state(pore_lining_view_disp) \
        -menu $parent.showlining_box.mb.m -relief raised -indicatoron 1 -width 10
    menu $parent.showlining_box.mb.m -tearoff 0
    foreach {_plv _pll} {None None  Lining "Pore lining"  Facing "Pore facing"} {
        $parent.showlining_box.mb.m add radiobutton -label $_pll -value $_plv \
            -variable ::VMDPathFinder::state(pore_lining_view)
    }
    # Margin rides on this row, to the RIGHT of "Show nearby": it qualifies the
    # CONNOLLY pore/lateral split that the openings list below reads, so it
    # reads immediately before that list.
    label $parent.showlining_box.mgl -text "Margin (Å)"
    entry $parent.showlining_box.mge -textvariable ::VMDPathFinder::state(conn_pore_margin) -width 5
    bind $parent.showlining_box.mge <Return>   {::VMDPathFinder::_commit_conn_margin}
    bind $parent.showlining_box.mge <FocusOut> {::VMDPathFinder::_commit_conn_margin}
    add_tooltip $parent.showlining_box.mge "How far past the traced pore wall still counts as pore, in Å. Raise it to pull sideways lobes back into the pore; lower it to split them off. Applies as soon as you click away."
    pack $parent.showlining_box.l -side left
    pack $parent.showlining_box.mb -side left -padx {4 0}
    grid $parent.showlining_box -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady 2
    add_tooltip $parent.showlining_box.mb "Show no residues, all pore-lining residues, or only those facing the pore."
    _trace_once ::VMDPathFinder::state(pore_lining_view) write \
        ::VMDPathFinder::on_pore_lining_view_changed
    _trace_once ::VMDPathFinder::state(pore_lining_view) write \
        ::VMDPathFinder::_sync_pore_lining_view_disp
    incr row

    # After "Show nearby", not before it: the list is the tallest thing on the
    # panel and building it first pushed every control below it down.
    _build_conn_lobe_panel $parent $row
    incr row
    # Column 1 absorbs any extra width (path entries above use -sticky ew). The
    # Property/Lining controls are left-anchored (-sticky w) and short, so removing
    # the Advanced dropdown does not widen the panel's natural size.
    grid columnconfigure $parent 1 -weight 1
    # Visibility first (show/hide dependent rows), then auto-apply the change to
    # the live surface. No "Redraw" button: changing Display / Color / Hydro
    # scheme updates the pore immediately (apply_display_change rebuilds geometry
    # only when the geometry actually changed, otherwise it just re-renders).
    _trace_once ::VMDPathFinder::state(display_mode) write \
        [list ::VMDPathFinder::update_color_row_visibility $parent]
    _trace_once ::VMDPathFinder::state(surface_color) write \
        [list ::VMDPathFinder::update_color_row_visibility $parent]
    _trace_once ::VMDPathFinder::state(display_mode) write \
        ::VMDPathFinder::on_display_setting_changed
    _trace_once ::VMDPathFinder::state(surface_color) write \
        ::VMDPathFinder::on_display_setting_changed
    _trace_once ::VMDPathFinder::state(surface_color) write \
        ::VMDPathFinder::_sync_surface_color_disp
    # The gate changes the CONNOLLY mesh, so it re-renders like a display
    # setting. The margin is an ENTRY and is committed on Return/focus-out
    # instead: tracing it would rebuild the mesh on every keystroke, and a
    # half-typed "3." is not a double, so it would render at the default first.
    _trace_once ::VMDPathFinder::state(conn_pore_gate) write \
        ::VMDPathFinder::on_display_setting_changed
    _trace_once ::VMDPathFinder::state(ion_radius_fallback) write \
        ::VMDPathFinder::_on_ion_radius_fallback_changed
    _trace_once ::VMDPathFinder::state(hydro_scheme) write \
        ::VMDPathFinder::on_hydro_method_changed
    _trace_once ::VMDPathFinder::state(hydro_scheme) write \
        [list ::VMDPathFinder::update_color_row_visibility $parent]
    _trace_once ::VMDPathFinder::state(hydro_scheme) write \
        ::VMDPathFinder::_sync_scheme_disp
    _trace_once ::VMDPathFinder::state(hydro_scheme) write \
        ::VMDPathFinder::_sync_property_scheme_across_panels
    _trace_once ::VMDPathFinder::state(profile_color_scheme) write \
        ::VMDPathFinder::_sync_profile_color_scheme_disp
    _trace_once ::VMDPathFinder::state(profile_color_scheme) write \
        ::VMDPathFinder::_sync_property_scheme_across_panels
    _trace_once ::VMDPathFinder::state(hydro_avg_mode) write \
        ::VMDPathFinder::on_hydro_method_changed
    _trace_once ::VMDPathFinder::state(hydro_facing) write \
        ::VMDPathFinder::on_hydro_method_changed
    # hydro_shell is set from the Settings dialog, not this panel, but the write
    # trace fires regardless of which UI touches state(hydro_shell) - it needs
    # the same "mark stale, refresh the current frame, don't auto-recompute the
    # trajectory" handling hydro_facing already gets (it still gates the plain
    # atom-averaging neighbourhood in compute_sphere_hydro).
    _trace_once ::VMDPathFinder::state(hydro_shell) write \
        ::VMDPathFinder::on_hydro_method_changed
    # lining_dist_thresh and hydrophob_kde_bandwidth are free-typed numeric Entry fields, so
    # they are NOT live-traced (a live trace would re-run on_hydro_method_changed on every
    # keystroke while typing). show_scale_cutoff_settings instead binds <Return>/<FocusOut> to
    # call it once, when the value is committed. hydro_3d_accurate switches between the axial
    # and true-3D coloring paths, with the same cache-invalidation/refresh handling.
    _trace_once ::VMDPathFinder::state(hydro_3d_accurate) write \
        ::VMDPathFinder::on_hydro_method_changed
    _trace_once ::VMDPathFinder::state(surface_material) write \
        ::VMDPathFinder::on_material_changed
    _trace_once ::VMDPathFinder::state(show_hydro_scalebar) write \
        ::VMDPathFinder::on_scalebar_visibility_changed
    _trace_once ::VMDPathFinder::state(scalebar_font_color) write \
        ::VMDPathFinder::on_scalebar_visibility_changed
    _trace_once ::VMDPathFinder::state(scalebar_corner) write \
        ::VMDPathFinder::on_scalebar_visibility_changed
    # The Memory row sits at the BOTTOM of the panel: it acts on the whole
    # analysis above it, so it reads as a footer rather than a heading. Built
    # at the top of this proc with the other widgets, gridded here, after the
    # last row number is known.
    grid $parent.mem -row $row -column 0 -columnspan 3 -sticky ew -padx 8 -pady {6 4}
    incr row
    update_color_row_visibility $parent
}

proc ::VMDPathFinder::update_color_row_visibility {parent args} {
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    variable state
    # Display + Material share one row (mc_box). Material applies only when
    # something is actually drawn; Display itself always stays visible (it's
    # the control that gets you OUT of "none").
    if {[winfo exists $parent.mc_box]} {
        if {$state(display_mode) eq "none"} {
            catch {pack forget $parent.mc_box.ml $parent.mc_box.mat}
        } else {
            # Re-show Material between Display and the trailing gear (row order is
            # Display, Material, gear-last), so re-entering a drawn mode restores
            # the same layout the initial pack set up.
            catch {pack $parent.mc_box.ml -side left -padx {12 0} -after $parent.mc_box.dm}
            catch {pack $parent.mc_box.mat -side left -padx {4 0} -after $parent.mc_box.ml}
        }
    }
    # Color + Property share the next row (hs_box). Color only applies to
    # surface geometries (hidden for none/centerline, same condition Material
    # uses) - it must stay reachable whenever ANY surface is drawn, so the user
    # can switch INTO property coloring. Property's own widgets additionally
    # require Color to actually be "property". The Scale-bar/Accurate-3D row
    # shows together with Property - no collapsing once shown, so the choice
    # is never hidden.
    set surf_shown [expr {$state(display_mode) ni {none centerline}}]
    set prop_shown [expr {$surf_shown && $state(surface_color) eq "property"}]
    # The openings list belongs to pore_lobes the way Property belongs to
    # "property" - shown only while that coloring is selected.
    set lobes_shown [expr {$surf_shown && $state(surface_color) eq "pore_lobes"}]
    # Margin decides where the pore ends and a sideways lobe begins, so it only
    # means anything while a coloring actually DRAWS that boundary. Under any
    # other Color it sat there changing nothing visible.
    set _mg_shown [expr {$surf_shown && ([_run_uses_card conn] || [_run_uses_card connolly]) \
        && $state(surface_color) in {pore_lat pore_lobes}}]
    if {[winfo exists $parent.hs_box]} {
        catch {pack forget $parent.hs_box.cl $parent.hs_box.sc \
            $parent.hs_box.pl $parent.hs_box.m}
        if {$surf_shown} {
            pack $parent.hs_box.cl -side left
            pack $parent.hs_box.sc -side left -padx {4 12}
        }
        if {$prop_shown} {
            pack $parent.hs_box.pl -side left
            pack $parent.hs_box.m  -side left -padx {4 0}
        }
        if {$surf_shown} { grid $parent.hs_box } else { grid remove $parent.hs_box }
    }
    if {[winfo exists $parent.showlining_box.mgl]} {
        catch {pack forget $parent.showlining_box.mgl $parent.showlining_box.mge}
        if {$_mg_shown} {
            pack $parent.showlining_box.mgl -side left -padx {12 0}
            pack $parent.showlining_box.mge -side left -padx {4 0}
        }
    }
    if {[winfo exists $parent.lobepanel]} {
        if {$lobes_shown} { grid $parent.lobepanel; catch {_refresh_conn_lobes_panel} } \
        else { grid remove $parent.lobepanel }
    }
    # Auto-lock avg_mode to the scientifically correct default for this scale:
    # kr is atom-level; the residue scales average per unique residue; gz/dens
    # bypass atom/residue averaging entirely (trajectory-average quantities).
    # ("Scale bar" and "Accurate 3D" moved off this row to the ⚙ Property Coloring
    # Settings popup, so there's no adv_box visibility to manage here any more.)
    if {$prop_shown} {
        set is_kr [expr {[info exists state(hydro_scheme)] && $state(hydro_scheme) eq "kr"}]
        set state(hydro_avg_mode) [expr {$is_kr ? "atom" : "residue"}]
    }
}

proc ::VMDPathFinder::hydration_available {} {
    # True once the Hydration analysis has produced a usable G(z)/density profile.
    variable hydration_data
    return [expr {$hydration_data ne "" && [dict exists $hydration_data coords] && \
                  [llength [dict get $hydration_data coords]] >= 2}]
}

proc ::VMDPathFinder::hydration_perframe_available {} {
    # True once the Hydration analysis has produced usable PER-FRAME occupancy
    # data (perframe_occ) - a superset check beyond hydration_available, since
    # per-frame storage can in principle be absent from an older saved result.
    variable hydration_data
    return [expr {$hydration_data ne "" && [dict exists $hydration_data perframe_occ] && \
                  [llength [dict get $hydration_data perframe_occ]] > 0}]
}

proc ::VMDPathFinder::_heatmap_scheme_choices {} {
    # Over Time's own property-scheme choices: the residue/atom properties only.
    # NO water schemes at all:
    #   * gz/dens are trajectory-constant, so an over-time map of them is flat.
    #   * per-frame water density ("pfdens") was offered here and was REMOVED (user
    #     decision): the Hydration tab already has its own per-frame density
    #     heatmap, so this duplicated it in a second place. Per-frame water now
    #     appears as a 3D-surface / Pore-Profile-Fill coloring instead, which is
    #     where it adds something the Hydration tab does not already show.
    set base {
        kd "kyte-doolittle"  ww "wimley-white"  kr "kapcha-rossky"
        lipophilicity "fauchère-pliska"
        charge "formal charge"  polarity "grantham polarity"
        logp "MOLE logP"  logd "MOLE logD"  logs "MOLE logS"
        mutability "MOLE mutability"  ionizable "MOLE ionizable"
        esp "electrostatic potential"
    }
    return $base
}

proc ::VMDPathFinder::_populate_heatmap_scheme_menu {} {
    # (Re)populate Over Time's own property-scheme menu from _heatmap_scheme_choices.
    variable w
    set menu $w.plotframe.nb.heatmap.exportbar.psch.m
    # Headless (`vmd -dispdev text`) has NO Tk, so `winfo` is an UNDEFINED command,
    # not a false predicate. This proc already returns when its widget is absent,
    # so returning when Tk itself is absent is the SAME behaviour - it just cannot
    # be expressed with `winfo`. Added mechanically to every proc whose FIRST winfo
    # use is such an early-return guard.
    if {![_have_tk]} { return }
    if {![winfo exists $menu]} { return }
    catch {$menu delete 0 end}
    foreach {_v _l} [_heatmap_scheme_choices] {
        $menu add radiobutton -label $_l -value $_v -variable ::VMDPathFinder::state(hm_prop_scheme)
    }
}

proc ::VMDPathFinder::_property_scheme_choices {} {
    # The MOLE-table entries (logP/logD/logS/mutability/ionizable) are the ones
    # tunnel mode already exposed that carry information nothing else here does:
    # logD/logS have no equivalent at all, mutability is lining conservation,
    # and ionizable is a per-residue flag distinct from net charge. logP keeps
    # an explicit MOLE prefix because it is a DIFFERENT lipophilicity scale
    # from fauchère-pliska above, not a synonym.
    #
    # Deliberately NOT added: MOLE "hydropathy" (numerically identical to kd -
    # the same values under a second name) and MOLE "polarity"/"hydrophobicity"
    # (genuinely different scales from grantham/kd/ww, so listing them beside
    # those under near-identical names would invite silent mis-comparison).
    #
    # Values come from mole_residue_property - the same table the tunnel engine
    # uses - so one residue reads identically in both modes. The LINING does
    # not: pore mode picks lining residues by a distance threshold, MOLE by the
    # five nearest atoms per sample, so aggregates are not cross-comparable
    # between modes even though the per-residue constants are shared.
    # Value/label pairs for every property-scheme picker. Labels are lower-case
    # except acronyms/symbols (JSON, G(z), pH). The water schemes (gz/dens) are
    # offered ONLY once the Hydration analysis has produced data - they're
    # derived from it, so showing them before it exists is a dead end. "pfdens"
    # (this frame's own instantaneous G(z), unlike gz's trajectory average) needs
    # PER-FRAME hydration data specifically, same gate as Over Time's "pfdens".
    set base {
        kd "kyte-doolittle"  ww "wimley-white"  kr "kapcha-rossky"
        lipophilicity "fauchère-pliska"
        charge "formal charge"  polarity "grantham polarity"
        logp "MOLE logP"  logd "MOLE logD"  logs "MOLE logS"
        mutability "MOLE mutability"  ionizable "MOLE ionizable"
        esp "electrostatic potential"
    }
    if {[hydration_available]} {
        lappend base gz "water G(z)"  dens "water density"
    }
    if {[hydration_perframe_available]} {
        lappend base pfdens "water density, this frame"
    }
    return $base
}

proc ::VMDPathFinder::_profile_fill_scheme_choices {} {
    # Pore Profile Fill = the shared list minus pfdens. Fill is the one picker
    # that offered BOTH "water density" (trajectory average) and "water density,
    # this frame", which reads as two different properties and duplicates what
    # the Hydration tab's per-frame density panel already shows more clearly.
    # Over Time had pfdens removed for the same reason; the 3D surface keeps it,
    # because a per-frame surface needs a per-frame field and pfdens is the ONLY
    # water option there (labelled plainly - see _surface_scheme_label).
    set out [list watermelon "watermelon (radius)"]
    foreach {_v _l} [_property_scheme_choices] {
        if {$_v eq "pfdens"} continue
        lappend out $_v $_l
    }
    return $out
}

proc ::VMDPathFinder::_scheme_values {choice_list} {
    # Strip a {value label value label ...} choice list down to just the values,
    # for membership tests (is this scheme actually offered by this picker?).
    set out {}
    foreach {_v _l} $choice_list { lappend out $_v }
    return $out
}

proc ::VMDPathFinder::_conn_site_scheme_label {key} {
    # Short form for the per-row menu, which sits in a fixed-width list column.
    # The full names ("kyte-doolittle", "MOLE mutability") are the panel-wide
    # picker's; here they only have to be told apart from each other.
    switch -- $key {
        kd            { return "KD" }
        ww            { return "WW" }
        chap_ww       { return "WW-oct" }
        kr            { return "KR" }
        charge        { return "charge" }
        polarity      { return "polarity" }
        lipophilicity { return "lipo" }
        esp           { return "ESP" }
        pfdens        { return "water" }
        logp          { return "logP" }
        logd          { return "logD" }
        logs          { return "logS" }
        mutability    { return "mutab" }
        ionizable     { return "ioniz" }
        default       { return $key }
    }
}

proc ::VMDPathFinder::_surface_scheme_label {key} {
    # Label for a property-scheme key. pfdens reads as plain "water density" here
    # (the 3D surface picker doesn't also offer "dens", so no disambiguation is
    # needed - contrast Pore Profile Fill/Over Time, which offer both). Shared by
    # the picker's menu text and hydro_scheme_disp so the two never diverge.
    if {$key eq "pfdens"} { return "water density" }
    return [scheme_display_label $key]
}

proc ::VMDPathFinder::_surface_scheme_choices {} {
    # 3D isosurface color picker = the shared scheme list minus gz (duplicates the
    # Hydration tab's own G(z) plot as horizontal bands) and dens (a trajectory-
    # constant value painted on geometry that changes every frame). pfdens (this
    # frame's own occupancy) takes dens's place as the water option here, since it
    # actually matches a per-frame surface - see _surface_scheme_label. Pore Profile
    # Fill and Mean Profile still offer gz/dens; see _mean_hydro_scheme_choices.
    set out {}
    foreach {_v _l} [_property_scheme_choices] {
        if {$_v in {gz dens}} continue
        lappend out $_v [_surface_scheme_label $_v]
    }
    return $out
}

proc ::VMDPathFinder::_mean_hydro_scheme_choices {} {
    # Value/label pairs for the Mean Profile color picker. Residue/atom
    # hydrophobicity schemes are always available; gz/dens (trajectory-mean water
    # free energy/density, see _binned_hydration_property) are added only once
    # Hydration has produced data. esp (trajectory-mean electrostatic potential,
    # see _binned_esp_property) needs formal charges, not a hydration run.
    # Rebuilt on hydration availability by refresh_property_scheme_menus.
    set base {
        kd "kyte-doolittle"  ww "wimley-white"  kr "kapcha-rossky"
        lipophilicity "fauchère-pliska"
        charge "formal charge"  polarity "grantham polarity"
        logp "MOLE logP"  logd "MOLE logD"  logs "MOLE logS"
        mutability "MOLE mutability"  ionizable "MOLE ionizable"
        esp "electrostatic potential"
    }
    # Always listed, so the user can see the analysis exists; greyed until
    # Hydration has produced data - see _populate_scheme_menu.
    lappend base gz "water G(z)"  dens "water density"
    return $base
}

proc ::VMDPathFinder::_scheme_needs_hydration {v} {
    return [expr {$v in {gz dens}}]
}

proc ::VMDPathFinder::_populate_scheme_menu {menu var {choices ""}} {
    # (Re)populate a property-scheme radiobutton menu. Defaults to the shared
    # _property_scheme_choices; pass an explicit list (e.g. _surface_scheme_choices)
    # to offer a picker-specific subset.
    # Headless guard - see _have_tk.
    if {![_have_tk]} { return }
    if {![winfo exists $menu]} { return }
    if {$choices eq ""} { set choices [_property_scheme_choices] }
    catch {$menu delete 0 end}
    set _hyd [hydration_available]
    foreach {_v _l} $choices {
        $menu add radiobutton -label $_l -value $_v -variable ::VMDPathFinder::state($var)
        if {[_scheme_needs_hydration $_v] && !$_hyd} {
            catch {$menu entryconfigure end -state disabled}
        }
    }
}

proc ::VMDPathFinder::refresh_property_scheme_menus {} {
    # Rebuild the visualization + Pore Profile property pickers so the water
    # schemes appear/disappear with hydration availability. If a water scheme was
    # selected and hydration is no longer available, fall back to kd so the UI
    # never points at a hidden option. Over Time never offers gz/dens (they're
    # trajectory-constant) but DOES get its own "pfdens" (per-frame water
    # density) rebuilt here too, gated on hydration_perframe_available.
    variable w
    variable state
    variable _runpanel
    _populate_scheme_menu $_runpanel.hs_box.m.m hydro_scheme [_surface_scheme_choices]
    _populate_scheme_menu $w.plotframe.nb.profile.exportbar.psch.m profile_color_scheme \
        [_profile_fill_scheme_choices]
    _populate_scheme_menu $w.plotframe.nb.mean.exportbar.psc.m mean_hydro_scheme \
        [_mean_hydro_scheme_choices]
    _populate_heatmap_scheme_menu
    # TUNNEL MODE: the two menus just rebuilt above are HOLE-mode menus, bound to
    # mean_hydro_scheme / hm_prop_scheme, which nothing in tunnel mode reads.
    # Rebuilding them unconditionally silently UNDID the tunnel wiring - and this
    # proc runs from five places (show_gui, import, clear-results, reset, and
    # after a hydration run), so the tunnel pickers reverted the moment any of
    # them fired. That is why the Mean Profile property picker was inert.
    if {[analysis_mode] eq "tunnel"} {
        catch {_sync_mean_prop_picker_for_mode}
        catch {_populate_hm_tunnel_prop_menu}
    }
    catch {_sync_mean_dispmode_for_mode}
    # gz/dens are not 3D surface options (see _surface_scheme_choices; pfdens is
    # the surface's sole water option), so a surface still set to either falls
    # back to kd unconditionally. pfdens itself falls back only when per-frame
    # data is unavailable. profile_color_scheme/mean_hydro_scheme/hm_prop_scheme
    # are untouched otherwise - Mean Profile still offers both dens and pfdens.
    # Pore Profile Fill no longer offers pfdens at all, so a config carrying it
    # from an older session is dropped to the trajectory-average dens (or kd when
    # there is no hydration data) rather than pointing at an option that is gone.
    # These fallbacks are the MACHINE deciding a scheme is unrenderable, not the
    # user picking one, so they must not travel through
    # _sync_property_scheme_across_panels: with mean_hydro_scheme now a sync
    # source, dropping Mean Profile from gz to kd would otherwise drag a
    # perfectly valid hydro_scheme=ww surface down to kd with it. Holding the
    # re-entrancy guard makes every write below local. Each panel is reset on
    # its own terms in the same breath anyway, so nothing is left unhandled.
    variable _syncing_property_scheme
    set _syncing_property_scheme 1
    catch {
        if {[info exists state(hydro_scheme)] && $state(hydro_scheme) in {gz dens}} {
            set state(hydro_scheme) kd
        }
        if {[info exists state(profile_color_scheme)] && \
                $state(profile_color_scheme) eq "pfdens"} {
            set state(profile_color_scheme) [expr {[hydration_available] ? "dens" : "kd"}]
        }
        if {![hydration_available]} {
            if {[info exists state(profile_color_scheme)] && $state(profile_color_scheme) in {gz dens}} {
                set state(profile_color_scheme) kd
            }
            if {[info exists state(mean_hydro_scheme)] && $state(mean_hydro_scheme) in {gz dens}} {
                set state(mean_hydro_scheme) kd
            }
        }
    }
    set _syncing_property_scheme 0
    if {![hydration_perframe_available] && [info exists state(hm_prop_scheme)] && \
            $state(hm_prop_scheme) eq "pfdens"} {
        set state(hm_prop_scheme) kd
    }
    if {![hydration_perframe_available]} {
        if {[info exists state(hydro_scheme)] && $state(hydro_scheme) eq "pfdens"} {
            set state(hydro_scheme) kd
        }
        if {[info exists state(profile_color_scheme)] && $state(profile_color_scheme) eq "pfdens"} {
            set state(profile_color_scheme) kd
        }
    }
}

proc ::VMDPathFinder::browse_work_dir {} {
    variable state
    set initial $state(work_dir)
    if {$initial eq "auto" || $initial eq "" || ![file isdirectory $initial]} {
        set initial [file normalize ~]
    }
    set chosen [tk_chooseDirectory -title "Select output directory" -initialdir $initial]
    if {$chosen ne ""} { set state(work_dir) $chosen }
}

proc ::VMDPathFinder::_browse_start_dir {path} {
    # Open the picker where the file it is replacing lives, not wherever VMD was
    # started. A bare command name ("hole", found on PATH) has no directory, and
    # "." would drop the picker in the startup directory again.
    if {$path eq ""} { return [file normalize ~] }
    set d [file dirname $path]
    if {$d eq "" || $d eq "."} { return [file normalize ~] }
    if {![file isdirectory $d]} { return [file normalize ~] }
    return $d
}

proc ::VMDPathFinder::browse_exe {key title} {
    variable state
    set chosen [tk_getOpenFile -title "Select $title" \
        -initialdir [_browse_start_dir $state($key)] \
        -initialfile [file tail $state($key)]]
    if {$chosen ne ""} { set state($key) $chosen }
}

proc ::VMDPathFinder::browse_radius_file {} {
    variable state
    set chosen [tk_getOpenFile -title "Select radius file" \
        -initialdir [_browse_start_dir $state(radius_file)] \
        -initialfile [file tail $state(radius_file)] \
        -filetypes {{"Radius files" {*.rad}} {"All files" *}}]
    if {$chosen ne ""} { set state(radius_file) $chosen }
}

proc ::VMDPathFinder::open_radius_file {} {
    # Opens the current Radius file in the system's default text editor/handler
    # so the user can inspect or extend its VDWR entries directly (e.g. add a
    # missing element wildcard) without leaving VMD to find the file by hand.
    variable state
    set path $state(radius_file)
    if {$path eq "" || ![file exists $path]} {
        tk_messageBox -icon error -type ok -title "Radius file" \
            -message "No radius file set, or it doesn't exist:\n$path"
        return
    }
    set ok 0
    switch -- $::tcl_platform(platform) {
        windows {
            set ok [expr {![catch {exec {*}[auto_execok start] {} $path}]}]
        }
        default {
            if {$::tcl_platform(os) eq "Darwin"} {
                set ok [expr {![catch {exec open $path &}]}]
            } else {
                if {[auto_execok xdg-open] ne ""} {
                    set ok [expr {![catch {exec xdg-open $path &}]}]
                }
                if {!$ok && [info exists ::env(EDITOR)] && $::env(EDITOR) ne ""} {
                    set ok [expr {![catch {exec $::env(EDITOR) $path &}]}]
                }
            }
        }
    }
    if {!$ok} {
        tk_messageBox -icon info -type ok -title "Radius file" \
            -message "Couldn't launch an external opener automatically.\nFile path:\n$path"
    }
}

# -- Settings dialog (File > Settings...) --------------------------------------

proc ::VMDPathFinder::show_settings_dialog {} {
    variable w
    set d "$w.settings"
    if {[winfo exists $d]} { wm deiconify $d; raise $d; return }
    toplevel $d
    wm withdraw $d
    wm title $d "VMDPathFinder Settings"
    wm resizable $d 0 0
    # Column 1 is NOT weighted: the text/path entries below carry explicit
    # widths and left-align (-sticky w), so the dialog sizes to its content
    # instead of stretching every entry across a wide window (the IGNORE /
    # extra-cards / path fields were far wider than they need to be).
    set row 0

    # Additional HOLE Parameters (ENDRAD/SAMPLE/SHORTO/...) and Appearance live in
    # show_hole_params_settings, reached via the gear on the main left panel's own
    # "HOLE parameters" header (build_run_panel) - not duplicated here.

    # ============ Output & Files ============
    label $d.out_hdr -text "Output & Files" -font {Helvetica 9 bold}
    grid $d.out_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {12 2}
    incr row
    label $d.work_l -text "Output directory"
    entry $d.work_e -textvariable ::VMDPathFinder::state(work_dir) -width 26
    button $d.work_b -text "Browse" -command ::VMDPathFinder::browse_work_dir
    grid $d.work_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.work_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.work_b -row $row -column 2 -sticky w -padx 8 -pady 3
    add_tooltip $d.work_b "Output folder for HOLE runs."
    incr row
    frame $d.oc1
    checkbutton $d.oc1.save_c -text "Save results to disk" -variable ::VMDPathFinder::state(save_results)
    checkbutton $d.oc1.overwrite_c -text "Overwrite on recalculate" -variable ::VMDPathFinder::state(overwrite_results)
    pack $d.oc1.save_c -side left
    pack $d.oc1.overwrite_c -side left -padx {18 0}
    grid $d.oc1 -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady 3
    incr row

    # ============ Performance ============
    # Pore-only knobs (pre-build/keep-visualization/playback density, none of
    # which tunnel mode reads) live in the HOLE Parameters gear instead - see
    # show_hole_params_settings. Parallel jobs and Surface cache stay here:
    # both pore AND tunnel meshing read them.
    label $d.perf_hdr -text "Performance" -font {Helvetica 9 bold}
    grid $d.perf_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {12 2}
    incr row
    frame $d.perf
    grid [label $d.perf.pj_l -text "Parallel jobs" -anchor w]                          -row 0 -column 0 -sticky w -pady 3
    grid [entry $d.perf.pj_e -textvariable ::VMDPathFinder::state(parallel_jobs) -width 7]   -row 0 -column 1 -sticky w -padx {4 20}
    grid [label $d.perf.pc_l -text "Surface cache" -anchor w]                          -row 0 -column 2 -sticky w
    grid [entry $d.perf.pc_e -textvariable ::VMDPathFinder::state(plot_cache_max) -width 7]  -row 0 -column 3 -sticky w -padx {4 0}
    grid $d.perf -row $row -column 0 -columnspan 3 -sticky w -padx 8
    incr row
    add_tooltip $d.perf.pj_e "auto = cores - 1."
    add_tooltip $d.perf.pc_e "Rendered frames kept in RAM (~18 MB each)."

    # ============ Engines ============
    label $d.bin_hdr -text "Engines" -font {Helvetica 9 bold}
    grid $d.bin_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {12 2}
    incr row
    label $d.ms_l -text "Surface mesher"
    switch -- $::VMDPathFinder::state(mesher) {
        sos     { set ::VMDPathFinder::state(mesher_disp) "sos_triangle" }
        default { set ::VMDPathFinder::state(mesher_disp) "Marching cubes" }
    }
    menubutton $d.ms_mb -textvariable ::VMDPathFinder::state(mesher_disp) \
        -relief raised -width 13 -anchor w -indicatoron 1 -menu $d.ms_mb.m
    menu $d.ms_mb.m -tearoff 0
    foreach {_msv _msd} {csg {Marching cubes} sos {sos_triangle}} {
        $d.ms_mb.m add command -label $_msd -command [list ::VMDPathFinder::_set_mesher $_msv $_msd]
    }
    frame $d.ms_vx
    label $d.ms_vx.l1 -text "grid"
    entry $d.ms_vx.e1 -textvariable ::VMDPathFinder::state(csg_voxel) -width 4
    label $d.ms_vx.l2 -text "neck"
    entry $d.ms_vx.e2 -textvariable ::VMDPathFinder::state(csg_voxel_fine) -width 4
    # Commit on Enter or on leaving the field, as every other numeric entry in
    # this plugin does. A -textvariable alone writes on each keystroke and
    # nothing redraws, so typing a new cell size changed nothing on screen.
    foreach _e {e1 e2} {
        bind $d.ms_vx.$_e <Return>   ::VMDPathFinder::_commit_csg_voxel
        bind $d.ms_vx.$_e <KP_Enter> ::VMDPathFinder::_commit_csg_voxel
        bind $d.ms_vx.$_e <FocusOut> ::VMDPathFinder::_commit_csg_voxel
    }
    pack $d.ms_vx.l1 $d.ms_vx.e1 $d.ms_vx.l2 $d.ms_vx.e2 -side left -padx {0 2}
    # the mesher's own knob sits beside it on the same row: grid/neck for
    # marching cubes, dot density for sos_triangle (_update_mesher_rows)
    frame $d.ms_dd
    label $d.ms_dd.l -text "dots"
    entry $d.ms_dd.e -textvariable ::VMDPathFinder::state(dot_density) -width 4
    label $d.ms_dd.l2 -text "playback"
    entry $d.ms_dd.e2 -textvariable ::VMDPathFinder::state(draft_stride) -width 4
    label $d.ms_dd.l3 -text "Connolly"
    entry $d.ms_dd.e3 -textvariable ::VMDPathFinder::state(conn_draft_dotden) -width 4
    pack $d.ms_dd.l $d.ms_dd.e $d.ms_dd.l2 $d.ms_dd.e2 $d.ms_dd.l3 $d.ms_dd.e3 -side left -padx {0 2}
    grid $d.ms_l -row $row -column 0 -sticky w -padx 8 -pady 3
    # One row frame: the mesher menu and its fields sit next to each other,
    # not in grid columns whose widths other rows set.
    frame $d.ms_row
    grid $d.ms_row -row $row -column 1 -columnspan 2 -sticky w -padx 8 -pady 3
    pack $d.ms_mb -in $d.ms_row -side left
    raise $d.ms_mb
    pack $d.ms_vx -in $d.ms_row -side left -padx {6 0}
    raise $d.ms_vx
    pack $d.ms_dd -in $d.ms_row -side left -padx {6 0}
    raise $d.ms_dd
    incr row
    add_tooltip $d.ms_mb "Marching cubes (mesh_csg) or HOLE\'s sos_triangle."
    add_tooltip $d.ms_vx "Cell size in \u00c5. Neck applies to spherical runs only."
    add_tooltip $d.ms_dd.l "Dots per sphere that sph_process generates. Higher is smoother and slower."
    add_tooltip $d.ms_dd.e "Dots per sphere that sph_process generates. Higher is smoother and slower."
    add_tooltip $d.ms_dd.e2 "Draw every Nth triangle while playing."
    add_tooltip $d.ms_dd.e3 "Dot density while playing, for a frame with no surface yet."
    # Smoothing moved to the Frames row, beside the playback buttons, where it
    # is a spinbox driving VMD's own window as well as the plugin's.
    set ::VMDPathFinder::_settings_d $d
    _update_mesher_rows

    # Radius file kept last: it's the field a user edits least often (only to add
    # a missing VDWR entry), so it sits at the bottom of the binaries section.
    label $d.hole_l -text "HOLE exe"
    entry $d.hole_e -textvariable ::VMDPathFinder::state(hole_exec) -width 26
    # Browse + a COMPACT acceleration indicator on the same row (no separate
    # acceleration line). The checkbutton shows a green ticked "accelerated" when
    # the binary is the VMDPathFinder build, or a greyed/red "not accelerated" (disabled
    # tick) when it's stock; it doubles as the on/off toggle - unticking forces
    # serial HOLE. Per-feature detail on hover; re-detected on open and whenever
    # the exe path changes. update_hole_accel_status drives its text/color/state.
    frame $d.hole_bb
    button $d.hole_bb.browse -text "Browse" -command [list ::VMDPathFinder::browse_exe hole_exec "HOLE executable"]
    checkbutton $d.hole_bb.acc -variable ::VMDPathFinder::state(hole_accel) -onvalue auto -offvalue off
    pack $d.hole_bb.browse -side left
    pack $d.hole_bb.acc -side left -padx {12 0}
    grid $d.hole_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.hole_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.hole_bb -row $row -column 2 -sticky w -padx 8 -pady 3
    incr row
    bind $d.hole_bb.acc <Enter> "+[list ::VMDPathFinder::_accel_tip_show %W]"
    bind $d.hole_bb.acc <Leave> "+::VMDPathFinder::_tooltip_cancel"
    bind $d.hole_e <FocusOut> "+[list ::VMDPathFinder::update_hole_accel_status $d]"
    ::VMDPathFinder::update_hole_accel_status $d
    label $d.sph_l -text "sph_process"
    entry $d.sph_e -textvariable ::VMDPathFinder::state(sph_process_exec) -width 26
    # Acceleration indicator on the sph_process row, so all three binaries report
    # their status and not just hole/sos_triangle (sph_process is parallelised too).
    # A checkbutton like the other two rows: it now has a real switch of its own
    # (state(sph_accel) -> _sph_omp_prefix), so unticking forces the serial dot cull.
    frame $d.sph_bb
    button $d.sph_bb.browse -text "Browse" -command [list ::VMDPathFinder::browse_exe sph_process_exec "sph_process"]
    checkbutton $d.sph_bb.acc -variable ::VMDPathFinder::state(sph_accel) -onvalue auto -offvalue off \
        -command [list ::VMDPathFinder::update_sph_accel_status $d]
    pack $d.sph_bb.browse -side left
    pack $d.sph_bb.acc -side left -padx {12 0}
    grid $d.sph_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.sph_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.sph_bb -row $row -column 2 -sticky w -padx 8 -pady 3
    incr row
    bind $d.sph_bb.acc <Enter> "+[list ::VMDPathFinder::_sph_accel_tip_show %W]"
    bind $d.sph_bb.acc <Leave> "+::VMDPathFinder::_tooltip_cancel"
    bind $d.sph_e <FocusOut> "+[list ::VMDPathFinder::update_sph_accel_status $d]"
    ::VMDPathFinder::update_sph_accel_status $d
    label $d.tri_l -text "sos_triangle"
    entry $d.tri_e -textvariable ::VMDPathFinder::state(sos_triangle_exec) -width 26
    # Compact acceleration indicator on the sos_triangle row, mirroring the HOLE
    # exe row: a green ticked "accelerated" when this binary has the fast features,
    # a greyed/red "not accelerated" when it doesn't. Doubles as the on/off toggle
    # (unticking = don't use the fast features). Re-detected when the path changes.
    frame $d.tri_bb
    button $d.tri_bb.browse -text "Browse" -command [list ::VMDPathFinder::browse_exe sos_triangle_exec "sos_triangle"]
    checkbutton $d.tri_bb.acc -variable ::VMDPathFinder::state(hydro_fast) -onvalue auto -offvalue off \
        -command [list ::VMDPathFinder::update_hydro_fast_status $d]
    pack $d.tri_bb.browse -side left
    pack $d.tri_bb.acc -side left -padx {12 0}
    grid $d.tri_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.tri_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.tri_bb -row $row -column 2 -sticky w -padx 8 -pady 3
    incr row
    bind $d.tri_e <FocusOut> "+[list ::VMDPathFinder::update_hydro_fast_status $d 1]"
    add_tooltip $d.tri_bb.acc "Green: VMDPathFinder build detected. Untick to force the stock path."

    ::VMDPathFinder::update_hydro_fast_status $d

    # MOLE has one implementation, not an accelerated/stock pair like the three
    # binaries above, so this row gets a detected/not-detected status label,
    # same short style as the accel checkbuttons. Blank entry = auto-resolve
    # (sibling of sos_triangle, then PATH) - see tool_path, which this
    # status mirrors exactly; init_executables backfills this field the same
    # way it does sph_process/sos_triangle, so it's rarely blank in practice.
    label $d.mole_l -text "MOLE tunnel engine"
    entry $d.mole_e -textvariable ::VMDPathFinder::state(mole_engine_exec) -width 26
    frame $d.mole_bb
    button $d.mole_bb.browse -text "Browse" -command [list ::VMDPathFinder::browse_exe mole_engine_exec "MOLE tunnel engine"]
    label $d.mole_bb.status -anchor w
    pack $d.mole_bb.browse -side left
    pack $d.mole_bb.status -side left -padx {12 0}
    grid $d.mole_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.mole_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.mole_bb -row $row -column 2 -sticky w -padx 8 -pady 3
    incr row
    bind $d.mole_e <FocusOut> "+[list ::VMDPathFinder::update_mole_engine_status $d]"
    bind $d.mole_bb.status <Enter> "+[list ::VMDPathFinder::_mole_engine_tip_show %W]"
    bind $d.mole_bb.status <Leave> "+::VMDPathFinder::_tooltip_cancel"
    ::VMDPathFinder::update_mole_engine_status $d
    label $d.rad_l -text "Radius file"
    entry $d.rad_e -textvariable ::VMDPathFinder::state(radius_file) -width 32
    frame $d.rad_btns
    button $d.rad_btns.browse -text "Browse" -command ::VMDPathFinder::browse_radius_file
    button $d.rad_btns.open   -text "Open"      -command ::VMDPathFinder::open_radius_file
    pack $d.rad_btns.browse -side left -padx {0 4}
    pack $d.rad_btns.open   -side left
    grid $d.rad_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.rad_e -row $row -column 1 -sticky w -padx 8 -pady 3
    grid $d.rad_btns -row $row -column 2 -sticky w -padx 8 -pady 3
    incr row
    add_tooltip $d.rad_btns.open "Open the .rad file to add a missing VDWR entry."

    frame $d.btns
    button $d.btns.save  -text "Save Settings" -command ::VMDPathFinder::save_config
    button $d.btns.close -text "Close" -command [list destroy $d]
    pack $d.btns.save  -side left  -padx 4
    pack $d.btns.close -side right -padx 4
    grid $d.btns -row $row -column 0 -columnspan 3 -sticky ew -padx 8 -pady {8 12}
    _center_toplevel $d
}

proc ::VMDPathFinder::show_hole_params_settings {} {
    # Extra HOLE input cards (ENDRAD, SAMPLE, SHORTO, random seed, IGNORE, pore
    # method) + Appearance (scale-bar font/corner, metrics-readout ions), reached
    # via the ⚙️ on the main left panel's "HOLE parameters" header (build_run_panel).
    # Same split as every other gear popup in this plugin: essentials stay inline,
    # feature-specific knobs live one click away.
    variable w
    variable state
    set d "$w.hole_params_settings"
    if {[winfo exists $d]} { wm deiconify $d; raise $d; return }
    toplevel $d
    wm withdraw $d
    wm title $d "HOLE Parameters"
    wm resizable $d 0 0
    set row 0

    # ============ Additional HOLE parameters (3-column grid) ============
    label $d.hp_hdr -text "Additional HOLE parameters" -font {Helvetica 9 bold}
    grid $d.hp_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {8 2}
    incr row
    # Three label+entry columns, grid-aligned so labels and fields line up both
    # vertically (same column) and horizontally (same row). The short
    # numeric cards sit 3-per-row; IGNORE / Extra cards need a wide entry for their
    # text lists, so they span all three columns below.
    frame $d.hp
    grid [label $d.hp.er_l -text "ENDRAD (Å)" -anchor w]                          -row 0 -column 0 -sticky w -pady 3
    grid [entry $d.hp.er_e -textvariable ::VMDPathFinder::state(endrad) -width 7]           -row 0 -column 1 -sticky w -padx {2 6}
    grid [label $d.hp.sa_l -text "SAMPLE" -anchor w]                                  -row 0 -column 2 -sticky w
    grid [entry $d.hp.sa_e -textvariable ::VMDPathFinder::state(sample) -width 7]           -row 0 -column 3 -sticky w -padx {2 6}
    grid [label $d.hp.ig_l -text "IGNORE" -anchor w]                                  -row 1 -column 0 -sticky w -pady 3
    grid [entry $d.hp.ig_e -textvariable ::VMDPathFinder::state(ignore) -width 34]          -row 1 -column 1 -columnspan 3 -sticky w -padx {4 0}
    # Rows a choice enables come AFTER the choice: the Monte Carlo rows and
    # HOLE's own cards (seed, SHORTO, extra cards) follow the Search picker and
    # show for Monte Carlo only; Nelder-Mead is deterministic, prints nothing
    # of HOLE's and takes no cards (_update_search_rows).
    # Two label+field pairs per row, never three. A third pair added columns 4
    # and 5 that no other row used, and those two columns set the whole dialog's
    # width - which is what pushed MC kT past every row above it.
    grid [label $d.hp.ms_l -text "MC steps" -anchor w]                                -row 4 -column 0 -sticky w -pady 3
    grid [entry $d.hp.ms_e -textvariable ::VMDPathFinder::state(mcstep) -width 7]           -row 4 -column 1 -sticky w -padx {2 6}
    grid [label $d.hp.md_l -text "MC step size" -anchor w]                            -row 4 -column 2 -sticky w
    grid [entry $d.hp.md_e -textvariable ::VMDPathFinder::state(mcdisp) -width 7]           -row 4 -column 3 -sticky w -padx {2 6}
    grid [label $d.hp.mk_l -text "MC kT" -anchor w]                                   -row 5 -column 0 -sticky w -pady 3
    grid [entry $d.hp.mk_e -textvariable ::VMDPathFinder::state(mckt) -width 7]             -row 5 -column 1 -sticky w -padx {2 6}
    grid [label $d.hp.rs_l -text "Random seed" -anchor w]                             -row 5 -column 2 -sticky w
    grid [entry $d.hp.rs_e -textvariable ::VMDPathFinder::state(random_seed) -width 7]      -row 5 -column 3 -sticky w -padx {2 6}
    grid [label $d.hp.sh_l -text "SHORTO" -anchor w]                                  -row 6 -column 0 -sticky w -pady 3
    grid [entry $d.hp.sh_e -textvariable ::VMDPathFinder::state(shorto) -width 7]           -row 6 -column 1 -sticky w -padx {2 6}
    grid [label $d.hp.ex_l -text "Extra HOLE cards" -anchor w]                        -row 7 -column 0 -sticky w -pady 3
    grid [entry $d.hp.ex_e -textvariable ::VMDPathFinder::state(extra_cards) -width 34]     -row 7 -column 1 -columnspan 3 -sticky w -padx {4 0}
    # Pore-detection method: pick Spherical (default plain HOLE) / Connolly /
    # Capsule instead of typing a card. Sets pore_method (see write_control_file).
    grid [label $d.hp.pm_l -text "Pore method" -anchor w]                             -row 2 -column 0 -sticky w -pady 3
    menubutton $d.hp.pm_mb -textvariable ::VMDPathFinder::state(pore_method_disp) \
        -relief raised -width 10 -anchor w -indicatoron 1 -menu $d.hp.pm_mb.m
    menu $d.hp.pm_mb.m -tearoff 0
    foreach {_pmv _pmd} {circular Spherical  connolly Connolly  capsule Capsule} {
        $d.hp.pm_mb.m add command -label $_pmd \
            -command [list ::VMDPathFinder::_set_pore_method $_pmv $_pmd]
    }
    grid $d.hp.pm_mb -row 2 -column 1 -sticky w -padx {2 6}
    grid [label $d.hp.se_l -text "Search" -anchor w]                                -row 2 -column 2 -sticky w
    switch -- $state(search_engine) {
        nm      { set state(search_engine_disp) "Nelder-Mead" }
        default { set state(search_engine_disp) "Monte Carlo" }
    }
    menubutton $d.hp.se_mb -textvariable ::VMDPathFinder::state(search_engine_disp) \
        -relief raised -width 12 -anchor w -indicatoron 1 -menu $d.hp.se_mb.m
    menu $d.hp.se_mb.m -tearoff 0
    foreach {_sev _sed} {mc {Monte Carlo} nm Nelder-Mead} {
        $d.hp.se_mb.m add command -label $_sed \
            -command [list ::VMDPathFinder::_set_search_engine $_sev $_sed]
    }
    grid $d.hp.se_mb -row 2 -column 3 -sticky w -padx {2 6}
    add_tooltip $d.hp.se_mb "Monte Carlo: HOLE\'s annealing, with the rows below. Nelder-Mead: deterministic and\
        faster; no seed, SHORTO or extra cards (an extra card switches the run back to HOLE)."
    grid [label $d.hp.ce_l -text "Connolly surface" -anchor w] -row 3 -column 0 -sticky w -pady 3
    switch -- $state(conn_engine) {
        fast    { set state(conn_engine_disp) "Fast port" }
        default { set state(conn_engine_disp) "HOLE conn" }
    }
    menubutton $d.hp.ce_mb -textvariable ::VMDPathFinder::state(conn_engine_disp) \
        -relief raised -width 10 -anchor w -indicatoron 1 -menu $d.hp.ce_mb.m
    menu $d.hp.ce_mb.m -tearoff 0
    foreach {_cev _ced} {hole {HOLE conn} fast {Fast port}} {
        $d.hp.ce_mb.m add command -label $_ced -command [list ::VMDPathFinder::_set_conn_engine $_cev $_ced]
    }
    grid $d.hp.ce_mb -row 3 -column 1 -sticky w -padx {2 6}
    add_tooltip $d.hp.ce_mb "HOLE's own conn, or the faster port of it - the same dots. Nelder-Mead normally uses the port and falls back to HOLE's conn if it is missing."
    set ::VMDPathFinder::_hp_frame $d.hp
    after idle ::VMDPathFinder::_update_search_rows
    checkbutton $d.hp.cgate_c -text "Hide sideways spill" \
        -variable ::VMDPathFinder::state(conn_pore_gate)
    grid $d.hp.cgate_c -row 3 -column 2 -columnspan 2 -sticky w -pady 2
    add_tooltip $d.hp.cgate_c "Drops the Connolly volume that escapes sideways through openings, keeping the pore. Its Margin lives on the main panel, next to Show nearby."
    # Margin itself is NOT here - it moved to the main panel's color row, in
    # front of Color, because it governs what pore_lat/pore_lobes SHOW and is
    # tuned interactively against the render, not set once in a dialog.

    checkbutton $d.hp.fixnm_c -text "Rename unreadable atoms" \
        -variable ::VMDPathFinder::state(hole_fix_atom_names)
    grid $d.hp.fixnm_c -row 8 -column 0 -columnspan 2 -sticky w -pady 2
    add_tooltip $d.hp.fixnm_c "For CHARMM lipid names like C210, which HOLE reads as 210. Only matters if your selection includes lipid - it does not add lipid to the selection itself. Tunnel mode does not need it."

    checkbutton $d.hp.ionrad_c -text "Ionic radii fallback" \
        -variable ::VMDPathFinder::state(ion_radius_fallback)
    grid $d.hp.ionrad_c -row 8 -column 2 -columnspan 2 -sticky w -pady 2
    add_tooltip $d.hp.ionrad_c "Adds crystal ionic radii (Nightingale 1959) for ions your radius file is missing, such as CHARMM's POT. Your file is not changed. Also turns on \"Rename unreadable atoms\"."
    grid $d.hp -row $row -column 0 -columnspan 3 -sticky w -padx 8
    incr row
    add_tooltip $d.hp.rs_e "Blank = 1."
    add_tooltip $d.hp.ms_e "Annealing steps per slice. Blank = 1000."
    add_tooltip $d.hp.md_e "Trial move size, Å. Blank = 0.1."
    add_tooltip $d.hp.mk_e "Annealing temperature. Blank = 0.1."
    add_tooltip $d.hp.pm_mb "How the pore radius is measured."
    add_tooltip $d.hp.ex_e "Extra HOLE cards, separated by ';'."
    add_tooltip $d.hp.er_e "Search stops once the pore radius reaches this, in Å - the slice that\
        reaches it is not stored. Required; pre-filled with HOLE's own default, 15."
    add_tooltip $d.hp.sa_e "Distance between successive search planes along the channel axis, in Å.\
        Required; pre-filled with HOLE's own default, 0.25."
    add_tooltip $d.hp.sh_e "How much HOLE prints to the console: 0 = everything. Use 0, 1 or 2 here; 3 omits the radius table the profile plot needs."
    add_tooltip $d.hp.ig_e "Residue names HOLE treats as empty space rather than wall. Pre-filled with\
        this plugin's own default, HOH WAT TIP SOL; blank omits the card entirely."

    # ============ Playback & session ============
    # Pore-only: none of these are read by tunnel mode (see show_settings_dialog).
    label $d.pb_hdr -text "Playback & session" -font {Helvetica 9 bold}
    grid $d.pb_hdr -row $row -column 0 -columnspan 3 -sticky w -padx 8 -pady {12 2}
    incr row
    # All three on one row, with Close. Shorter labels: what each keeps, or
    # builds, is in its tooltip.
    frame $d.oc2
    checkbutton $d.oc2.keep_c    -text "Keep visualization" -variable ::VMDPathFinder::state(keep_visualization)
    checkbutton $d.oc2.keeppdb_c -text "Keep input PDB"     -variable ::VMDPathFinder::state(keep_input_pdb)
    checkbutton $d.oc2.prebuild_c -text "Pre-build surfaces" -variable ::VMDPathFinder::state(prebuild_surfaces)
    pack $d.oc2.keep_c $d.oc2.keeppdb_c $d.oc2.prebuild_c -side left -padx {0 12}
    add_tooltip $d.oc2.keep_c "Leave the pore and its surface in the VMD scene after this window closes."
    add_tooltip $d.oc2.keeppdb_c "Keep each frame's input_frame.pdb. Uncheck to save disk space - surfaces\
        still redraw fine from the .sph file."
    add_tooltip $d.oc2.prebuild_c "Build every frame's surface right after a run. Smoother scrubbing; slower\
        right after a run on a big trajectory."
    grid $d.oc2 -row $row -column 0 -columnspan 4 -sticky w -padx 8 -pady 3
    incr row
    grid [_settings_btn_row $d] -row $row -column 0 -columnspan 4 -sticky w -padx 8 -pady {8 10}
    incr row
    _center_toplevel $d
    # After sizing, so the window is measured with the Connolly rows in place -
    # hiding them then leaves blank space rather than a window too short to show
    # them when CONNOLLY is selected again. The dialog is built on demand, so it
    # sets its own initial state instead of waiting for the next method change.
    _update_conn_controls
}

proc ::VMDPathFinder::show_scale_cutoff_settings {} {
    # Everything about HOW the pore is drawn: property-coloring thresholds, the
    # pore-facing filter, Accurate 3D, and the scale-bar/metrics appearance.
    # Reached via the ⚙ next to Color/Property.
    variable w
    variable state
    set d "$w.scale_settings"
    if {[winfo exists $d]} { wm deiconify $d; raise $d; return }
    toplevel $d
    wm withdraw $d
    wm title $d "Property Coloring Settings"
    wm resizable $d 0 0
    # No column weight + no wide inline help column: the window sizes to its
    # short label/entry pairs, and the explanations live in tooltips instead of
    # wraplength-260 side labels that forced the dialog far wider/taller than it
    # needs to be (the wide side labels made the window too large).
    set row 0

    # ---- Pore lining & smoothing (numeric thresholds) ----
    label $d.thr_hdr -text "Pore lining & smoothing" -font {Helvetica 9 bold}
    grid $d.thr_hdr -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {8 2}
    incr row

    # VMDPathFinder's own pore lining/facing distance threshold (not CHAP's COG-within-
    # radius+7.5A test): a residue is lining when ANY of its atoms is within this
    # distance of the local pore surface. Applied on commit (Enter/FocusOut), not
    # per keystroke - see the trace-removal note near hydro_shell.
    label $d.ltol_l -text "Pore lining threshold (Å)"
    entry $d.ltol_e -textvariable ::VMDPathFinder::state(lining_dist_thresh) -width 8
    bind $d.ltol_e <Return>   {::VMDPathFinder::on_hydro_method_changed x lining_dist_thresh write}
    bind $d.ltol_e <FocusOut> {::VMDPathFinder::on_hydro_method_changed x lining_dist_thresh write}
    grid $d.ltol_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.ltol_e -row $row -column 1 -sticky w -padx 8 -pady 3
    incr row

    # Gaussian-kernel Nadaraya-Watson bandwidth turning discrete lining/facing
    # residue values into a smooth profile along the pore.
    label $d.hpbw_l -text "Smoothing bandwidth (Å)"
    entry $d.hpbw_e -textvariable ::VMDPathFinder::state(hydrophob_kde_bandwidth) -width 8
    bind $d.hpbw_e <Return>   {::VMDPathFinder::on_hydro_method_changed x hydrophob_kde_bandwidth write}
    bind $d.hpbw_e <FocusOut> {::VMDPathFinder::on_hydro_method_changed x hydrophob_kde_bandwidth write}
    grid $d.hpbw_l -row $row -column 0 -sticky w -padx 8 -pady 3
    grid $d.hpbw_e -row $row -column 1 -sticky w -padx 8 -pady 3
    incr row

    # ---- Residue filter (at the very bottom) ----
    label $d.face_hdr -text "Residue filter" -font {Helvetica 9 bold}
    grid $d.face_hdr -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {12 2}
    incr row
    # Pore-facing ANALYSIS setting - meaningless for kr / gz/dens; the tooltip
    # says so (this dialog isn't hidden/shown per scheme).
    checkbutton $d.face_c -text "Pore facing" \
        -variable ::VMDPathFinder::state(hydro_facing)
    grid $d.face_c -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady 3
    incr row

    # ---- Display toggles (moved here off the main panel) ----
    label $d.disp_hdr -text "Display" -font {Helvetica 9 bold}
    grid $d.disp_hdr -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {10 2}
    incr row
    checkbutton $d.acc3d_c -text "Accurate 3D" \
        -variable ::VMDPathFinder::state(hydro_3d_accurate)
    grid $d.acc3d_c -row $row -column 0 -sticky w -padx 8 -pady 3
    checkbutton $d.sbar_c -text "Scale bar (3D viewer)" \
        -variable ::VMDPathFinder::state(show_hydro_scalebar)
    grid $d.sbar_c -row $row -column 1 -sticky w -padx 8 -pady 3
    incr row
    # Accurate 3D has no per-position contributor for gz/dens/pfdens (all three are
    # the water-hydration interpolation path, a pure function of axial position with
    # no residue to attach a value to), and esp is already a direct pointwise field
    # (K*q/d evaluated AT every surface point - no per-residue value to spread), so
    # the toggle does nothing for any of them - disable it there.
    if {[info exists state(hydro_scheme)] && $state(hydro_scheme) in {gz dens pfdens esp}} {
        $d.acc3d_c configure -state disabled
    }

    add_tooltip $d.ltol_e "Any atom within this distance of the pore surface counts as lining. Default 3.0 Å."
    add_tooltip $d.hpbw_e "Gaussian-kernel bandwidth for smoothing the hydrophobicity profile. Default 3.0 Å."
    add_tooltip $d.face_c "Only average residues whose side chain points into the pore. No effect for Kapcha-Rossky or water schemes."
    add_tooltip $d.acc3d_c "Color by true 3D distance to each residue (varies around the pore), not just axial height. No effect for the water schemes."
    add_tooltip $d.sbar_c "Show the color-scale bar in the 3D VMD viewer."

    label $d.ui_hdr -text "Appearance" -font {Helvetica 9 bold}
    grid $d.ui_hdr -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {12 2}
    incr row
    frame $d.ui
    grid [label $d.ui.sbc_l -text "Scale-bar font" -anchor w] -row 0 -column 0 -sticky w -pady 3
    menubutton $d.ui.sbc_m -textvariable ::VMDPathFinder::state(scalebar_font_color) \
        -menu $d.ui.sbc_m.m -relief raised -indicatoron 1 -width 8
    menu $d.ui.sbc_m.m -tearoff 0
    foreach _sbcval {auto black white gray yellow orange red green cyan blue} {
        $d.ui.sbc_m.m add radiobutton -label $_sbcval -value $_sbcval \
            -variable ::VMDPathFinder::state(scalebar_font_color)
    }
    grid $d.ui.sbc_m -row 0 -column 1 -sticky w -padx {4 20}
    grid [label $d.ui.sbcn_l -text "Corner" -anchor w] -row 1 -column 0 -sticky w -pady 3
    menubutton $d.ui.sbcn_m -textvariable ::VMDPathFinder::state(scalebar_corner) \
        -menu $d.ui.sbcn_m.m -relief raised -indicatoron 1 -width 11
    menu $d.ui.sbcn_m.m -tearoff 0
    foreach _cn {{Lower right} {Lower left} {Top right} {Top left}} {
        $d.ui.sbcn_m.m add radiobutton -label $_cn -value $_cn \
            -variable ::VMDPathFinder::state(scalebar_corner)
    }
    grid $d.ui.sbcn_m -row 1 -column 1 -sticky w -padx {4 20}
    # Legend on/off (same state var as the "Scale bar" checkbox on the surface
    # controls - the two stay in sync; its write-trace triggers the redraw).
    checkbutton $d.ui.mrshow -text "Show legend" \
        -variable ::VMDPathFinder::state(show_metrics_readout) \
        -command ::VMDPathFinder::_apply_metrics_readout_visibility
    grid $d.ui.mrshow -row 1 -column 2 -columnspan 2 -sticky w -padx {4 0}
    add_tooltip $d.ui.mrshow "Show the metrics box on the Pore Profile plot."
    # Which ions the on-figure metrics readout lists (passability line).
    grid [label $d.ui.ions_l -text "Metrics ions" -anchor w] -row 2 -column 0 -sticky w -pady 3
    frame $d.ui.ions
    # Two rows: eight in a line stretched the dialog wider than the rest of it.
    set _icol 0; set _irow 0
    foreach _sp {Water Na K Ca Mg Cl Li Cs} {
        set _il [string map {Water H2O Na Na+ K K+ Ca Ca2+ Mg Mg2+ Cl Cl- Li Li+ Cs Cs+} $_sp]
        set _wn [string tolower $_sp]  ;# Tk window names must start lower-case
        set ::VMDPathFinder::_readout_sp($_sp) \
            [expr {[lsearch -exact $::VMDPathFinder::state(metrics_readout_species) $_sp] >= 0 ? 1 : 0}]
        checkbutton $d.ui.ions.$_wn -text $_il -variable ::VMDPathFinder::_readout_sp($_sp) \
            -command ::VMDPathFinder::_apply_readout_species
        grid $d.ui.ions.$_wn -row $_irow -column $_icol -sticky w
        incr _icol
        if {$_icol >= 4} { set _icol 0; incr _irow }
    }
    grid $d.ui.ions -row 2 -column 1 -columnspan 2 -sticky w -padx {4 0}
    grid $d.ui -row $row -column 0 -columnspan 2 -sticky w -padx 8
    incr row
    # Initial state: hide the Metrics-ions row if the readout is off.
    catch {_apply_metrics_readout_visibility}
    add_tooltip $d.ui.sbc_m  "Scale-bar label color."
    add_tooltip $d.ui.sbcn_m "Which corner the scale bar sits in."
    add_tooltip $d.ui.ions   "Which ions the metrics box lists."

    label $d.vis_hdr -text "Visualization" -font {Helvetica 9 bold}
    grid $d.vis_hdr -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {12 2}
    incr row
    checkbutton $d.cpm_c -text "Show cues" \
        -variable ::VMDPathFinder::state(show_cpoint_marker)
    grid $d.cpm_c -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady 2
    add_tooltip $d.cpm_c "Mark CPOINT and CVECT in the viewer."
    incr row
    # Standard Apply / Set default footer (the numeric entries commit on Enter/FocusOut and
    # the checkboxes apply live via traces, so Apply just closes; Set default also persists).
    grid [_settings_btn_row $d ::VMDPathFinder::_apply_metrics_readout_visibility] -row $row -column 0 -columnspan 2 -sticky w -padx 8 -pady {8 10}
    # These left-panel property knobs are NOT touched by CHAP mode (CHAP is confined to
    # the Hydration analysis) - they always reflect the user's own values.
    _center_toplevel $d
}

proc ::VMDPathFinder::on_mean_fill_toggled {} {
    # Fill is a 2D-only control and must NOT force the 3D IsoSurface on - the two are
    # independent, sharing only the property-scheme picker's visibility (see
    # _update_mean_property_visibility).
    catch {_update_mean_property_visibility}
    draw_mean_profile
}

proc ::VMDPathFinder::_settings_btn_row {d {apply_cmd {}}} {
    # Standard two-button footer for every settings popup: Apply (run apply_cmd,
    # close - this session only) and Set default (run apply_cmd, save_config, close -
    # persists to ~/.vmdpathfinder_config). Builds but does not place frame $d.btns; the
    # caller grids/packs it (column spans differ per dialog).
    frame $d.btns
    button $d.btns.ap  -text "Apply"       -command "catch {$apply_cmd}; destroy $d"
    button $d.btns.def -text "Set default" -command "catch {$apply_cmd}; ::VMDPathFinder::save_config; destroy $d"
    pack $d.btns.ap $d.btns.def -side left -padx 6
    add_tooltip $d.btns.ap  "Apply these settings for this session and close."
    add_tooltip $d.btns.def "Apply now and also save these as the defaults for next time, then close."
    return $d.btns
}

proc ::VMDPathFinder::show_mean_profile_settings {} {
    # Mean Profile display options, reached via the ⚙ on the Mean tab: Accurate-3D
    # coloring + smooth-mesh rendering (3D surface), and the 2D Fill (color the
    # area under the mean curve by the sphere-mean property, like the Pore Profile).
    variable w
    variable state
    set d "$w.mean_settings"
    if {[winfo exists $d]} { wm deiconify $d; raise $d; return }
    toplevel $d
    wm withdraw $d
    wm title $d "Mean Profile Settings"
    wm resizable $d 0 0
    set row 0
    # --- 2D plot (always relevant - the mean curve is this tab's main canvas) ---
    label $d.fhdr -text "2D plot" -font {Helvetica 9 bold}
    grid $d.fhdr -row $row -column 0 -sticky w -padx 8 -pady {8 2}; incr row
    checkbutton $d.fill -text "Fill (color area under the mean curve)" \
        -variable ::VMDPathFinder::state(mean_profile_fill) \
        -command ::VMDPathFinder::on_mean_fill_toggled
    grid $d.fill -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    # The fill's own scheme: watermelon radius bands or a property. Separate
    # from the 3D surface's Property picker under the plot, which belongs to
    # the surface alone.
    frame $d.fillrow
    label $d.fillrow.l -text "Fill by"
    menubutton $d.fillrow.m -textvariable ::VMDPathFinder::state(mean_fill_scheme_disp) \
        -menu $d.fillrow.m.m -relief raised -indicatoron 1 -width 22
    menu $d.fillrow.m.m -tearoff 0
    _populate_scheme_menu $d.fillrow.m.m mean_fill_scheme [_mean_fill_scheme_choices]
    pack $d.fillrow.l -side left -padx {0 6}
    pack $d.fillrow.m -side left
    grid $d.fillrow -row $row -column 0 -sticky w -padx 20 -pady 1; incr row
    add_tooltip $d.fillrow.m "What the fill is coloured by: the mean radius in watermelon bands, or a lining/hydration property averaged per bin."
    _sync_mean_fill_scheme_disp
    catch {_sync_mean_fill_row_state $d}
    # Radius source for the mean curve, the histogram and the mean surface:
    # HOLE's spherical probe, or the fitted ellipse's area-equivalent radius.
    frame $d.rsrc
    label $d.rsrc.l -text "Radius"
    radiobutton $d.rsrc.sph -text "spherical" -value spherical \
        -variable ::VMDPathFinder::state(mean_radius_source) -command ::VMDPathFinder::on_mean_radius_source_changed
    radiobutton $d.rsrc.ell -text "ellipse (area-equivalent)" -value ellipse \
        -variable ::VMDPathFinder::state(mean_radius_source) -command ::VMDPathFinder::on_mean_radius_source_changed
    pack $d.rsrc.l $d.rsrc.sph $d.rsrc.ell -side left -padx {0 6}
    grid $d.rsrc -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    add_tooltip $d.rsrc.ell "Uses the fitted ellipse's area-equivalent radius per frame. Shares the ellipse cache with Over Time, so a fit done there is reused here and the other way round; a missing fit is computed on first use."

    foreach {_mv _mlbl _mtip} [list \
            mean_show_mean   "Mean line" "The mean radius in each bin." \
            mean_show_sd     "\u00b11 std"    "The spread either side of the mean, as a band - or as dashed lines when Fill is on." \
            mean_show_minmax "Min / max" "The narrowest and widest value seen in each bin, across the frames averaged."] {
        if {![info exists state($_mv)]} { set state($_mv) 1 }
        checkbutton $d.$_mv -text $_mlbl -variable ::VMDPathFinder::state($_mv) \
            -command ::VMDPathFinder::draw_mean_profile
        grid $d.$_mv -row $row -column 0 -sticky w -padx 20 -pady 1; incr row
        add_tooltip $d.$_mv $_mtip
    }
    checkbutton $d.swap -text "Swap X/Y" \
        -variable ::VMDPathFinder::state(mean_swap) -command ::VMDPathFinder::draw_mean_profile
    grid $d.swap -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    checkbutton $d.flipz -text "Flip Z" \
        -variable ::VMDPathFinder::state(mean_flip_z) -command ::VMDPathFinder::draw_mean_profile
    grid $d.flipz -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    # --- 3D surface (only meaningful while the IsoSurface is shown) ---
    label $d.shdr -text "3D surface" -font {Helvetica 9 bold}
    grid $d.shdr -row $row -column 0 -sticky w -padx 8 -pady {10 2}; incr row
    checkbutton $d.acc3d -text "Accurate 3D" \
        -variable ::VMDPathFinder::state(mean_hydro_3d_accurate) \
        -command ::VMDPathFinder::refresh_mean_surface_if_shown
    grid $d.acc3d -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    frame $d.m3_row
    label $d.m3_row.l -text "Accurate 3D: average over" -anchor w
    entry $d.m3_row.e -textvariable ::VMDPathFinder::state(mean_3d_frame_cap) -width 6
    label $d.m3_row.r -text "frames (0 = all)" -anchor w
    pack $d.m3_row.l -side left
    pack $d.m3_row.e -side left -padx {6 0}
    pack $d.m3_row.r -side left -padx {6 0}
    grid $d.m3_row -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    checkbutton $d.smooth -text "Render smoothly" \
        -variable ::VMDPathFinder::state(mean_smooth_mesh) \
        -command ::VMDPathFinder::refresh_mean_surface_if_shown
    grid $d.smooth -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    # --- Occupancy volume (CONNOLLY only, opt-in) ---------------------------
    # Its own section, and its own Apply: the pass reads every frame's cloud, so
    # it must not fire from a stray checkbox the way the tube's controls do.
    label $d.vhdr -text "Occupancy volume (Connolly)" -font {Helvetica 9 bold}
    grid $d.vhdr -row $row -column 0 -sticky w -padx 8 -pady {10 2}; incr row
    checkbutton $d.venable -text "Average occupancy volume" \
        -variable ::VMDPathFinder::state(mean_vol_enabled) \
        -command ::VMDPathFinder::_sync_mean_settings_lock
    grid $d.venable -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    frame $d.vgrid
    label $d.vgrid.hl -text "Grid (\u00c5):" -anchor w
    entry $d.vgrid.he -textvariable ::VMDPathFinder::state(mean_vol_voxel) -width 5
    label $d.vgrid.sl -text "Smooth (cells):" -anchor w
    entry $d.vgrid.se -textvariable ::VMDPathFinder::state(mean_vol_sigma) -width 5
    pack $d.vgrid.hl $d.vgrid.he $d.vgrid.sl $d.vgrid.se -side left -padx {0 4}
    grid $d.vgrid -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    frame $d.vth
    label $d.vth.l -text "Min. frames - pore:" -anchor w
    entry $d.vth.e -textvariable ::VMDPathFinder::state(mean_vol_thresh) -width 5
    label $d.vth.ol -text "openings:" -anchor w
    entry $d.vth.oe -textvariable ::VMDPathFinder::state(mean_vol_thresh_open) -width 5
    pack $d.vth.l $d.vth.e $d.vth.ol $d.vth.oe -side left -padx {0 4}
    grid $d.vth -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    add_tooltip $d.venable "Builds the surface from the Connolly clouds instead of revolving the mean radius. The volume is the lumen open in at least half the frames, so it reads below the mean profile's. Applies on Apply."
    add_tooltip $d.vgrid.he "Voxel size in Å. Smaller resolves finer openings and takes longer. The volume shifts about 14% across a twofold change, so quote it with this setting."
    add_tooltip $d.vgrid.se "Gaussian width in voxels. Each region is smoothed separately, so the pore does not bleed into an opening."
    add_tooltip $d.vth.e "Fraction of frames a point must be inside the pore to count. 0.5 is the median lumen - what was open more often than not."
    add_tooltip $d.vth.oe "The same, per opening, counted over the frames that opening appears in. Lower than the pore's because openings show for fewer frames."
    add_tooltip $d.fill "Shade the area under the mean curve by the selected property. Reaches up to the\
outermost curve still shown, so turning Min / max off fills to the std band instead. Independent of the 3D IsoSurface."
    add_tooltip $d.swap  "Swap the R and Z axes of the 2D mean plot."
    add_tooltip $d.flipz "Reverse the channel-coordinate (Z) direction of the 2D mean plot."
    add_tooltip $d.acc3d "Color the 3D surface by true 3D distance to each residue (varies around the pore), not just axial height. No effect for the water schemes."
    add_tooltip $d.m3_row.e "Frames the Accurate 3D average samples, evenly spaced. 0 uses every frame. About 40 ms per frame, so 20000 frames take roughly 14 minutes."
    add_tooltip $d.smooth "Smooth the 3D surface mesh (render only - doesn't change the 2D plot or CSV data)."
    # Fill is deliberately NOT included in the 3D-only state gating below - see
    # on_mean_fill_toggled and: Fill and the
    # IsoSurface were decoupled specifically so Fill never depends
    # on the 3D surface's state. Greying it here together with acc3d/smooth would
    # reintroduce exactly that coupling in a different place.
    _sync_mean_settings_lock
    # state(show_mean_surface) has three independent toggle paths (the tab-bar
    # IsoSurface checkbutton, the status-row Mean button, and solo-surface
    # exclusivity) that can all change it while this dialog stays open, so the
    # lock needs a trace, not just this one evaluation at build time.
    _trace_once ::VMDPathFinder::state(show_mean_surface) write ::VMDPathFinder::_sync_mean_settings_lock
    # The lock now also reads Color, scheme, Accurate 3D and the display mode
    # (see _sync_mean_settings_lock), every one of which has its own path that
    # can change it while this dialog stays open - so each needs its own trace,
    # or the greying is right only for whatever was set when it opened.
    foreach _lv {mean_surface_color mean_hydro_scheme mean_hydro_3d_accurate mean_display_mode} {
        _trace_once ::VMDPathFinder::state($_lv) write ::VMDPathFinder::_sync_mean_settings_lock
    }
    grid [_settings_btn_row $d ::VMDPathFinder::_apply_mean_settings] -row $row -column 0 -sticky w -padx 8 -pady {10 10}; incr row
    _center_toplevel $d
}

proc ::VMDPathFinder::_sync_mean_settings_lock {args} {
    # Re-applies the 3D-only widget states in show_mean_profile_settings
    # whenever state(show_mean_surface) changes while the dialog is open - see
    # the trace in show_mean_profile_settings. No-op when the dialog is closed.
    # Fill is NOT touched here; see the comment at its tooltip.
    variable w
    variable state
    set d "$w.mean_settings"
    # Headless guard - see _have_tk.
    if {![_have_tk]} { return }
    if {![winfo exists $d]} { return }
    set _mean_surf_on [expr {[info exists state(show_mean_surface)] && $state(show_mean_surface)}]
    set _3d_state [expr {$_mean_surf_on ? "normal" : "disabled"}]
    foreach _wp {acc3d m3_row.e smooth} {
        if {[winfo exists $d.$_wp]} { catch {$d.$_wp configure -state $_3d_state} }
    }
    # Accurate 3D has no per-residue position for gz/dens, and esp is a direct pointwise
    # field (K*q/d evaluated AT every surface point - no per-residue value to spread), so
    # the toggle does nothing for those - grey it even when the surface is on. It also
    # needs the property coloring itself: with Color on a flat colour there is no
    # per-point value to average in the first place.
    # The subsample only has anything to decide above its own 1000-frame mark;
    # below that every frame is used whatever the box says, so the row is not
    # shown.
    variable result_frames
    set _many [expr {[info exists result_frames] && [llength $result_frames] > 1000}]
    if {[winfo exists $d.m3_row]} {
        if {$_many} { catch {grid $d.m3_row} } else { catch {grid remove $d.m3_row} }
    }
    set _prop_on [expr {[info exists state(mean_surface_color)] && $state(mean_surface_color) eq "property"}]
    set _sch_ok [expr {[info exists state(mean_hydro_scheme)] && $state(mean_hydro_scheme) ni {gz dens esp}}]
    if {$_mean_surf_on && (!$_prop_on || !$_sch_ok)} {
        catch {$d.acc3d configure -state disabled}
    }
    # No tunnel-mode implementation: the averaged tube is coloured per SPHERE from
    # _tunnel_mean_property_spheres, and build_mean_hydro3d_average - the
    # per-triangle averaging this box selects - is reached only from HOLE mode's
    # own builder. Greyed rather than left live and inert.
    if {[analysis_mode] eq "tunnel"} { catch {$d.acc3d configure -state disabled} }
    # The frames cap feeds ONLY the Accurate-3D average, so it follows the same
    # condition build_and_show_mean_surface's own want_3d does: property + a
    # scheme that has per-residue positions + the toggle on + a binary that can
    # do the averaging batch. Outside those it changes nothing that is drawn.
    set _cap_live [expr {$_mean_surf_on && $_prop_on && $_sch_ok \
        && [info exists state(mean_hydro_3d_accurate)] && $state(mean_hydro_3d_accurate)}]
    if {$_cap_live && [catch {sos_triangle_has_feature hydro3daverage} _hf]} { set _hf 0 }
    if {$_cap_live && !$_hf} { set _cap_live 0 }
    if {[winfo exists $d.m3_row.e]} {
        catch {$d.m3_row.e configure -state [expr {$_cap_live ? "normal" : "disabled"}]}
    }
    # Smoothing is a MESH control. Dots draws the mesh's vertices as a point
    # cloud and Centerline draws axis beads from the .sph, so offering it there
    # is offering a control for something not on screen. (It is not inert for
    # Dots - the cloud is extracted after smoothing, so the points would move -
    # it just is not a meaningful thing to ask of a point cloud.)
    set _mdm_now [expr {[info exists state(mean_display_mode)] ? $state(mean_display_mode) : "triangulated"}]
    if {$_mean_surf_on && $_mdm_now in {dots centerline}} {
        catch {$d.smooth configure -state disabled}
    }
    # The occupancy volume is a CONNOLLY measurement - it averages that method's
    # own flood-fill clouds, and no other method produces one. Hidden outright
    # rather than offered and then refused.
    set _volok [expr {[_run_uses_card conn] || [_run_uses_card connolly]}]
    foreach _vw {vhdr venable} {
        if {![winfo exists $d.$_vw]} { continue }
        if {$_volok} { catch {grid $d.$_vw} } else { catch {grid remove $d.$_vw} }
    }
    # The knobs only exist once the volume is switched on - until then they
    # describe something that is not being built.
    set _volon [expr {$_volok && [info exists state(mean_vol_enabled)] && $state(mean_vol_enabled)}]
    foreach _vw {vgrid vth} {
        if {![winfo exists $d.$_vw]} { continue }
        if {$_volon} { catch {grid $d.$_vw} } else { catch {grid remove $d.$_vw} }
    }
    # ...and it draws into the 3D surface slot, so it follows the same on/off
    # the rest of that section does.
    foreach _vw {venable vgrid.he vgrid.se vth.e vth.oe} {
        if {[winfo exists $d.$_vw]} { catch {$d.$_vw configure -state $_3d_state} }
    }
}

proc ::VMDPathFinder::show_pore_profile_settings {} {
    # Pore Profile display options, reached via the ⚙ on the Pore Profile tab:
    # the 2D-plot axis toggles (Swap X/Y, Flip Z), moved off the tab bar into here.
    variable w
    variable state
    set d "$w.profile_settings"
    # Destroyed, not raised: which controls belong here depends on the view
    # mode, so a dialog built in another mode would show the wrong set.
    catch {destroy $d}
    toplevel $d
    wm withdraw $d
    wm title $d "Pore Profile Settings"
    wm resizable $d 0 0
    set row 0
    label $d.hdr -text "2D plot" -font {Helvetica 9 bold}
    grid $d.hdr -row $row -column 0 -sticky w -padx 8 -pady {8 2}; incr row
    # Swap X/Y applies to the radius-vs-Z profile only. The Unrolled map's X is
    # the ANGLE around the axis, not a spatial coordinate, so swapping means
    # nothing there - hidden rather than left inert, same as Ion Flow's.
    checkbutton $d.swap -text "Swap X/Y" \
        -variable ::VMDPathFinder::state(plot_swap_axes) -command ::VMDPathFinder::redraw_profile_plot
    if {![info exists state(profile_view_mode)] || $state(profile_view_mode) ne "unroll"} {
        grid $d.swap -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    }
    checkbutton $d.flipz -text "Flip Z" \
        -variable ::VMDPathFinder::state(plot_flip_z) -command ::VMDPathFinder::redraw_profile_plot
    grid $d.flipz -row $row -column 0 -sticky w -padx 8 -pady 3; incr row
    catch {add_tooltip $d.swap "Swap the R and Z axes of the profile plot."}
    add_tooltip $d.flipz "Reverse the Z direction."
    grid [_settings_btn_row $d ::VMDPathFinder::redraw_profile_plot] -row $row -column 0 -sticky w -padx 8 -pady {10 10}; incr row
    _center_toplevel $d
}

proc ::VMDPathFinder::show_overtime_settings {} {
    # Over Time (heatmap) display options, reached via the ⚙ on the Over Time tab:
