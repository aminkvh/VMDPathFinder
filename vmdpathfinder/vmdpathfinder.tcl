proc ::VMDPathFinder::_config_skip_keys {} {
    # Keys that are NEVER restored from disk. Extracted from load_config so the
    # test suite can pin the list rather than restate it: "Fill is on by
    # default" and "Over Time defaults to Property" were both reported as bugs,
    # and the defence against a stale ~/.vmdpathfinder_config resurrecting either one
    # is membership HERE. See load_config for why each is listed.
    return {selection profile_color profile_view_mode heatmap_color_by heatmap_radius_source water_radius_floor
        display_mode surface_color surface_material heatmap_scheme pore_lining_view show_mean_surface
        mean_profile_fill water_use_cpoint_axis
        hydration_view
        trends_metric trends_metric_disp
        ion_flow_species ion_flow_species_disp ion_flow_view ion_flow_view_disp
        ion_flow_passage_show ion_flow_passage_show_disp
        tunnel_cluster_on}
}

proc ::VMDPathFinder::load_config {} {
    variable config_file
    variable state
    variable _loading_config
    # One-time carry-over from the pre-rename config (VMDHole -> VMDPathFinder):
    # a user upgrading in place keeps their settings instead of silently
    # starting from the defaults. Only when the new file does not exist yet,
    # and only the default location - an explicit VMDPATHFINDER_CONFIG_FILE
    # means the user already chose where their config lives.
    if {![file exists $config_file] && ![info exists ::env(VMDPATHFINDER_CONFIG_FILE)]} {
        set _old [file join [file normalize ~] .vmdhole_config]
        if {[file isfile $_old]} {
            if {![catch {file copy $_old $config_file}]} {
                catch {vmdcon -info "VMDPathFinder: settings carried over from $_old."}
            }
        }
    }
    if {![file exists $config_file]} { return }
    set _loading_config 1
    # Keys that must NOT be restored from disk even if an older config wrote them:
    # per-molecule/analysis inputs (selection, CPOINT/CVECT, HOLE params) and per-panel
    # view toggles (display_mode, surface_color, ...) describe one specific analysis, not
    # a durable preference, so they always start from the code default. Listing them here
    # (not just omitting from save_config's persistent_keys) neutralises an existing
    # config that already has e.g. "surface_color = property" on disk.
    # Keep this list and save_config's persistent_keys in sync - a key excluded from one
    # but not the other reintroduces the stale-restore bug this split prevents.
    # NOTE: the settings-dialog PARAMETERS (HOLE run cards, hydration/KDE numbers,
    # lining/hydrophobicity thresholds, MOLE parameters) are deliberately NOT
    # skipped any more - every gear popup offers "Set default", and skipping them
    # here meant that button applied for the session and then silently discarded
    # the value on reload, on both the write and the read side. What stays skipped
    # is per-molecule state, VIEW selections, and the *_disp mirrors that are
    # derived from a real key. show_mean_surface / mean_profile_fill in particular
    # must stay non-sticky - persisting Fill was a reported complaint.
    set skip_keys [_config_skip_keys]
    if {![file isfile $config_file] || [catch {open $config_file r} fh]} {
        # An unreadable config (NFS hiccup, wrong permissions) must not stop
        # the GUI from opening - run on defaults and say so.
        catch {vmdcon -warn "VMDPathFinder: could not read $config_file ($fh) - using defaults."}
        set _loading_config 0
        return
    }
    while {[gets $fh line] >= 0} {
        set line [string trim $line]
        if {$line eq "" || [string match "#*" $line]} { continue }
        if {[regexp {^(\w+)\s*=\s*(.*)$} $line -> key val]} {
            if {$key in $skip_keys} { continue }
            set _v [string trim $val]
            # Persisted enum keys reach a shell (e.g. --hydro-scheme in the
            # sos_triangle command lines), so a hand-edited config was a way to
            # smuggle shell syntax into `sh -c`. Every legitimate value here is
            # a bare token; anything else is dropped in favour of the code
            # default rather than trusted. The command lines quote these too -
            # this is the second layer, not the only one.
            if {[string match "*_scheme" $key] || [string match "*_scheme_disp" $key]
                || $key in {hydro_property_scale surface_color heatmap_scheme}} {
                if {![regexp {^[A-Za-z0-9 ._-]*$} $_v]} {
                    vmdcon -warn "VMDPathFinder: ignoring unsafe value for '$key' in\
                        [set ::VMDPathFinder::config_file]"
                    continue
                }
            }
            set state($key) $_v
        }
    }
    close $fh
    # Migrate any renamed values from older configs.
    if {[info exists state(heatmap_scheme)] && $state(heatmap_scheme) eq "hole_classic"} {
        set state(heatmap_scheme) watermelon
    }
    if {[info exists state(surface_color)] && $state(surface_color) eq "hydrophobic"} {
        set state(surface_color) property
    }
    # csg_voxel meant "the settled mesh" while the mesher still built a second,
    # coarser mesh for playback (csg_voxel_draft). It now means the grid used
    # everywhere, with csg_voxel_fine only around the narrow pore, so a value
    # saved under the old pair is far finer than intended and costs several
    # times the frame budget. Presence of the retired key identifies it.
    if {[info exists state(csg_voxel_draft)]} {
        array unset state csg_voxel_draft
        set state(csg_voxel) 1.4
        set state(csg_voxel_fine) 0.7
    }
    # A neck finer than the grid is the only combination that means anything;
    # the other way round just makes a uniform grid, which is what it now does.
    if {[info exists state(csg_voxel_fine)] && [info exists state(csg_voxel)]
            && [string is double -strict $state(csg_voxel_fine)]
            && [string is double -strict $state(csg_voxel)]
            && $state(csg_voxel_fine) > $state(csg_voxel)} {
        set state(csg_voxel_fine) $state(csg_voxel)
    }
    # Default salt changed to physiological 150 mM NaCl (37C). Flip a config that
    # still holds the OLD shipped default (1 M KCl) so existing users get the new
    # default too; a deliberately-chosen different salt is left untouched.
    foreach _pk {metrics_kappa_preset trends_kappa_preset} {
        if {[info exists state($_pk)] && $state($_pk) eq "1 M KCl (25C)"} {
            set state($_pk) "150 mM NaCl (37C)"
        }
    }
    foreach _ck {metrics_kappa_custom trends_kappa_custom} {
        if {[info exists state($_ck)] && $state($_ck) eq "11.2"} { set state($_ck) "1.9" }
    }
    # The radius-weighting feature (×R/÷R, then a "gate score") was removed entirely -
    # drop any of its keys from an older config rather than resurrect them.
    foreach _k {hydro_radius_weight hydro_radius_mode hydro_radius_mode_disp gate_r0 gate_sigma \
                chap_hydro_scale chap_hydro_scale_disp} {
        if {[info exists state($_k)]} { unset state($_k) }
    }
    if {[info exists state(hydro_scheme)]} {
        set state(hydro_scheme_disp) [_surface_scheme_label $state(hydro_scheme)]
    }
    if {[info exists state(surface_color)]} {
        set state(surface_color_disp) $state(surface_color)
    }
    if {[info exists state(display_mode)]} {
        set state(display_mode_disp) [display_mode_display_label $state(display_mode)]
    }
    if {[info exists state(hydration_view)]} {
        set state(hydration_view_disp) [hydration_view_label $state(hydration_view)]
    }
    if {[info exists state(pore_lining_view)]} {
        _sync_pore_lining_view_disp
    }
    # A persisted engine path whose binary is GONE (a deleted checkout, an
    # unloaded module tree) must not outrank discovery or the Tcl fallback:
    # kept, it surfaced as a run-time "sph_process not found" against a ghost
    # path. Lives HERE so the source-time load at the end of this file is
    # covered too, not only init_executables; caller presets are safe because
    # init_executables restores them after this returns.
    foreach _k [tool_exec_keys] {
        if {[info exists state($_k)] && $state($_k) ne "" && ![file executable $state($_k)]} {
            catch {vmdcon -warn "VMDPathFinder: ignoring persisted $_k = $state($_k) (not executable)"}
            set state($_k) ""
        }
    }
    set _loading_config 0
}

proc ::VMDPathFinder::_config_persistent_keys {} {
    # Keys persisted across sessions: executable locations plus genuine UI/workflow
    # PREFERENCES - not per-molecule/runtime state (molid, frame_spec, cpoint, status)
    # or per-panel view toggles (see load_config's skip_keys for the full exclusion
    # list and why). Must stay in sync with skip_keys, its read-side counterpart.
    return {
        hole_exec sph_process_exec sos_triangle_exec mole_engine_exec nm_search_exec conn_lobes_exec mesh_csg_exec radius_file
        dot_density
        hydro_fast hole_accel sph_accel
        sync_visualization show_centerline show_hydro_scalebar
