proc ::VMDPathFinder::_hydration_sync_view_vis {} {
    # The hydration View dropdown (Density / Energy / Hydrophobicity / Per-frame ...) is only
    # meaningful once there is something to view, so it stays hidden on a fresh tab and appears
    # - to the LEFT of the Compute button - only once the water Compute has actually finished
    # (hydration_data populated), not just after a HOLE run. Idempotent; safe to call on every
    # redraw.
    variable w
    variable hydration_data
    set eb $w.plotframe.nb.hydration.exportbar
    # Headless guard - see _have_tk.
    if {![_have_tk]} { return }
    if {![winfo exists $eb.view]} { return }
    if {$hydration_data ne "" && [llength [dict get $hydration_data coords]] > 0} {
        catch {pack $eb.view -side left -padx {6 0} -before $eb.go}
    } else {
        catch {pack forget $eb.view}
    }
}

proc ::VMDPathFinder::on_mean_coloring_changed {args} {
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    # Color/Material/Property changes EXCLUSIVE to the Mean Profile 3D surface -
    # rebuilds ONLY that surface (if shown), never the main per-frame isosurface (its own
    # independent picker). See refresh_mean_surface_if_shown.
    # Suppressed when this write came from _sync_property_scheme_across_panels: the
    # picker still updates to match, but does NOT eagerly rebuild the (potentially
    # expensive) surface - only an explicit Compute or a genuine local edit of Mean
    # Profile's own picker rebuilds it.
    variable _syncing_property_scheme
    # The 2D Mean Profile plot's property FILL reads mean_hydro_scheme too, but it is
    # cheap (cached collect_binned_property) and was NEVER redrawn on a scheme change -
    # so the fill kept showing the PREVIOUS scheme's colors (the "KR fill not wired"
    # report). Redraw it here always, including for a scheme synced from another panel
    # (only the expensive 3D surface below is gated on a local change).
    catch {draw_mean_profile}
    if {$_syncing_property_scheme} { return }
    refresh_mean_surface_if_shown
}

proc ::VMDPathFinder::normalize_raw_value {value lo hi signed} {
    # Map a RAW property value to a normalized position, given explicit scale
    # bounds (not read from state(hydro_scheme)) - shared by property_norm
    # (main-panel scheme) and colorize_by_sphere_values (any scheme/lo/hi,
    # e.g. the Mean Profile tube's own independent scheme), so both stay
    # identical to the C binary's own normalize_raw().
    #   signed   -> [-1,1] (two-sided: -1 at lo, 0 at neutral, +1 at hi)
    #   unsigned -> [0,1]
    if {$signed} {
        if {$value < 0} {
            set t [expr {($lo < 0) ? $value / (-1.0*$lo) : 0.0}]
        } else {
            set t [expr {($hi > 0) ? $value / double($hi) : 0.0}]
        }
        if {$t < -1.0} { set t -1.0 }; if {$t > 1.0} { set t 1.0 }
        return $t
    }
    set span [expr {$hi - $lo}]
    set t [expr {($span != 0) ? ($value - $lo) / double($span) : 0.5}]
    if {$t < 0.0} { set t 0.0 }; if {$t > 1.0} { set t 1.0 }
    return $t
}

proc ::VMDPathFinder::property_norm {prop value} {
    # Map a raw property value to a normalized position for the MAIN panel's
    # own scheme (state(hydro_scheme)'s scale) - see normalize_raw_value for
    # the actual math, shared with any other scheme/lo/hi.
    set m [property_meta $prop]
    return [normalize_raw_value $value [dict get $m lo] [dict get $m hi] [dict get $m signed]]
}

proc ::VMDPathFinder::norm_to_vmd_color {t signed} {
    # Normalized value -> VMD color name. Cascaded "if" (Tcl 8.5 has no elseif).
    if {$signed} {
        if {$t < -0.66} { return blue }
        if {$t < -0.33} { return iceblue }
        if {$t < -0.11} { return cyan }
        if {$t <  0.11} { return white }
        if {$t <  0.33} { return yellow }
        if {$t <  0.66} { return orange }
        return red
    }
    if {$t < 0.25} { return white }
    if {$t < 0.50} { return yellow }
    if {$t < 0.75} { return orange }
    return red
}

proc ::VMDPathFinder::property_short {prop} {
    # Short label for titles/legends/scale bars. The specific scale (Kyte-Doolittle,
    # Wimley-White, Kapcha-Rossky) is already visible on the scheme picker, so the
    # bars themselves just say "Hydrophobicity" rather than cryptic author-initial
    # codes (KD/WW/K-R).
    switch -- $prop {
        kd - ww - kr { return "hydrophobicity" }
        charge { return "charge" }
        polarity { return "polarity" }

        lipophilicity { return "lipophilicity" }
        gz            { return "G(z)" }
        dens          { return "ρ/ρ_bulk" }
        pfdens        { return "ρ/ρ_bulk, frame" }
        default { return [string tolower $prop] }
    }
}

proc ::VMDPathFinder::property_scalebar_bands {prop} {
    # Color bands {name lo hi} spanning the scale, derived from property_meta so
    # every property gets a faithful bar (signed -> 7 diverging bands centred on
    # the neutral value; unsigned -> 4 sequential white->red bands).
    if {$prop eq "watermelon"} {
        lassign [watermelon_levels] bounds hexes slots
        _watermelon_apply_vmd_colors
        set out {}
        foreach slot $slots lo [lrange $bounds 0 end-1] hi [lrange $bounds 1 end] {
            lappend out [list $slot $lo $hi]
        }
        return $out
    }
    set m [property_meta $prop]
    set lo [dict get $m lo]; set hi [dict get $m hi]
    if {[dict get $m signed]} {
        set a [expr {-1.0 * $lo}]
        return [list \
            [list blue    $lo                 [expr {-0.66*$a}]] \
            [list iceblue [expr {-0.66*$a}]   [expr {-0.33*$a}]] \
            [list cyan    [expr {-0.33*$a}]   [expr {-0.11*$a}]] \
            [list white   [expr {-0.11*$a}]   [expr { 0.11*$hi}]] \
            [list yellow  [expr { 0.11*$hi}]  [expr { 0.33*$hi}]] \
            [list orange  [expr { 0.33*$hi}]  [expr { 0.66*$hi}]] \
            [list red     [expr { 0.66*$hi}]  $hi]]
    }
    set sp [expr {$hi - $lo}]
    return [list \
        [list white  $lo                   [expr {$lo+0.25*$sp}]] \
        [list yellow [expr {$lo+0.25*$sp}]  [expr {$lo+0.50*$sp}]] \
        [list orange [expr {$lo+0.50*$sp}]  [expr {$lo+0.75*$sp}]] \
        [list red    [expr {$lo+0.75*$sp}]  $hi]]
}

# -- Scale bar -----------------------------------------------------------------

proc ::VMDPathFinder::scalebar_label_color {} {
    # Resolve the configured scale-bar label color. "auto" makes a best-effort
    # contrast choice from the VMD background and falls back to white if the
    # background color cannot be queried on this build.
    variable state
    set choice $state(scalebar_font_color)
    if {$choice ne "auto"} { return $choice }
    if {[catch {
        lassign [display get backgroundcolor] r g b
        set lum [expr {0.299*$r + 0.587*$g + 0.114*$b}]
        set out [expr {$lum > 0.5 ? "black" : "white"}]
    }]} { set out white }
    return $out
}

proc ::VMDPathFinder::remove_hydro_scalebar {} {
    variable hydro_scalebar_mol
    variable hydro_scalebar_scheme
    variable scalebar_watch_id
    catch {after cancel $scalebar_watch_id}
    set scalebar_watch_id ""
    # Same existence check as every other track delete - see
    # remove_ellipse_surface.
    if {$hydro_scalebar_mol >= 0} {
        if {![catch {molinfo $hydro_scalebar_mol get name}]} {
            catch {mol delete $hydro_scalebar_mol}
        }
        set hydro_scalebar_mol -1
    }
    set hydro_scalebar_scheme ""
}

proc ::VMDPathFinder::_scalebar_surface_on_screen {} {
    # Is there actually a property-colored SURFACE in the 3D viewer for the
    # bar to be a legend FOR?
    #
    # Every gate before this one tested the color MODE (state(surface_color)
    # eq "property", or the tunnel property being set) - a setting that stays
    # true while nothing at all is displayed. So computing a property in Over
    # Time, which is a 2D plot, popped a scale bar into the 3D viewer for a
    # pore surface that was switched off or never built: "the 3d scale bar
    # shows up in 3d visualizer regardless of if the pore is activated or
    # not."
    #
    # Read `displayed` from VMD directly rather than the cached _vis_*_shown
    # flags: those are only refreshed by _update_surface_vis_buttons, so on
    # this path they can be one event behind the mol they describe.
    variable current_surface_mol
    variable mean_surface_mol
    variable tunnel_mean_surface_mol
    variable tunnel_surface_mols
    set mols [list $current_surface_mol $mean_surface_mol $tunnel_mean_surface_mol]
    if {![catch {resolve_molid} _rm] && [info exists tunnel_surface_mols($_rm)]} {
        lappend mols $tunnel_surface_mols($_rm)
    }
    foreach m $mols {
        if {$m eq "" || $m < 0} { continue }
        if {[catch {molinfo $m get displayed} d]} { continue }
        if {$d} { return 1 }
    }
    return 0
}

proc ::VMDPathFinder::draw_hydro_scalebar {sph_file {scheme ""}} {
    # scheme: optional override so a caller OTHER than the main per-frame surface (the
    # Mean Profile 3D tube, which has its own independent mean_hydro_scheme) can drive
    # this SAME single global scale bar with its own property scale. Defaults to the
    # main panel's state(hydro_scheme), matching every existing caller unchanged.
    variable state
    variable hydro_scalebar_mol
    set _scheme [expr {$scheme ne "" ? $scheme : $state(hydro_scheme)}]

    remove_hydro_scalebar
    if {!$state(show_hydro_scalebar)} { return }
    # ONE choke point for "is there anything for this to be a legend for",
    # rather than a repeat of the check at each of the ~8 call sites - several
    # of which reach here from a 2D plot (Over Time's property Compute) that
    # has no reason to touch the 3D viewer at all. Every caller's own gate
    # tests the color MODE, which stays true with the surface switched off.
    if {![_scalebar_surface_on_screen]} { return }

    # ---- technique from VMD colorscalebar plugin (Liang/Wright/Stone) ----
    # 1. save viewpoints for every molecule
    # 2. display resetview  -> neutral camera so screen-space coords work
    # 3. mol new + mol fix  -> bar stays put when user rotates the scene
    # 4. draw at screen-space coords (-1..+1)
    # 5. restore all other molecules' viewpoints
    set old_top [molinfo top]
    if {$old_top == -1} { return }

    array set vpts {}
    foreach mol [molinfo list] {
        set vpts($mol) [molinfo $mol get \
            {center_matrix rotate_matrix scale_matrix global_matrix}]
    }

    display update off
    display resetview

    # The whole draw is wrapped so that ANY failure still restores the saved
    # viewpoints and re-enables "display update" - otherwise an error here leaves
    # the scene reset and the display frozen (the window looks locked/unusable).
    set _sb_err ""
    set _sb_failed [catch {
        set _meta  [property_meta $_scheme]
        set bands  [property_scalebar_bands $_scheme]
        set lbl_fmt [expr {[dict get $_meta signed] ? "%+.2f" : "%.1f"}]

        set hydro_scalebar_mol [mol new]
        mol top $hydro_scalebar_mol
        mol rename $hydro_scalebar_mol "[dict get $_meta label] scale"
        mol fix $hydro_scalebar_mol

        # ---- screen-space geometry (lower-right corner, out of the way like
        # VMD's own axes indicator, rather than vertically centred at full
        # height where it would sit at eye level, snapping against the
        # protein). ----
        set n_bands [llength $bands]
        set bar_w   0.04                                  ;# screen units
        # 0.50 gives each of the (typically 7) band labels real breathing room
        # without growing the bar back toward eye level; smaller values crowd
        # adjacent band labels into the default font's own glyph height.
        # Ten watermelon bands need a taller bar and smaller labels, or the
        # edge labels overprint each other.
        set bar_h   [expr {$n_bands > 7 ? 0.70 : 0.50}]
        set bh      [expr {$bar_h / double($n_bands)}]   ;# per-band height
        set z       0.0
        set fsz     [expr {$n_bands > 7 ? 0.75 : 1.0}]
        # ---- CORNER placement, ASPECT-CORRECTED ----
        # After display resetview, the fixed bar mol draws in clip space where the shorter
        # window dimension maps to [-1,1] and the longer stretches to [-aspect,aspect]
        # (aspect = long/short). VMD's own axes indicator is aspect-corrected, so use the real
        # aspect too, or a right corner lands mid-window instead of at the edge. Handles both
        # landscape and portrait. Default lower-right = the axes' corner; selectable to all four
        # in the gear (Scale & Cutoff) settings.
        set _asp 1.0
        if {![catch {display get size} _sz] && [llength $_sz] == 2} {
            lassign $_sz _dw _dh
            if {$_dh > 0 && $_dw > 0} { set _asp [expr {$_dw / double($_dh)}] }
        }
        set _xedge [expr {$_asp > 1.0 ? $_asp : 1.0}]
        set _yedge [expr {$_asp < 1.0 ? 1.0/$_asp : 1.0}]
        set _corner [expr {[info exists state(scalebar_corner)] ? $state(scalebar_corner) : "Lower right"}]
        set _cl     [string tolower $_corner]
        set _right  [string match "*right*" $_cl]
        set _top    [string match "*top*"   $_cl]
        # The bar's labels/words extend to its RIGHT by up to ~0.32*fontsize; a right
        # corner insets the bar by that much so the widest end-cap word still ends just
        # inside the right edge; a left corner sits flush-left. Both then hug the true
        # edge like the axes indicator.
        set _room [expr {0.32 * ($fsz > 1.0 ? $fsz : 1.0)}]
        set x0      [expr {$_right ? ($_xedge - $_room) : (-$_xedge + 0.03)}]
        set x1      [expr {$x0 + $bar_w}]
        set lbl_x   [expr {$x1 + 0.05}]
        # y_bot = bar's bottom edge; end-cap labels sit 0.12 beyond each end, so a top
        # corner keeps its top cap ~0.03 inside the top edge and a bottom corner its
        # bottom cap ~0.03 inside the bottom edge - both hug the corner, on-screen.
        set y_bot   [expr {$_top ? ($_yedge - 0.15 - $bar_h) : (-$_yedge + 0.15)}]

        # colored quads (two triangles each); bottom = low end, top = high end
        for {set i 0} {$i < $n_bands} {incr i} {
            set col  [lindex [lindex $bands $i] 0]
            set y_lo [expr {$y_bot + $i * $bh}]
            set y_hi [expr {$y_lo  + $bh}]
            draw color $col
            draw triangle "$x0 $y_lo $z" "$x1 $y_lo $z" "$x1 $y_hi $z"
            draw triangle "$x0 $y_lo $z" "$x1 $y_hi $z" "$x0 $y_hi $z"
        }

        # Label color is user-configurable so the scale stays readable on any VMD
        # background (a hard-coded white is invisible when exporting on white).
        set font_col [scalebar_label_color]

        set y_top  [expr {$y_bot + $n_bands * $bh}]
        draw color $font_col
        for {set i 0} {$i < $n_bands} {incr i} {
            set lo   [lindex [lindex $bands $i] 1]
            set y_lo [expr {$y_bot + $i * $bh}]
            draw text "$lbl_x $y_lo $z" [format $lbl_fmt $lo] size $fsz
        }
        draw text "$lbl_x $y_top $z" [format $lbl_fmt [lindex [lindex $bands end] 2]] size $fsz
        # No title above the bar - it only ever restated either the scheme
        # (already shown in the Property picker) or the end-cap labels drawn
        # below (e.g. "Hydrophobicity" sitting right next to "hydrophobic").

        # end-cap polarity labels (property-specific)
        draw color $font_col
        draw text "$x0 [expr {$y_bot - 0.12}] $z" [dict get $_meta loend] size $fsz
        draw text "$x0 [expr {$y_top + 0.12}] $z" [dict get $_meta hiend] size $fsz
    } _sb_err]
    if {$_sb_failed} {
        # drawing failed - drop the partial bar mol so the scene stays clean
        catch {remove_hydro_scalebar}
    }

    # ALWAYS restore scene + re-enable the display, even on error.
    catch {mol top $old_top}
    foreach mol [molinfo list] {
        if {$hydro_scalebar_mol >= 0 && $mol == $hydro_scalebar_mol} { continue }
        if {[info exists vpts($mol)]} {
            catch {molinfo $mol set {center_matrix rotate_matrix scale_matrix global_matrix} $vpts($mol)}
        }
    }
    display update on
    if {!$_sb_failed} {
        variable hydro_scalebar_scheme
        set hydro_scalebar_scheme $_scheme
        # remember the size this drew at + (re)arm the resize watcher so the bar
        # follows the corner when the window is rescaled (like VMD's axes).
        variable scalebar_drawn_size
        variable scalebar_seen_size
        variable scalebar_watch_id
        if {![catch {display get size} _dsz] && [llength $_dsz] == 2} {
            set scalebar_drawn_size $_dsz
            set scalebar_seen_size  $_dsz
        }
        catch {after cancel $scalebar_watch_id}
        set scalebar_watch_id [after 250 ::VMDPathFinder::_scalebar_resize_watch]
    } else {
        set state(status) "Scale bar skipped: $_sb_err"
    }
}

proc ::VMDPathFinder::_scalebar_owner {} {
    # Which surface the property scale bar belongs to right now, as
    # {kind scheme}, or {} when nothing on screen is property-colored.
    #
    # Both callers used to ask ONLY state(surface_color) - the MAIN per-frame
    # surface. So with just the Mean Profile isosurface shown and
    # property-colored, the resize watcher decided the bar was inactive and
    # returned WITHOUT re-arming (killing itself), and the visibility checkbox
    # returned before doing anything. Whether the bar appeared then depended on
    # whether the main surface happened to be property-colored too - which is
    # exactly the reported "sometimes it is not shown".
    variable state
    variable mean_surface_mol
    variable tunnel_mean_surface_mol
    if {[analysis_mode] eq "tunnel"} {
        set p [_tunnel_scalebar_prop]
        if {$p ni {none {}}} { return [list tunnel $p] }
        # The tunnel MEAN tube carries its own coloring and is a separate mol.
        if {[info exists state(show_mean_surface)] && $state(show_mean_surface) \
                && $tunnel_mean_surface_mol >= 0} {
            set p [_tunnel_scalebar_prop]
            if {$p ni {none {}}} { return [list tunnel $p] }
        }
        return {}
    }
    if {[info exists state(surface_color)] && $state(surface_color) eq "property"} {
        return [list pore ""]
    }
    if {[info exists state(surface_color)] && $state(surface_color) eq "watermelon"} {
        return [list pore watermelon]
    }
    if {[info exists state(show_mean_surface)] && $state(show_mean_surface) \
            && $mean_surface_mol >= 0 \
            && [info exists state(mean_surface_color)] \
            && $state(mean_surface_color) in {property watermelon}} {
        return [list mean [expr {$state(mean_surface_color) eq "watermelon" ? "watermelon" : $state(mean_hydro_scheme)}]]
    }
    return {}
}

proc ::VMDPathFinder::_scalebar_resize_watch {} {
    # Poll the VMD window size; when it changes AND has SETTLED (unchanged for one
    # poll, so this don't flicker mid-drag), redraw the scale bar so its aspect-
    # corrected position tracks the corner. Self-cancels when the bar is hidden.
    variable state
    variable scalebar_watch_id
    variable scalebar_drawn_size
    variable scalebar_seen_size
    set scalebar_watch_id ""
    set _active [expr {[_scalebar_owner] ne ""}]
    if {!([info exists state(show_hydro_scalebar)] && $state(show_hydro_scalebar) && $_active)} {
        return
    }
    if {![catch {display get size} sz] && [llength $sz] == 2} {
        if {$sz ne $scalebar_drawn_size && $sz eq $scalebar_seen_size} {
            # size changed since the last draw and is now stable -> redraw (this
            # restarts the watcher via draw_hydro_scalebar's success path).
            catch {on_scalebar_visibility_changed}
            return
        }
        set scalebar_seen_size $sz
    }
    set scalebar_watch_id [after 250 ::VMDPathFinder::_scalebar_resize_watch]
}

proc ::VMDPathFinder::on_scalebar_visibility_changed {args} {
    variable state
    variable results
    if {[analysis_mode] eq "tunnel"} {
        set _sbp [_tunnel_scalebar_prop]
        if {$_sbp in {none {}}} { return }
        if {!$state(show_hydro_scalebar)} {
            remove_hydro_scalebar
        } else {
            catch {draw_hydro_scalebar "tunnel" $_sbp}
        }
        return
    }
    lassign [_scalebar_owner] _sbkind _sbscheme
    if {$_sbkind eq ""} { return }
    if {!$state(show_hydro_scalebar)} {
        remove_hydro_scalebar
        return
    }
    if {$_sbkind eq "mean"} {
        # The mean tube has no .sph of its own, and draw_hydro_scalebar does not
        # read the file anyway (see its own comment) - the scheme override is
        # what matters.
        catch {draw_hydro_scalebar "mean" $_sbscheme}
        return
    }
    if {$state(selected_result_frame) ne "" && \
            [dict exists $results $state(selected_result_frame)]} {
        set sph [dict get [dict get $results $state(selected_result_frame)] sph_file]
        if {[file exists $sph]} { catch {draw_hydro_scalebar $sph $_sbscheme} }
    }
}

proc ::VMDPathFinder::_commit_csg_voxel {args} {
    # A new mesher cell size is new geometry, so drop what is cached and
    # redraw - the same two steps _set_mesher takes.
    variable state
    variable last_geom_key
    foreach k {csg_voxel csg_voxel_fine} {
        set v [string trim $state($k)]
        if {![string is double -strict $v] || $v <= 0} { return }
    }
    set last_geom_key ""
    catch {apply_display_change}
    catch {_render_tunnels_now}
}

proc ::VMDPathFinder::_render_tunnels_now {} {
    # Redraw the tunnel scene for the frame on screen. apply_display_change is
    # the HOLE path only - it works off state(selected_result_frame) and the
    # pore results - so a mesher or grid change had no visible effect in tunnel
    # mode until something unrelated forced a redraw.
    if {[analysis_mode] ne "tunnel"} { return }
    if {[tunnel_surface_is_hidden]} { return }
    set fr [_tunnel_display_frame]
    if {$fr eq ""} { return }
    catch {render_tunnels_for_frame $fr}
}

proc ::VMDPathFinder::surface_geom_key {} {
    # Identity of the .vmd_plot FILE the current Display+Color needs. Two states
    # that share this key render from the same cached geometry, so switching
    # between them is a cheap re-render (no sph_process / sos_triangle rebuild):
    #   - triangulated and wireframe share one mesh (wireframe is a draw flag)
    #   - all solid colors share one mesh (the color is an override at draw time)
    # A key change means the underlying file differs (dots<->mesh, solid<->hole_def
    # <->hydrophobic, or a hydro scheme switch), so the geometry must be rebuilt.
    variable state
    # Geometry identity for apply_display_change. The base mesh is now COLOR-
    # INDEPENDENT - it is triangulated once (radius-colored) and then overridden
    # (solid), shown as-is (hole_def) or recolored (hydrophobic) at render time.
    # So ONLY the mesh class matters here: a color or hydro-scheme change shares
    # the same geometry and re-renders without rebuilding any frame's surface.
    # triangulated and wireframe collapse to one mesh (wireframe is a draw flag);
    # centerline (a sphere path) and dots are distinct.
    # The mesher's own grid is part of the geometry's identity. Without it a
    # changed cell size wrote a differently-named plot that was never asked
    # for: the key compared equal, so the cached asset for every frame stayed,
    # and the setting looked inert.
    set _vx ""
    if {[_csg_active]} { catch {set _vx "|v[_csg_voxel_spec]"} }
    # Dots is gated on _csg_can_mesh, not _csg_active, everywhere it actually
    # builds (prebuild_surfaces_parallel and its siblings check
    # "mode eq dots || _csg_active" - dots is meshed by marching cubes
    # whenever the mesher can run one, regardless of _csg_active excluding
    # it) - the SAME gate surface_mesh_tag itself uses for the file it
    # actually writes. Using _vx (built above from _csg_active alone) left
    # dots-mode geometry keyed the same across a grid change even though the
    # file on disk was already correctly named differently.
    set _dvx ""
    if {[_csg_can_mesh]} { catch {set _dvx "|v[_csg_voxel_spec]"} }
    switch -- $state(display_mode) {
        centerline { return "centerline$_vx" }
        dots       { return "dots$_dvx" }
        default    {
            # pore_lat and the sideways gate are the exceptions to "color is a
            # draw-time override": both are separate MESHES, so they need their
            # own key or a switch back re-renders the cached one. Both must also
            # carry _conn_surface_suffix (trim/gate/draft) - without it, toggling
            # Trim while viewing either split coloring computed an unchanged
            # key, so the pre-toggle mesh kept rendering (a silent no-op).
            if {[_conn_lobes_active]}    { return "mesh_lobes_[_conn_lobes_tag][_conn_surface_suffix]$_vx" }
            if {[_conn_two_tone_active]} { return "mesh_2tone_[_conn_margin_tag][_conn_surface_suffix]$_vx" }
            return "mesh[_conn_surface_suffix]$_vx"
        }
    }
}


proc ::VMDPathFinder::on_display_setting_changed {args} {
    # Coalesce a burst of writes (e.g. a menu pick) into one apply on idle.
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    variable display_apply_after
    if {[info exists display_apply_after] && $display_apply_after ne ""} {
        after cancel $display_apply_after
    }
    set display_apply_after [after 40 ::VMDPathFinder::apply_display_change]
}

proc ::VMDPathFinder::on_hydro_method_changed {args} {
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    # A change to the hydrophobicity method (scheme, atom/residue averaging, or
    # the pore-facing filter) changes every per-frame colored surface AND the
    # hydrophobicity-profile tab. Drop the cached colored meshes and profile
    # memo so both rebuild, then re-apply the display.
    variable results
    variable plot_cache
    variable plot_cache_order
    variable hydro_profile_cache
    variable hm_prop_cache
    variable hm_render_cache
    variable state
    variable hydration_data
    # Guard: gz/dens/pfdens schemes require hydration_data from the Hydration
    # tab; pfdens (the 3D surface's water option) specifically needs PER-FRAME
    # data. Revert to kd and show a status message so the user knows what to do,
    # rather than letting the surface build fail later with a buried error.
    if {[info exists state(hydro_scheme)] && $state(hydro_scheme) in {gz dens pfdens}} {
        set _need_pf [expr {$state(hydro_scheme) eq "pfdens"}]
        set _no_data [expr {$hydration_data eq "" || [llength [dict get $hydration_data coords]] < 2}]
        set _no_pf   [expr {$_need_pf && !$_no_data && \
            (![dict exists $hydration_data perframe_frames] || \
             [llength [dict get $hydration_data perframe_frames]] == 0)}]
        if {$_no_data || $_no_pf} {
            set _hint [expr {$_need_pf ? " (with Per-frame data enabled)" : ""}]
            set state(status) "[_surface_scheme_label $state(hydro_scheme)]: run Compute in the Hydration tab first$_hint."
            set state(hydro_scheme) kd
            return
        }
    }
    if {[info exists results]} {
        foreach f [dict keys $results] { dict set results $f asset {} }
    }
    cache_clear plot
    # The Over Time heatmap is independent of the surface color scheme - it
    # has its own hm_prop_scheme. A pure surface-color (hydro_scheme) change
    # must not touch the heatmap's caches at all; only a LINING change
    # (facing/sidechain/avg-mode), which the heatmap shares, invalidates it.
    # hydro_3d_accurate is the same kind of surface-only setting: it isn't
    # part of the heatmap's cache key at all (hydro3d_props_fast_available -
    # the checkbox controls the 3D isosurface only, panels always use the
    # true-3D average regardless), so it must be excluded here too or every
    # toggle force-redraws Over Time for no reason.
    variable w
    if {[lindex $args 1] ni {hydro_scheme hydro_3d_accurate}} {
        if {[lindex $args 1] in {hydro_facing hydro_shell lining_dist_thresh hydrophob_kde_bandwidth}} {
            # Facing/shell/margin change: keep the existing rendered photo so
            # the user still sees the heatmap, but mark it stale so draw_heatmap
            # overlays a banner instead of auto-recomputing (which can take
            # minutes on long runs). The user clicks Compute to update with the
            # new setting. lining_dist_thresh is included because it drives
            # the lining/facing test (_lining_facing_sets) that gates
            # the Pore-facing property-averaging filter, same as facing/shell.
            # EXCEPT: if the data for the NEW combination is already sitting in
            # hydro3d_props_cache - e.g. the user flipped a setting back to a value
            # Mean Profile Fill (or a prior Compute) already warmed for every frame -
            # there is genuinely nothing stale; don't warn, just let draw_heatmap show
            # the already-computed result. Only a real settings mismatch (a genuine
            # miss on this same cache key) still gates on an explicit Compute click.
            variable _hm_stale_reason
            variable result_frames
            set _hmsch_now [expr {[info exists state(hm_prop_scheme)] ? $state(hm_prop_scheme) : $state(hydro_scheme)}]
            if {[info exists result_frames] && [_hydro3d_props_all_cached $result_frames $_hmsch_now]} {
                set _hm_stale_reason ""
            } else {
                set _hm_stale_reason "facing"
            }
        } else {
            set hm_render_cache {}
        }
        # Only redraw if the user is already viewing the Over-Time tab (prevents
        # a frozen UI from a background-triggered all-frames Tcl batch).
        if {[info exists state(heatmap_color_by)] && \
                $state(heatmap_color_by) eq "property" && \
                ![catch {$w.plotframe.nb select} _tab] && [string match {*.heatmap} $_tab]} {
            catch {draw_heatmap}
        }
        if {[lindex $args 1] in {hydro_facing hydro_shell lining_dist_thresh hydrophob_kde_bandwidth}} {
            # Live-refresh the "Show pore facing" VISUALIZATION (if currently
            # shown) so it reflects the new shell/facing/margin setting
            # immediately, rather than waiting for an unrelated frame change to
            # "notice".
            catch {update_pore_facing_rep}
            # The Hydration tab's Hydrophobicity profile is built from these SAME gear knobs
            # (smoothing bandwidth + pore-facing/lining), so redraw it live if the user is
            # currently viewing it - otherwise a knob change silently leaves the on-screen
            # profile stale until an unrelated redraw. Its Density/Energy/heatmap views don't
            # use these knobs (they come from the Hydration Compute), so gate on hydrophob.
            if {[info exists state(hydration_view)] && $state(hydration_view) eq "hydrophob" && \
                    ![catch {$w.plotframe.nb select} _htab] && [string match {*.hydration} $_htab]} {
                catch {draw_hydration_tab}
            }
        }
        if {[lindex $args 1] eq "lining_dist_thresh"} {
            # Margin also changes the "Show pore lining" set directly (it's no
            # longer a fixed vdW-touching test - see _lining_facing_sets).
            catch {update_pore_lining_rep}
        }
    }
    on_display_setting_changed
}

proc ::VMDPathFinder::_sync_property_scheme_across_panels {name1 name2 op} {
    # Connect the property SELECTION across the panels that show the SAME
    # quantity in different views: Visualization (hydro_scheme, the 3D surface),
    # Pore Profile Fill (profile_color_scheme) and Mean Profile
    # (mean_hydro_scheme). Picking a property in any one syncs the same choice
    # into the others, so they cannot disagree about what is on screen. Each
    # already reacts cheaply to its own scheme change alone (hydro_scheme
    # rebuilds only the current frame; the two plots redraw one cached canvas),
    # so syncing just fires those already-cheap reactions together.
    #
    # A1 - Over Time (hm_prop_scheme) is deliberately NOT in this set. It was,
    # and the user's complaint was exactly that: changing the Over Time picker
    # recolored the 3D visualiser. Over Time is also the one panel where a
    # property change is EXPENSIVE (a per-frame batch behind a Compute button),
    # so joining it made the cheap panels drag the costly one along. It keeps
    # its own value; hm_prop_cache holds several schemes at once, so switching
    # back and forth there is already free.
    #
    # A2 - mean_hydro_scheme replaced hm_prop_scheme in this set by user
    # instruction. Its extra
    # hydration-only choices (gz/dens) simply do not propagate: the per-target
    # valid-choice gate below drops any value the target cannot render.
    variable state
    variable _syncing_property_scheme
    if {$_syncing_property_scheme} { return }
    set _syncing_property_scheme 1
    # Each write below fires the target's own traces SYNCHRONOUSLY; if any of those
    # downstream handlers ever throws, the guard must STILL reset - otherwise it is
    # stranded at 1 and cross-panel scheme sync silently dies for the rest of the
    # session ("changing the property in one panel stops updating the others").
    # Wrap the body so the reset in the finally-clause below always runs.
    catch {
        set new_val $state($name2)
        # Not every scheme is offered by every picker ("pfdens" is Over-Time-only). Gate
        # each target write by ITS OWN valid-choice list rather than special-casing one
        # scheme name, so a value only propagates where it can actually be rendered.
        array set _valid [list \
            hydro_scheme            [_scheme_values [_property_scheme_choices]] \
            profile_color_scheme   [_scheme_values [_profile_fill_scheme_choices]] \
            mean_hydro_scheme       [_scheme_values [_mean_hydro_scheme_choices]] \
        ]
        foreach _k {hydro_scheme profile_color_scheme mean_hydro_scheme} {
            if {$_k eq $name2 || ![info exists state($_k)]} continue
            if {[lsearch -exact $_valid($_k) $new_val] < 0} continue
            if {$state($_k) ne $new_val} { set state($_k) $new_val }
        }
    }
    set _syncing_property_scheme 0
}

proc ::VMDPathFinder::refresh_hydro_views {} {
    # The property is now drawn as a gradient on the Pore Profile tab, so a change
    # to the scheme / lining (from the sidebar or the profile bar) refreshes that
    # plot. Cheap cached canvas repaint, gated on a frame being selected.
    catch {redraw_profile_plot}
}

proc ::VMDPathFinder::_display_state_sig {} {
    # Everything a redraw reads. Used to tell "the state moved while this were
    # drawing" from "the plugin's own render pumped the event loop and asked for the
    # pass this just did". The geometry key alone is not enough: two flat colours
    # share a key, so a green -> blue made mid-render would look like no change.
    variable state
    set sig ""
    foreach k {display_mode surface_color surface_material hydro_scheme hydro_facing
               selected_result_frame show_pore_lining show_pore_facing} {
        append sig "|" [expr {[info exists state($k)] ? $state($k) : ""}]
    }
    return "$sig|[surface_geom_key]"
}

proc ::VMDPathFinder::apply_display_change {} {
    # Re-entrancy guard. Rendering pumps the event loop (render_vmd_plot_to_mol
    # runs `update idletasks` between chunks), which lets a queued apply fire
    # mid-render; that one renders too and pumps again. Measured on one
    # hole_def -> property switch: apply_display_change ran 3 times and
    # rendered the same frame 3 times, 1410 ms. Collapse the nested calls and
    # run ONE more pass at the end if state moved while this were drawing, so a
    # change made mid-render is not lost.
    variable _display_applying
    variable _display_apply_again
    if {[info exists _display_applying] && $_display_applying} {
        set _display_apply_again 1
        return
    }
    set _display_applying 1
    set _display_apply_again 0
    set _adc_sig [_display_state_sig]
    set _adc_code [catch {_apply_display_change_now} _adc_res _adc_opts]
    set _display_applying 0
    if {$_display_apply_again} {
        set _display_apply_again 0
        # ...but only when the state genuinely moved. A nested request raised by
        # the plugin's own render pumping the event loop asks for the pass this just did;
        # re-running it draws the same frame a second time for nothing.
        if {[_display_state_sig] ne $_adc_sig} { catch {_apply_display_change_now} }
    }
    if {$_adc_code == 1} { return -options $_adc_opts $_adc_res }
    return $_adc_res
}

proc ::VMDPathFinder::_apply_display_change_now {} {
    # Auto-apply a Display / Color / Hydro-scheme change to the live surface.
    # Re-renders the selected frame; rebuilds per-frame geometry ONLY when the
    # geometry identity changed (so solid-color and wireframe<->triangulated
    # switches stay instant, while dots/hole_def/hydrophobic/scheme switches
    # rebuild and lazily refresh other frames).
    variable state
    variable results
    variable last_geom_key
    variable display_apply_after
    set display_apply_after ""
    if {$state(display_mode) eq "none"} {
        clear_surface
        set last_geom_key "none"
        set state(status) "Display cleared."
        return
    }
    set key [surface_geom_key]
    set geometry_changed [expr {![info exists last_geom_key] || $key ne $last_geom_key}]
    set last_geom_key $key
    # INVALIDATE BEFORE the no-frame-selected guard, never after it. This used to
    # sit below that guard, so a mode change made while no result row was
    # selected - the normal state after Run + Play - stamped last_geom_key as
    # applied while dropping nothing. Every later call then compared equal, so
    # the assets built under the OLD mode were never cleared and exactly those
    # frames kept rendering in it: centerline selected, isosurface on screen,
    # and only on the frames that happened to be cached. Switching away and back
    # appeared to fix it because that produced two further key changes.
    # Rendering still needs a selected frame; invalidation does not.
    if {$geometry_changed} {
        # The cached meshes no longer match the requested geometry/color-source.
        # Drop the in-memory parsed-plot cache and every frame's built asset so
        # each frame rebuilds to the new look the next time it is shown.
        cache_clear plot
        foreach f [dict keys $results] { dict set results $f asset {} }
        _mem_forget_assets
    }
    # Which frame to repaint: the selected result row, or - with no row selected
    # (the normal state after Run + Play) - the frame whose surface is already on
    # screen. Without the fallback, a color/scheme/facing change made in that
    # state invalidated every cache above and then repainted NOTHING: the visible
    # surface kept its old colors with no message, and the new look only appeared
    # on the next row click, which reads as "the setting does nothing".
    variable _last_rendered_frame
    set _adc_frame $state(selected_result_frame)
    if {$_adc_frame eq "" || ![dict exists $results $_adc_frame]} {
        if {[info exists _last_rendered_frame] && \
                [dict exists $results $_last_rendered_frame]} {
            set _adc_frame $_last_rendered_frame
        } else {
            return
        }
    }
    # Build (if needed) + render that frame now.
    if {[catch {load_surface_for_frame $_adc_frame} err]} {
        # LOG IT TOO, do not just drop it in the status bar - the very next status
        # update overwrites it, and a surface that silently fails to build after a
        # successful compute (profile present, 3D surface absent) is otherwise
        # confusing with no trace of why. vmdcon keeps it in the console, errorInfo
        # keeps the stack.
        set state(status) "Surface not built: $err"
        catch {vmdcon -err "VMDPathFinder: surface build FAILED for frame '$_adc_frame': $err"}
        catch {vmdcon -err "VMDPathFinder: $::errorInfo"}
        return
    }
    # The other memories follow the same display mode, mesher and colour
    # mode; left alone they kept whatever they were drawn with last.
    catch {_mem_render_other_memories $_adc_frame 0}
    catch {display update}
    catch {refresh_hydro_views}
    # Property coloring: proactively recolor every OTHER frame whose base geometry
    # already exists on disk, so scrubbing/release afterward hits a cache. Disk-aware and
    # idempotent (checks file mtimes, not the asset dict just cleared above), so calling
    # it on every scheme change is safe - a fast no-op once cached. Only the cheap
    # recolor runs here, never the full geometry prebuild.
    # Gated on state(prebuild_surfaces): fires on EVERY interactive scheme/facing pick,
    # so without the opt-in it must not silently trigger a full-trajectory background
    # computation ("Accurate 3D" in particular is much heavier per-frame).
    # load_surface_for_frame above already rendered the current frame; other frames build
    # lazily on first visit unless the checkbox is on.
    if {$state(surface_color) eq "property" && $state(prebuild_surfaces) && \
            [dict size $results] > 1} {
        # Defer the (potentially multi-second) all-frames property pre-cache OUT of
        # this interactive handler: the frame on screen is already rendered above, and
        # the prebuild is only a scrub-ahead cache. Running it inline froze the UI for
        # a couple of seconds AFTER the surface appeared (the "hiccup"). `after idle`
        # (NOT a fixed delay) fires the instant the event loop is free - so nothing the
        # user sees is delayed - yet it's off the render path; the deferred pass itself
        # pumps the event loop while it works so the UI never freezes. Rapid scheme/
        # scrub changes cancel + reschedule, so it runs once the user settles.
        variable prebuild_after
        if {[info exists prebuild_after] && $prebuild_after ne ""} {
            after cancel $prebuild_after
        }
        set prebuild_after [after idle ::VMDPathFinder::_deferred_property_prebuild]
    }
    # NOTE: the Mean Profile 3D surface has its OWN exclusive Color/Material/Property
    # (mean_surface_color/mean_surface_material/mean_hydro_scheme, set from its own
    # "Coloring options" row) - a main-panel display/color change here must NOT rebuild
    # it. refresh_mean_surface_if_shown is called from those mean-exclusive controls'
    # own traces instead (on_mean_coloring_changed) and from on_mean_stats_changed.
}

proc ::VMDPathFinder::_deferred_property_prebuild {} {
    # Runs the all-frames property pre-cache OFF the interactive display-change path
    # (scheduled by apply_display_change via `after 250`). prebuild_hydro_variants_
    # parallel yields to the event loop as it works (its sidecar loop + run_shell_pool
    # + prime_hydro_fastpath_cache all pump `update`), so the UI stays usable instead
    # of freezing for a couple of seconds. The busy guard stops a scheme change made
    # DURING one of those `update` calls from re-entering a second overlapping pass -
    # the running pass is disk-mtime-gated and idempotent, so the newer scheme's
    # prebuild simply runs after this one returns (a fresh `after` is rescheduled).
    variable prebuild_after
    variable prebuild_busy
    set prebuild_after ""
    if {[info exists prebuild_busy] && $prebuild_busy} { return }
    set prebuild_busy 1
    catch {prebuild_hydro_variants_dispatch}
    set prebuild_busy 0
}

proc ::VMDPathFinder::prebuild_hydro_variants_dispatch {} {
    # Route to whichever prebuild matches the current coloring mode: the
    # axial (values/recolor) batch when "Accurate 3D coloring" is off, the
    # true-3D batch when it's on - each has its own C-side batch mode, and
    # dispatching to the wrong one would either skip the prebuild or write a
    # mismatched cache file.
    variable state
    if {[info exists state(hydro_3d_accurate)] && $state(hydro_3d_accurate)} {
        prebuild_hydro3d_variants_parallel
    } else {
        prebuild_hydro_variants_parallel
    }
}

proc ::VMDPathFinder::on_material_changed {args} {
    variable _mem_swapping
    if {[info exists _mem_swapping] && $_mem_swapping} { return }
    # Material has its own handler (not apply_display_change) because a material
    # change is special: re-rendering produces an IDENTICAL display list (same
    # geometry, same per-vertex colors - only the material binding differs), and
    # a plain "display update" does not always repaint that on the graphics track.
    # A frame seek does (it rebuilds the track's display list), which is why the
    # change only showed after play/seek. So here this re-render with the new
    # material and then force that same rebuild: toggle the track off/on and
    # re-assert the current animation frame (the programmatic equivalent of a seek).
    variable state
    variable current_surface_mol
    variable syncing_frame
    variable material_after
    if {[info exists material_after] && $material_after ne ""} { after cancel $material_after }
    set material_after [after 50 ::VMDPathFinder::apply_material_now]
}

proc ::VMDPathFinder::apply_material_now {} {
    variable state
    variable current_surface_mol
    variable syncing_frame
    variable material_after
    set material_after ""
    if {$state(display_mode) eq "none"} { return }
    if {$state(selected_result_frame) eq ""} { return }
    # A coloring that BAKES the material into the mesh file - pore_lobes writes
    # it as a "draw material" line per region, and resolves each region set to
    # "follow panel" against THIS value at write time - makes the material part
    # of surface_geom_key. The seek trick below cannot help there: the file on
    # disk still carries the old material, so re-rendering it shows the old
    # material. apply_display_change is what drops the stale per-frame assets,
    # and skipping it is why the panel's Material did nothing under pore_lobes
    # while the same pick from the openings gear (which routes through
    # on_display_setting_changed) worked.
    variable last_geom_key
    if {![info exists last_geom_key] || [surface_geom_key] ne $last_geom_key} {
        apply_display_change
        set state(status) "Surface material: $state(surface_material)."
        return
    }
    # Only the frame trace (frame_changed) reliably redraws the surface under the
    # new material - a plain "display update" or a mol off/on re-shows a cached
    # render (the previous material). So step one frame and back so the trace
    # fires. Two refinements over a naive step: (1) turn AUTOMATIC display updates
    # OFF across the step so the intermediate frame is never drawn on screen (no
    # visible scrub), and (2) draw the landing frame at FULL detail before the one
    # render, so the new material appears immediately instead of after the trace's
    # deferred full-detail settle. Net: instant and flicker-free.
    set nf 1; set cf 0
    catch {
        set pm [resolve_molid]
        set cf [molinfo $pm get frame]
        set nf [molinfo $pm get numframes]
    }
    if {$nf > 1} {
        catch {display update off}
        catch {
            animate goto [expr {$cf > 0 ? $cf - 1 : 1}]
            animate goto $cf
        }
        # Turn display on BEFORE rendering so VMD sees the new material rather
        # than discarding it as a no-op while display updates are suppressed.
        catch {display update on}
        catch {load_surface_for_frame $state(selected_result_frame)}
        catch {display update}
    } else {
        # Single-frame structure: no frame to step. Redraw and toggle the track
        # (update between off and on so "on" rebuilds rather than restoring cache).
        catch {load_surface_for_frame $state(selected_result_frame)}
        if {$current_surface_mol >= 0 && ![catch {molinfo $current_surface_mol get name}]} {
            catch {mol off $current_surface_mol}
            catch {display update}
            catch {mol on  $current_surface_mol}
        }
        catch {display update}
    }
    set state(status) "Surface material: $state(surface_material)."
}

