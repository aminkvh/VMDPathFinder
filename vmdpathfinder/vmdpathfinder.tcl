    grid $d.flipy -row $row -column 0 -sticky w -padx 8 -pady {8 3}; incr row
    add_tooltip $d.flipy "Reverse the frame axis direction of the Over Time heatmap."
    grid [_settings_btn_row $d ::VMDPathFinder::draw_heatmap] -row $row -column 0 -sticky w -padx 8 -pady {10 10}; incr row
