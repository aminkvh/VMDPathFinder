proc ::VMDPathFinder::_update_heatmap_picker_visibility {} {
    variable state
    variable w
    set eb $w.plotframe.nb.heatmap.exportbar
    # Headless guard - see _have_tk.
    if {![_have_tk]} { return }
    if {![winfo exists $eb]} { return }
    set is_prop [expr {[info exists state(heatmap_color_by)] && $state(heatmap_color_by) eq "property"}]
    # Re-pack the mode-specific widgets from scratch to keep visual order stable.
    # (Flip Y moved into the ⚙ Over Time settings popup - no longer packed here.)
    # cby is included so the whole left group is packed here in one known order
    # rather than half at build time; without that, forgetting it for Tunnel
    # mode below would leave nothing able to put it back in the right place.
    pack forget $eb.cby $eb.sch $eb.schl $eb.psch $eb.pcompute $eb.rsrc
    catch {pack forget $eb.tprop}
    # Tunnel mode: Color by (Radius/Property) applies, the radius SOURCE does
    # not - there is no per-slice ellipse fit for a branching path. The
    # property scheme picker is absent too: HOLE's hm_prop_scheme lists schemes
    # tunnel mode cannot draw. The MOLE property comes from this tab's own
    # picker ($eb.tprop / _hm_tunnel_prop) instead. Color scheme only means
    # anything for radius - a property carries its own palette.
    # Absent, not greyed, and NOT reset: the values keep the user's HOLE-mode
    # choice for when they switch back (same rule as
    # _sync_profile_exportbar_for_mode, which only resets profile_view_mode
    # because the tunnel path actually reads it).
    if {[analysis_mode] eq "tunnel"} {
        pack $eb.cby -side left -padx {10 0}
        if {$is_prop} {
            _populate_hm_tunnel_prop_menu
            pack $eb.tprop -side left -padx {10 0}
        } else {
            pack $eb.schl -side left -padx {10 0}
            pack $eb.sch  -side left -padx {2 0}
        }
        return
    }
    catch {pack forget $eb.tprop}
    pack $eb.cby -side left -padx {10 0}
    if {$is_prop} {
        # Property mode, grouped LEFT: Property → scheme picker → Compute.
        pack $eb.psch     -side left -padx {10 4}
        pack $eb.pcompute -side left -padx {0 4}
    } else {
        # Radius mode, grouped LEFT reading in order: Color by -> Radius source
        # (HOLE/Ellipse) -> Color scheme (Viridis/...), right after each other instead
        # of the color-scheme picker being stranded on the right near Export/gear.
        # The Ellipse source is a costly per-frame ray-cast, so it gets the same
        # Compute gate as Property mode (HOLE circular is already parsed - no button).
        pack $eb.rsrc -side left -padx {10 0}
        pack $eb.schl -side left -padx {10 0}
        pack $eb.sch  -side left -padx {2 0}
        if {[info exists state(heatmap_radius_source)] && $state(heatmap_radius_source) eq "ellipse"} {
            pack $eb.pcompute -side left -padx {6 0}
        }
    }
}

proc ::VMDPathFinder::_populate_hm_tunnel_prop_menu {} {
    # Same MOLE property set the other two tunnel pickers offer. Rebuilt on show
    # rather than at construction so it always reflects the current label table.
    # -variable is Over Time's OWN _hm_tunnel_prop_tok, so the selected dot
    # tracks this tab's property and not the tunnel's display property.
    variable w
    variable state
    if {![_have_tk]} { return }
    set m $w.plotframe.nb.heatmap.exportbar.tprop.m
    if {![winfo exists $m]} { return }
    catch {$m delete 0 end}
    foreach tok [_tunnel_prop_tokens] {
        $m add radiobutton -label [::VMDPathFinder::_tunnel_prop_label $tok] \
            -value $tok -variable ::VMDPathFinder::_hm_tunnel_prop_tok \
            -command [list ::VMDPathFinder::_hm_tunnel_prop_pick $tok]
    }
    catch {_menu_apply_column_breaks $m}
    # state(hm_tunnel_prop) is authoritative (it is what the renderer and the
    # cache keys read); the tok mirror only drives the radiobutton indicator.
    set _tok [_hm_tunnel_prop]
    set ::VMDPathFinder::_hm_tunnel_prop_tok $_tok
    catch {set state(hm_tunnel_prop_disp) [::VMDPathFinder::_tunnel_prop_label $_tok]}
}

proc ::VMDPathFinder::_hm_tunnel_prop {} {
    # Which MOLE property tunnel-mode Over Time plots. INDEPENDENT of the
    # per-tunnel display property (_tunnel_effective_prop_for_cluster) since A1 -
    # changing this picker used to rewrite the selected tunnel's override, which
    # recolored the 3D route as a side effect of touching a 2D plot.
    variable state
    if {[info exists state(hm_tunnel_prop)] && $state(hm_tunnel_prop) ne "" \
            && $state(hm_tunnel_prop) ne "none"} {
        return $state(hm_tunnel_prop)
    }
    return "hydropathy"
}

proc ::VMDPathFinder::_hm_tunnel_prop_pick {tok} {
    # Over Time's own property only - deliberately does NOT call
    # _tunnel_profile_prop_pick any more. Pore Profile Fill, the 3D route
    # and Mean Profile keep sharing the per-tunnel override between themselves.
    variable state
    set ::VMDPathFinder::_hm_tunnel_prop_tok $tok
    set state(hm_tunnel_prop) $tok
    catch {set state(hm_tunnel_prop_disp) [::VMDPathFinder::_tunnel_prop_label $tok]}
    catch {draw_heatmap}
}

