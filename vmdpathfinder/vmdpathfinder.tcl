## NAME: vmdpathfinder
##
## SYNOPSIS:
##   VMDPathFinder is a Tcl/Tk plugin for VMD that runs HOLE (Smart et al., 1996) on a
##   single structure or a frame-selected trajectory slice, displays the pore
##   radius profile inside the plugin GUI, and loads the resulting pore surface
##   back into VMD for inspection.
##
## VERSION: 1.0.2
##   Requires Tcl/Tk 8.5 for the GUI (the Tk-free analysis core loads headless
##   regardless, via `vmd -dispdev text`), so it runs on VMD 1.9.x as well as
##   VMD 2.0+. Rotated axis labels need Tk 8.6 and are stacked instead on 8.5 -
##   see _cv_vtext. Developed and exercised on both VMD 1.9.4a57 (Tcl/Tk 8.5.6)
##   and VMD 2.0.0b1 (8.6.17).
##   Requires HOLE 2.2  (hole, sph_process, sos_triangle)
##
## PROCEDURES (public entry points):
##   vmdpathfinder_singleframe_tk  -- open the main plugin window
##
## DISPLAY MODES (surface geometry; independent of Color/Property):
##   none          -- run HOLE analysis only, no surface loaded
##   centerline    -- pore axis as a thin tube/line
##   dots          -- dot surface (sph_process points when the fast sos_triangle
##                    is available, else derived from the sphere-mesh vertices)
##   wireframe     -- mesh surface (sos_triangle)
##   triangulated  -- solid triangulated surface (sos_triangle)
##   Any mode can be colored by radius, HOLE's own banding, or a property scale
##   (see the Property field: Kyte-Doolittle, Wimley-White, Fauchere-Pliska,
##   Kapcha-Rossky, formal charge, Grantham polarity, or water density/G(z)).
##
## AUTHOR:
##   Amin Akbari Ahangar
##   Department of Biomolecular Sciences, University of Mississippi
##   aakbari1@go.olemiss.edu
##
## LICENSE:
##   VMDPathFinder's ORIGINAL code: MIT License -- see LICENSE in the repository root.
##   This file ALSO contains code derived from HOLE 2 (Apache License 2.0);
##   the MIT statement above does not cover those portions. The Apache text and
##   the required modification notice ship beside this file, inside vmdpathfinder/,
##   as LICENSE-Apache-2.0.txt and NOTICE.md -- read NOTICE.md before
##   redistributing.
##
## CITATION:
##   Cite VMDPathFinder, VMD, and HOLE for every analysis. Add citations for the
##   specific methods reported. See Help > Guide & Citations... for entries.
##
##   Kyte, J. & Doolittle, R.F.  A simple method for displaying the hydropathic
##   character of a protein.  J. Mol. Biol. 157, 105-132 (1982).
##
##   Wimley, W.C. & White, S.H.  Experimentally determined hydrophobicity scale
##   for proteins at membrane interfaces.  Nat. Struct. Biol. 3, 842-848 (1996).
##
##   Klesse, G., Rao, S., Sansom, M.S.P. & Tucker, S.J.  CHAP: a versatile tool
##   for the structural and functional annotation of ion channel pores.
##   J. Mol. Biol. 431, 3353-3365 (2019).
##
##   Seiferth, D. & Biggin, P.C.  Exploring the influence of pore shape on
##   conductance and permeation.  Biophys. J. 123, 3107-3119 (2024).
##
## ACKNOWLEDGEMENTS:
##   Scale-bar screen-space rendering technique adapted from:
##   colorscalebar.tcl (VMD plugin) by Wuwei Liang, Dan Wright, John Stone,
##   and Axel Kohlmeyer.  https://www.ks.uiuc.edu/Research/vmd/plugins/
##

package provide vmdpathfinder 1.0.2
# Tk is required LAZILY (in show_gui), not here, so the package can be loaded in a
# headless VMD session (`vmd -dispdev text`) for scripted trajectory analysis where
# no display / Tk is available. Requiring Tk at load blocked `package require vmdpathfinder`
# entirely on HPC/batch nodes even though the whole computational core is Tk-free.

namespace eval ::VMDPathFinder:: {
    # Where this file lives, captured HERE because `info script` is only the
    # plugin at source time - a proc that asks for it at CALL time gets whatever
    # is being sourced then, or "." if nothing is. The pure-Tcl MOLE modules sit
    # beside this file and are loaded on demand, so they need the real path.
    variable plugin_dir [file normalize [file dirname [info script]]]

    # Height budget for the left panel's own content. The tunnel panel drives
    # the whole window's height, and letting it ask for everything it wants
    # opened the window at ~750px ("stretched"). build_gui spends this budget on
    # the fixed controls first and gives the remainder to the tunnel list, which
    # scrolls internally - so lowering this shortens the window without putting
    # any control out of reach.
    variable SIDEBAR_HEIGHT_BUDGET 470

    variable version 1.0.2
    # Optional nightly/dev build tag, appended to the title, console banner and CPU
    # diagnostic ONLY when non-empty. Dated stamps like "2026-07-26w" belong to
    # nightly builds; a tagged release is identified by its version alone, so this is
    # empty here.
    variable build ""
    variable accel_tooltip ""
    # Dewetting free-energy barrier (kcal/mol, relative to bulk) at or above which a
    # sterically-open constriction is flagged as a HYDROPHOBIC GATE in the metrics
    # readout - CHAP's central point that pore RADIUS alone can miss (Klesse 2019).
    # ~1 kcal/mol ~= 1.7 kT at 300 K, an e^-1.7 ~= 5x water depletion vs bulk.
    variable GATE_G_KCAL 1.0
    variable plugin_author "Amin Akbari Ahangar"
    variable w ".vmdpathfinder"
    variable plot_handle {}
    variable plot_available 0
    variable results [dict create]
    variable result_frames {}
    # Tunnel mode keeps its OWN results, root and surface track. Nothing here is
    # shared with `results`/`result_frames`: the two modes answer different
    # questions and a mixed store would be indistinguishable downstream.
    variable tunnel_results
    array set tunnel_results {}
    # Lining layers and physico-chemical properties per frame, keyed the same
    # way as tunnel_results. Populated only when the engine emitted them.
    variable tunnel_lining
    array set tunnel_lining {}
    # Per-cavity draw ticks (show_tunnel_cavities), keyed by per-frame cavity id.
    variable tunnel_cavity_shown
    array set tunnel_cavity_shown {}
    variable tunnel_result_frames {}
    # Cross-snapshot clusters (CAVER-style) + the {cid,frame -> rank} lookup that
    # gives a tunnel an identity across the trajectory. See _tunnel_xframe_build.
    variable tunnel_xclusters {}
    variable tunnel_xrank
    array set tunnel_xrank {}
    variable tunnel_xcid
    array set tunnel_xcid {}
    # {frame rank} -> distance to that pathway's cluster representative, filled
    # by the kernel's third --tunnel-cluster column. See _tunnel_repr_dist.
    variable tunnel_xrepr_dist
    array set tunnel_xrepr_dist {}
    variable tunnel_root {}
    variable tunnel_surface_mols
    array set tunnel_surface_mols {}
    variable tunnel_shown
    array set tunnel_shown {}
    # Per-cross-frame-cluster show/hide memory, so the 3D checkbox follows a
    # TUNNEL across frames instead of whatever holds its rank slot - see
    # _tunnel_sync_shown_from_cluster.
    variable tunnel_shown_cid
    array set tunnel_shown_cid {}
    # Per-tunnel display overrides (the row gear popup, show_tunnel_gear_settings):
    # keyed by tunnel index (1-based, matches tunnel_shown/tunnel_results), NOT
    # persisted across a fresh search (a re-run renumbers tunnels, so a stale
    # override would silently land on the wrong route). Empty string/"auto" means
    # "use the existing default" for that field - color falls back to _tunnel_color's
    # rank palette, material to Opaque, wire to non-wireframe, prop to state(tunnel_prop).
    # Color override only affects the FLAT fallback path (property coloring, whichever
    # property is in effect, still bakes its own per-triangle colors into the cached
    # .plot) - material/wireframe/prop apply unconditionally - see render_tunnels_for_frame.
    # Per-pocket display overrides (show_cavity_gear_settings) and which
    # pockets currently have their lining drawn. Dicts keyed by TRACKED id.
    variable cavity_gear_color
    set cavity_gear_color [dict create]
    variable cavity_gear_material
    set cavity_gear_material [dict create]
    variable cavity_gear_style
    set cavity_gear_style [dict create]
    variable _cavity_lining_on
    set _cavity_lining_on [dict create]
    variable tunnel_gear_color
    array set tunnel_gear_color {}
    variable tunnel_gear_material
    array set tunnel_gear_material {}
    variable tunnel_gear_wire
    array set tunnel_gear_wire {}
    variable tunnel_gear_prop
    array set tunnel_gear_prop {}
    variable tunnel_gear_colormode
    array set tunnel_gear_colormode {}
    # Cluster-keyed mirror of the five tunnel_gear_* arrays, keyed
    # "<cid>,<field>". Those are keyed by RANK, which names a different
    # physical route in the next frame - so a per-tunnel color/material/
    # representation override silently jumped to an unrelated tunnel on every
    # frame change. _tunnel_sync_gear_from_cluster copies these back into the
    # rank arrays at draw time, the same way tunnel_shown_cid feeds
    # tunnel_shown. Absence here means "no override", which is distinct from
    # an override whose value is the empty string.
    variable tunnel_gear_cid
    array set tunnel_gear_cid {}
    variable tunnel_clusters
    array set tunnel_clusters {}
    variable current_surface_mol -1
    variable centerline_mol -1
    # Dedicated track for the Mean Profile tab's "Show in 3D viewer" surface - a
    # revolved-mean-radius tube, independent of the per-frame HOLE surface so it
    # can stay visible (or not) regardless of which frame is being scrubbed.
    variable mean_surface_mol -1
    # Path to the last-built mean .sph (write_stock_sph_file's plain centerline
    # output, build_and_show_mean_surface) - update_pore_lining_rep/_facing_rep
    # read this when state(show_mean_surface) is on, so the lining representation
    # follows what is actually on screen instead of staying anchored to whichever
    # per-frame result was last selected.
    variable mean_surface_sph ""
    # Tunnel-mode counterpart: an averaged 3D tube for the SELECTED cross-frame
    # cluster (build_and_show_tunnel_mean_surface), separate from mean_surface_mol
    # since the two are never the same geometry (one revolves a curve around a
    # straight axis, the other averages real 3D centreline positions) and can be
    # toggled independently if the user switches modes with either left on.
    variable tunnel_mean_surface_mol -1
    variable _tunnel_mean_surface_was_shown 0
    # Visibility-toggle button state (track region) - mirrors each surface
    # molecule's own VMD "Displayed" flag; see _update_surface_vis_buttons.
    variable _vis_pore_shown 0
    variable _vis_mean_shown 0
    variable _vis_tunnel_shown 0
    # Whether the per-frame tunnel geometry was on screen when the tunnel MEAN
    # surface took the view (see _tunnel_hide_geometry_for_mean). "" = the mean
    # is not currently holding it hidden.
    variable _tunnel_geom_was_shown ""
    # Pore<->Tunnel mode-tab visibility handoff (see _sync_solo_surface_for_mode):
    # which HOLE-side surface (pore/mean/ellipse/"") was on screen when the user
    # last left the HOLE tab, and whether the tunnel surface was on screen when
    # they last left the Tunnel tab - so switching back shows the same thing
    # again instead of leaving both tabs' surfaces stacked on top of each other.
    variable _hole_surface_was_shown ""
    variable _tunnel_surface_was_shown 0
    variable traced_molid {}
    # Per-molecule state so analyzing/switching between molecules does not
    # clobber each other. active_molid is the molecule whose results are
    # currently live in `results`/`result_frames`; mol_results / mol_result_frames
    # cache the other molecules' sets; surface_mols maps a reference molecule to
    # its own dedicated HOLE-surface track.
    variable active_molid {}
    # When set to 1 by the overwrite-confirmation dialog, the dialog is skipped
    # for the rest of this VMD session (resets to 0 on next VMD startup).
    variable overwrite_dialog_suppressed 0
    # Monotonic id for each Run/Import batch, so the frame list can color
    # frames by which run produced them.
    variable run_counter 0
    variable mol_results
    array set mol_results {}
    variable mol_result_frames
    array set mol_result_frames {}
    variable surface_mols
    array set surface_mols {}
    # MEMORY SLOTS (spherical pore mode only). One structure can hold several
    # pores; each memory is a complete analysis - its own run parameters, its
    # own results, its own surface - and they are all drawn at once.
    #
    # Same stash/restore shape as mol_results/activate_molecule, keyed by slot
    # instead of molecule, with two differences that matter: every memory's
    # surface stays visible so each needs its OWN surface mol, and each needs
    # its own work directory so a new run cannot overwrite an older one.
    variable pore_memories [dict create]
    variable pore_memory_active ""
    variable pore_memory_next 1
    # The folder the live results live in (one per run) and whether it is
    # under the temp dir.
    variable run_root ""
    variable run_root_temp 0
    variable mem_surface_mols
    array set mem_surface_mols {}
    # Memories are per molecule, stashed and restored by activate_molecule the
    # same way results are.
    variable mol_memories
    array set mol_memories {}
    # Transient inputs for the CVECT helper dialog.
    variable vec_mode {Two atoms}
    variable vec_atom1 {}
    variable vec_atom2 {}
    variable vec_p1 {}
    variable vec_p2 {}
    variable vec_label1 {}
    variable vec_label2 {}
    variable vec_label_map
    array set vec_label_map {}
    variable temporary_roots {}
    variable adv_visible 0
    variable busy 0
    variable slider_updating 0
    variable playing 0
    variable syncing_frame 0
    variable scrub_last_frame {}
    # Wall-clock (ms) of the most recent VMD-driven frame change (slider, VMD's
    # own animate controls - anything the plugin did not initiate). Lets the play
    # button tell "VMD is currently animating" from "idle" so pressing it stops
    # VMD's animation instead of starting a competing one.
    variable vmd_last_frame_ms 0
    variable ion_flow_geo {}
    variable heatmap_geo
    # {molid -> rep index} for the "Show pore facing" button's persistent rep, so
    # repeat clicks update the SAME representation instead of stacking duplicates.
    variable pore_facing_rep_idx [dict create]
    # Same, for Tunnel mode's own lining rep (MOLE's per-layer lining for the
    # SELECTED tunnel - a different measurement from pore lining, see
    # update_tunnel_lining_rep). Kept in its own dict so the two reps can be
    # parked and restored independently by the Pore<->Tunnel switch.
    variable tunnel_lining_rep_idx [dict create]
    # Same idea for the "Show pore facing" rep (visualizes
    # _lining_facing_sets's facing output - the same CHAP COG-based
    # residue set the "Pore-facing" property-averaging filter uses). Separate
    # index dict so the two overlays (lining vs. facing) don't collide.
    variable pore_facing_viz_rep_idx [dict create]
    variable heatmap_photo {}
    variable hydro_scalebar_mol -1
    variable hydro_scalebar_scheme ""
    # Scale-bar auto-reposition on window resize: VMD gives no Tcl resize event, so
    # a light poll of the window size redraws the (aspect-corrected) bar once the
    # size has SETTLED, keeping it in its corner like VMD's own axes indicator.
    variable scalebar_watch_id ""
    variable scalebar_drawn_size ""
    variable scalebar_seen_size ""
    # Ion-flow analysis. ion_flow_raw = the ONE expensive trajectory scan (per-ion
    # near-pore z/R/frame traces, unwrapped), produced by Compute. ion_flow_cache = the
    # CHEAP re-aggregation of that raw scan for the current species + R cutoff (grids +
    # flux + display traces), rebuilt live whenever Species/R-cutoff/View changes so the
    # user never has to press Compute just to re-filter.
    variable ion_flow_cache ""
    variable ion_flow_raw ""
    # Reshaped elliptical-pore surface molecule (PoreAnalyser-style), -1 when hidden.
    variable ellipse_surface_mol -1
    # Parsed-vmd_plot cache: plot_file -> {mtime entries}. Lets playback/scrub replay a
    # surface from memory instead of re-parsing the file every frame. Bounded LRU:
    # plot_cache_order tracks insertion order to evict the oldest once the cache exceeds
    # plot_cache_max_value() (Settings > "Rendered-surface cache", default 20). Each entry is
    # ~15-20 MB, so a larger cache trades RAM for smoother long-range scrubbing.
    variable plot_cache
    variable plot_stride_cache
    array set plot_cache {}
    array set plot_stride_cache {}
    variable plot_cache_order {}
    # Memoized profile aggregation for the analysis tabs. collect_binned_radii
    # iterates every sample point of every frame (~millions on a 10K-frame run);
    # without this, every tab draw and every tab switch re-runs it. Keyed by
    # "nbins|version"; the version bumps (and the cache clears) only when the
    # result set actually changes (new run / import / delete), so switching among
    # Over Time / Mean / Histogram is instant after the first compute.
    variable binned_cache [dict create]
    variable _conn_draft_build 0
    variable _unroll_layer_picked 0
    variable _2dmap_chain_names {}
    variable _conn_cls_memo [dict create]
    variable _conn_unroll_memo [dict create]
    variable msg_log {}
    variable conn_site_cache [dict create]
    variable plot_data_version 0
    # Single-entry memo for the heatmap's per-frame resample+aggregate (the
    # other expensive analysis-tab computation). Keyed "version|ncols|nbins";
    # ncols tracks the canvas width so a resize recomputes but a tab switch
    # reuses the matrix.
    variable hm_bundle_cache [dict create]
    # Same memo as hm_bundle_cache, for the Ellipse radius-source instead of HOLE's
    # circular one - kept as its own dict since it comes from a completely different
    # computation (the ellipse-probe fit vs HOLE's own profile), not just a key variant.
    variable hm_ellipse_bundle_cache [dict create]
    # Memo for the heatmap's finished photo render (color mapping + photo fill),
    # keyed by data version + pixel geometry + scheme + flip. A plain tab switch
    # reuses the photo; a resize / new data / scheme change repaints it.
    variable hm_render_cache {}
    variable _ionflow_coff {}   ;# run-level constant: profile coord - axis projection
    # Which Over-Time property scheme the user has explicitly approved for computing
    # (via the Compute button). Changing the scheme does NOT auto-run the per-frame
    # batch (costly on 40K-frame trajectories); draw_heatmap shows a "click Compute"
    # placeholder until the scheme here matches the picked scheme.
    variable _hm_computed_scheme ""
    # Reason the Over-Time heatmap is stale: "" = current, "facing" = facing
    # changed (show old photo + note), "version" handled by _hm_computed_scheme.
    variable _hm_stale_reason ""
    # "" = every frame in result_frames shares one pore method; otherwise a
    # short summary like "connolly (3), spherical (47)" - set by
    # refresh_results_list, read by the Over Time / Mean Profile / Trends
    # stale-data banners (see _result_frames_method_summary).
    variable _method_mismatch_summary ""
    # Cached sos_triangle hydrophobicity-capability probe, keyed by
    # "exec_path|mtime" so a swapped binary is re-probed. Empty each session, so
    # the check runs once per VMD startup (on first hydrophobic use).
    variable hydro_cap_cache [dict create]
    # Memo for the hydrophobicity-profile tab: key "frame|scheme|mode|facing|mtime"
    # -> sorted list of {coord radius h}. Cleared on new run / method change.
    variable hydro_profile_cache [dict create]
    # Atom-data cache for compute_sphere_hydro: key "molid|frame|seltext|bbox"
    # -> {pos res key name charge}. Avoids repeated atomselect+get across scheme
    # switches on the same frame. Cap 500; reset when exceeded.
    variable sphere_atom_cache [dict create]
    # Property-heatmap bundle cache: multi-key dict, key = full version|geometry
    # |scheme|lining string, value = data dict. Kept across scheme switches so
    # switching back is instant. Cap 6 (covers all 6 schemes at current geometry).
    variable hm_prop_cache [dict create]
    # Unrolled-map build memo: frame -> {sph_mtime result_message}. _2dmap_ensure
    # is called on EVERY draw and its build blocks in exec, so without this a
    # redraw storm re-ran HOLE per event. Failures are memoised too.
    variable _2dmap_memo
    array set _2dmap_memo {}
    # Per-sphere property value cache: key "version|molid|frame|seltext|bbox|prop|avg|facing|sidechain"
    # -> list of one scalar per sphere. Shared between profile and surface coloring paths so
    # a pore-profile compute pre-fills the cache for the surface (and vice versa). Invalidated
    # by plot_data_version bump (new HOLE run). Cap 2000; reset when exceeded.
    variable sphere_hydro_values_cache [dict create]
    # Fast-path -> single-frame bridge: the over-time C batch already computes one
    # value per centerline sphere for every frame, then throws them away after
    # resampling. We stash them here keyed "version|frame|scheme|avg|facing" -> list
    # of per-sphere values (centerline file order), so a later Pore-Profile Fill or
    # surface recolor for the SAME frame+scheme reuses them instead of recomputing
    # in Tcl. compute_sphere_hydro checks it (length must equal the requested sphere
    # count, so centerline-only callers hit and surface-cloud callers correctly miss).
    variable fastpath_sphere_cache [dict create]
    # Per-sphere true-3D property values, one list per key, keyed the same way
    # as fastpath_sphere_cache. This is the single source Pore Profile
    # Fill/Heatmap/Mean Profile read from when hydro_3d_accurate is on, so
    # they can never disagree with the 3D surface's own values.
    variable hydro3d_props_cache [dict create]
    # Topology cache for the fast heatmap batch path: key "molid|seltext" (no frame,
    # no bbox) -> {sel_handle all_res all_resid}. Holds a persistent VMD selection for
    # ALL seltext atoms; per-frame cost is only $sel frame + get {x y z}. Deleted
    # handles are evicted on the next write_hydro_sidecar_batch call (cap 20 entries).
    variable hydro_topo_cache [dict create]
    # ---- Caches: one registry, one clear ------------------------------------
    # Every cache the plugin keeps, with its empty form and the events that
    # drop it. cache_clear takes tags or names; the smoke test refuses a
    # cache variable that is not listed here.
    #   run      a new result set (clear_results_for_new_settings)
    #   results  the results list was rebuilt after a run (refresh_results_list)
    #   plot     the rendered look changed: colour source, hydro method, display
    #   keyed    invalidates itself by signature; listed so its lifetime is on record
    #   session  process-lifetime lookups
    variable _caches {
        plot_cache                {form array tags {run plot}}
        plot_stride_cache         {form array tags {run plot}}
        plot_cache_order          {form list  tags {run plot}}
        binned_cache              {form dict  tags {run results}}
        hm_prop_cache             {form dict  tags {run results}}
        hm_bundle_cache           {form dict  tags {run}}
        hm_ellipse_bundle_cache   {form dict  tags {run}}
        hm_render_cache           {form list  tags {run results}}
        sphere_hydro_values_cache {form dict  tags {run}}
        fastpath_sphere_cache     {form dict  tags {run}}
        conn_site_cache           {form dict  tags {run results}}
        _conn_cls_memo            {form dict  tags {run results}}
        _conn_unroll_memo         {form dict  tags {run results}}
        _2dmap_memo               {form array tags {results}}
        _tunnel_esp_cache         {form array tags {run results}}
        _cavity_track_cache       {form dict  tags {run results}}
        _pore_axis_memo           {form dict  tags {run results}}
        _conn_occ_memo            {form dict  tags {run results}}
        _tunnel_rows_memo         {form dict  tags {run results}}
        hydro_topo_cache          {form dict  tags {run} free _free_hydro_topo_cache}
        sphere_atom_cache         {form dict  tags {run}}
        hydro3d_props_cache       {form dict  tags {run}}
        trend_cache               {form list  tags {run}}
        ion_flow_cache            {form str   tags {run}}
        _fit_cache                {form unset tags {run}}
        asym_cache                {form unset tags {run}}
        asym_batch_cache          {form unset tags {keyed}}
        bottleneck_cache          {form unset tags {keyed}}
        formal_charge_cache       {form unset tags {keyed}}
        _esp_cache                {form unset tags {keyed}}
        _nproc_cache              {form unset tags {session}}
        _fc_ident_cache           {form unset tags {keyed}}
        _esp_profile_cache        {form unset tags {keyed}}
        hydro_profile_cache       {form dict  tags {keyed}}
        _axis_straightness_cache  {form unset tags {keyed}}
        _mean_vol_fields_cache    {form unset tags {keyed}}
        _perm_axes_cache          {form unset tags {keyed}}
        _ionflow_water_menu_cache {form unset tags {keyed}}
        _stab_selcache            {form list  tags {keyed}}
        _csg_owned                {form unset tags {keyed}}
        _axis_straight_memo       {form unset tags {keyed}}
        _lining_sets_memo         {form unset tags {keyed}}
        _pore_surf_memo           {form unset tags {keyed}}
        _tool_memo                {form array tags {session}}
        hydro_cap_cache           {form dict  tags {session}}
        _hole_tcl_script_cache    {form unset tags {session}}
        _ion_fallback_cache       {form unset tags {session}}
        _vmd_color_names_cache    {form unset tags {session}}
    }
    variable _props_fast_warned 0  ;# print the one-shot fallback note at most once
    # Re-entrancy guard for _sync_property_scheme_across_panels - each of
    # hydro_scheme/profile_color_scheme/mean_hydro_scheme writes the OTHER two
    # when the user picks a property in any one of them; without this guard,
    # each of those writes would itself trigger the same sync proc again via its
    # own write trace, looping. Also held around machine-driven scheme fallbacks
    # (refresh_property_scheme_menus) so those stay local. Over Time
    # (hm_prop_scheme) is not in the set at all - see that proc.
    variable _syncing_property_scheme 0
    # Tk radiobutton -variable for tunnel-mode Over Time's property menu. Its own,
    # not the _tunnel_profile_prop_tok the other three tunnel menus share -
    # a shared -variable would move Over Time's selected dot whenever the tunnel's
    # display property changed. Mirrors state(hm_tunnel_prop), which is what the
    # renderer and cache keys actually read.
    variable _hm_tunnel_prop_tok "hydropathy"
    # Hover-tooltip state (see add_tooltip) - no tcllib/"tooltip" package
    # dependency, since that's not guaranteed present in whatever Tcl/Tk
    # build VMD itself embeds.
    variable _tooltip_win ""
