proc ::VMDPathFinder::_center_toplevel {win {width 0} {height 0}} {
    # Centers on the main VMDPathFinder window - not the mouse pointer, which put a
    # dialog wherever the pointer last happened to be (jumpy/unpredictable,
    # and could push a dialog's title bar off the top edge on a small
    # screen). The main window itself (win eq w, only at first open/reopen -
    # see show_gui's early return for the already-open case) has no window to
    # center ON yet, so it uses the screen instead; both are still
    # multi-monitor-safe since winfo screenwidth/rootx/rooty all read whatever
    # monitor Tk/the WM currently consider current.
    #
    # width/height default to the window's own already-computed request size.
    # Withdrawn before its first geometry is set and only deiconified after,
    # so the window never becomes visible anywhere but its final position -
    # the previous "set geometry, let a FULL update map it (often at the WM's
    # own default spot), set geometry again to win the race" two-step was
    # itself the visible glide/relocation across the screen being reported,
    # not a fix for it.
    #
    # A window the user has already MOVED reopens where they left it, not back
    # at centre: re-centring every time discards a deliberate placement, which
    # reads as the dialog relocating itself. _toplevel_pos remembers the
    # position per window path (recorded on destroy, below); only a window
    # that has never been positioned by hand gets centred.
    variable w
    variable _toplevel_pos
    wm withdraw $win
    update idletasks
    # Whether the CALLER asked for a size, captured before the defaults below
    # fill it in. Only then is the size written into the geometry string: a
    # dialog that passed 0 must keep negotiating its own size, or it can never
    # grow when its content does.
    set _explicit [expr {$width > 0 && $height > 0}]
    if {$width  <= 0} { set width  [winfo reqwidth  $win] }
    if {$height <= 0} { set height [winfo reqheight $win] }
    set sw [winfo screenwidth  $win]
    set sh [winfo screenheight $win]
    if {[info exists _toplevel_pos($win)]} {
        lassign $_toplevel_pos($win) x y
        # Clamp exactly as a fresh placement is clamped - a remembered spot can
        # be off-screen now (monitor unplugged, resolution changed).
        if {$x + $width  > $sw} { set x [expr {$sw - $width}]  }
        if {$y + $height > $sh} { set y [expr {$sh - $height}] }
        if {$x < 0} { set x 0 }
        if {$y < 0} { set y 0 }
        wm geometry $win [_wm_geom_spec $_explicit $width $height $x $y]
        _remember_toplevel_pos $win
        wm deiconify $win
        return
    }
    if {$win eq $w} {
        set x [expr {($sw - $width)  / 2}]
        set y [expr {($sh - $height) / 2}]
    } else {
        set mw [winfo width  $w]
        set mh [winfo height $w]
        set mx [winfo rootx  $w]
        set my [winfo rooty  $w]
        set x [expr {$mx + ($mw - $width)  / 2}]
        set y [expr {$my + ($mh - $height) / 2}]
    }
    if {$x + $width  > $sw} { set x [expr {$sw - $width}]  }
    if {$y + $height > $sh} { set y [expr {$sh - $height}] }
    if {$x < 0} { set x 0 }
    if {$y < 0} { set y 0 }
    wm geometry $win [_wm_geom_spec $_explicit $width $height $x $y]
    _remember_toplevel_pos $win
    wm deiconify $win
}

proc ::VMDPathFinder::_wm_geom_spec {explicit width height x y} {
    # "WxH+x+y" when the caller asked for a size, so the window manager
    # negotiates once instead of twice; "+x+y" otherwise, leaving the window
    # free to size itself.
    if {$explicit && $width > 0 && $height > 0} {
        return "${width}x${height}+${x}+${y}"
    }
    return "+${x}+${y}"
}

proc ::VMDPathFinder::_remember_toplevel_pos {win} {
    # Record where this window sits, so reopening it restores that spot instead
    # of re-centring (see _center_toplevel).
    #
    # On <Configure>, not <Destroy>: by the time the toplevel's own Destroy
    # binding runs, `wm geometry` no longer reports a usable position, so
    # nothing was ever recorded (verified - the position came back centred).
    # Configure fires on every move, which is more often than needed, but the
    # handler is a single regexp against a string.
    #
    # %W-guarded because Configure also fires for descendants, which report
    # their OWN geometry rather than the window's.
    bind $win <Configure> [list ::VMDPathFinder::_on_toplevel_configure $win %W]
}

proc ::VMDPathFinder::_on_toplevel_configure {win which} {
    variable _toplevel_pos
    if {$which ne $win || ![winfo exists $win]} { return }
    catch {
        if {[regexp {([+-][0-9]+)([+-][0-9]+)$} [wm geometry $win] -> gx gy]} {
            set _toplevel_pos($win) [list [string trimleft $gx +] [string trimleft $gy +]]
        }
    }
}

proc ::VMDPathFinder::_pin_toplevel_size {win} {
    # Freeze a popup at its CURRENT requested size and return {w h}.
    #
    # For a dialog that grids/ungrids a control depending on another control's
    # value (the gear popups' Property column), Tk re-fits the toplevel on
    # every such change, so merely picking a different Color visibly resized
    # the window under the pointer. Called while every conditional widget is
    # still gridded, so the pinned size is the widest/tallest layout; a later
    # `grid remove` then leaves blank space instead of shrinking the window.
    # wm minsize (not a fixed wm geometry WxH) so the dialog can still grow if
    # a font or a longer label needs more room - it can only never shrink.
    update idletasks
    set ww [winfo reqwidth  $win]
    set hh [winfo reqheight $win]
    wm minsize $win $ww $hh
    return [list $ww $hh]
}

proc ::VMDPathFinder::window_diag {} {
    # Diagnostic for window-placement issues - run this in the VMD Tk console.
    # _center_toplevel's math depends on winfo screenwidth/height and
    # pointerx/y correctly reflecting the monitor the window should land on;
    # this reports those raw numbers plus the virtual root geometry some
    # tiling window managers use, so a placement problem can be diagnosed
    # from real numbers instead of guesswork.
    variable w
    set out {}
    lappend out "screenwidth/height: [winfo screenwidth .]/[winfo screenheight .]"
    lappend out "pointerx/y (combined virtual-desktop space): [winfo pointerx .]/[winfo pointery .]"
    catch {lappend out "vrootwidth/height: [winfo vrootwidth .]/[winfo vrootheight .]"}
    catch {lappend out "vrootx/y: [winfo vrootx .]/[winfo vrooty .]"}
    if {[info exists w] && [winfo exists $w]} {
        lappend out "VMDPathFinder window geometry (wm geometry): [wm geometry $w]"
    } else {
        lappend out "VMDPathFinder window is not currently open."
    }
    set msg [join $out "\n"]
    vmdcon -info "VMDPathFinder window_diag:\n$msg"
    return $msg
}

