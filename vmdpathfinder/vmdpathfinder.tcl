proc ::VMDPathFinder::_sweep_stale_tmpdirs {} {
    # Reclaims /tmp/vmdpathfinder_* scratch dirs (named vmdpathfinder_<type>_<pid>[_<ms>]) orphaned
    # by a crashed/killed VMD session, so they don't accumulate and fill /tmp. Deletes a
    # dir only when its owning pid is no longer alive (via /proc, Linux-only), so a
    # concurrent VMD instance's in-flight temp is never touched. No /proc (e.g. macOS) =
    # does nothing, since a live dir mistaken for stale would delete a running analysis.
    # Best-effort and silent; run once at first GUI open.
    if {![file isdirectory /proc]} { return }
    # THREE naming layouts exist, and the sweeper originally understood only the
    # first, so the other two accumulated after a killed session - the /dev/shm
    # one in RAM:
    #   vmdpathfinder_<type>_<pid>          scratch dirs        (pid last)
    #   vmdpathfinder_<pid>                 automatic results   (pid first)
    #   vmdpathfinder_<pid>_f<frame>        per-frame HOLE tmp  (pid first, /dev/shm)
    #   vmdpathfinder_<type>_<pid>_<ms>     clip / asymtrend    (pid in the MIDDLE)
    # So: if the component after "vmdpathfinder" is an integer that is the pid;
    # otherwise take the FIRST integer component.
    #
    # "Last integer" was wrong for the fourth layout - it picked the
    # MILLISECOND TIMESTAMP as the pid. A 13-digit ms value is never a live pid,
    # so /proc/<ms> never exists, so those directories were deleted on sight -
    # including a running session's, while its own scratch was still in use.
    # The first integer after a non-numeric <type> is the pid in both the
    # 3-part and 4-part layouts.
    foreach base {/tmp /dev/shm} {
        if {![file isdirectory $base]} { continue }
        foreach d [glob -nocomplain -directory $base -type d vmdpathfinder_*] {
            set parts [lrange [split [file tail $d] _] 1 end]
            if {[llength $parts] == 0} { continue }
            set pid ""
            if {[string is integer -strict [lindex $parts 0]]} {
                set pid [lindex $parts 0]
            } else {
                foreach _p $parts {
                    if {[string is integer -strict $_p]} { set pid $_p; break }
                }
            }
            if {![string is integer -strict $pid]} { continue }
            # Owner still running - never touch a live session's temp.
            if {[file isdirectory [file join / proc $pid]]} { continue }
            # /proc is not proof. In a PID namespace (a container) the process's /proc
            # cannot see the owner at all, so "absent" would mean "delete a
            # LIVE session's scratch". An age guard makes that unreachable: a
            # running session writes to its scratch, so anything untouched for
            # an hour is not in use, whatever /proc says. Costs only that a
            # crashed session's scratch survives its first hour.
            if {![catch {file mtime $d} _mt]
                && [clock seconds] - $_mt < 3600} { continue }
            catch {file delete -force $d}
        }
    }
}

